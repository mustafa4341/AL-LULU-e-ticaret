# Yönetim paneli giriş parolası (uzun ve tahmin edilemez olsun)
YONETIM_PAROLA=
# Oturum imza anahtarı: en az 32 karakter rastgele metin
OTURUM_GIZLI=

# Supabase bulut veritabanı ve depolama (tanımlıysa dosya deposu yerine Supabase kullanılır)
SUPABASE_URL=https://yrbvywobqnrqqvkndvqj.supabase.co
SUPABASE_KEY=
SUPABASE_SUNUCU_ANAHTARI=

# Kartlı ödeme: önce HTTPS test ortamında PAYTR_MOD=test.
# Canlıya geçerken PayTR mağaza panelinin onayından sonra PAYTR_MOD=canli.
PAYTR_MOD=kapali
PAYTR_SITE_URL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Veri klasörü (varsayılan: ./veri)
# VERI_KLASORU=

