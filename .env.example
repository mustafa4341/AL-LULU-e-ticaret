# Yönetim paneli giriş parolası (uzun ve tahmin edilemez olsun)
YONETIM_PAROLA=
# Oturum imza anahtarı: en az 32 karakter rastgele metin
OTURUM_GIZLI=

# Veri klasörü (varsayılan: ./veri)
# VERI_KLASORU=

# E-posta bildirimi (isteğe bağlı) — Gmail için "Uygulama şifresi" kullanın
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_KULLANICI=
# SMTP_PAROLA=
# SMTP_GONDEREN=
