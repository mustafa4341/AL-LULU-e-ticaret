---
import Ikon from './Ikon.astro';
/* İçerik scripts/sepet.ts tarafından doldurulur. */
---
<aside class="cekmece cekmece--sag" id="sepet" role="dialog" aria-modal="true" aria-labelledby="sepet-baslik" data-cekmece tabindex="-1" hidden>
  <div class="cekmece__tutamac" aria-hidden="true"></div>
  <div class="cekmece__bas">
    <h2 id="sepet-baslik" class="cekmece__baslik">Sepetiniz <span class="muted" data-sepet-baslik-sayi></span></h2>
    <button class="icon-btn" type="button" data-cekmece-kapat aria-label="Sepeti kapat"><Ikon ad="kapat" boyut={22} /></button>
  </div>
  <div class="cekmece__govde" data-sepet-govde></div>
  <div class="cekmece__alt" data-sepet-alt></div>
</aside>
