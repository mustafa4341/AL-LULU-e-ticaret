---
/* Mobil alt menü çubuğu (başparmak bölgesi). Ürün sayfasında yerini satın alma çubuğuna bırakır. */
import Ikon from './Ikon.astro';
interface Props { aktif?: string }
const { aktif } = Astro.props;
const k = Astro.locals.katalog;
---
<nav class="alt-menu" aria-label="Alt menü" data-alt-menu>
  <a href="/" class:list={['alt-menu__oge', { 'is-active': aktif === 'ana' }]} aria-current={aktif === 'ana' ? 'page' : undefined}>
    <Ikon ad="ev" boyut={22} /><span>Ana Sayfa</span>
  </a>
  <button type="button" class:list={['alt-menu__oge', { 'is-active': aktif && aktif !== 'ana' }]} data-cekmece-ac="kategori-paneli" aria-controls="kategori-paneli" aria-expanded="false">
    <Ikon ad="grid" boyut={22} /><span>Kategoriler</span>
  </button>
  <button type="button" class="alt-menu__oge" data-cekmece-ac="sepet" aria-controls="sepet" aria-expanded="false">
    <span class="alt-menu__ikon"><Ikon ad="canta" boyut={22} /><span class="cart-count" data-sepet-sayi data-bos="true">0</span></span><span>Sepetim</span>
  </button>
  <a href={k.whatsapp('Merhaba, bir sorum var.')} class="alt-menu__oge alt-menu__oge--wa" target="_blank" rel="noopener">
    <Ikon ad="whatsapp" boyut={22} /><span>WhatsApp</span>
  </a>
</nav>
