---
interface Props { bitis: string }
const { bitis } = Astro.props;
const tarih = new Date(bitis);
const bicim = new Intl.DateTimeFormat('tr-TR', { timeZone: 'Europe/Istanbul', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
const bitisMetni = bicim.format(tarih);
---
<span class="firsat-sure">
  <span data-firsat-sure hidden aria-hidden="true"></span>
  <time datetime={bitis} data-firsat-bitis aria-label={`Bitiş zamanı ${bitisMetni}, Türkiye saati`}>{bitisMetni}</time>
</span>
