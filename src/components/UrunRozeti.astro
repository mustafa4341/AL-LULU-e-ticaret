---
import type { RozetTonu } from '../lib/katalog';

interface Props {
  etiket: string;
  tur: 'cok-satan' | 'firsat' | 'stok' | 'ozellik';
  ton?: RozetTonu;
  konum?: 'galeri';
}

const { etiket, tur, ton = 'turuncu', konum } = Astro.props;
const cokSatan = tur === 'cok-satan';
---
<span class:list={['urun-rozeti', `urun-rozeti--${ton}`, konum && `urun-rozeti--${konum}`, { 'urun-rozeti--cok-satan': cokSatan }]}>
  <span>{etiket}</span>
</span>
