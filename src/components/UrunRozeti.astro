---
import Ikon from './Ikon.astro';

interface Props {
  etiket: string;
  tur: 'cok-satan' | 'firsat' | 'stok';
  konum?: 'galeri';
}

const { etiket, tur, konum } = Astro.props;
const cokSatan = tur === 'cok-satan';
---
<span class:list={['urun-rozeti', konum && `urun-rozeti--${konum}`, { 'urun-rozeti--cok-satan': cokSatan }]}>
  {!cokSatan && <Ikon ad={tur === 'firsat' ? 'etiket' : 'kutu'} boyut={14} />}
  <span>{etiket}</span>
</span>
