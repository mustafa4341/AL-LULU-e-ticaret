---
import type { Urun } from '../lib/sema';
import Ikon from './Ikon.astro';
import Fiyat from './Fiyat.astro';
import GorselYok from './GorselYok.astro';
import FirsatSayaci from './FirsatSayaci.astro';

interface Props {
  urun: Urun;
  konum?: string;
  oncelikliYukle?: boolean;
  /** Tek ürün gösterilirken tam genişlik, görsel solda */
  yatay?: boolean;
}
const { urun, konum = 'liste', oncelikliYukle = false, yatay = false } = Astro.props;
const k = Astro.locals.katalog;
const gorsel = k.anaGorsel(urun);
const bilgi = k.fiyatBilgisi(urun);
const rozet = k.rozetler(urun);
const stokta = k.stoktaMi(urun);
const kat = k.kategoriBul(urun.kategoriler[0]!);
const siralamaFiyati = bilgi.sepette?.fiyat ?? bilgi.fiyat;
---
<article class:list={["kart", { "kart--firsat": !!bilgi.firsat, "kart--yatay": yatay }]} data-urun-kart data-urun-id={urun.id} data-fiyat={siralamaFiyati} data-reveal>
  <a class="kart__gorsel" href={`/urun/${urun.id}`} tabindex="-1" aria-hidden="true">
    {gorsel ? (
      <img src={gorsel.src} alt="" width="400" height="400" loading={oncelikliYukle ? 'eager' : 'lazy'} decoding="async" data-ucus-gorsel />
    ) : (
      <GorselYok ikon={kat?.ikon} />
    )}
    {urun.durum === 'taslak' && <span class="rozet rozet--taslak kart__taslak">Örnek</span>}
    {rozet.damga && (k.cokSatanMi(urun)
      ? <span class="cok-satan-damga kart__cok-satan" aria-label="En Çok Satan"><span>En Çok<br />Satan</span></span>
      : <span class="damga"><span>{rozet.damga}</span></span>)}
    {bilgi.onceki && urun.durum !== 'taslak' && <span class="kart__indirim"><Ikon ad="trend" boyut={12} />%{bilgi.yuzde}</span>}
    {rozet.serit && <span class="kart__serit"><Ikon ad="kargo" boyut={14} />{rozet.serit}</span>}
  </a>
  <div class="kart__govde">
    <h3 class="kart__ad"><a href={`/urun/${urun.id}`}><strong lang="en">{urun.marka}</strong> {urun.ad}</a></h3>
    {bilgi.firsat && <FirsatSayaci etiket={bilgi.firsat.etiket} bitis={bilgi.firsat.bitis} stil={bilgi.firsat.stil} boyut="kucuk" />}
    {!bilgi.firsat && rozet.kucuk.length > 0 && <p class="kart__bilgi"><Ikon ad="kalkan" boyut={14} />{rozet.kucuk[0]}</p>}
    <Fiyat bilgi={bilgi} boyut="kucuk" />
    {bilgi.etiket && <span class="indirim-etiket" style="font-size:11.5px;margin-top:2px">{bilgi.etiket}</span>}
  </div>
  {stokta ? (
    <button class="kart__ekle" type="button" data-sepete-ekle data-tip="urun" data-id={urun.id} data-konum={konum} data-hizli aria-label={`${urun.kisaAd} sepete ekle`}>
      <Ikon ad="canta" boyut={16} /><span data-etiket>Sepete Ekle</span>
    </button>
  ) : (
    <button class="kart__ekle" type="button" disabled>Tükendi</button>
  )}
</article>
