---
import UrunVitrini from './UrunVitrini.astro';
import { BUTCE_ESIGI } from '../../lib/katalog';
import { formatTL } from '../../lib/fiyat';
import type { Urun } from '../../lib/sema';

const k = Astro.locals.katalog;
const cokSatanlar = k.cokSatanUrunler();
const butce = k.butceUrunleri();
const adaylar = k.oneCikanUrunler().filter((u) => k.stoktaMi(u));
const vitrineGirenler = new Set([...cokSatanlar.slice(0, 4), ...butce.slice(0, 4)].map((u) => u.id));
const secim: Urun[] = [];
const kullanilanKategoriler = new Set<string>();
for (const u of adaylar) {
  const kategori = u.kategoriler[0];
  if (!kategori || kullanilanKategoriler.has(kategori) || vitrineGirenler.has(u.id)) continue;
  kullanilanKategoriler.add(kategori);
  secim.push(u);
}
const urunler = [...secim, ...adaylar.filter((u) => !secim.includes(u) && !vitrineGirenler.has(u.id)), ...adaylar.filter((u) => vitrineGirenler.has(u.id))];
---
<UrunVitrini id="one-cikanlar" baslik={k.anaSayfa.oneCikanlarBaslik} {urunler} href="/urunler" baglanti="Tüm ürünleri gör" />
<UrunVitrini id="cok-satanlar" baslik="Çok satanlar" urunler={cokSatanlar} href="/urunler?secim=cok-satan" baglanti="Çok satanları gör" ton="sicak" />
<UrunVitrini id="butceye-uygun" baslik={`${formatTL(BUTCE_ESIGI)} ve altı`} urunler={butce} href="/urunler?secim=butce" baglanti="Bu fiyat aralığını gör" />
