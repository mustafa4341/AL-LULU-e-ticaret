---
import UrunVitrini from './UrunVitrini.astro';
import FirsatSure from '../FirsatSure.astro';

const k = Astro.locals.katalog;
const indirimliler = k.indirimliUrunler();
const urunler = [...new Set([...indirimliler, ...k.firsatUrunleri()])];
const sadeceIndirim = urunler.length === indirimliler.length;
const enYakin = urunler.slice(0, 4).map((u) => u.firsat?.bitis)
  .filter((b): b is string => !!b && Number.isFinite(Date.parse(b)))
  .sort((a, b) => Date.parse(a) - Date.parse(b))[0];
---
<UrunVitrini id="firsatlar" baslik={sadeceIndirim ? 'İndirimdekiler' : 'Fırsat ürünleri'} {urunler} ton="indirim"
  href={sadeceIndirim ? '/urunler?secim=indirim' : '/urunler?secim=firsat'} baglanti={sadeceIndirim ? 'Tüm indirimleri gör' : 'Tüm fırsatları gör'}>
  {enYakin && <div slot="baslik-eki" class="firsat-bolum__sayac" data-firsat-sayac={enYakin}>
    <span class="muted small">İlk fırsatın bitişine</span>
    <FirsatSure bitis={enYakin} />
  </div>}
</UrunVitrini>
