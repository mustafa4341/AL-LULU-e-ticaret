---
/* Ana sayfa vitrini — müşteri ilk bakışta 4 soruya cevap bulmalı:
   Ne satılıyor? (büyük, tıklanabilir görsel) · Neden değerli? (3 madde)
   Ne kadar avantajlı? (fiyat; GERÇEK indirim varsa üstü çizili + % rozeti) · Nasıl alırım? (butonlar)
   Rozetler yalnız doğru bilgiden: "En Çok Satan" gerçek satıştan, "%X İndirim" fiyat geçmişinden (lib/fiyat.ts). */
import Fiyat from '../Fiyat.astro';
import Ikon from '../Ikon.astro';
import KargoSayaci from '../KargoSayaci.astro';
import FirsatSayaci from '../FirsatSayaci.astro';
import UrunRozeti from '../UrunRozeti.astro';
import OzellikListesi from '../OzellikListesi.astro';
import { metindenIkon } from '../../lib/ozellik';
const k = Astro.locals.katalog;
const h = k.anaSayfa.hero;
const urun = k.urunBul(h.urunId);
const gorsel = urun ? k.anaGorsel(urun) : undefined;
const rozet = urun ? k.rozetler(urun) : undefined;
const bilgi = urun ? k.fiyatBilgisi(urun) : undefined;
/* Görselin sol üst etiketi: gerçek durum varsa o (En Çok Satan / Fırsat / Son N Adet), yoksa panel → "Üst başlık" */
const etiket = rozet?.damga ?? h.ustBaslik;
const rozetTuru = urun && k.cokSatanMi(urun) ? 'cok-satan' : bilgi?.firsat ? 'firsat' : 'stok';
const href = urun ? `/urun/${urun.id}` : '/';
---
{urun && (
  <section class="hero hero--vitrin" aria-labelledby="hero-baslik">
    <div class="container hero__grid">
      <a class="hero__vitrin" href={href} aria-label={`${urun.marka} ${urun.kisaAd} ürün sayfasını aç`}>
        {gorsel && <img src={gorsel.src} alt="" width="400" height="400" fetchpriority="high" data-yuklenen-gorsel />}
        {rozet?.damga ? (
          <UrunRozeti etiket={rozet.damga} tur={rozetTuru} />
        ) : (
          etiket && <span class="hero__etiket">{etiket}</span>
        )}
        {bilgi?.onceki && <span class="hero__indirim"><Ikon ad="trend" boyut={14} />%{bilgi.yuzde} İndirim</span>}
        <span class="hero__incele-hap">Ürünü incele <Ikon ad="sag" boyut={16} /></span>
      </a>
      <div class="hero__metin">
        {bilgi?.firsat && <FirsatSayaci etiket={bilgi.firsat.etiket} bitis={bilgi.firsat.bitis} stil={bilgi.firsat.stil} />}
        <h1 id="hero-baslik"><a href={href}>{h.baslik}</a></h1>
        <p class="hero__alt">{h.altBaslik}</p>
        <OzellikListesi kucuk maddeler={h.maddeler.slice(0, 3).map((m) => ({ ikon: metindenIkon(m), metin: m }))} dipnot="" />
        <div class="hero__fiyat"><Fiyat bilgi={bilgi!} boyut="buyuk" /></div>
        {rozet?.serit && <p class="hero__kargo"><Ikon ad="kargo" boyut={18} />{rozet.serit} · Vergiler dahil</p>}
        <div class="hero__cta">
          <button class="btn btn--simdi" type="button" data-hemen-al data-tip="urun" data-id={urun.id}>Şimdi Al</button>
          <button class="btn btn--sepet" type="button" data-sepete-ekle data-tip="urun" data-id={urun.id} data-konum="hero">
            <Ikon ad="canta" boyut={18} /><span data-etiket>Sepete Ekle</span>
          </button>
        </div>
        <a class="hero__detay" href={href}>
          <span><strong>Ürünü incele</strong><span>Fotoğraflar, pişirme süreleri, teknik özellikler</span></span>
          <Ikon ad="sag" boyut={18} />
        </a>
        {h.maddeler.some((m) => m.includes('*')) && <p class="hero__dipnot">* Fissler verisi; yemeğe ve miktara göre değişir.</p>}
        <KargoSayaci kompakt />
      </div>
    </div>
  </section>
)}
