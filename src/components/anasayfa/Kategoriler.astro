---
import Ikon from '../Ikon.astro';
const k = Astro.locals.katalog;
const kategoriler = k.gorunurKategoriler({ anaSayfa: true }).filter((kat) => k.kategoriUrunleri(kat.id).length > 0);
---
{kategoriler.length >= 2 && (
  <section class="bolum kategori-bolum" aria-labelledby="kat-baslik">
    <div class="container">
      <div class="bolum-bas">
        <h2 id="kat-baslik">Kategoriler</h2>
        <a class="bolum-bas__link" href="/urunler">Tüm ürünler</a>
      </div>
      <div class="kategori-grid">
        {kategoriler.map((kat) => {
          const n = k.kategoriUrunleri(kat.id).length;
          return (
            <a class="kategori-kart" href={`/kategori/${kat.id}`} data-reveal>
              <span class="kategori-kart__ikon"><Ikon ad={kat.ikon} boyut={22} /></span>
              <span class="kategori-kart__ad">{kat.ad}</span>
              <span class="kategori-kart__alt">{n} ürün</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .kategori-bolum { padding-block: clamp(20px, 3vw, 36px); }
  .kategori-grid { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
  .kategori-kart { gap: 8px; padding: 12px; min-height: 108px; }
  @media (max-width: 699px) {
    .kategori-grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 128px; overflow-x: auto; scroll-snap-type: x proximity; padding: 4px 3px 8px; }
    .kategori-kart { scroll-snap-align: start; }
  }
</style>
