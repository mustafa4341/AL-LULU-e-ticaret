---
/* Tek navigasyon kuralı:
   • Mobil: üstte logo + WhatsApp + sepet; kategoriler alttaki menü çubuğundan (AltMenu).
   • Masaüstü: kategoriler başlığın altındaki satırda. Hamburger menü yok. */
import Ikon from './Ikon.astro';
import Logo from './Logo.astro';
import { ODEME_BAGLI } from '../lib/altyapi';

interface Props {
  /** Aktif kategori id'si, 'setler' veya 'urunler' */
  aktif?: string;
  /** Ödeme sayfası: dikkat dağıtmayan sade başlık */
  sade?: boolean;
}
const { aktif, sade = false } = Astro.props;
const k = Astro.locals.katalog;
const kategoriler = k.gorunurKategoriler({ menu: true });
const setVar = k.tumSetler().length > 0;
const wa = k.whatsapp('Merhaba, bir sorum var.');
---
{sade ? (
  <header class="site-header site-header--sade">
    <div class="container header-row">
      <a class="header-logo" href="/" aria-label="Al Lulu Home ana sayfa"><Logo /></a>
      <div class="header-actions">
        <a class="header-wa" href={wa} target="_blank" rel="noopener" aria-label={`WhatsApp destek ${k.site.telefonGorunen}`}>
          <Ikon ad="whatsapp" boyut={20} /><span>Yardım: {k.site.telefonGorunen}</span>
        </a>
        {Astro.url.pathname === '/odeme' && ODEME_BAGLI() && <span class="header-guvenli"><Ikon ad="kilit" boyut={16} /><span>PayTR ile ödeme</span></span>}
      </div>
    </div>
  </header>
) : (
  <header class="site-header" data-header>
    <div class="container header-row">
      <a class="header-logo" href="/" aria-label="Al Lulu Home ana sayfa"><Logo /></a>
      <div class="header-actions">
        <a class="header-wa" href={wa} target="_blank" rel="noopener" aria-label={`WhatsApp'tan yazın: ${k.site.telefonGorunen}`}>
          <Ikon ad="whatsapp" boyut={22} /><span>{k.site.telefonGorunen}</span>
        </a>
        <button class="icon-btn cart-btn" type="button" data-cekmece-ac="sepet" aria-controls="sepet" aria-expanded="false" aria-label="Sepeti aç">
          <Ikon ad="canta" boyut={24} />
          <span class="cart-count" data-sepet-sayi data-bos="true">0</span>
        </button>
      </div>
    </div>
    <nav class="cat-nav" aria-label="Kategoriler">
      <div class="container cat-nav__track">
        <a href="/urunler" class:list={['cat-link', { 'is-active': aktif === 'urunler' }]}>Tüm ürünler</a>
        {kategoriler.map((kat) => (
          <a href={`/kategori/${kat.id}`} class:list={['cat-link', { 'is-active': aktif === kat.id }]} aria-current={aktif === kat.id ? 'page' : undefined}>{kat.ad}</a>
        ))}
        {setVar && <a href="/setler" class:list={['cat-link cat-link--firsat', { 'is-active': aktif === 'setler' }]}><Ikon ad="etiket" boyut={16} />Setler & Fırsatlar</a>}
      </div>
    </nav>
  </header>
)}
