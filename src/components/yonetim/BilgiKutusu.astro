---
/**
 * Panelde "bu sayfa ne işe yarar / ne yapmalıyım" açıklaması.
 * Açılıp kapanır; kapatılınca o tarayıcıda kapalı kalır (anahtar başına). Tarayıcı depolaması
 * kapalıysa her zaman açık başlar — içerik yine okunur.
 */
interface Props {
  baslik: string;
  /** Kapalı/açık tercihinin saklandığı kısa ad (sayfaya özgü) */
  anahtar: string;
  ton?: 'bilgi' | 'ipucu' | 'uyari';
  acik?: boolean;
}
const { baslik, anahtar, ton = 'bilgi', acik = true } = Astro.props;
---
<details class:list={['y-bilgi', 'y-bilgi--' + ton]} open={acik} data-bilgi={anahtar}>
  <summary>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 11v6M12 7.2v.1" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
    <span>{baslik}</span>
    <small class="y-bilgi__ac">Göster</small><small class="y-bilgi__kapat">Gizle</small>
  </summary>
  <div class="y-bilgi__icerik"><slot /></div>
</details>

<script>
  const ANAHTAR = 'y-bilgi:';
  for (const kutu of document.querySelectorAll<HTMLDetailsElement>('details[data-bilgi]')) {
    const ad = ANAHTAR + kutu.dataset.bilgi;
    try { if (localStorage.getItem(ad) === 'kapali') kutu.open = false; } catch { /* depolama kapalı */ }
    kutu.addEventListener('toggle', () => {
      try { localStorage.setItem(ad, kutu.open ? 'acik' : 'kapali'); } catch { /* depolama kapalı */ }
    });
  }
</script>

<style is:global>
  .y-bilgi { margin: 0 0 12px; border: 1px solid #d9e3ee; border-left: 4px solid #3b6fa8; border-radius: 9px; background: #f5f9fd; color: #1f2d3d; }
  .y-bilgi--ipucu { border-color: #e6dcc2; border-left-color: #aa812e; background: #fdfaf2; color: #3a2f1c; }
  .y-bilgi--uyari { border-color: #f0d2c9; border-left-color: #b42318; background: #fdf5f3; color: #5b1a12; }
  .y-bilgi > summary { display: flex; align-items: center; gap: 8px; padding: 10px 13px; cursor: pointer; font-weight: 700; font-size: 14px; list-style: none; min-height: 44px; }
  .y-bilgi > summary::-webkit-details-marker { display: none; }
  .y-bilgi > summary svg { flex: none; color: #3b6fa8; }
  .y-bilgi--ipucu > summary svg { color: #aa812e; }
  .y-bilgi--uyari > summary svg { color: #b42318; }
  .y-bilgi > summary span { flex: 1; }
  .y-bilgi > summary small { font-weight: 600; font-size: 12px; color: #4f6378; text-decoration: underline; text-underline-offset: 2px; }
  .y-bilgi[open] .y-bilgi__ac, .y-bilgi:not([open]) .y-bilgi__kapat { display: none; }
  .y-bilgi__icerik { padding: 0 14px 12px 39px; font-size: 13.5px; line-height: 1.6; }
  .y-bilgi__icerik > :first-child { margin-top: 0; }
  .y-bilgi__icerik > :last-child { margin-bottom: 0; }
  .y-bilgi__icerik p { margin: 0 0 6px; }
  .y-bilgi__icerik ul, .y-bilgi__icerik ol { margin: 4px 0 6px; padding-left: 18px; }
  .y-bilgi__icerik ul { list-style: disc; }
  .y-bilgi__icerik ol { list-style: decimal; }
  .y-bilgi__icerik li { margin-bottom: 3px; }
  .y-bilgi__icerik code { background: #fff; border: 1px solid #dfe6ee; border-radius: 4px; padding: 0 4px; font-size: 12.5px; }
  @media (max-width: 600px) { .y-bilgi__icerik { padding-left: 14px; } }
</style>
