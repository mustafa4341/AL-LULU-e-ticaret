---
import Ikon from '../Ikon.astro';
import { kargoFirmalari } from '../../lib/kargoTakip';
import { siradakiDurum } from '../../lib/siparisAkisi';
import type { Siparis, SiteAyarlari } from '../../lib/sema';

interface Props { siparis: Siparis; kargo: SiteAyarlari['kargo']; form?: FormData; action?: string; geri?: string }
const { siparis, kargo, form, action, geri } = Astro.props;
const durum = siradakiDurum(siparis);
const kargola = durum === 'kargoda';
const adlar = { odendi: 'Ödemeyi onayla', hazirlaniyor: 'Hazırlamaya al', kargoda: 'Kargoya verildi', 'teslim-edildi': 'Teslim edildi olarak işaretle' };
---
{durum && <form method="post" {action} data-editor={action && kargola && !geri ? '' : undefined} class:list={['y-sonraki', { 'y-sonraki--kargo': kargola }]}>
  {geri && <input type="hidden" name="geri" value={geri} />}
  <input type="hidden" name="eylem" value="durum" /><input type="hidden" name="durum" value={durum} />
  {durum === 'odendi' && <label class="y-secim"><input type="checkbox" name="odemeOnay" required />Ödemenin hesaba geçtiğini kontrol ettim.</label>}
  {kargola && <>
    <label class="y-alan">Kargo firması<select name="kargoFirma" required><option value="">Firma seçin</option>
      {kargoFirmalari(kargo).map((x) => <option value={x.ad} selected={x.ad === (form?.get('kargoFirma') || siparis.kargoFirma || kargo.firma)}>{x.ad}</option>)}
    </select></label>
    <label class="y-alan">Kargo takip numarası<input name="kargoTakip" required minlength="6" maxlength="40" autocomplete="off" value={String(form?.get('kargoTakip') ?? siparis.kargoTakip ?? '')} placeholder="Kargo fişindeki numara" /></label>
  </>}
  {/* Teslim edildi geri alınamaz (müşteriye e-posta gider, değerlendirme açılır): onay sorulur — denetim AUD-029 */}
  <button class="btn btn--sepet" type="submit" data-onayla={durum === 'teslim-edildi' ? 'Sipariş teslim edildi olarak işaretlensin mi? Müşteriye bildirim gider ve bu adım geri alınamaz.' : undefined}>{kargola && <Ikon ad="kargo" boyut={16} />}{adlar[durum]}</button>
</form>}
