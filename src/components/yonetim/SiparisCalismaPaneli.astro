---
/**
 * Siparişler ekranındaki sağ çalışma paneli (Slide-over Workspace).
 * Mağaza sahibinin sipariş listesinden ayrılmadan:
 *  - Hazırlama / Toplamaya Başla / Paketle
 *  - Kargo etiketi, barkodla paketleme, takip numarası ve iç belgeler
 *  - 3 aşamalı e-Arşiv fatura (1. GİB Kopyala -> 2. Kaydet -> 3. İlet)
 *  - Eşleşmeyen ürün bağlama, stok açığı tamamlama, iade depo kontrolü
 *  - Sipariş bazlı gerçek kazanç / hakediş / mutabakat ve zaman çizelgesi
 * işlemlerini yürütmesini sağlar. Tüm mutasyonlar mevcut tek-sahip POST uçlarına `geri` ile döner.
 */
import Ikon from '../Ikon.astro';
import KanalLogo from './KanalLogo.astro';
import PIkon from './PIkon.astro';
import SiparisSonraki from './SiparisSonraki.astro';
import { epostaBagli } from '../../lib/altyapi';
import { BELGE_DURUMLARI, BELGE_TURLERI, belgeGecerli, finansGunu, finansPara, type BelgeTuru } from '../../lib/finans';
import { faturaKanalLinki } from '../../lib/faturaKanaldan';
import { GENEL_TCKN, GIB_PORTAL, sayiYaz, tlYaz } from '../../lib/faturaMerkezi';
import { HB_IPTAL_NEDENLERI, hbOrtakEtiketVar } from '../../lib/hepsiburadaApi';
import { PY_DURUM_ADLARI, kurusTL } from '../../lib/pazaryeri';
import { pazaryeriApiDurumu } from '../../lib/pazaryeriApi';
import { SIPARIS_DURUM_ADLARI, type SiteAyarlari, type Urun } from '../../lib/sema';
import { gonderildi, iadeEdildi, iptalEdilebilir, siradakiDurum } from '../../lib/siparisAkisi';
import type { SiparisMerkeziKaydi } from '../../lib/siparisMerkezi';
import { tyOrtakEtiketVar } from '../../lib/trendyolApi';
import { yTarih } from '../../lib/yonetimRapor';

interface Props {
  kayit: SiparisMerkeziKaydi;
  panelId: string;
  acik: boolean;
  geriBazAdresi: string;
  kapatAdresi: string;
  oncekiPanelId?: string;
  sonrakiPanelId?: string;
  siraBilgisi: string;
  kargoAyar: SiteAyarlari['kargo'];
  urunSecenekleri: Urun[];
  kullanilabilirStok: (u: Urun) => number;
  origin: string;
}

const {
  kayit: s,
  panelId,
  acik,
  geriBazAdresi,
  kapatAdresi,
  oncekiPanelId,
  sonrakiPanelId,
  siraBilgisi,
  kargoAyar,
  urunSecenekleri,
  kullanilabilirStok,
  origin,
} = Astro.props;

const geriAdresi = `${geriBazAdresi}${geriBazAdresi.includes('?') ? '&' : '?'}sec=${encodeURIComponent(s.anahtar)}`;
const bugun = finansGunu();
const tyBagli = ['canli', 'test'].includes(pazaryeriApiDurumu('trendyol'));
const hbBagli = ['canli', 'test'].includes(pazaryeriApiDurumu('hepsiburada'));
const smtpAcik = epostaBagli();

const KANAL_PANELI = {
  trendyol: 'https://partner.trendyol.com/account/login',
  hepsiburada: 'https://merchant.hepsiburada.com/',
} as const;

const py = s.py;
const web = s.web;
const faturaAdayi = s.fatura.aday;
const kesilenFatura = s.fatura.kayit;

const tyIslemAcik = Boolean(
  py && py.kanal === 'trendyol' && py.paketNo && !s.entegrasyon.testSiparisi && tyBagli
  && !['Cancelled', 'UnSupplied', 'Returned'].includes(py.hamDurum),
);
const hbIslemAcik = Boolean(
  py && py.kanal === 'hepsiburada' && !s.entegrasyon.testSiparisi && hbBagli
  && !['iptal', 'iade', 'teslim-edilemedi', 'onay-bekliyor'].includes(py.durum),
);
const stokEngeli = s.stok.durum === 'eslesmeyen' || s.stok.durum === 'eksik';

const waFaturaLinki = (() => {
  if (!web || !kesilenFatura) return undefined;
  const tel = web.musteri.tel.replace(/\D/g, '');
  if (!tel) return undefined;
  const tamTel = tel.startsWith('90') ? tel : tel.startsWith('0') ? '9' + tel : '90' + tel;
  if (!/^90\d{10}$/.test(tamTel)) return undefined;
  const mesaj = `Merhaba ${web.musteri.ad}, ${web.no} numaralı Al Lulu Home siparişinizin ${kesilenFatura.no} numaralı e-Arşiv faturası hazırlanmıştır. Sipariş durumunuzu ${origin}/siparis-takip adresinden görüntüleyebilirsiniz.`;
  return `https://wa.me/${tamTel}?text=${encodeURIComponent(mesaj)}`;
})();

const siraliBelgeler = [...s.belgeler].sort((a, b) => b.olusturma.localeCompare(a.olusturma));
const mevcutBelge = Object.fromEntries(siraliBelgeler.filter(belgeGecerli).map((b) => [b.tur, b])) as Partial<Record<BelgeTuru, (typeof s.belgeler)[number]>>;
const webIptalMi = web ? web.durum === 'iptal' || iadeEdildi(web) : false;

const gecmisListesi = web
  ? [...web.gecmis].reverse().map((g) => ({
      tarih: g.tarih,
      baslik: g.islem === 'iade' ? 'İade tamamlandı' : g.durum ? SIPARIS_DURUM_ADLARI[g.durum] : (g.islem ?? 'İşlem'),
      not: g.not,
    }))
  : py
    ? [...py.gecmis].reverse().map((g) => ({
        tarih: g.tarih,
        baslik: PY_DURUM_ADLARI[g.durum],
        not: g.not,
      }))
    : [];

const varsayilanSekme = s.birincilIslem.sekme;
---

<section id={panelId} class="sp-panel" data-panel-kayit data-siparis-anahtar={s.anahtar} hidden={!acik}>
  {/* 1. ÜST ÖZET VE GEÇİŞ ÇUBUĞU */}
  <header class="sp-ust">
    <div class="sp-ust__kimlik">
      <KanalLogo kanal={s.kanal} boyut="kucuk" />
      <div>
        <div class="sp-ust__no-satir">
          <h2>{s.no}</h2>
          <button type="button" class="y-kopya" data-kopyala={s.no} title="Sipariş numarasını kopyala" aria-label={s.no + ' kopyala'}>
            <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v10H9zM5 15V5h10" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          </button>
          {s.entegrasyon.etiket && <span class="y-chip y-chip--gri">{s.entegrasyon.etiket}</span>}
        </div>
        <small class="muted">
          {s.kanalAdi} · {yTarih.format(new Date(s.tarih))}
          {s.paketNo && s.paketNo !== s.no ? ` · Paket ${s.paketNo}` : ''}
        </small>
      </div>
    </div>

    <div class="sp-ust__sag">
      <div class="sp-gecis" role="group" aria-label="Siparişler arası geçiş">
        <button type="button" class="y-icon-button" data-panel-gecis={oncekiPanelId} disabled={!oncekiPanelId} title="Önceki sipariş" aria-label="Önceki sipariş">
          <PIkon ad="ok-sol" boyut={16} />
        </button>
        <span class="sp-gecis__sira">{siraBilgisi}</span>
        <button type="button" class="y-icon-button" data-panel-gecis={sonrakiPanelId} disabled={!sonrakiPanelId} title="Sonraki sipariş" aria-label="Sonraki sipariş">
          <PIkon ad="sag" boyut={16} />
        </button>
      </div>
      <a class="y-icon-button" href={s.detayHref} title="Tam sayfa sipariş detayını aç" aria-label={s.no + ' tam detay sayfası'}>
        <PIkon ad="dis-baglanti" boyut={16} />
      </a>
      <a href={kapatAdresi} class="y-icon-button" data-astro-prefetch="false" data-panel-kapat title="Paneli kapat" aria-label="Paneli kapat">
        <Ikon ad="kapat" boyut={17} />
      </a>
    </div>
  </header>

  {/* 2. TEK BAKIŞTA AŞAMA ÇİZGİSİ VE TUTAR */}
  <div class="sp-ozet-serit">
    <div class="sp-ozet-serit__sol">
      <span class:list={['y-chip', 'y-chip--' + s.asamaRenk]}>{s.asamaEtiketi}</span>
      <span class:list={['y-chip', 'y-chip--' + s.fatura.renk]}>{s.fatura.kisaEtiket}</span>
      {s.stok.durum !== 'ayrildi' && s.stok.durum !== 'bekliyor' && (
        <span class:list={['y-chip', 'y-chip--' + s.stok.renk]}>{s.stok.etiket}</span>
      )}
    </div>
    <strong class="sp-tutar">{kurusTL(s.tutarKurus)}</strong>
  </div>

  <ol class="sp-adimlar" aria-label="Sipariş aşamaları">
    {s.adimlar.map((a) => (
      <li class:list={['sp-adim', 'is-' + a.durum]}>
        <span class="sp-adim__nokta" aria-hidden="true"></span>
        <span class="sp-adim__ad">{a.ad}</span>
      </li>
    ))}
  </ol>

  {/* 3. UYARILAR VE TEK BİRİNCİL EYLEM KUTUSU */}
  {s.uyarilar.length > 0 && (
    <div class="sp-uyari-kutusu" role="status">
      <PIkon ad="uyari" boyut={17} />
      <ul>{s.uyarilar.map((u) => <li>{u}</li>)}</ul>
    </div>
  )}

  <div class:list={['sp-birincil', 'is-' + s.birincilIslem.tur]}>
    <div class="sp-birincil__metin">
      <span class="sp-birincil__ust"><PIkon ad="simsek" boyut={15} /> Sıradaki İşlem</span>
      <strong>{s.birincilIslem.etiket}</strong>
      <small>{s.birincilIslem.aciklama}</small>
    </div>

    {/* Doğrudan tek tıkla çalışabilen birincil aksiyonlar (ek girdi istemeyenler) hemen burada; girdi isteyenler altındaki ilgili karta odaklanır */}
    <div class="sp-birincil__aksiyon">
      {s.birincilIslem.kod === 'ty-toplama' && tyIslemAcik && !stokEngeli ? (
        <form method="post" action={s.detayHref} data-tek-gonder>
          <input type="hidden" name="geri" value={geriAdresi} />
          <button class="btn btn--sepet" type="submit" name="eylem" value="ty-toplama">Toplamaya Başla →</button>
        </form>
      ) : s.birincilIslem.kod === 'hb-paketle' && hbIslemAcik && !stokEngeli ? (
        <form method="post" action={s.detayHref} data-tek-gonder>
          <input type="hidden" name="geri" value={geriAdresi} />
          <button class="btn btn--sepet" type="submit" name="eylem" value="hb-paketle">Kargoya Hazırla →</button>
        </form>
      ) : s.birincilIslem.kod === 'web-hazirla' && web && !stokEngeli ? (
        <form method="post" action={s.detayHref} data-tek-gonder>
          <input type="hidden" name="geri" value={geriAdresi} />
          <input type="hidden" name="eylem" value="durum" />
          <input type="hidden" name="durum" value="hazirlaniyor" />
          <button class="btn btn--sepet" type="submit">Hazırlamaya Al →</button>
        </form>
      ) : s.birincilIslem.kod === 'stok-coz' && web && web.paytr?.stokEksik ? (
        <form method="post" action={s.detayHref} data-tek-gonder>
          <input type="hidden" name="geri" value={geriAdresi} />
          <button class="btn btn--sepet" type="submit" name="eylem" value="stok-tamamla">Stoğu Ayır →</button>
        </form>
      ) : s.birincilIslem.odak ? (
        <button
          type="button"
          class="btn btn--sepet"
          data-sp-odak={`${panelId}-${s.birincilIslem.odak}`}
          data-sp-hedef-sekme={s.birincilIslem.sekme}
        >
          {s.birincilIslem.etiket} ↓
        </button>
      ) : (
        <a class="btn btn--cizgi" href={s.detayHref}>Tam Detayı Aç →</a>
      )}
    </div>
  </div>

  {/* 4. İÇERİK SEKMELERİ: İŞLEMLER | KAZANÇ | GEÇMİŞ */}
  <div class="sp-sekmeler" role="tablist" aria-label="Sipariş çalışma bölümleri">
    <button type="button" role="tab" aria-selected={varsayilanSekme === 'islemler' ? 'true' : 'false'} data-sp-sekme="islemler">
      <PIkon ad="kutu" boyut={15} /> İşlemler
    </button>
    <button type="button" role="tab" aria-selected={varsayilanSekme === 'kazanc' ? 'true' : 'false'} data-sp-sekme="kazanc">
      <PIkon ad="para" boyut={15} /> Kazanç
    </button>
    <button type="button" role="tab" aria-selected={varsayilanSekme === 'gecmis' ? 'true' : 'false'} data-sp-sekme="gecmis">
      <PIkon ad="gecmis" boyut={15} /> Müşteri &amp; Geçmiş
    </button>
  </div>

  {/* ==================== SEKME 1: İŞLEMLER ==================== */}
  <div class="sp-icerik" data-sp-icerik="islemler" hidden={varsayilanSekme !== 'islemler'}>
    {/* A) ÜRÜN LİSTESİ + EŞLEŞTİRME / STOK / İADE KONTROLÜ */}
    <div class="sp-kart" id={`${panelId}-eslestir`}>
      <div class="sp-kart__bas">
        <h3><PIkon ad="kutu" boyut={15} /> Sipariş Kalemleri ({s.toplamAdet} adet)</h3>
        {s.paketleHref && (
          <a class="btn btn--cizgi btn--kucuk" href={s.paketleHref}>
            <PIkon ad="barkod" boyut={15} /> Barkodla Paketle
          </a>
        )}
      </div>

      <ul class="sp-kalemler" id={`${panelId}-stok`}>
        {s.kalemler.map((k) => (
          <li class="sp-kalem">
            <div class="sp-kalem__satir">
              {k.gorsel ? (
                <img src={k.gorsel} alt="" width="40" height="40" loading="lazy" />
              ) : (
                <span class="y-kalem-gorsel--yok"><Ikon ad="kutu" boyut={16} /></span>
              )}
              <div class="sp-kalem__bilgi">
                <strong>{k.ad}</strong>
                <small>
                  {k.adet} adet × {kurusTL(k.birimKurus)}
                  {k.sku ? ` · ${k.sku}` : ''}
                  {k.barkod && k.barkod !== k.sku ? ` · Barkod: ${k.barkod}` : ''}
                </small>
              </div>
              <b class="sp-kalem__tutar">{kurusTL(k.toplamKurus)}</b>
            </div>

            {/* Pazaryeri eşleşmeyen ürün bağlama formu */}
            {py && k.eslesmeyen && (
              <form method="post" action={s.detayHref} class="sp-alt-form sp-alt-form--uyari" data-tek-gonder>
                <input type="hidden" name="geri" value={geriAdresi} />
                <input type="hidden" name="surum" value={py.surum} />
                <input type="hidden" name="kalem" value={k.anahtar} />
                <label class="y-alan">Katalog ürününe bağla (stok otomatik düşer ve kod kaydedilir)
                  <select name="urun" required class="y-girdi">
                    <option value="">Ürün seçin…</option>
                    {urunSecenekleri.map((u) => (
                      <option value={u.id}>{u.marka} {u.kisaAd} (Stok: {kullanilabilirStok(u)})</option>
                    ))}
                  </select>
                </label>
                <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="eslestir">Ürünü Eşleştir ve Stoğu Düş</button>
              </form>
            )}

            {/* Pazaryeri eksik stok tamamlama */}
            {py && k.eksikStok > 0 && (
              <form method="post" action={s.detayHref} class="sp-alt-form sp-alt-form--uyari" data-tek-gonder>
                <input type="hidden" name="geri" value={geriAdresi} />
                <input type="hidden" name="surum" value={py.surum} />
                <input type="hidden" name="kalem" value={k.anahtar} />
                <p class="y-help y-yazi-kirmizi" style="margin:0">{k.eksikStok} adet stok açığı var. Depo stoğunu artırdıktan sonra buradan tamamlayın.</p>
                <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="stogu-tamamla">Eksik Stoğu Tamamla</button>
              </form>
            )}

            {/* Pazaryeri iade depo kontrolü */}
            {py && k.iadeBekliyor && (
              <form method="post" action={s.detayHref} class="sp-alt-form" id={`${panelId}-iade`} data-tek-gonder>
                <input type="hidden" name="geri" value={geriAdresi} />
                <input type="hidden" name="surum" value={py.surum} />
                <input type="hidden" name="kalem" value={k.anahtar} />
                <label class="y-alan">İade gelen ürünün durumu
                  <select name="iade-karari" required class="y-girdi">
                    <option value="satilabilir">Satılabilir durumda — ortak stoğa geri ekle</option>
                    <option value="satilamaz">Hasarlı / kullanılmış — stoğa ekleme</option>
                  </select>
                </label>
                <label class="y-secim">
                  <input type="checkbox" name="iade-onay" required />
                  <span>Paketi depoda kontrol ettim</span>
                </label>
                <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="iade">İade Kararını Kaydet</button>
              </form>
            )}
          </li>
        ))}
      </ul>
    </div>

    {/* B) HAZIRLAMA, KARGO VE ETİKET İŞLEMLERİ (KANAL GERÇEKLERİNE GÖRE) */}
    <div class="sp-kart" id={`${panelId}-durum`}>
      <div class="sp-kart__bas">
        <h3><PIkon ad="kargo" boyut={15} /> Hazırlama, Etiket ve Kargo</h3>
        {s.kargo.takipUrl && (
          <a class="y-link" href={s.kargo.takipUrl} target="_blank" rel="noopener">Kargo Takibi ↗</a>
        )}
      </div>

      {stokEngeli && (
        <p class="y-uyari" style="margin:0 0 8px">
          Yukarıdaki ürün eşleştirme / stok açığı çözülmeden hazırlama ve kargo adımları güvenlik için kilitlidir.
        </p>
      )}

      {/* WEB KANAL İŞLEMLERİ */}
      {web && !s.entegrasyon.testSiparisi && (
        <div class="sp-kanal-blok">
          {!stokEngeli && siradakiDurum(web) && (
            <SiparisSonraki siparis={web} kargo={kargoAyar} action={s.detayHref} geri={geriAdresi} />
          )}
          {web.kargoTakip && (
            <p class="sp-bilgi-satir">
              <span>Kargo: <strong>{web.kargoFirma || kargoAyar.firma}</strong> · <code>{web.kargoTakip}</code></span>
              <button type="button" class="y-kopya" data-kopyala={web.kargoTakip} title="Takip numarasını kopyala">Kopyala</button>
            </p>
          )}
          {!webIptalMi && (
            <div class="sp-buton-grup">
              <a class="btn btn--cizgi btn--kucuk" href={`/yonetim/finans/etiket?no=${encodeURIComponent(web.no)}&bicim=etiket`} target="_blank" rel="noopener">
                <PIkon ad="yazici" boyut={15} /> 10×15 Etiket
              </a>
              <a class="btn btn--cizgi btn--kucuk" href={`/yonetim/finans/etiket?no=${encodeURIComponent(web.no)}&bicim=a4`} target="_blank" rel="noopener">
                <PIkon ad="yazici" boyut={15} /> A4 Etiket
              </a>
              <a class="btn btn--cizgi btn--kucuk" href={`/yonetim/finans/etiket?no=${encodeURIComponent(web.no)}&bicim=a4&tur=toplama`} target="_blank" rel="noopener">
                <PIkon ad="liste" boyut={15} /> Toplama Fişi
              </a>
            </div>
          )}
        </div>
      )}

      {/* TRENDYOL KANAL İŞLEMLERİ */}
      {py && py.kanal === 'trendyol' && (
        <div class="sp-kanal-blok" id={`${panelId}-kanal`}>
          {py.kargoTakip ? (
            <p class="sp-bilgi-satir">
              <span>Kargo Kodu ({py.kargoFirma || 'Trendyol'}): <code>{py.kargoTakip}</code></span>
              <button type="button" class="y-kopya" data-kopyala={py.kargoTakip}>Kopyala</button>
            </p>
          ) : (
            <p class="y-help" style="margin:0">“Toplamaya Başla” bildirildikten sonra Trendyol kargo barkodunu oluşturur.</p>
          )}
          <div class="sp-buton-grup">
            {tyIslemAcik && py.hamDurum === 'Created' && (
              <form method="post" action={s.detayHref} data-tek-gonder>
                <input type="hidden" name="geri" value={geriAdresi} />
                <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="ty-toplama" disabled={stokEngeli}>
                  Toplamaya Başla
                </button>
              </form>
            )}
            {tyIslemAcik && py.kargoTakip && tyOrtakEtiketVar(py.kargoFirma) && (
              <form method="post" action={s.detayHref}>
                <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="ty-etiket">
                  <PIkon ad="yazici" boyut={15} /> Termal Etiket (ZPL) İndir
                </button>
              </form>
            )}
            {tyIslemAcik && py.kargoTakip && !tyOrtakEtiketVar(py.kargoFirma) && (
              <>
                <a class="btn btn--sepet btn--kucuk" href={`/yonetim/siparisler/pazaryeri/${encodeURIComponent(py.id)}/etiket?kagit=a4`} target="_blank" rel="noopener">
                  <PIkon ad="yazici" boyut={15} /> A4 Barkodlu Etiket Yazdır
                </a>
                <a class="btn btn--cizgi btn--kucuk" href={`/yonetim/siparisler/pazaryeri/${encodeURIComponent(py.id)}/etiket?kagit=etiket`} target="_blank" rel="noopener">
                  <PIkon ad="barkod" boyut={15} /> 10×10 Etiket
                </a>
              </>
            )}
            <a class="btn btn--cizgi btn--kucuk" href={KANAL_PANELI.trendyol} target="_blank" rel="noopener">
              Trendyol Paneli ↗
            </a>
          </div>
          {py.kargoTakip && !tyOrtakEtiketVar(py.kargoFirma) && (
            <small class="muted">Barkodlu kargo etiketini doğrudan buradan A4 veya 10×10 cm yazdırabilirsiniz; kargo görevlisi barkodu okutunca sipariş otomatik “Kargoda” olur.</small>
          )}
        </div>
      )}

      {/* HEPSİBURADA KANAL İŞLEMLERİ */}
      {py && py.kanal === 'hepsiburada' && (
        <div class="sp-kanal-blok" id={`${panelId}-kanal`}>
          {py.kargoTakip && (
            <p class="sp-bilgi-satir">
              <span>Kargo ({py.kargoFirma || 'Hepsiburada'}): <code>{py.kargoTakip}</code></span>
              <button type="button" class="y-kopya" data-kopyala={py.kargoTakip}>Kopyala</button>
            </p>
          )}
          {hbIslemAcik && s.asama === 'hazirlanacak' && (
            <form method="post" action={s.detayHref} class="sp-satir-form" data-tek-gonder>
              <input type="hidden" name="geri" value={geriAdresi} />
              <input class="y-girdi" name="desi" inputmode="decimal" placeholder="Desi (opsiyonel)" style="max-width:130px" />
              <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="hb-paketle" disabled={stokEngeli}>
                Kargoya Hazırla (Paketle)
              </button>
            </form>
          )}
          <div class="sp-buton-grup">
            {hbIslemAcik && hbOrtakEtiketVar(py.kargoFirma) && (
              <form method="post" action={s.detayHref}>
                <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="hb-etiket">
                  <PIkon ad="yazici" boyut={15} /> Kargo Etiketi (PDF) İndir
                </button>
              </form>
            )}
            <a class="btn btn--cizgi btn--kucuk" href={KANAL_PANELI.hepsiburada} target="_blank" rel="noopener">
              Hepsiburada Paneli ↗
            </a>
          </div>
          {hbIslemAcik && !['kargoda', 'tamamlandi', 'iptal-iade'].includes(s.asama) && (
            <details class="sp-detay-kart" style="border-color:#f0c2bc;background:#fff9f8;margin-top:4px">
              <summary style="color:var(--y-kirmizi)">Tehlikeli İşlemler · Paket Boz / Kalem İptali</summary>
              <div class="sp-detay-icerik">
                {s.asama === 'kargoya-hazir' && (
                  <form method="post" action={s.detayHref} class="sp-alt-form sp-alt-form--uyari" data-tek-gonder>
                    <input type="hidden" name="geri" value={geriAdresi} />
                    <input type="hidden" name="eylem" value="hb-paket-boz" />
                    {py.paketNo && <input type="hidden" name="paket" value={py.paketNo} />}
                    <label class="y-secim"><input type="checkbox" name="hb-onay" required /><span>Paketi boz (mevcut kargo barkodu iptal olur)</span></label>
                    <button class="btn btn--cizgi btn--kucuk" type="submit">Paketi Boz (Unpack)</button>
                  </form>
                )}
                <form method="post" action={s.detayHref} class="sp-alt-form sp-alt-form--uyari" data-tek-gonder>
                  <input type="hidden" name="geri" value={geriAdresi} />
                  <input type="hidden" name="eylem" value="hb-kalem-iptal" />
                  {py.kalemler.length > 1 ? (
                    <label class="y-alan">İptal edilecek kalem
                      <select name="satirId" required class="y-girdi">
                        <option value="">Kalem seçin…</option>
                        {py.kalemler.filter((k) => k.satirId).map((k) => <option value={k.satirId}>{k.adet}× {k.ad}</option>)}
                      </select>
                    </label>
                  ) : py.kalemler[0]?.satirId ? (
                    <input type="hidden" name="satirId" value={py.kalemler[0].satirId} />
                  ) : null}
                  <label class="y-alan">Hepsiburada iptal nedeni
                    <select name="nedenId" required class="y-girdi">
                      <option value="">Neden seçin…</option>
                      {Object.entries(HB_IPTAL_NEDENLERI).map(([kod, ad]) => <option value={kod}>{ad}</option>)}
                    </select>
                  </label>
                  <label class="y-secim"><input type="checkbox" name="hb-iptal-onay" required /><span>Cezai yaptırımı biliyorum, kalemi iptal et</span></label>
                  <button class="btn btn--cizgi btn--kucuk y-yazi-kirmizi" type="submit" data-onayla="Bu Hepsiburada kalemi kalıcı olarak iptal edilsin mi?">Kalemi İptal Et</button>
                </form>
              </div>
            </details>
          )}
        </div>
      )}
    </div>

    {/* C) 3 AŞAMALI RESMÎ FATURA AKIŞI (1. KESİLECEK -> 2. KAYDEDİLDİ -> 3. İLETİLDİ) */}
    {s.fatura.asama !== 'gerekmez' && (
      <div class="sp-kart sp-fatura-kart" id={`${panelId}-fatura`}>
        <div class="sp-kart__bas">
          <h3><PIkon ad="fatura" boyut={15} /> e-Arşiv Fatura (3 Aşamalı)</h3>
          <span class:list={['y-chip', 'y-chip--' + s.fatura.renk]}>{s.fatura.etiket}</span>
        </div>

        <ol class="sp-fatura-adimlar" aria-label="Fatura aşamaları">
          <li class:list={{ 'is-tamam': s.fatura.adimNo > 1, 'is-aktif': s.fatura.adimNo === 1 }}>1. GİB’de Kes</li>
          <li class:list={{ 'is-tamam': s.fatura.adimNo > 2, 'is-aktif': s.fatura.adimNo === 2 }}>2. Kaydet</li>
          <li class:list={{ 'is-tamam': s.fatura.adimNo === 3 }}>3. İletildi</li>
        </ol>

        {/* AŞAMA 1: GİB KOPYALA + KAYDET FORMU */}
        {s.fatura.asama === 'kesilecek' && faturaAdayi && (
          <div class="sp-fatura-govde">
            <div class="sp-gib-kutu">
              <div class="sp-gib-baslik">
                <strong>1. Adım: GİB e-Arşiv Bilgileri</strong>
                <a class="btn btn--cizgi btn--kucuk" href={GIB_PORTAL} target="_blank" rel="noopener">GİB Portalını Aç ↗</a>
              </div>
              {faturaAdayi.eksikler.length > 0 && (
                <p class="y-uyari" style="margin:4px 0">Eksik bilgi: {faturaAdayi.eksikler.join('; ')}</p>
              )}
              <dl class="sp-kopya-liste">
                <div>
                  <dt>{faturaAdayi.alici.tip === 'kurumsal' ? 'Unvan' : 'Ad Soyad'}</dt>
                  <dd>
                    <span>{faturaAdayi.alici.firma || faturaAdayi.alici.ad || '—'}</span>
                    {(faturaAdayi.alici.firma || faturaAdayi.alici.ad) && (
                      <button type="button" class="y-kopya" data-kopyala={faturaAdayi.alici.firma || faturaAdayi.alici.ad}>Kopyala</button>
                    )}
                  </dd>
                </div>
                <div>
                  <dt>{faturaAdayi.alici.tip === 'kurumsal' ? 'VKN / VD' : 'TCKN'}</dt>
                  <dd>
                    <span>
                      {faturaAdayi.alici.tip === 'kurumsal'
                        ? `${faturaAdayi.alici.vergiNo || '—'} (${faturaAdayi.alici.vergiDairesi || '—'})`
                        : `${faturaAdayi.alici.tckn || GENEL_TCKN}${faturaAdayi.alici.tcknBilinmiyor ? ' (genel)' : ''}`}
                    </span>
                    <button
                      type="button"
                      class="y-kopya"
                      data-kopyala={faturaAdayi.alici.tip === 'kurumsal' ? (faturaAdayi.alici.vergiNo || '') : (faturaAdayi.alici.tckn || GENEL_TCKN)}
                    >
                      Kopyala
                    </button>
                  </dd>
                </div>
                {faturaAdayi.alici.adres && (
                  <div>
                    <dt>Adres</dt>
                    <dd>
                      <span>{faturaAdayi.alici.adres}</span>
                      <button type="button" class="y-kopya" data-kopyala={faturaAdayi.alici.adres}>Kopyala</button>
                    </dd>
                  </div>
                )}
                <div>
                  <dt>Fatura Notu</dt>
                  <dd>
                    <span>{faturaAdayi.aciklama}</span>
                    <button type="button" class="y-kopya" data-kopyala={faturaAdayi.aciklama}>Kopyala</button>
                  </dd>
                </div>
              </dl>

              <div class="sp-fatura-satirlar">
                {faturaAdayi.satirlar.map((st) => (
                  <div class="sp-fatura-satir">
                    <span>{st.adet}× {st.ad} <small class="muted">(KDV %{st.kdvOrani})</small></span>
                    <span>
                      KDV hrç birim: <strong>{sayiYaz(st.birimHaric)}</strong>
                      <button type="button" class="y-kopya" data-kopyala={sayiYaz(st.birimHaric)}>Kopyala</button>
                    </span>
                  </div>
                ))}
                <div class="sp-fatura-toplam">
                  <span>KDV Hariç: {tlYaz(faturaAdayi.toplam.matrah)} TL · KDV: {tlYaz(faturaAdayi.toplam.kdv)} TL</span>
                  <strong>Genel Toplam: {finansPara(faturaAdayi.toplam.genel)}</strong>
                </div>
              </div>
            </div>

            {s.kanal === 'trendyol' && tyBagli && (
              <form method="post" action="/yonetim/finans/faturalar" class="sp-alt-form" data-tek-gonder>
                <input type="hidden" name="geri" value={geriAdresi} />
                <input type="hidden" name="siparisNo" value={s.no} />
                <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="trendyoldan-al">
                  <PIkon ad="indir" boyut={15} /> Faturayı Trendyol Panelinden Yüklediysem Çek
                </button>
              </form>
            )}

            <form method="post" action="/yonetim/finans/faturalar" enctype="multipart/form-data" class="sp-alt-form" data-tek-gonder>
              <input type="hidden" name="geri" value={geriAdresi} />
              <input type="hidden" name="eylem" value="kaydet" />
              <input type="hidden" name="anahtar" value={faturaAdayi.anahtar} />
              <strong>2. Adım: Kestiğiniz Faturayı Kaydedin</strong>
              <div class="sp-ikili">
                <label class="y-alan">Fatura No
                  <input class="y-girdi" name="no" required maxlength="40" placeholder="GIB2026000000012" autocomplete="off" />
                </label>
                <label class="y-alan">Tarih
                  <input class="y-girdi" type="date" name="tarih" value={bugun} max={bugun} required />
                </label>
              </div>
              <label class="y-alan">Fatura PDF / Görsel (en fazla 4 MB)
                <input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" />
              </label>
              {s.kanal !== 'hepsiburada' && (
                <label class="y-secim">
                  <input type="checkbox" name="ilet" checked={s.kanal === 'trendyol' ? tyBagli : smtpAcik} />
                  <span>{s.kanal === 'trendyol' ? 'Kaydedince Trendyol’a otomatik yükle' : 'Kaydedince müşteriye e-posta ile gönder'}</span>
                </label>
              )}
              <button class="btn btn--sepet btn--kucuk" type="submit">
                <PIkon ad="tik" boyut={15} /> Faturayı Kaydet{s.kanal !== 'hepsiburada' ? ' ve İlet' : ''}
              </button>
            </form>
          </div>
        )}

        {/* AŞAMA 2 VE 3: KAYDEDİLMİŞ FATURA YÖNETİMİ VE İLETİM */}
        {kesilenFatura && (
          <div class="sp-fatura-govde">
            <div class="sp-bilgi-satir">
              <span>
                <strong>{kesilenFatura.no}</strong> · {kesilenFatura.tarih.split('-').reverse().join('.')} · {finansPara(kesilenFatura.toplam)}
              </span>
              {kesilenFatura.ek ? (
                <a class="y-link" href={`/yonetim/finans/fatura-dosya?id=${encodeURIComponent(kesilenFatura.id)}`} target="_blank" rel="noopener">
                  PDF Aç ↗
                </a>
              ) : faturaKanalLinki(kesilenFatura) ? (
                <span class="y-chip y-chip--yesil">✓ Trendyol’da Yüklü</span>
              ) : (
                <span class="y-chip y-chip--turuncu">PDF eklenmedi</span>
              )}
            </div>

            {s.fatura.hataMesaji && (
              <p class="y-uyari" style="margin:0">{s.fatura.hataMesaji}</p>
            )}

            {!kesilenFatura.ek && (
              <form method="post" action="/yonetim/finans/faturalar" enctype="multipart/form-data" class="sp-alt-form" data-tek-gonder>
                <input type="hidden" name="geri" value={geriAdresi} />
                <input type="hidden" name="eylem" value="dosya-yukle" />
                <input type="hidden" name="id" value={kesilenFatura.id} />
                <label class="y-alan">Eksik Fatura PDF Dosyasını Yükle
                  <input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" required />
                </label>
                {s.kanal !== 'hepsiburada' && (
                  <label class="y-secim">
                    <input type="checkbox" name="ilet" checked={s.kanal === 'trendyol' ? tyBagli : smtpAcik} />
                    <span>Yükleyince otomatik ilet</span>
                  </label>
                )}
                <button class="btn btn--sepet btn--kucuk" type="submit">Dosyayı Kaydet</button>
              </form>
            )}

            <div class="sp-buton-grup">
              {s.kanal === 'trendyol' && kesilenFatura.ek && (
                <form method="post" action="/yonetim/finans/faturalar" data-tek-gonder>
                  <input type="hidden" name="geri" value={geriAdresi} />
                  <input type="hidden" name="id" value={kesilenFatura.id} />
                  <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="ilet" disabled={!tyBagli}>
                    <PIkon ad="gonder" boyut={15} /> {s.fatura.asama === 'iletildi' ? 'Trendyol’a Tekrar Yükle' : 'Trendyol’a Otomatik Yükle'}
                  </button>
                </form>
              )}
              {s.kanal === 'web' && kesilenFatura.ek && smtpAcik && (
                <form method="post" action="/yonetim/finans/faturalar" data-tek-gonder>
                  <input type="hidden" name="geri" value={geriAdresi} />
                  <input type="hidden" name="id" value={kesilenFatura.id} />
                  <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="ilet">
                    <PIkon ad="gonder" boyut={15} /> {s.fatura.asama === 'iletildi' ? 'E-postayı Tekrar Gönder' : 'Müşteriye E-posta Gönder'}
                  </button>
                </form>
              )}
              {waFaturaLinki && (
                <a class="btn btn--cizgi btn--kucuk" href={waFaturaLinki} target="_blank" rel="noopener">
                  <PIkon ad="whatsapp" boyut={15} /> WhatsApp ile Bildir ↗
                </a>
              )}
              {s.kanal === 'hepsiburada' && (
                <a class="btn btn--cizgi btn--kucuk" href={KANAL_PANELI.hepsiburada} target="_blank" rel="noopener">
                  Hepsiburada Paneli ↗
                </a>
              )}
              {s.fatura.asama !== 'iletildi' && (
                <form method="post" action="/yonetim/finans/faturalar" data-tek-gonder>
                  <input type="hidden" name="geri" value={geriAdresi} />
                  <input type="hidden" name="id" value={kesilenFatura.id} />
                  <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="elle">
                    <PIkon ad="tik" boyut={15} /> {s.kanal === 'hepsiburada' ? 'HB’ye Yükledim (3/3 Tamamla)' : 'Elle İlettim (3/3 Tamamla)'}
                  </button>
                </form>
              )}
            </div>
          </div>
        )}
      </div>
    )}

    {/* D) WEB İÇ SİPARİŞ BELGELERİ VE İADE / İPTAL (KATLANIR) */}
    {web && !s.entegrasyon.testSiparisi && (
      <details class="sp-detay-kart">
        <summary><PIkon ad="belge" boyut={15} /> Koli İçi Belgeler ve İptal / İade İşlemleri</summary>
        <div class="sp-detay-icerik">
          <div class="sp-belgeler">
            {(['ozet', 'fis', 'paket', 'iade'] as BelgeTuru[]).filter((t) => !webIptalMi || t === 'iade').map((t) => {
              const b = mevcutBelge[t];
              return (
                <div class="sp-belge-satir">
                  <span><strong>{BELGE_TURLERI[t]}</strong> {b && <small class="muted">({BELGE_DURUMLARI[b.durum]})</small>}</span>
                  <div class="sp-buton-grup">
                    {b && ['duzenlendi', 'gonderildi'].includes(b.durum) ? (
                      <>
                        <a class="btn btn--cizgi btn--kucuk" href={`/yonetim/finans/belge?goster=1&id=${encodeURIComponent(b.id)}`} target="_blank" rel="noopener">Aç ↗</a>
                        <a class="btn btn--cizgi btn--kucuk" href={`/yonetim/finans/belge?id=${encodeURIComponent(b.id)}`}>İndir</a>
                      </>
                    ) : (
                      <form method="post" action="/yonetim/finans/belge" data-tek-gonder>
                        <input type="hidden" name="geri" value={geriAdresi} />
                        <input type="hidden" name="no" value={web.no} />
                        <input type="hidden" name="tur" value={t} />
                        <input type="hidden" name="indir" value="0" />
                        <button class="btn btn--cizgi btn--kucuk" type="submit" name="islem" value="olustur">Oluştur</button>
                      </form>
                    )}
                  </div>
                </div>
              );
            })}
          </div>

          {iptalEdilebilir(web) && (
            <form method="post" action={s.detayHref} class="sp-alt-form" data-tek-gonder>
              <input type="hidden" name="geri" value={geriAdresi} />
              <input type="hidden" name="eylem" value="durum" />
              <input type="hidden" name="durum" value="iptal" />
              <label class="y-alan">Siparişi İptal Et (stok geri eklenir)
                <input class="y-girdi" name="iptalNotu" placeholder="İptal sebebi (isteğe bağlı)" maxlength="240" />
              </label>
              <button class="btn btn--cizgi btn--kucuk y-yazi-kirmizi" type="submit" data-onayla={`${web.no} numaralı siparişi iptal etmek istediğinize emin misiniz?`}>
                Siparişi İptal Et
              </button>
            </form>
          )}

          {gonderildi(web) && !iadeEdildi(web) && (
            <form method="post" action={s.detayHref} class="sp-alt-form" data-tek-gonder>
              <input type="hidden" name="geri" value={geriAdresi} />
              <input type="hidden" name="eylem" value="iade" />
              <label class="y-secim">
                <input type="checkbox" name="iadeOnay" required />
                <span>Ürün depoya sağlam döndü ve ücret iadesi yapıldı (stok geri eklenir)</span>
              </label>
              <button class="btn btn--cizgi btn--kucuk" type="submit">İadeyi Tamamla</button>
            </form>
          )}
        </div>
      </details>
    )}
  </div>

  {/* ==================== SEKME 2: KAZANÇ VE MUTABAKAT ==================== */}
  <div class="sp-icerik" data-sp-icerik="kazanc" hidden={varsayilanSekme !== 'kazanc'}>
    <div class="sp-kart">
      <div class="sp-kart__bas">
        <h3><PIkon ad="para" boyut={15} /> Sipariş Ekonomisi ve Net Kâr</h3>
        <span class="y-chip y-chip--gri">
          {s.kazanc.kaynak === 'kesinlesen-ekstre' ? 'Kesinleşen Ekstre' : s.kazanc.kaynak === 'web-hesabi' ? 'Web Satışı' : s.kazanc.kaynak === 'tahmini-tarife' ? 'Tarife Tahmini' : 'Bilgi'}
        </span>
      </div>

      <dl class="sp-hesap">
        <div><dt>Müşterinin Ödediği (KDV dahil)</dt><dd><strong>{kurusTL(s.kazanc.musteriOdedigi)}</strong></dd></div>
        {s.kazanc.indirim > 0 && <div><dt>Uygulanan İndirim</dt><dd>−{kurusTL(s.kazanc.indirim)}</dd></div>}
        {s.kazanc.komisyon !== undefined && s.kazanc.komisyon > 0 && <div><dt>Kanal Komisyonu</dt><dd>−{kurusTL(s.kazanc.komisyon)}</dd></div>}
        {s.kazanc.kargoKesintisi !== undefined && <div><dt>Kargo Kesintisi / Maliyeti</dt><dd>−{kurusTL(s.kazanc.kargoKesintisi)}</dd></div>}
        {s.kazanc.hizmetKesintisi !== undefined && s.kazanc.hizmetKesintisi > 0 && <div><dt>Hizmet / İşlem Bedeli</dt><dd>−{kurusTL(s.kazanc.hizmetKesintisi)}</dd></div>}
        {s.kazanc.stopaj !== undefined && s.kazanc.stopaj > 0 && <div><dt>E-Ticaret Stopajı (%1)</dt><dd>−{kurusTL(s.kazanc.stopaj)}</dd></div>}
        <div>
          <dt>Kayıtlı Ürün Alış Maliyeti (KDV hrç)</dt>
          <dd>
            {s.kazanc.urunMaliyeti !== undefined ? `−${kurusTL(s.kazanc.urunMaliyeti)}` : <span class="y-yazi-kirmizi">Eksik</span>}
          </dd>
        </div>

        <div class="sp-hesap__vurgulu">
          <dt>Tahmini Net Kâr (KDV hariç)</dt>
          <dd class:list={[s.kazanc.tahminiNetKar !== undefined ? (s.kazanc.tahminiNetKar < 0 ? 'y-yazi-kirmizi' : 'y-yazi-yesil') : 'muted']}>
            {s.kazanc.tahminiNetKar !== undefined ? (
              <strong>
                {s.kazanc.tahminiNetKar < 0 ? '−' : '+'}{kurusTL(Math.abs(s.kazanc.tahminiNetKar))}
                {s.kazanc.netMarj !== undefined ? ` (%${(s.kazanc.netMarj * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 })})` : ''}
              </strong>
            ) : (
              <span>Hesaplanmadı ({s.kazanc.eksikNeden || 'veri eksik'})</span>
            )}
          </dd>
        </div>

        {s.kazanc.beklenenHakedis !== undefined && (
          <div><dt>Beklenen Hakediş / Tahsilat</dt><dd><strong>{kurusTL(s.kazanc.beklenenHakedis)}</strong></dd></div>
        )}
        {s.kazanc.kesinlesenHakedis !== undefined && (
          <div><dt>Kesinleşen Hakediş (Ekstre)</dt><dd><strong>{kurusTL(s.kazanc.kesinlesenHakedis)}</strong></dd></div>
        )}
        {s.kazanc.mutabakatFarki !== undefined && s.kazanc.mutabakatFarki !== 0 && (
          <div>
            <dt>Mutabakat Farkı</dt>
            <dd class="y-yazi-kirmizi">{s.kazanc.mutabakatFarki < 0 ? '−' : '+'}{kurusTL(Math.abs(s.kazanc.mutabakatFarki))}</dd>
          </div>
        )}
      </dl>

      {s.kazanc.maliyetEksik && (
        <p class="y-help" style="margin:8px 0 0">
          Doğru kâr hesabı için <a class="y-link" href="/yonetim/fiyatlar">Fiyat, Stok ve Kâr Tablosu</a>’ndan alış maliyeti ve kargo/komisyon bilgilerini tamamlayın.
        </p>
      )}
      {s.kazanc.not && <small class="muted" style="display:block;margin-top:6px">{s.kazanc.not}</small>}
    </div>
  </div>

  {/* ==================== SEKME 3: MÜŞTERİ, NOT VE GEÇMİŞ ==================== */}
  <div class="sp-icerik" data-sp-icerik="gecmis" hidden={varsayilanSekme !== 'gecmis'}>
    <div class="sp-kart">
      <h3><PIkon ad="kullanici" boyut={15} /> Müşteri ve Teslimat</h3>
      <p style="margin:0"><strong>{s.musteriAdi}</strong></p>
      {s.telefon && <small class="sp-iletisim"><a class="y-link" href={'tel:' + s.telefon}>{s.telefon}</a></small>}
      {s.eposta && <small class="sp-iletisim"><a class="y-link" href={'mailto:' + s.eposta}>{s.eposta}</a></small>}
      <small class="muted" style="display:block;margin-top:4px">{s.adres || s.konum || 'Adres satıcı panelinde'}</small>
      {web?.teslimat.not && <p class="sp-musteri-notu"><strong>Müşteri notu:</strong> {web.teslimat.not}</p>}
    </div>

    {web && (
      <div class="sp-kart">
        <h3><PIkon ad="kalem" boyut={15} /> Mağaza İç Notu</h3>
        <form method="post" action={s.detayHref} class="sp-alt-form" data-tek-gonder>
          <input type="hidden" name="geri" value={geriAdresi} />
          <input type="hidden" name="eylem" value="not" />
          <textarea class="y-girdi" name="yoneticiNotu" rows="2" maxlength="500" placeholder="Yalnız yönetim panelinde görünür…">{web.yoneticiNotu ?? ''}</textarea>
          <button class="btn btn--cizgi btn--kucuk" type="submit">Notu Kaydet</button>
        </form>
      </div>
    )}

    <div class="sp-kart">
      <div class="sp-kart__bas">
        <h3><PIkon ad="gecmis" boyut={15} /> İşlem Zaman Çizelgesi</h3>
        <a class="y-link" href={s.detayHref}>Tam Sayfa Detay →</a>
      </div>
      {gecmisListesi.length ? (
        <ul class="sp-zaman-listesi">
          {gecmisListesi.map((g) => (
            <li>
              <strong>{g.baslik}</strong>
              <small class="muted">{yTarih.format(new Date(g.tarih))}</small>
              {g.not && <p>{g.not}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="y-help" style="margin:0">Henüz kayıtlı işlem geçmişi yok.</p>
      )}
    </div>
  </div>
</section>

