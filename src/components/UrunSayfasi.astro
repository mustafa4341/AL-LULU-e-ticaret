---
import Base from '../layouts/Base.astro';
import Ikon from './Ikon.astro';
import Fiyat from './Fiyat.astro';
import Galeri from './Galeri.astro';
import KargoSayaci from './KargoSayaci.astro';
import UrunKarti from './UrunKarti.astro';
import SSS from './SSS.astro';
import FirsatSayaci from './FirsatSayaci.astro';
import BirlikteAl from './BirlikteAl.astro';
import UrunRozeti from './UrunRozeti.astro';
import FaydaBolumleri from './FaydaBolumleri.astro';
import PisirmeSureleri from './PisirmeSureleri.astro';
import SonCagri from './SonCagri.astro';
import OzellikListesi from './OzellikListesi.astro';
import { formatTL } from '../lib/fiyat';
import { ODEME_BAGLI, SMS_BAGLI, hizmeteUygunSSS } from '../lib/altyapi';
import { gtinAlani, markaliUrunAdi, urunGtin, urunMpn } from '../lib/urunKimlik';
import { metaAciklama } from '../lib/seo';
import { ozet, urunYorumlari } from '../lib/yorum';

const k = Astro.locals.katalog;
const { urun } = Astro.props as { urun: import('../lib/sema').Urun };

const site = k.site;
const kat = k.kategoriBul(urun.kategoriler[0]!);
const bilgi = k.fiyatBilgisi(urun);
const rozet = k.rozetler(urun);
const stokta = k.stoktaMi(urun);
const oneriSet = k.urunuIcerenSetler(urun.id)[0];
const oneriSetFiyati = oneriSet ? k.setFiyati(oneriSet) : undefined;
const tamamlayicilar = Astro.locals.vitrinOnizleme ? k.birlikteIyiGiderOnizleme(urun) : k.birlikteIyiGiderler(urun);
const benzerUrunler = kat ? k.kategoriUrunleri(kat.id)
  .filter((u) => u.id !== urun.id && k.stoktaMi(u) && !tamamlayicilar.some((item) => item.id === u.id)).slice(0, 4) : [];
const stokMetni = urun.stok <= 3 ? 'Stokta son ' + urun.stok + ' adet' : 'Stokta · hemen gönderime hazır';
const soruUrl = k.whatsapp(`Merhaba, ${urun.marka} ${urun.kisaAd} hakkında bir sorum var.`);
const stokHaberUrl = k.whatsapp(`${urun.kisaAd} stoğa girince haber verir misiniz?`);
const gosterilenFiyat = bilgi.sepette?.fiyat ?? bilgi.fiyat;
const hacim = urun.teknik.find(([e]) => e.toLocaleLowerCase('tr') === 'hacim')?.[1];
const guvenSatiri = [...rozet.kucuk, ...(rozet.serit ? [rozet.serit] : [])].slice(0, 3);
/* Ödeme/SMS gerçekten bağlıysa söz verilir (lib/altyapi.ts) */
const odemeSatiri = [ODEME_BAGLI() ? 'PayTR ile kartlı ödeme' : '', SMS_BAGLI ? 'Sipariş takibi SMS ile' : 'Hesapsız sipariş takibi'].filter(Boolean).join(' · ');
/* Teknik tablo telefonda uzun kalıyordu: ilk 6 satır açık, kalanı "Tüm teknik özellikler" altında */
const TEKNIK_ACIK = 6;
const teknikIlk = urun.teknik.slice(0, TEKNIK_ACIK);
const teknikKalan = urun.teknik.slice(TEKNIK_ACIK);
/* Barkod yalnız panelde "Barkod (EAN)" teknik satırı girilmiş ve kontrol hanesi doğruysa kullanılır (lib/urunKimlik.ts) */
const gtin = urunGtin(urun);
const seoAd = markaliUrunAdi(urun);
const urunSSS = hizmeteUygunSSS(urun.sss);
const kok = (Astro.site ?? new URL(site.url)).origin;
const urunUrl = new URL(`/urun/${urun.id}`, kok).href;
/* Yalnız doğrulanmış alıcıların panelde onaylanan yorumları (lib/yorum.ts); yoksa yapısal veriye puan yazılmaz */
const yorumlar = await urunYorumlari(urun.id).catch(() => []);
const puanOzet = ozet(yorumlar);
const yildiz = (p: number) => '★'.repeat(Math.round(p)) + '☆'.repeat(5 - Math.round(p));
const yorumTarih = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' });

const yapisalVeri = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${urunUrl}#urun`,
  name: seoAd,
  brand: { '@type': 'Brand', name: urun.marka },
  sku: urun.sku || undefined,
  mpn: urunMpn(urun),
  ...(gtin ? { [gtinAlani(gtin)]: gtin } : {}),
  description: urun.ozet,
  url: urunUrl,
  mainEntityOfPage: urunUrl,
  ...(kat ? { category: kat.ad } : {}),
  image: urun.gorseller.map((g) => new URL(g.src, kok).href),
  // Teknik bilgiler: Google ve yapay zekâ aramaları ürünü bu özelliklerle eşleştirir (yalnız paneldeki gerçek veri)
  ...(urun.teknik.length ? { additionalProperty: urun.teknik.map(([ad, deger]) => ({ '@type': 'PropertyValue', name: ad, value: deger })) } : {}),
  offers: {
    // Müşterinin ödeyeceği fiyat (sepette indirim varsa o); süreli fırsatta bitiş tarihi
    '@type': 'Offer', priceCurrency: 'TRY', price: String(gosterilenFiyat),
    ...(bilgi.onceki && !bilgi.sepette ? { priceSpecification: {
      '@type': 'UnitPriceSpecification', price: String(bilgi.onceki), priceCurrency: 'TRY',
      priceType: 'https://schema.org/StrikethroughPrice',
    } } : {}),
    ...(bilgi.sepette && urun.firsat?.bitis ? { priceValidUntil: urun.firsat.bitis.slice(0, 10) } : {}),
    availability: stokta ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition', url: urunUrl,
    // Satıcı = ana sayfadaki çevrim içi mağaza kaydı (aynı @id: Google ikisini tek işletme olarak birleştirir)
    seller: { '@type': 'OnlineStore', '@id': `${kok}/#magaza`, name: site.ad },
    // Google Merchant Center / ücretsiz ürün listelemeleri için kargo ve iade bilgisi (ürün akışıyla aynı hesap)
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: { '@type': 'MonetaryAmount', value: String(gosterilenFiyat >= site.kargo.ucretsizEsik ? 0 : site.kargo.ucret), currency: 'TRY' },
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'TR' },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: site.kargo.teslimGun[0], maxValue: site.kargo.teslimGun[1], unitCode: 'DAY' },
      },
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy', applicableCountry: 'TR',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow', merchantReturnDays: site.iadeGun,
      returnMethod: 'https://schema.org/ReturnByMail', returnFees: 'https://schema.org/FreeReturn',
    },
  },
  ...(puanOzet.adet ? {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: String(puanOzet.ortalama), reviewCount: puanOzet.adet, bestRating: '5', worstRating: '1' },
    review: yorumlar.slice(0, 10).map((y) => ({
      '@type': 'Review', author: { '@type': 'Person', name: y.ad }, datePublished: y.tarih.slice(0, 10),
      reviewRating: { '@type': 'Rating', ratingValue: String(y.puan), bestRating: '5', worstRating: '1' },
      ...(y.metin ? { reviewBody: y.metin } : {}),
    })),
  } : {}),
};
/* Sayfadaki "Bu ürün hakkında" soruları (yalnız sayfada görünen metin) */
const sssVerisi = urunSSS.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: urunSSS.map((m) => ({ '@type': 'Question', name: m.soru, acceptedAnswer: { '@type': 'Answer', text: m.cevap } })),
} : undefined;
---
<Base baslik={`${seoAd} | ${site.ad}`} aciklama={metaAciklama(urun.ozet || seoAd)} gorsel={urun.gorseller[0]?.src} aktif={urun.kategoriler[0]} yapisalVeri={sssVerisi ? [yapisalVeri, sssVerisi] : yapisalVeri} ogTuru="product" urunMeta={{ id: urun.id, marka: urun.marka, fiyat: gosterilenFiyat, stokta, gtin }} kirinti={[...(kat ? [[kat.ad, `/kategori/${kat.id}`] as [string, string]] : []), [markaliUrunAdi({ marka: urun.marka, ad: urun.kisaAd }), `/urun/${urun.id}`]]} altCubuk={stokta} ozelDuyuru={rozet.serit ? `Bu üründe kargo bedava · Hafta içi ${site.kargo.kesimSaati}:00'e kadar aynı gün kargoda` : undefined}>
  <div class="container">
    <nav aria-label="Konum" class="kirinti-kap--urun">
      <ol class="kirinti">
        <li><a href="/">Ana sayfa</a></li>
        {kat && <li><a href={`/kategori/${kat.id}`}>{kat.ad}</a></li>}
        <li aria-current="page">{urun.kisaAd}</li>
      </ol>
    </nav>

    <section class="urun-ust" aria-labelledby="urun-adi" data-ga-urun={urun.id}>
      <div class="urun-galeri-kap">
        <Galeri gorseller={urun.gorseller} yedekIkon={kat?.ikon} />
        {rozet.damga && !bilgi.firsat && <UrunRozeti etiket={rozet.damga} tur={k.cokSatanMi(urun) ? 'cok-satan' : rozet.damgaTon === 'kirmizi' ? 'stok' : 'ozellik'} ton={rozet.damgaTon} stil={rozet.damgaStil} konum="galeri" />}
        {bilgi.onceki && <span class="urun-indirim-cip"><Ikon ad="trend" boyut={14} />{bilgi.yuzde ? `%${bilgi.yuzde} İndirim` : 'İndirim'}</span>}
      </div>

      <div class="urun-bilgi">
        {(bilgi.firsat || urun.durum === 'taslak') && (
          <div class="urun-ust-satir">
            {bilgi.firsat && <FirsatSayaci etiket={bilgi.firsat.etiket} bitis={bilgi.firsat.bitis} stil={bilgi.firsat.stil} />}
            {urun.durum === 'taslak' && <span class="rozet rozet--taslak">Örnek ürün · canlıda görünmez</span>}
          </div>
        )}
        <p class="urun-eyebrow"><a href={kat ? `/kategori/${kat.id}` : '/urunler'}><span>{urun.marka}</span>{hacim && <> · {hacim}</>}</a></p>
        <h1 class="urun-ad" id="urun-adi">{urun.ad}</h1>
        {urun.ozet && urun.oneCikanBilgiler.length === 0 && <p class="urun-deger">{urun.ozet}</p>}
        {guvenSatiri.length > 0 && (
          <ul class="urun-guven-satir" aria-label="Güvenceler">{guvenSatiri.map((g) => <li><Ikon ad="tik" boyut={14} />{g}</li>)}</ul>
        )}

        <div class="urun-fiyat">
          <Fiyat bilgi={bilgi} boyut="buyuk" vurgu={urun.id === k.anaSayfa.hero.urunId} />
          {bilgi.etiket && <span class="indirim-etiket">{bilgi.etiket}</span>}
          <p class="urun-fiyat__alt">Vergiler dahil{rozet.serit && <> · <strong class="yesil">{rozet.serit}</strong></>}</p>
        </div>

        {oneriSet && oneriSetFiyati && (
          <a class="urun-seti-kisa" href={`#set-${oneriSet.id}`}>
            <span class="urun-seti-kisa__bilgi">
              <span class="urun-seti-kisa__ad">{oneriSet.ad}</span>
              <span class="urun-seti-kisa__incele">Seti incele</span>
            </span>
            <span class="urun-seti-kisa__fiyat">
              {oneriSetFiyati.yuzde > 0 && (
                <span class="urun-seti-kisa__rozet"><Ikon ad="trend" boyut={14} />%{oneriSetFiyati.yuzde} set avantajı</span>
              )}
              <strong>{formatTL(oneriSetFiyati.fiyat)}</strong>
            </span>
          </a>
        )}

        <OzellikListesi maddeler={urun.oneCikanBilgiler} marka={urun.marka} />

        {stokta ? (
          <>
            <div class="satin-al" data-ana-cta>
              <button class="btn btn--simdi" type="button" data-hemen-al data-tip="urun" data-id={urun.id}>Şimdi Al</button>
              <button class="btn btn--sepet" type="button" data-sepete-ekle data-tip="urun" data-id={urun.id} data-konum="urun-sayfasi">
                <Ikon ad="canta" boyut={20} /><span data-etiket>Sepete Ekle</span>
              </button>
            </div>
            <p class:list={['stok', { 'stok--az': urun.stok <= 3 }]}>{stokMetni}</p>
            <KargoSayaci />
          </>
        ) : (
          <>
            <p class="stok stok--yok">Şu an stokta yok</p>
            <a class="btn btn--wa btn--block" style="margin-top:14px" href={stokHaberUrl} target="_blank" rel="noopener"><Ikon ad="whatsapp" />Stoğa girince haber ver</a>
          </>
        )}

        {urun.hediye && <p class="hediye"><Ikon ad="hediye" />{urun.hediye}</p>}

        {oneriSet && <BirlikteAl set={oneriSet} mevcutUrunId={urun.id} />}

        <a class="soru-sor" href={soruUrl} target="_blank" rel="noopener">
          <Ikon ad="whatsapp" boyut={26} />
          <span><strong>Bu ürünle ilgili sorunuz mu var?</strong><span>WhatsApp'tan bize yazın, hemen yanıtlayalım</span></span>
          <Ikon ad="sag" boyut={18} />
        </a>

        {urun.sku && <p class="urun-model">Model kodu: {urun.sku}</p>}
        <ul class="guvenceler">
          <li><Ikon ad="kalkan" boyut={18} /><span>Orijinal ürün, adınıza faturalı gönderim</span></li>
          {urun.garanti && <li><Ikon ad="belge" boyut={18} /><span>{urun.garanti} garanti · <a href="/yasal/garanti-kosullari">Garanti koşulları</a></span></li>}
          <li><Ikon ad={ODEME_BAGLI() ? 'kilit' : 'belge'} boyut={18} /><span>{odemeSatiri}</span></li>
        </ul>
      </div>
      <div class="urun-pisirme"><PisirmeSureleri urun={urun} /></div>
    </section>
  </div>

  <FaydaBolumleri urun={urun} />

  {(urun.teknik.length > 0 || urun.kutuIcerigi.length > 0) && (
    <section class="bolum" aria-label="Teknik bilgiler">
      <div class="container iki-kolon">
        {urun.teknik.length > 0 && (
          <div data-reveal>
            <h2 class="alt-baslik">Teknik özellikler</h2>
            <table class="teknik-tablo"><tbody>{teknikIlk.map(([e, d]) => <tr><th scope="row">{e}</th><td>{d}</td></tr>)}</tbody></table>
            {teknikKalan.length > 0 && (
              <details class="teknik-devam">
                <summary>Tüm teknik özellikler <span class="muted">(+{teknikKalan.length})</span><Ikon ad="asagi" boyut={16} /></summary>
                <table class="teknik-tablo"><tbody>{teknikKalan.map(([e, d]) => <tr><th scope="row">{e}</th><td>{d}</td></tr>)}</tbody></table>
              </details>
            )}
          </div>
        )}
        {urun.kutuIcerigi.length > 0 && (
          <div data-reveal>
            <h2 class="alt-baslik">Kutu içeriği</h2>
            <ul class="kutu-liste">{urun.kutuIcerigi.map((x) => <li><Ikon ad="tik" boyut={18} />{x}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  {puanOzet.adet === 0 ? (
    <section class="yorum-kompakt" aria-labelledby="yorum-baslik">
      <div class="container">
        <div class="yorum-bos" data-reveal>
          <Ikon ad="yildiz" boyut={22} />
          <p><strong id="yorum-baslik">Değerlendirmeler yakında.</strong> Yalnızca gerçek siparişlerden gelen yorumları yayınlıyoruz.</p>
        </div>
      </div>
    </section>
  ) : (
    <section class="bolum" id="degerlendirmeler" aria-labelledby="yorum-baslik">
      <div class="container yorumlar">
        <div class="bolum-bas"><div><p class="eyebrow eyebrow--altin">Müşteri değerlendirmeleri</p><h2 id="yorum-baslik">Alanlar ne diyor?</h2></div></div>
        <div class="yorumlar-ozet">
          <strong>{puanOzet.ortalama.toLocaleString('tr-TR')}</strong>
          <span class="yildizlar" aria-label={`5 üzerinden ${puanOzet.ortalama}`}>{yildiz(puanOzet.ortalama)}</span>
          <span class="muted">{puanOzet.adet} değerlendirme · yalnızca bu ürünü satın alan müşterilerden</span>
        </div>
        {yorumlar.slice(0, 20).map((y) => (
          <article class="yorum">
            <div class="yorum__ust">
              <span><b>{y.ad}</b> · <span class="yildizlar" aria-label={`${y.puan} yıldız`}>{yildiz(y.puan)}</span></span>
              <span><span class="yorum__dogrulanmis">✓ Doğrulanmış alıcı</span> · <time datetime={y.tarih}>{yorumTarih.format(new Date(y.tarih))}</time></span>
            </div>
            {y.metin && <p>{y.metin}</p>}
            {y.yanit && <div class="yorum__yanit"><b>{site.ad}:</b> {y.yanit}</div>}
          </article>
        ))}
      </div>
    </section>
  )}

  {urunSSS.length > 0 && (
    <section class="bolum bolum--beyaz" aria-labelledby="urun-sss">
      <div class="container">
        <div class="bolum-bas"><div><p class="eyebrow eyebrow--altin">Sık sorulanlar</p><h2 id="urun-sss">Bu ürün hakkında</h2></div></div>
        <SSS maddeler={urunSSS} />
      </div>
    </section>
  )}

  {tamamlayicilar.length > 0 && (
    <section class="bolum" aria-labelledby="tamamlayici">
      <div class="container">
        <div class="bolum-bas"><div><p class="eyebrow eyebrow--altin">Tamamlayıcı ürünler</p><h2 id="tamamlayici">Bununla iyi gider</h2></div></div>
        <div class="urun-ray">{tamamlayicilar.map((u) => <UrunKarti urun={u} konum="tamamlayici" />)}</div>
      </div>
    </section>
  )}

  {kat && benzerUrunler.length > 0 && (
    <section class="bolum bolum--beyaz" aria-labelledby="benzer-urunler">
      <div class="container">
        <div class="bolum-bas">
          <h2 id="benzer-urunler">Benzer ürünler</h2>
          <a class="bolum-bas__link" href={`/kategori/${kat.id}`}>{kat.ad}</a>
        </div>
        <div class="urun-ray">{benzerUrunler.map((u) => <UrunKarti urun={u} konum="benzer-urunler" />)}</div>
      </div>
    </section>
  )}

  <SonCagri urun={urun} />

  {stokta && (
    <div class="alt-cubuk" slot="alt-cubuk" data-alt-cubuk aria-hidden="true">
      <div class="alt-cubuk__bilgi">
        {bilgi.onceki && <s class="alt-cubuk__eski">{formatTL(bilgi.onceki)}</s>}
        <div class:list={['alt-cubuk__fiyat', { 'fiyat--indirimli': !!bilgi.onceki }]}>{formatTL(gosterilenFiyat)}</div>
        <div class="alt-cubuk__not">{bilgi.sepette ? 'Sepette fiyat' : rozet.serit ?? 'Vergiler dahil'}</div>
      </div>
      <button class="btn btn--simdi" type="button" data-hemen-al data-tip="urun" data-id={urun.id} tabindex="-1">Şimdi Al</button>
      <button class="btn btn--sepet" type="button" data-sepete-ekle data-tip="urun" data-id={urun.id} data-konum="alt-cubuk" tabindex="-1"><span data-etiket>Sepete Ekle</span></button>
    </div>
  )}

  <script>
  import '../scripts/buyutec';
  </script>
</Base>

<style>
  .urun-seti-kisa {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-top: 10px;
    padding: 11px 14px;
    border: 1px solid #e5aeba;
    border-radius: var(--r);
    background: #fff5f6;
    color: #6e1a2d;
    text-decoration: none;
  }
  .urun-seti-kisa:hover { border-color: #a71931; }
  .urun-seti-kisa__bilgi, .urun-seti-kisa__fiyat { display: grid; gap: 3px; }
  .urun-seti-kisa__ad { font-weight: 700; font-size: .875rem; }
  .urun-seti-kisa__incele { font-size: .8125rem; text-decoration: underline; text-underline-offset: 2px; }
  .urun-seti-kisa__fiyat { color: #a71931; font-variant-numeric: tabular-nums; }
  .urun-seti-kisa__rozet { display: inline-flex; align-items: center; gap: 4px; font-size: .8125rem; font-weight: 750; }
  .urun-bilgi :global(.birlikte) { scroll-margin-top: 140px; }
</style>
