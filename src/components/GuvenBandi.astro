---
import Ikon from './Ikon.astro';
import type { IkonAdi } from '../lib/sema';
import { formatTL } from '../lib/fiyat';
import { ODEME_BAGLI } from '../lib/altyapi';
const k = Astro.locals.katalog;
const s = k.site;
const maddeler: { ikon: IkonAdi; baslik: string; metin: string; href?: string }[] = [
  { ikon: 'kalkan', baslik: 'Orijinal ürün', metin: 'Faturalı gönderim' },
  { ikon: 'belge', baslik: 'Üretici garantili', metin: 'Süre ürün sayfasında' }, // tek kullanımlık/aksesuar ürünlerle çelişmesin (AUD-035)
  { ikon: 'kargo', baslik: 'Kargo bedava', metin: `${formatTL(s.kargo.ucretsizEsik)} üzeri` },
  { ikon: 'saat', baslik: 'Aynı gün kargo', metin: `${s.kargo.kesimSaati}:00'e kadar` },
  ODEME_BAGLI()
    ? { ikon: 'kilit', baslik: 'Kartla ödeme', metin: 'PayTR ödeme ekranı' }
    : { ikon: 'belge', baslik: 'Sipariş takibi', metin: 'Hesap açmadan', href: '/siparis-takip' },
  { ikon: 'iade', baslik: `${s.iadeGun} gün iade`, metin: 'Koşulsuz cayma', href: '/yasal/iptal-iade-kosullari' },
];
---
<section class="guven" aria-label="Alışveriş güvenceleri">
  <ul class="container guven__liste">
    {maddeler.map((m) => (
      <li>
        {m.href ? (
          <a href={m.href} target={m.href.startsWith('/') ? undefined : '_blank'} rel="noopener" class:list={{ guven__wa: m.ikon === 'whatsapp' }}><Ikon ad={m.ikon} boyut={24} /><span><strong>{m.baslik}</strong><span>{m.metin}</span></span></a>
        ) : (
          <><Ikon ad={m.ikon} boyut={24} /><span><strong>{m.baslik}</strong><span>{m.metin}</span></span></>
        )}
      </li>
    ))}
  </ul>
</section>
