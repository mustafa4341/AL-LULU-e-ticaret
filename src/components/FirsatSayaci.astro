---
import Ikon from './Ikon.astro';
import FirsatSure from './FirsatSure.astro';

interface Props {
  etiket: string;
  bitis?: string;
  boyut?: 'kucuk' | 'buyuk';
  stil?: 'firsat' | 'flas' | 'ozel';
}
const { etiket, bitis, boyut = 'buyuk', stil = 'firsat' } = Astro.props;
const sureli = bitis && Number.isFinite(Date.parse(bitis));
---
<span class:list={['firsat-cip', `firsat-cip--${boyut}`, `firsat-cip--${stil}`]} data-firsat-sayac={sureli ? bitis : undefined}>
  <Ikon ad={sureli ? 'saat' : 'etiket'} boyut={14} />
  <span>{etiket}</span>
  {sureli && <FirsatSure bitis={bitis} />}
</span>
