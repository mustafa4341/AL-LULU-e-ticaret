---
import Base from '../layouts/Base.astro';
import VitrinBanner from './anasayfa/VitrinBanner.astro';
import UrunBannerlari from './anasayfa/UrunBannerlari.astro';
import Guven from './anasayfa/Guven.astro';
import Firsatlar from './anasayfa/Firsatlar.astro';
import Kategoriler from './anasayfa/Kategoriler.astro';
import OneCikanlar from './anasayfa/OneCikanlar.astro';
import Setler from './anasayfa/Setler.astro';
import AmiralHikaye from './anasayfa/AmiralHikaye.astro';
import NedenBiz from './anasayfa/NedenBiz.astro';
import SSSBolumu from './anasayfa/SSSBolumu.astro';
import { magazaVerisi } from '../lib/seo';
import { hizmeteUygunSSS } from '../lib/altyapi';

/* Bölümler panel → Ayarlar → Ana sayfa'daki sırayla gösterilir. */
const bilesenler = { firsatlar: Firsatlar, guven: Guven, kategoriler: Kategoriler, oneCikanlar: OneCikanlar, setler: Setler, amiralHikaye: AmiralHikaye, nedenBiz: NedenBiz, sss: SSSBolumu } as const;
const k = Astro.locals.katalog;
const sss = hizmeteUygunSSS(k.anaSayfa.sss);
const aciklama = 'Fissler düdüklü tencere ve buhar aparatları, Tefal tava ve tencere setleri, doğrayıcılar ve sofra gereçleri Al Lulu Home’da.';
---
<Base
  baslik={`${k.site.ad} | Düdüklü Tencere, Tava ve Mutfak Gereçleri`}
  {aciklama}
  gorsel="/img/vitrin/secim.webp"
  aktif="ana"
  yapisalVeri={[
    ...magazaVerisi(k.site),
    // Ana sayfadaki "Aklınızdaki sorular" bölümü görünüyorsa aynı soru-cevaplar
    ...(k.anaSayfa.bolumler.includes('sss') && sss.length ? [{
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: sss.map((m) => ({ '@type': 'Question', name: m.soru, acceptedAnswer: { '@type': 'Answer', text: m.cevap } })),
    }] : []),
  ]}
>
  {!k.anaSayfa.bolumler.includes('hero') && <h1 class="visually-hidden">Tencere, tava ve mutfak gereçleri</h1>}
  {k.anaSayfa.bolumler.map((ad) => {
    if (ad === 'hero') return <><VitrinBanner /><UrunBannerlari /></>;
    const Bolum = bilesenler[ad];
    return <Bolum />;
  })}
</Base>
