---
import Ikon from './Ikon.astro';
import Logo from './Logo.astro';
import { bosYasalBilgi } from '../lib/yonetimSite';
import { SOSYAL_ADLARI, SOSYAL_AGLAR, type SosyalAg } from '../lib/sema';
/* Sosyal medya simgeleri (tek renk, 24×24). Yalnız panelde adresi girilen hesaplar görünür. */
const SOSYAL_IKON: Record<SosyalAg, string> = {
  instagram: 'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM12 3.6c2.7 0 3 0 4.1.1 2.7.1 4 1.4 4.1 4.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 2.7-1.4 4-4.1 4.1-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-2.7-.1-4-1.4-4.1-4.1C3.7 15 3.6 14.7 3.6 12s0-3 .1-4.1c.1-2.7 1.4-4 4.1-4.1C8.9 3.7 9.3 3.6 12 3.6ZM12 2c-2.7 0-3.1 0-4.2.1-3.6.2-5.6 2.2-5.8 5.8C2 8.9 2 9.3 2 12s0 3.1.1 4.2c.2 3.6 2.2 5.6 5.8 5.8 1.1.1 1.5.1 4.2.1s3.1 0 4.2-.1c3.6-.2 5.6-2.2 5.8-5.8.1-1.1.1-1.5.1-4.2s0-3.1-.1-4.2c-.2-3.6-2.2-5.6-5.8-5.8C15.1 2 14.7 2 12 2Z',
  facebook: 'M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v1.9H8v3.2h2.6V22H14V11.7h2.6l.4-3.2H14Z',
  tiktok: 'M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.8 5.8 0 1 0 5 5.7V9.1a7.4 7.4 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.3-1.6Z',
  youtube: 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z',
  x: 'M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.5l11.2 14.5Z',
  pinterest: 'M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.8 0 1.2.6 1.2 1.4 0 .8-.5 2.1-.8 3.2-.2.9.5 1.7 1.4 1.7 1.7 0 3-1.8 3-4.4 0-2.3-1.7-3.9-4-3.9-2.8 0-4.4 2.1-4.4 4.2 0 .8.3 1.7.7 2.2l.1.4-.3 1c0 .2-.1.2-.3.1-1.2-.6-2-2.3-2-3.8 0-3.1 2.2-5.9 6.5-5.9 3.4 0 6 2.4 6 5.7 0 3.4-2.1 6.1-5.1 6.1-1 0-1.9-.5-2.2-1.1l-.6 2.3c-.2.9-.8 1.9-1.2 2.6A10 10 0 1 0 12 2Z',
  linkedin: 'M6.9 8.9H3.6V20h3.3V8.9ZM5.2 3.5a1.9 1.9 0 1 0 0 3.9 1.9 1.9 0 0 0 0-3.9ZM20.4 13.6c0-3-1.6-4.9-4.2-4.9-1.5 0-2.5.8-2.9 1.6V8.9H10V20h3.3v-5.8c0-1.5.3-3 2.2-3 1.8 0 1.8 1.7 1.8 3.1V20h3.3v-6.4Z',
};
const k = Astro.locals.katalog;
const site = k.site;
/* "[Ticari Unvan]" gibi doldurulmamış şablonlar müşteriye gösterilmez; panelde girilince kendiliğinden görünür */
const unvan = bosYasalBilgi(site.satici.unvan) ? '' : site.satici.unvan;
const adres = bosYasalBilgi(site.satici.adres) ? '' : site.satici.adres;
const etbis = bosYasalBilgi(site.satici.etbis) ? '' : site.satici.etbis;
const kategoriler = k.gorunurKategoriler({ menu: true });
const yil = new Date().getFullYear();
const sosyal = SOSYAL_AGLAR.map((ag) => [ag, site.sosyal?.[ag] ?? ''] as const).filter(([, adres]) => /^https:\/\//.test(adres));
---
<footer class="site-footer" id="footer">
  <div class="container">
    <div class="footer-iletisim" data-reveal>
      <div>
        <p class="footer-iletisim__baslik">Sorunuz mu var? Hemen yazın.</p>
        <p class="footer-iletisim__alt">{site.calismaSaatleri || 'Her gün'} · Ortalama yanıt birkaç dakika</p>
      </div>
      <div class="footer-iletisim__butonlar">
        <a class="btn btn--wa" href={k.whatsapp('Merhaba, bir sorum var.')} target="_blank" rel="noopener"><Ikon ad="whatsapp" boyut={22} />WhatsApp'tan Yazın</a>
        <a class="btn btn--koyu-cizgi" href={`mailto:${site.eposta}`}><Ikon ad="eposta" boyut={20} />{site.eposta}</a>
      </div>
    </div>
    <div class="footer-grid">
      <div class="footer-marka">
        <Logo tip="tam" class="footer-logo" />
        <p class="footer-slogan">{site.slogan}</p>
        {sosyal.length > 0 && <ul class="footer-sosyal" aria-label="Sosyal medya hesaplarımız">
          {sosyal.map(([ag, adres]) => <li><a href={adres} target="_blank" rel="noopener me" aria-label={SOSYAL_ADLARI[ag]} title={SOSYAL_ADLARI[ag]}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d={SOSYAL_IKON[ag]} /></svg>
          </a></li>)}
        </ul>}
      </div>
      <div>
        <h3>Kategoriler</h3>
        <ul>
          {kategoriler.map((kat) => <li><a href={`/kategori/${kat.id}`}>{kat.ad}</a></li>)}
          <li><a href="/urunler">Tüm ürünler</a></li>
        </ul>
      </div>
      <div>
        <h3>Yardım</h3>
        <ul>
          <li><a href="/siparis-takip">Sipariş takip</a></li>
          <li><a href="/yasal/teslimat-ve-kargo">Kargo ve teslimat</a></li>
          <li><a href="/yasal/garanti-kosullari">Garanti</a></li>
          <li><a href="/#sss">Sık sorulanlar</a></li>
        </ul>
      </div>
      <div>
        <h3>Yasal</h3>
        <ul>
          <li><a href="/bilgi">Satıcı bilgileri</a></li>
          <li><a href="/yasal/iptal-iade-kosullari">İptal ve iade koşulları</a></li>
          <li><a href="/yasal/on-bilgilendirme-formu">Ön bilgilendirme formu</a></li>
          <li><a href="/yasal/mesafeli-satis-sozlesmesi">Mesafeli satış sözleşmesi</a></li>
          <li><a href="/yasal/kvkk-aydinlatma-metni">KVKK aydınlatma metni</a></li>
          <li><a href="/yasal/gizlilik-ve-cerez-politikasi">Gizlilik ve çerez politikası</a></li>
          <li hidden data-cerez-ac><a href="/yasal/gizlilik-ve-cerez-politikasi">Çerez tercihleri</a></li>
          <li><a href="/yasal/kullanim-kosullari">Kullanım koşulları</a></li>
        </ul>
      </div>
      <div>
        <h3>İletişim</h3>
        <address>
          <a href={k.whatsapp('Merhaba, bir sorum var.')} target="_blank" rel="noopener">WhatsApp Destek Hattı</a><br />
          <a href={`mailto:${site.eposta}`}>{site.eposta}</a><br />
          {site.kurumsalEposta && site.kurumsalEposta !== site.eposta && <>Kurumsal: <a href={`mailto:${site.kurumsalEposta}`}>{site.kurumsalEposta}</a><br /></>}
          {site.calismaSaatleri && <span>{site.calismaSaatleri}<br /></span>}
          {(unvan || adres) && <span>{unvan}{unvan && adres && <br />}{adres}</span>}
        </address>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {yil} {site.ad}. Sitede yer alan markalar ilgili hak sahiplerinin tescilli markalarıdır.</span>
      {etbis && <span>ETBİS: {etbis}</span>}
    </div>
  </div>
</footer>

<style>
  .footer-sosyal { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; }
  .footer-sosyal a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; border: 1px solid currentColor; color: inherit; opacity: .85; transition: opacity .15s, background-color .15s; }
  .footer-sosyal a:hover, .footer-sosyal a:focus-visible { opacity: 1; background: rgb(255 255 255 / .08); }
</style>
