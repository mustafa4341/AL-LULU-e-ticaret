---
import Base from '../../layouts/Base.astro';
import { YASAL_SAYFALAR } from '../../lib/yasal';
const k = Astro.locals.katalog;
const sayfa = YASAL_SAYFALAR.find((s) => s.yol === Astro.params.sayfa);
if (!sayfa) return Astro.rewrite('/404');
const icerik = sayfa.uret(k.site);
---
<Base baslik={`${sayfa.baslik} | ${k.site.ad}`} aciklama={`${k.site.ad} ${sayfa.baslik.toLocaleLowerCase('tr')}.`}>
  <div class="container belge">
    <p class="eyebrow"><a href="/bilgi">Yasal bilgiler</a></p>
    <h1>{sayfa.baslik}</h1>
    <article class="belge-metin" set:html={icerik} />
    <nav class="belge-diger" aria-label="Diğer yasal metinler">
      {YASAL_SAYFALAR.filter((s) => s.yol !== sayfa.yol).map((s) => <a href={`/yasal/${s.yol}`}>{s.baslik}</a>)}
    </nav>
  </div>
</Base>
