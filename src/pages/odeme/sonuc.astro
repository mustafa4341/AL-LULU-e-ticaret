---
/*
 * PayTR, ödeme bitince bu sayfayı kendi iFrame'i içinde açar (merchant_ok_url / merchant_fail_url).
 * Müşteri iFrame içinde kalmasın diye sayfa, ana pencereyi doğrudan sipariş sayfasına götürür.
 * ref, sipariş anahtarı kadar gizli rastgele bir değerdir; sahibi sipariş bağlantısını zaten görebilir.
 */
import { siparisleriOku } from '../../lib/depo';

const ref = Astro.url.searchParams.get('ref') ?? '';
const siparis = /^AL[a-f0-9]{32}$/.test(ref)
  ? (await siparisleriOku()).find((s) => s.paytr?.ref === ref)
  : undefined;
const odeme = siparis?.paytr;
if (!odeme) Astro.response.status = 404;
const hedef = siparis ? `/siparis/${siparis.no}?t=${siparis.token}&yeni` : '/siparis-takip';
const baslik = !odeme ? 'Ödeme kaydı bulunamadı'
  : odeme.sonuc === 'odendi' ? 'Ödemeniz onaylandı'
  : odeme.sonuc === 'basarisiz' ? 'Ödeme tamamlanamadı' : 'Ödeme sonucu kontrol ediliyor';
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{baslik} · Al Lulu Home</title>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F7F5F0; color: #1B1916; font: 16px/1.5 Inter, system-ui, -apple-system, "Segoe UI", sans-serif; }
      main { text-align: center; padding: 28px 22px; max-width: 360px; }
      img { width: 64px; height: auto; }
      h1 { font-size: 22px; margin: 14px 0 6px; }
      p { margin: 0 0 18px; color: #5C5650; }
      a { display: inline-block; padding: 12px 20px; border-radius: 12px; background: #E8650A; color: #fff; font-weight: 700; text-decoration: none; }
    </style>
  </head>
  <body>
    <main>
      <img src="/img/logo/amblem.webp" alt="Al Lulu Home" width="64" height="51" />
      <h1>{baslik}</h1>
      <p>{siparis ? 'Sipariş sayfanıza yönlendiriliyorsunuz…' : 'Siparişinizi sipariş numaranız ve telefonunuzla görüntüleyebilirsiniz.'}</p>
      <a href={hedef} target="_top">{siparis ? 'Sipariş sayfasını aç' : 'Sipariş takibe git'}</a>
    </main>
    {siparis && <script is:inline define:vars={{ hedef }}>
      try { (window.top || window).location.replace(hedef); } catch (e) { location.replace(hedef); }
    </script>}
  </body>
</html>
