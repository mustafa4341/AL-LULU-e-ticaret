---
import Yonetim from '../../layouts/Yonetim.astro';
import Ikon from '../../components/Ikon.astro';
import Onizleme from '../../components/yonetim/Onizleme.astro';
import { DogrulamaHatasi, gorselKaydet, gorselSil, magazaGuncelle, magazaOku } from '../../lib/depo';
import { formatTL } from '../../lib/fiyat';
import { benzersizKod, metin } from '../../lib/form';
import { Katalog } from '../../lib/katalog';
import { SetSema, type UrunSeti } from '../../lib/sema';
import { BOS_SET, setFormu } from '../../lib/yonetimSet';
import { YAYIN_ADLARI } from '../../lib/yonetimRapor';
let hatalar: string[] = [];
const basari = Astro.url.searchParams.get('ok');
let secim = Astro.url.searchParams.get('duzenle');
let taslak: UrunSeti | undefined;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const eylem = metin(f, 'eylem');
  secim = metin(f, 'id');
  let yuklenen: string | undefined;
  try {
    const dosya = f.get('gorsel');
    if (eylem !== 'sil' && dosya instanceof File && dosya.size > 0) yuklenen = await gorselKaydet(dosya, 'setler');
    await magazaGuncelle((m) => {
      const mevcut = m.setler.find((x) => x.id === secim);
      if (!mevcut && secim !== 'yeni') throw new Error('Set bulunamadı.');
      if (eylem === 'sil') { m.setler = m.setler.filter((x) => x.id !== secim); return; }
      const aday = setFormu(f, mevcut ?? BOS_SET, yuklenen);
      taslak = aday;
      const sonuc = SetSema.safeParse(aday);
      if (!sonuc.success) throw new DogrulamaHatasi(sonuc.error.issues.map((i) => i.message));
      const engeller = new Katalog(m).setEngelleri(sonuc.data);
      if (aday.durum === 'yayinda' && engeller.length) throw new DogrulamaHatasi(engeller);
      if (mevcut) Object.assign(mevcut, sonuc.data);
      else m.setler.push({ ...sonuc.data, id: benzersizKod(aday.ad, new Set(m.setler.map((x) => x.id))) });
    });
    return Astro.redirect('/yonetim/setler?ok=' + encodeURIComponent(eylem === 'sil' ? 'Set silindi.' : 'Set kaydedildi.'), 303);
  } catch (e) {
    if (yuklenen) await gorselSil(yuklenen);
    if (taslak?.gorsel?.src === yuklenen && taslak) taslak.gorsel = undefined;
    hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
  }
}
const m = await magazaOku();
const k = new Katalog(m);
const yeni = secim === 'yeni';
const s = taslak ?? (yeni ? BOS_SET : m.setler.find((x) => x.id === secim));
const engeller = s && !yeni ? k.setEngelleri(s) : [];
---
<Yonetim baslik={s ? yeni ? "Yeni Set" : s.ad || "Seti Düzenle" : "Setler"} aktif="setler" basari={basari} hatalar={hatalar}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    {s ? <><a class="y-link" href="/yonetim/setler">Setlere dön</a><button type="button" class="btn btn--cizgi" data-onizleme-ac aria-controls="set-onizleme" aria-expanded="false">Önizle</button><button type="submit" form="set-form" class="btn btn--sepet">Kaydet</button></> : <a href="?duzenle=yeni" class="btn btn--sepet">Yeni Set</a>}
  </div>
  {s ? <div class="y-editor-duzen" data-editor-duzen>
      <form method="post" enctype="multipart/form-data" id="set-form" class="y-editor-form y-kart" data-editor data-onizleme-form="set">
        <input type="hidden" name="id" value={s.id} />
        {engeller.length > 0 && <p class="y-uyari">{engeller.join(" ")}</p>}
        <div class="y-izgara y-izgara--2" style="margin-top:8px">
          <div class="y-alan"><label>Set adı</label><input name="ad" value={s.ad} required placeholder="Örn. Vitaquick + Buhar Aparatı Seti" /></div>
          <div class="y-alan"><label>Durum</label><select name="durum">{[['yayinda', 'Yayında'], ['taslak', 'Taslak'], ['gizli', 'Gizli']].map(([v, a]) => <option value={v} selected={s.durum === v}>{a}</option>)}</select></div>
        </div>
        <div class="y-alan" style="margin-top:10px"><label>Açıklama</label><input name="aciklama" value={s.aciklama} /></div>
        <div class="y-alan" style="margin-top:10px">
          <span class="y-etiket">Setteki ürünler</span>
          <div class="y-tekrar">
            {s.kalemler.map((x) => (
              <div class="y-tekrar__satir"><div class="y-tekrar__alanlar y-tekrar__alanlar--yan">
                <select class="y-girdi" name="kalem_urun"><option value="">Ürün seçin</option>{m.urunler.map((u) => <option value={u.id} data-fiyat={u.fiyat} selected={u.id === x.urunId}>{u.kisaAd} — {formatTL(u.fiyat)}</option>)}</select>
                <input class="y-girdi" name="kalem_adet" type="number" step="1" min="1" value={x.adet} aria-label="Adet" />
              </div><button type="button" class="y-sil-btn" data-tekrar-sil aria-label="Ürünü setten çıkar"><Ikon ad="cop" boyut={18} /></button></div>
            ))}
            <template><div class="y-tekrar__satir"><div class="y-tekrar__alanlar y-tekrar__alanlar--yan">
              <select class="y-girdi" name="kalem_urun"><option value="">Ürün seçin</option>{m.urunler.map((u) => <option value={u.id} data-fiyat={u.fiyat}>{u.kisaAd} — {formatTL(u.fiyat)}</option>)}</select>
              <input class="y-girdi" name="kalem_adet" inputmode="numeric" value="1" aria-label="Adet" />
            </div><button type="button" class="y-sil-btn" data-tekrar-sil aria-label="Ürünü setten çıkar"><Ikon ad="cop" boyut={18} /></button></div></template>
            <button type="button" class="y-ekle-btn" data-tekrar-ekle>+ Ürün ekle</button>
          </div>
        </div>
        <div class="y-izgara y-izgara--3" style="margin-top:10px">
          <div class="y-alan"><label>İndirim türü</label><select name="fiyat_tip">
            <option value="kalem" selected={s.fiyatlama.tip === 'kalem'}>Belirli ürüne % indirim (önerilen)</option>
            <option value="yuzde" selected={s.fiyatlama.tip === 'yuzde'}>Tüm sete % indirim</option>
            <option value="sabit" selected={s.fiyatlama.tip === 'sabit'}>Sabit set fiyatı (TL)</option>
          </select></div>
          <div class="y-alan"><label>Değer (% ya da TL)</label><input name="deger" inputmode="numeric" value={s.fiyatlama.tip === 'sabit' ? s.fiyatlama.fiyat : s.fiyatlama.oran} /></div>
          <div class="y-alan" data-kalem-hedef><label>İndirimli ürün</label><select name="kalem_hedef"><option value="">Son ürün</option>{m.urunler.map((u) => <option value={u.id} selected={s.fiyatlama.tip === 'kalem' && s.fiyatlama.urunId === u.id}>{u.kisaAd}</option>)}</select></div>
        </div>
        <div class="y-alan" style="margin-top:10px"><label>Rozet <span class="y-ipucu">(isteğe bağlı)</span></label><input name="rozet" value={s.rozet ?? ''} placeholder="Set fırsatı" /></div>
        <div class="y-izgara y-izgara--2" style="margin-top:10px">
          <div class="y-alan"><label>Set görseli <span class="y-ipucu">(yoksa ürün görselleri yan yana gösterilir)</span></label>
            {s.gorsel && <img src={s.gorsel.src} alt="" style="width:90px;height:110px;object-fit:contain;border:1px solid var(--line);border-radius:8px;background:#fff" />}
            <input type="file" name="gorsel" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/heic,image/heif" data-gorsel-sec />
            {s.gorsel && <label class="y-secim"><input type="checkbox" name="gorsel_kaldir" />Görseli kaldır</label>}
          </div>
          <label class="y-secim" style="align-self:end"><input type="checkbox" name="oneCikan" checked={s.oneCikan} />Ana sayfada göster</label>
        </div>

    <output class="y-set-ozet" data-set-toplam aria-live="polite"></output>
    <p class="y-ipucu">Yüzde indirimi tüm sete uygulandığında sonuç bir alt 10 TL basamağına yuvarlanır.</p>
    <p data-kayit-durum class="y-form-state" role="status"></p>
    {!yeni && <details class="y-danger"><summary>Tehlikeli işlemler</summary><button type="submit" class="btn btn--tehlike" name="eylem" value="sil" formnovalidate data-onayla="Bu set silinsin mi?">Seti sil</button></details>}
    </form>
    <Onizleme id="set-onizleme" tur="set" kayit={s.id} />
  </div> : m.setler.length ? <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo"><thead><tr><th>Set</th><th>Ürünler</th><th>Ayrı ayrı</th><th>Set fiyatı</th><th>Tasarruf</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>
    {m.setler.map((x) => { const f = k.setFiyati(x); const engel = x.durum === "yayinda" && k.setEngelleri(x).length > 0; return <tr><td data-etiket="Set"><strong>{x.ad}</strong></td><td data-etiket="Ürünler" class="y-urunler">{f.dokum.map((d) => d.adet + " × " + d.urun.kisaAd).join(", ")}</td><td data-etiket="Ayrı ayrı">{formatTL(f.ayriAyri)}</td><td data-etiket="Set fiyatı"><strong>{formatTL(f.fiyat)}</strong></td><td data-etiket="Tasarruf">{formatTL(f.kazanc)}</td><td data-etiket="Durum">{engel ? "Vitrin dışında" : YAYIN_ADLARI[x.durum]}</td><td class="y-islem"><a class="y-link" href={"?duzenle=" + x.id}>Düzenle</a></td></tr>; })}
  </tbody></table></div> : <p class="y-kart muted">Henüz set yok.</p>}
</Yonetim>
