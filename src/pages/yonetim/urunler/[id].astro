            <label for="rozetler">Güvence Rozetleri </label>
            <textarea
              id="rozetler"
              name="rozetler"
              rows="3"
              placeholder={'2 Yıl Garanti\nOrijinal Ürün'}
              data-alan-ipucu="Güvence Rozetleri: Her satır bir rozettir. Ürün sayfasında başlığın hemen altında yeşil ✓ işaretiyle, ürün kartında ise kalkan ikonuyla görünür."
              data-hedef-eleman="rozetler"
            >{u.rozetler.join('\n')}</textarea>
          </div>
          <div class="y-izgara">
            <div class="y-alan">
              <label for="garanti">Garanti Süresi </label>
              <input
                id="garanti"
                name="garanti"
                value={u.garanti ?? ''}
                placeholder="Örn. 2 yıl"
                data-alan-ipucu="Garanti Süresi: Ürün sayfasının altındaki güvence maddelerinde ve sayfa sonu özetinde '2 yıl garanti' olarak görünür."
                data-hedef-eleman="garanti"
              />
            </div>
            <div class="y-alan">
              <label for="hediye">Yanında Hediye </label>
              <input
                id="hediye"
                name="hediye"
                value={u.hediye ?? ''}
                placeholder="Örn. Yanında silikon spatula hediye"
                data-alan-ipucu="Hediye: Doldurulursa ürün sayfasında teslimat kutusunun altında altın sarısı hediye ikonuyla özel bir kutu olarak görünür."
                data-hedef-eleman="hediye"
              />
            </div>
          </div>
        </div>

        <div class="y-izgara y-izgara--2" style="margin-top:12px">
          <label class="y-secim">
            <input
              type="checkbox"
              name="cokSatan"
              checked={u.cokSatan}
              data-alan-ipucu="En Çok Satan Damgası: Ürün fotoğrafının sol üst köşesine birebir ana sitedeki 3 boyutlu yuvarlak turuncu 'EN ÇOK SATAN' damgasını yerleştirir."
              data-hedef-eleman="galeri"
            />
            <span>
              <strong>"En Çok Satan" yuvarlak turuncu damgası</strong><br />
              <span class="y-ipucu">Yalnızca satış kayıtlarınız destekliyorsa işaretleyin.</span>
            </span>
          </label>
          <label class="y-secim">
            <input
              type="checkbox"
              name="oneCikan"
              checked={u.oneCikan}
              data-alan-ipucu="Ana Sayfada Öne Çıkanlar: İşaretlendiğinde bu ürün ana sayfadaki 'Öne çıkan ürünler' vitrininde sergilenir."
            />
            <span><strong>Ana sayfada "Öne çıkan ürünler" bölümünde göster</strong></span>
          </label>
          <div class="y-alan">
            <label for="oncelik">Listeleme Sıra Önceliği <span class="y-ipucu">(büyük sayı daha önde çıkar)</span></label>
