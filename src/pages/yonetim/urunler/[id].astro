                  data-hedef-eleman="ozellikler"
                />
              </div>
              <button type="button" class="y-sil-btn" data-tekrar-sil aria-label="Satırı sil"><Ikon ad="cop" boyut={18} /></button>
            </div>
          </template>
          <button type="button" class="y-ekle-btn" data-tekrar-ekle>+ Öne Çıkan Bilgi Ekle</button>
        </div>

        <hr style="border:0;border-top:1px solid var(--line);margin:20px 0" />

        <h2><PIkon ad="tik-daire" /> Fayda Bölümleri </h2>
