              <option value="firsat" selected={u.firsat?.stil === "firsat"}>Fırsat · bordo</option>
              <option value="flas" selected={u.firsat?.stil === "flas"}>Flaş indirim · mercan</option>
              <option value="ozel" selected={u.firsat?.stil === "ozel"}>Özel seçim · şampanya</option>
            </select>
          </div>
          <div class="y-alan">
            <label for="firsat_etiket">Fırsat Etiketi </label>
            <input
              id="firsat_etiket"
              name="firsat_etiket"
              value={u.firsat?.etiket ?? ''}
              placeholder="Fırsat Ürünü (veya Flaş Fırsat)"
