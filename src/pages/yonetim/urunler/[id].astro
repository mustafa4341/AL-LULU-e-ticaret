                const fark = oncekiKayit ? g.fiyat - oncekiKayit.fiyat : 0;
                return (
                  <li>
                    <span>{tarihBicim.format(new Date(g.tarih))}</span>
                    <span>
                      <strong>{formatTL(g.fiyat)}</strong>
                      {fark < 0 && <span class="y-chip y-chip--yesil" style="margin-left:6px">{formatTL(fark)}</span>}
                      {fark > 0 && <span class="y-chip y-chip--kirmizi" style="margin-left:6px">+{formatTL(fark)}</span>}
                    </span>
                  </li>
                );
              })}
            </ul>
          </details>
        )}
      </section>

      <!-- 3. FIRSAT ÜRÜNÜ -->
