            <div class="y-tekrar__satir">
              <div class="y-tekrar__alanlar">
                <input class="y-girdi" name="sss_soru" value={x.soru} placeholder="Soru" data-alan-ipucu="Sık Sorulan Soru: Ürün sayfasının altındaki 'Bu ürün hakkında' bölümünde açılır-kapanır soru başlığı olarak görünür." data-hedef-eleman="sss" />
                <textarea class="y-girdi" name="sss_cevap" rows="2" placeholder="Cevap" data-alan-ipucu="Soru Cevabı: Müşteri soruya tıkladığında açılan cevaptır." data-hedef-eleman="sss">{x.cevap}</textarea>
              </div>
              <button type="button" class="y-sil-btn" data-tekrar-sil aria-label="Soruyu sil"><Ikon ad="cop" boyut={18} /></button>
            </div>
          ))}
          <template>
            <div class="y-tekrar__satir">
              <div class="y-tekrar__alanlar">
                <input class="y-girdi" name="sss_soru" placeholder="Soru" data-alan-ipucu="Sık Sorulan Soru: Ürün sayfasının altındaki açılır-kapanır soru başlığıdır." data-hedef-eleman="sss" />
                <textarea class="y-girdi" name="sss_cevap" rows="2" placeholder="Cevap" data-hedef-eleman="sss"></textarea>
              </div>
              <button type="button" class="y-sil-btn" data-tekrar-sil aria-label="Soruyu sil"><Ikon ad="cop" boyut={18} /></button>
            </div>
          </template>
          <button type="button" class="y-ekle-btn" data-tekrar-ekle>+ Soru-Cevap Ekle</button>
        </div>

        {digerUrunler.length > 0 && (
          <>
            <hr style="border:0;border-top:1px solid var(--line);margin:20px 0" />
            <h2>Bununla İyi Gider (Tamamlayıcı Ürünler) </h2>

            <p class="y-ipucu">Önizleme tüm seçilenleri gösterir. Mağazada yayındaki ve stoktaki ürünler gösterilir.</p>
            {tamamlayiciGruplar.map((grup) => <fieldset class="y-kart y-block-gap">
              <legend>{grup.ad}</legend>
              <div class="y-secimler">{grup.urunler.map((x) => <label class="y-secim">
                <input type="checkbox" name="birlikte" value={x.id} checked={u.birlikteIyiGider.includes(x.id)} />
                {x.kisaAd} · {formatTL(x.fiyat)}{x.durum !== "yayinda" ? " · " + (x.durum === "taslak" ? "Taslak" : "Gizli") : x.stok === 0 ? " · Tükendi" : ""}
              </label>)}</div>
            </fieldset>)}
          </>
        )}

        <hr style="border:0;border-top:1px solid var(--line);margin:20px 0" />
      </section>
      <section class="y-kart" data-bolum="gelismis" hidden>
                <h2>Arama görünümü ve iç notlar</h2>
        <p class="y-ipucu">Sayfa başlığı ürün adı ve markadan, arama açıklaması kısa açıklamadan oluşturulur.</p>
        <p class="y-block-gap"><strong>{u.marka} {u.ad} · {m.site.ad}</strong></p>
        {u.ozet && <p class="muted">{u.ozet}</p>}

        <textarea class="y-girdi" name="dogrula" rows="3" style="width:100%" placeholder="Örn. Fatura kodu kutuyla teyit edilecek">{u.dogrula.join('\n')}</textarea>
      </section>

      <p class="y-form-state" data-kayit-durum role="status"></p>
      {!yeni && <details class="y-kart" data-bolum="gelismis" hidden>
        <summary>Tehlikeli işlemler</summary>
        <button class="btn btn--tehlike btn--kucuk" type="submit" name="eylem" value="sil" formnovalidate data-onayla="Bu ürün kalıcı olarak silinsin mi?">Ürünü sil</button>
      </details>}
    </form>
    <Onizleme id="urun-onizleme" tur="urun" kayit={u.id} />
  </div>
</Yonetim>
