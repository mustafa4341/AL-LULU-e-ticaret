              Hepsiburada: <strong>{(envanter.kanallar.hepsiburada.urunler[u.id]?.ozelFiyat ?? envanter.kanallar.hepsiburada.urunler[u.id]?.kanalFiyat)?.toLocaleString('tr-TR') ?? 'Tanımsız'} TL</strong>.
              <a class="y-link" href={'/yonetim/fiyatlar#f-' + encodeURIComponent(u.id)}>Fiyat ve Kâr Tablosunda düzenle</a> ·
              <a class="y-link" href={'/yonetim/siparisler/trendyol-urunler?urun=' + encodeURIComponent(u.id)}>Trendyol ilan / taslak ekranı</a>
            </p>
          </div>
        )}

        <div class="y-kampanya-panel" style="margin-top:14px;padding:14px;border-radius:12px;border:1.5px solid var(--line);background:#FAF9F5">
