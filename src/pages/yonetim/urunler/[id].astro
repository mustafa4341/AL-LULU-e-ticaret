---
import Yonetim from '../../../layouts/Yonetim.astro';
import Ikon from '../../../components/Ikon.astro';
import { DogrulamaHatasi, gorselKaydet, gorselSil, magazaGuncelle, magazaOku, siparisleriOku } from '../../../lib/depo';
import { formatTL } from '../../../lib/fiyat';
import { benzersizKod, evet, istegeBagli, liste, metin, sayi } from '../../../lib/form';
import { fiyatUygula, urunBazliSatislar } from '../../../lib/urunIslem';
import { Katalog } from '../../../lib/katalog';
import type { IkonAdi, Urun } from '../../../lib/sema';
import { BOS_URUN, istanbulaYerel, urunFormu, urunGorselleri, yayinEksikleri } from '../../../lib/yonetimUrun';
import Onizleme from '../../../components/yonetim/Onizleme.astro';
import Sekmeler from '../../../components/yonetim/Sekmeler.astro';
import BilgiKutusu from '../../../components/yonetim/BilgiKutusu.astro';

const IKON_SECENEK: [IkonAdi, string][] = [
  ['tencere', 'Tencere'], ['duduklu', 'Düdüklü'], ['tava', 'Tava'], ['ates', 'Ocak / ateş'],
  ['gosterge', 'Gösterge'], ['konum', 'Konum / üretim'], ['kalkan', 'Kalkan / güven'], ['kutu', 'Kutu'],
  ['kasik', 'Kaşık / çatal'], ['kase', 'Kase'], ['saat', 'Saat'], ['yildiz', 'Yıldız'],
  ['hediye', 'Hediye'], ['kargo', 'Kargo'], ['belge', 'Belge / garanti'], ['etiket', 'Etiket'],
];
const param = Astro.params.id ?? 'yeni';
const yeni = param === 'yeni';
let hatalar: string[] = [];
const basari = Astro.url.searchParams.get('ok');
let m = await magazaOku();
let urun: Urun | undefined = yeni ? structuredClone(BOS_URUN) : m.urunler.find((u) => u.id === param);
if (!urun) return Astro.redirect('/yonetim/urunler');

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (metin(f, 'eylem') === 'sil' && !yeni) {
    try {
      const silinecek = urun.gorseller.map((g) => g.src);
      await magazaGuncelle((mm) => {
        const setler = mm.setler.filter((s) => s.kalemler.some((x) => x.urunId === param));
        if (setler.length) throw new DogrulamaHatasi([`Bu ürün şu setlerde kullanılıyor, önce setten çıkarın: ${setler.map((s) => s.ad).join(', ')}`]);
        if (mm.anaSayfa.hero.urunId === param) throw new DogrulamaHatasi(['Bu ürün ana sayfada öne çıkan ürün. Önce Site Düzeni → Ana sayfa’dan başka bir ürün seçin.']);
        mm.urunler = mm.urunler.filter((u) => u.id !== param);
        mm.urunler.forEach((u) => (u.birlikteIyiGider = u.birlikteIyiGider.filter((x) => x !== param)));
      });
      for (const s of silinecek) await gorselSil(s);
      return Astro.redirect(`/yonetim/urunler?ok=${encodeURIComponent('Ürün silindi')}`);
    } catch (e) {
      hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
    }
  } else {
    const aday = urunFormu(f, urun);
    // Üst çubuktaki "Kaydet ve yayınla" / "Yayından kaldır" düğmeleri seçili durumu ezer
    const yayin = metin(f, 'yayin');
    if (yayin === 'yayinda' || yayin === 'gizli' || yayin === 'taslak') aday.durum = yayin;
    const fiyat = sayi(f, 'fiyat', urun.fiyat);
    const kampanya = evet(f, 'kampanya');
    const kampanyaEtiket = istegeBagli(f, 'kampanya_etiket');
    const oncekiFiyat = sayi(f, 'onceki_fiyat');
    // Sayfa adresi marka + ürün adından tamamen otomatik oluşturulur
    const hedefId = yeni
      ? benzersizKod(`${aday.marka} ${aday.kisaAd || aday.ad}`.trim() || 'urun', new Set(m.urunler.map((u) => u.id)))
      : urun.id;

    // Görseller: mevcutlar (sıra, açıklama, silme) + yeni yüklenenler
    const silinecek = urun.gorseller.map((g) => g.src).filter((src) => liste(f, 'gorsel_sil').includes(src));
    const yuklenen: { src: string; alt: string }[] = [];
    try {
      for (const d of f.getAll('yeni_gorsel')) {
        if (d instanceof File && d.size > 0) yuklenen.push({ src: await gorselKaydet(d, hedefId), alt: `${aday.marka} ${aday.ad}`.trim() });
      }
    } catch (e) {
      hatalar = [`Görsel yüklenemedi: ${(e as Error).message}`];
      for (const g of yuklenen.splice(0)) await gorselSil(g.src);
    }
    aday.gorseller = urunGorselleri(f, urun, yuklenen);

    if (!hatalar.length) {
      try {
        await magazaGuncelle((mm) => {
          let u = mm.urunler.find((x) => x.id === hedefId);
          if (yeni && u) throw new DogrulamaHatasi(["Aynı ürün adresi bu sırada oluşturuldu. Yeniden deneyin."]);
          if (!yeni && !u) throw new DogrulamaHatasi(["Ürün artık katalogda bulunmuyor."]);
          if (!u) {
            u = { ...structuredClone(BOS_URUN), id: hedefId, fiyat };
            mm.urunler.push(u);
          }
          const eskiStok = sayi(f, "eskiStok", u.stok);
          const eskiFiyat = sayi(f, "eskiFiyat", u.fiyat);
          if (!yeni && u.stok !== eskiStok && aday.stok !== eskiStok) throw new DogrulamaHatasi(["Stok bu sırada değişti. Güncel miktarı kontrol edin."]);
          if (!yeni && u.fiyat !== eskiFiyat && fiyat !== eskiFiyat) throw new DogrulamaHatasi(["Fiyat bu sırada değişti. Güncel fiyatı kontrol edin."]);
          const stok = !yeni && aday.stok === eskiStok ? u.stok : aday.stok;
          const sonFiyat = !yeni && fiyat === eskiFiyat ? u.fiyat : fiyat;
          const { fiyat: _f, fiyatGecmisi: _g, kampanya: _k, id: _i, ...alanlar } = aday;
          Object.assign(u, alanlar, { stok });
          if (kampanya && oncekiFiyat && oncekiFiyat <= sonFiyat) throw new DogrulamaHatasi(["Önceki satış fiyatı indirimli satış fiyatından yüksek olmalı."]);
          fiyatUygula(u, sonFiyat, kampanya, kampanyaEtiket, oncekiFiyat);
          if (u.durum === 'yayinda') {
            const eksik = yayinEksikleri(u);
            if (eksik.length) throw new DogrulamaHatasi([`Yayına almak için eksik: ${eksik.join(', ')}. Tamamlayıp tekrar "Kaydet ve yayınla"ya basın (ya da önce taslak olarak kaydedin).`]);
          }
        }, yeni ? 'Yeni ürün' : 'Panel: ürün düzenleme');
        for (const s of silinecek) await gorselSil(s);
        const mesaj = aday.durum === 'yayinda'
          ? (yeni ? 'Ürün oluşturuldu ve yayında.' : 'Kaydedildi. Ürün yayında, müşteriler görebilir.')
          : aday.durum === 'gizli' ? 'Kaydedildi. Ürün gizli: sitede görünmüyor.'
          : (yeni ? 'Ürün taslak olarak oluşturuldu. Sitede görünmesi için "Kaydet ve yayınla"ya basın.' : 'Taslak kaydedildi. Sitede görünmüyor.');
        return Astro.redirect('/yonetim/urunler/' + hedefId + '?ok=' + encodeURIComponent(mesaj), 303);
      } catch (e) {
        hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
        for (const g of yuklenen) await gorselSil(g.src);
        aday.gorseller = aday.gorseller.filter((g) => !yuklenen.some((y) => y.src === g.src));
      }
    }
    m = await magazaOku();
    /* Kayıt başarısızsa "Yayın durumu" seçimi gerçek (kayıtlı) durumu göstersin; yoksa taslak ürün "Yayında" görünür */
    const oncekiId = urun.id;
    const kayitliDurum = yeni ? 'taslak' : m.urunler.find((x) => x.id === oncekiId)?.durum ?? aday.durum;
    urun = { ...aday, durum: kayitliDurum, fiyat, id: yeni ? '' : oncekiId };
  }
}

const u = urun;
const k = new Katalog(m, new Map(), true);
const kayitli = m.urunler.find((x) => x.id === u.id);
const bilgi = kayitli ? k.fiyatBilgisi(kayitli) : undefined;
const digerUrunler = m.urunler.filter((x) => x.id !== u.id);
const tamamlayiciGruplar = [...m.kategoriler].sort((a,b) => a.sira - b.sira)
  .map((k) => ({ ad: k.ad, urunler: digerUrunler.filter((x) => x.kategoriler[0] === k.id) })).filter((k) => k.urunler.length);
const gecmis = [...(kayitli?.fiyatGecmisi ?? [])].reverse();
const siparisler = await siparisleriOku();
const urunSatis = kayitli ? urunBazliSatislar(m, siparisler).find((x) => x.urun.id === kayitli.id) : undefined;
const tarihBicim = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });


---
<Yonetim
  baslik={yeni ? "Yeni Ürün" : u.marka + " " + u.kisaAd}
  aktif="urunler"
  basari={basari}
  hatalar={hatalar}
  genis
>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a href="/yonetim/urunler" class="y-link">Ürünlere dön</a>
    <button type="button" class="btn btn--cizgi" data-onizleme-ac aria-controls="urun-onizleme" aria-expanded="false">Önizle</button>
    {kayitli && <span class={'y-yayin-rozet y-yayin-rozet--' + kayitli.durum} title="Şu anki yayın durumu">{kayitli.durum === 'yayinda' ? 'Yayında' : kayitli.durum === 'gizli' ? 'Gizli' : 'Taslak'}</span>}
    {kayitli?.durum === 'yayinda'
      ? <>
          <button type="submit" form="urun-form" class="btn btn--cizgi" name="yayin" value="gizli" data-onayla="Ürün yayından kaldırılsın mı? Sitede görünmez olur, silinmez.">Yayından kaldır</button>
          <button type="submit" form="urun-form" class="btn btn--sepet" name="eylem" value="kaydet" data-yayin-kaydet>Kaydet</button>
        </>
      : <>
          {/* Yeni üründe taslak olarak kaydeder; kayıtlı taslak/gizli üründe formdaki "Yayın durumu" seçimine uyar */}
          {yeni
            ? <button type="submit" form="urun-form" class="btn btn--cizgi" name="yayin" value="taslak">Taslak kaydet</button>
            : <button type="submit" form="urun-form" class="btn btn--cizgi" name="eylem" value="kaydet">Kaydet</button>}
          <button type="submit" form="urun-form" class="btn y-yayinla-btn" name="yayin" value="yayinda">Kaydet ve yayınla</button>
        </>}
    {!yeni && <button type="submit" form="urun-form" class="btn btn--tehlike" name="eylem" value="sil" formnovalidate data-onayla="Bu ürün KALICI olarak silinsin mi? Fotoğrafları da silinir, geri alınamaz.">Sil</button>}
  </div>
  <div class="y-editor-duzen" data-editor-duzen>
    <!-- SOL SÜTUN: REHBERLİ ÜRÜN FORMU -->
    <form method="post" enctype="multipart/form-data" id="urun-form" class="y-editor-form" data-editor data-onizleme-form="urun" data-kayit={u.id} data-kayit-durum={kayitli?.durum ?? "taslak"}>
      <input type="hidden" name="eskiStok" value={kayitli?.stok ?? 0} />
      <input type="hidden" name="eskiFiyat" value={kayitli?.fiyat ?? 0} />
      <BilgiKutusu baslik={yeni ? 'Yeni ürün 3 adımda eklenir' : 'Bu sayfada ne var?'} anahtar={yeni ? 'urun-yeni' : 'urun-duzenle'} ton="ipucu" acik={yeni}>
        <ol>
          <li><strong>Genel Bilgiler:</strong> marka, ürün adı ve kategori.</li>
          <li><strong>Fiyat &amp; Stok:</strong> satış fiyatı ve depodaki adet. Stok 0 ise sitede “stokta yok” yazar.</li>
          <li><strong>Fotoğraflar:</strong> en az bir fotoğraf. Sonra sağ üstten <em>Kaydet ve yayınla</em>.</li>
        </ol>
        <p><strong>Barkod:</strong> kutunun üzerindeki çizgili kodun altındaki 13 haneli sayı. <em>Detaylar → Teknik özellikler</em> bölümüne “Barkod (EAN)” satırı olarak yazın. Google'da ve Trendyol eşleştirmesinde bu numara kullanılır; tahmin edip yazmayın, kutudan okuyun.</p>
        <p>Emin olmadığınız bir şey varsa <em>Taslak kaydet</em> deyin: müşteri görmez, sonra tamamlarsınız.</p>
      </BilgiKutusu>
      <Sekmeler secenekler={[["genel", "Genel Bilgiler"], ["fiyat", "Fiyat & Stok"], ["fotograf", "Fotoğraflar"], ["satis", "Satış İçeriği"], ["detay", "Detaylar"], ["gelismis", "Gelişmiş"]]} />
      <!-- 1. TEMEL BİLGİLER -->
      <section class="y-kart" id="bolum-temel" data-bolum="genel">
        <h2>Temel Bilgiler</h2>


        <div class="y-izgara">
          <div class="y-alan">
            <span class="y-etiket">Yayın Durumu </span>
            <select name="durum" aria-label="Yayın durumu">
              <option value="taslak" selected={u.durum === "taslak"}>Taslak</option>
              <option value="yayinda" selected={u.durum === "yayinda"}>Yayında</option>
              <option value="gizli" selected={u.durum === "gizli"}>Gizli</option>
            </select>
          </div>

          <div class="y-izgara y-izgara--2">
            <div class="y-alan">
              <label for="marka">Marka </label>
              <input
                id="marka"
                name="marka"
                value={u.marka}
                required
                placeholder="Örn. Fissler"
                data-alan-ipucu="Marka: Ürün kartında kalın harflerle ürün adının başında ve ürün sayfasında başlığın hemen üstünde altın rengiyle görünür."
                data-hedef-eleman="marka"
              />
            </div>
            <div class="y-alan">
              <label for="kisaAd">Kısa Ad </label>
              <input
                id="kisaAd"
                name="kisaAd"
                value={u.kisaAd}
                placeholder="Örn. Vitaquick® Premium 6 L (boşsa tam ad kullanılır)"
                data-alan-ipucu="Kısa Ad: 1) Sayfa üstündeki 'Ana sayfa › Kategori › Kısa Ad' konum çubuğunda, 2) Müşterinin Sepet çekmecesinde ve 3) Sayfa sonundaki 'Özetle' kutusunda görünür."
                data-hedef-eleman="kisaAd"
              />
            </div>
          </div>

          <div class="y-alan">
            <label for="ad">Tam Ürün Adı </label>
            <input
              id="ad"
              name="ad"
              value={u.ad}
              required
              placeholder="Örn. Vitaquick® Premium Düdüklü Tencere 6 L"
              data-alan-ipucu="Tam Ürün Adı: Ürün sayfasının en büyük ana başlığıdır ve vitrin kartlarında markanın yanında yer alır."
              data-hedef-eleman="ad"
            />
          </div>

          <div class="y-otomatik-adres">
            <span>🔗 <strong>Otomatik Sayfa Adresi:</strong> <code data-demo-url>/urun/{u.id || 'marka-urun-adi'}</code></span>
            <span class="y-ipucu">Sizin adres girmenize gerek yoktur; yazdığınız marka ve ürün adından otomatik oluşturulur.</span>
          </div>

          <div class="y-alan">
            <span class="y-etiket">Kategoriler  <span class="y-ipucu">(ilk seçilen ana kategori olur)</span></span>
            <div class="y-secimler">
              {m.kategoriler.map((c) => (
                <label class="y-secim">
                  <input
                    type="checkbox"
                    name="kategoriler"
                    value={c.id}
                    checked={u.kategoriler.includes(c.id)}
                    data-alan-ipucu={`Kategori (${c.ad}): İşaretlendiğinde sayfa üstü konum çubuğunda '${c.ad}' yazar ve ürün bu kategori sayfasında listelenir.`}
                    data-hedef-eleman="kategori"
                  />
                  {c.ad}
                </label>
              ))}
            </div>
          </div>

          <div class="y-alan">
            <label for="ozet">Kısa Açıklama (Özet) </label>
            <textarea
              id="ozet"
              name="ozet"
              rows="2"
              placeholder="1–2 cümle: Ürün ne işe yarar, neden iyi?"
              data-alan-ipucu="Kısa Açıklama (Özet): Ürün sayfasında ana başlığın hemen altında ve Google/WhatsApp bağlantı önizlemelerinde görünür."
              data-hedef-eleman="ozet"
            >{u.ozet}</textarea>
          </div>
        </div>
      </section>

      <!-- 2. FİYAT VE İNDİRİM -->
      <section class="y-kart" id="bolum-fiyat" data-bolum="fiyat" hidden data-fiyat-kutu data-mevcut={kayitli?.fiyat ?? 0} data-gun={m.site.indirimReferansGun} data-aktif-onceki={bilgi?.onceki ?? ''}>
        <h2>Fiyat ve İndirim Yönetimi</h2>


        <div class="y-izgara y-izgara--2">
          <div class="y-alan">
            <label for="fiyat">Satış Fiyatı (KDV dahil) </label>
            <div class="y-tl">
              <input
                id="fiyat"
                name="fiyat"
                inputmode="numeric"
                value={u.fiyat || ''}
                required
                data-fiyat-girdi
                data-alan-ipucu={`Satış Fiyatı: Müşterinin ödeyeceği KDV dahil fiyattır. ${formatTL(m.site.kargo.ucretsizEsik)} ve üzeri olduğunda ürüne otomatik 'Kargo Bedava' şeridi eklenir.`}
                data-hedef-eleman="fiyat"
              />
            </div>
          </div>
          <div class="y-alan">
            <label for="sepetteIndirim">Sepette Ek İndirim (%) </label>
            <input
              id="sepetteIndirim"
              name="sepetteIndirim"
              inputmode="numeric"
              value={u.sepetteIndirim}
              data-sepette-girdi
              data-alan-ipucu="Sepette Ek İndirim (%): 0'dan büyük girerseniz (örn. 10), ürün kartında ve ürün sayfasında yeşil 'Sepette %10 İndirim' kutusu çıkar ve sepette otomatik düşer."
              data-hedef-eleman="sepetteIndirim"
            />
            <span class="y-ipucu">0 girildiğinde sepet indirimi uygulanmaz.</span>
          </div>
        </div>

        <div class="y-kampanya-panel" style="margin-top:14px;padding:14px;border-radius:12px;border:1.5px solid var(--line);background:#FAF9F5">
          <label class="y-secim" style="border:0;padding:0;background:transparent">
            <input
              type="checkbox"
              name="kampanya"
              checked={!!u.kampanya}
              data-kampanya-girdi
              data-alan-ipucu="Fiyat Düşüşünü İndirim Olarak Göster: Açıldığında eski fiyat üstü çizili, yeni fiyat bordo/kırmızı, '%X İndirim' rozeti ve 'X TL daha az ödüyorsunuz' yazısı görünür."
              data-hedef-eleman="fiyat"
            />
            <span>
              <strong>Fiyat düşüşünü üstü çizili indirim olarak göster</strong><br />
              <span class="y-ipucu">Önceki satış fiyatını ve satış fiyatını girin.</span>
            </span>
          </label>

          <div class="y-izgara y-izgara--2" style="margin-top:12px">
            <div class="y-alan">
              <label for="onceki_fiyat">Önceki satış fiyatı</label>
              <input id="onceki_fiyat" name="onceki_fiyat" inputmode="numeric" value={u.kampanya?.oncekiFiyat ?? ""} placeholder="Örn. 13999" data-hedef-eleman="fiyat" />
              <small class="y-ipucu">Ürüne gerçekten uyguladığınız önceki fiyatı yazın.</small>
            </div>
            <div class="y-alan">
              <label for="kampanya_etiket">
                Kampanya Etiketi
              </label>
              <input
                id="kampanya_etiket"
                name="kampanya_etiket"
                value={u.kampanya?.etiket ?? ''}
                placeholder="Örn. Kasım Fırsatı / Özel Fiyat"
                data-alan-ipucu="Kampanya Etiketi: Fiyat kutusunun hemen içinde fiyatın altında ve ürün kartında kırmızı kalın yazı olarak görünür (örn. 'Kasım Fırsatı')."
                data-hedef-eleman="kampanyaEtiket"
              />

            </div>
          </div>
        </div>

        <div class="y-indirim-onizleme" data-indirim-onizleme aria-live="polite"></div>

        {gecmis.length > 0 && (
          <details class="y-fiyat-gecmis-kutu">
            <summary>Fiyat geçmişi ({gecmis.length})</summary>
            <ul class="y-gecmis">
              {gecmis.slice(0, 8).map((g, idx) => {
                const oncekiKayit = gecmis[idx + 1];
                const fark = oncekiKayit ? g.fiyat - oncekiKayit.fiyat : 0;
                return (
                  <li>
                    <span>{tarihBicim.format(new Date(g.tarih))}</span>
                    <span>
                      <strong>{formatTL(g.fiyat)}</strong>
                      {fark < 0 && <small style="color:var(--yesil);margin-left:6px">(📉 {formatTL(fark)})</small>}
                      {fark > 0 && <small style="color:var(--danger);margin-left:6px">(📈 +{formatTL(fark)})</small>}
                    </span>
                  </li>
                );
              })}
            </ul>
          </details>
        )}
      </section>

      <!-- 3. FIRSAT ÜRÜNÜ -->
      <section class="y-kart" id="bolum-firsat" data-bolum="satis" hidden style="border-color:#F3B8C0">
        <div class="y-kart-ust-etiket" style="color:var(--flas)">Adım 3 · Fırsat Vitrini & Canlı Geri Sayım Sayacı</div>
        <h2>⚡ Fırsat Ürünü ve Geri Sayım Sayacı</h2>


        <label class="y-secim">
          <input
            type="checkbox"
            name="firsat"
            checked={!!u.firsat}
            data-firsat-girdi
