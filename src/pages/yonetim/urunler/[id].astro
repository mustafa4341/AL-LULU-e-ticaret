        </div>

        <div class="y-mini-ozet" style="margin-bottom:14px">
          <div><PIkon ad="kutu" boyut={18} /><strong>{u.stok} adet</strong><span>Depodaki mevcut stok</span></div>
          <div class="y-mini-ozet--turuncu"><PIkon ad="saat" boyut={18} /><strong>{ayrilanStok} adet</strong><span>Siparişlere ayrılan (web)</span></div>
          <div class:list={[satilabilirStok === 0 ? 'y-mini-ozet--kirmizi' : 'y-mini-ozet--yesil']}><PIkon ad="tik-daire" boyut={18} /><strong>{satilabilirStok} adet</strong><span>Satılabilir stok</span></div>
        </div>

        <div class="y-izgara y-izgara--3">
