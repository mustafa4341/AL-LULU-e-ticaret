              id="stok"
              name="stok"
              inputmode="numeric"
              value={u.stok}
              data-alan-ipucu="Stok Adedi: 0 yazarsanız ürün 'Şu an stokta yok' olur. 1, 2 veya 3 yazarsanız kırmızı 'Stokta son X adet' uyarısı çıkar."
              data-hedef-eleman="stok"
            />
          </div>
          <div class="y-alan">
