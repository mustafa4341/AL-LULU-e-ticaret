          </div>
          <div class="y-alan">
            <label for="faydaBaslik">Fayda Ana Başlığı (H2)</label>
            <input id="faydaBaslik" name="faydaBaslik" value={u.faydaBaslik ?? ''} placeholder="Örn. Sofrada zarafet, elde kusursuz denge." data-hedef-eleman="faydalar" />
          </div>
          <div class="y-alan">
            <label for="faydaAltBaslik">Fayda Alt Açıklaması</label>
            <input id="faydaAltBaslik" name="faydaAltBaslik" value={u.faydaAltBaslik ?? ''} placeholder="Örn. 18/10 çelik ve monoblok bıçak farkı." data-hedef-eleman="faydalar" />
          </div>
        </div>

        <div class="y-tekrar">
          {u.faydalar.map((x) => (
            <div class="y-tekrar__satir">
              <div class="y-tekrar__alanlar">
                <input class="y-girdi" name="fayda_baslik" value={x.baslik} placeholder="Büyük başlık (örn. %70’e kadar daha kısa pişirme)" data-alan-ipucu="Fayda Kartı Başlığı: Sayfa ortasındaki 3'lü fayda kutularının kalın başlığıdır; ilk 3 tanesi sayfa sonu özet kutusunda da yer alır." data-hedef-eleman="faydalar" />
