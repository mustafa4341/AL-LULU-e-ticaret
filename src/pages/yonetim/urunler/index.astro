---
import Yonetim from '../../../layouts/Yonetim.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { DogrulamaHatasi, gorselSil, magazaGuncelle, magazaOku, siparisleriOku, webAyrilanAdetleri } from '../../../lib/depo';
import { yayinEksikleri } from '../../../lib/yonetimUrun';
import { formatTL } from '../../../lib/fiyat';
import { metin, sayi } from '../../../lib/form';
import { fiyatDegisimleriListesi, fiyatUygula, urunBazliSatislar } from '../../../lib/urunIslem';
import { Katalog } from '../../../lib/katalog';
import { YAYIN_ADLARI, stokSebebi, yTarih } from '../../../lib/yonetimRapor';
import { KANALLAR, KANAL_LISTESI, bosAyarlar, kritikEsik } from '../../../lib/pazaryeri';
import { envanterAyarlariGuncelle, envanterAyarlariOku, stokHareketleriOku } from '../../../lib/pazaryeriDepo';
import BilgiKutusu from '../../../components/yonetim/BilgiKutusu.astro';
import { urunGtin } from '../../../lib/urunKimlik';
import Ikon from '../../../components/Ikon.astro';

const basari = Astro.url.searchParams.get('ok');
/* Adres boşsa son seçilen filtre ve sıralama çerezden okunur (sayfa ikinci kez açılmaz) */
const p = new URLSearchParams(!Astro.url.search ? (Astro.cookies.get('y-filtre-urun')?.value ?? '').slice(0, 300) : Astro.url.search);
const filtre = p.get('filtre') ?? 'tumu';
const soru = p.get('q') ?? '';
const sira = p.get('sira') ?? 'katalog';
/* Kategoriler sayfasındaki "Ürünleri gör" bağlantısı ?kategori= ile gelir (eskiden okunmuyordu — denetim AUD-020) */
const kategori = p.get('kategori') ?? '';
let duzenle = Astro.url.searchParams.get('duzenle');
let hatalar: string[] = [];
let form: FormData | undefined;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const eylem = metin(f, 'eylem');
  if (eylem === 'stok-uyari') {
    try {
      const esik = sayi(f, 'kritikVarsayilan', -1);
      if (esik < 0 || esik > 1000) throw new Error('Uyarı eşiği 0 ile 1.000 adet arasında olmalı.');
      await envanterAyarlariGuncelle((a) => { a.kritikVarsayilan = esik; a.epostaBildirimi = f.get('epostaBildirimi') === 'on'; });
      return Astro.redirect('/yonetim/urunler?' + new URLSearchParams({ filtre, q: soru, sira, ok: 'Stok uyarı ayarı kaydedildi.' }), 303);
    } catch (e) {
      hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
    }
  } else if (eylem === 'yayinla' || eylem === 'gizle' || eylem === 'sil') {
    const id = metin(f, 'id');
    const geri = (mesaj: string) => Astro.redirect('/yonetim/urunler?' + new URLSearchParams({ filtre, q: soru, sira, ok: mesaj }) + (eylem === 'sil' ? '' : '#u-' + id), 303);
    try {
      let silinecek: string[] = [];
      let ad = '';
      await magazaGuncelle((m) => {
        const u = m.urunler.find((x) => x.id === id);
        if (!u) throw new Error('Ürün bulunamadı. Sayfayı yenileyin.');
        ad = (u.marka + ' ' + u.kisaAd).trim();
        if (eylem === 'yayinla') {
          const eksik = yayinEksikleri(u);
          if (eksik.length) throw new Error(`"${ad}" yayına alınamadı. Eksik: ${eksik.join(', ')}. Ürünü açıp "Düzenle" ile tamamlayın.`);
          u.durum = 'yayinda';
        } else if (eylem === 'gizle') {
          u.durum = 'gizli';
        } else {
          const setler = m.setler.filter((s) => s.kalemler.some((x) => x.urunId === id));
          if (setler.length) throw new Error(`Bu ürün şu setlerde kullanılıyor, önce setten çıkarın: ${setler.map((s) => s.ad).join(', ')}`);
          if (m.anaSayfa.hero.urunId === id) throw new Error('Bu ürün ana sayfada öne çıkan ürün. Önce Site Düzeni → Ana sayfa’dan başka bir ürün seçin.');
          silinecek = u.gorseller.map((g) => g.src);
          m.urunler = m.urunler.filter((x) => x.id !== id);
          m.urunler.forEach((x) => (x.birlikteIyiGider = x.birlikteIyiGider.filter((y) => y !== id)));
        }
      });
      for (const s of silinecek) await gorselSil(s).catch(() => undefined);
      return geri(eylem === 'yayinla' ? `"${ad}" yayında, müşteriler artık görebilir.` : eylem === 'gizle' ? `"${ad}" yayından kaldırıldı (gizli).` : `"${ad}" silindi.`);
    } catch (e) {
      hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
    }
  } else {
  duzenle = metin(f, 'id');
  form = f;
  try {
    await magazaGuncelle((m) => {
      const u = m.urunler.find((x) => x.id === duzenle);
      if (!u) throw new Error('Ürün bulunamadı.');
      const stok = sayi(f, 'stok', -1);
      const fiyat = sayi(f, 'fiyat', -1);
      const indirim = sayi(f, 'sepetteIndirim', -1);
      if (stok < 0 || fiyat <= 0 || indirim < 0 || indirim > 50) throw new Error('Geçerli fiyat, stok ve %0–50 arası sepet indirimi girin.');
      const eskiStok = sayi(f, 'eskiStok', -1);
      if (stok !== eskiStok && u.stok !== eskiStok) throw new Error('Stok bu sırada güncellendi. Güncel stoğu kontrol edip tekrar deneyin.');
      const eskiFiyat = sayi(f, 'eskiFiyat', -1);
      if (fiyat !== eskiFiyat && u.fiyat !== eskiFiyat) throw new Error('Fiyat bu sırada güncellendi. Güncel fiyatı kontrol edip tekrar deneyin.');
      if (stok !== eskiStok) u.stok = stok;
      if (fiyat !== eskiFiyat) fiyatUygula(u, fiyat);
      u.sepetteIndirim = indirim;
    }, 'Panel: hızlı stok düzeltme');
    const q = new URLSearchParams({ filtre, q: soru, sira, ok: 'Fiyat ve stok kaydedildi.' });
    return Astro.redirect('/yonetim/urunler?' + q + '#u-' + duzenle, 303);
  } catch (e) {
    hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
  }
  }
}
const [m, siparisler, envanter, hareketler] = await Promise.all([
  magazaOku(), siparisleriOku(), envanterAyarlariOku().catch(() => bosAyarlar()), stokHareketleriOku(undefined, 40).catch(() => []),
]);
const k = new Katalog(m);
const rapor = urunBazliSatislar(m, siparisler);
const gecmis = fiyatDegisimleriListesi(m).slice(0, 30);
const ayrilanMap = webAyrilanAdetleri(siparisler, Date.now(), m.paytrStokIslemleri);
const aranan = soru.toLocaleLowerCase('tr').trim();
const esik = (id: string) => kritikEsik(envanter, id);
const urunAdi = new Map(m.urunler.map((u) => [u.id, `${u.marka} ${u.kisaAd}`]));
const kritikUrunler = m.urunler.filter((u) => u.durum === 'yayinda' && u.stok <= esik(u.id)).sort((a, b) => a.stok - b.stok);
const azalan = kritikUrunler.length;
const barkodsuz = m.urunler.filter((u) => u.durum === 'yayinda' && !urunGtin(u)).length;
const fotosuz = m.urunler.filter((u) => !u.gorseller.length).length;
/* 1 TL = taslak ürünün fiyatı henüz girilmedi (yayinEksikleri ile aynı kural) */
const fiyatGirilmedi = (u: (typeof m.urunler)[number]) => u.fiyat <= 1;
const fiyatsiz = m.urunler.filter(fiyatGirilmedi).length;
/* Şablonda "<=" yazılırsa Astro derleyicisi etiket sanıyor; rozet metni burada hesaplanır */
const stokYazisi = (u: (typeof m.urunler)[number]) => u.durum !== 'yayinda' ? undefined
  : u.stok === 0 ? 'Tükendi' : u.stok <= esik(u.id) ? `${u.stok} · Azalıyor` : undefined;
/* Stok hücresi: yeşil stokta, turuncu azalıyor, kırmızı tükendi (yalnız yayındaki ürünlerde uyarı) */
const stokGorunumu = (u: (typeof m.urunler)[number]): [string, string] => u.durum !== 'yayinda' ? [`${u.stok} adet`, 'gri']
  : u.stok === 0 ? ['Tükendi', 'tukendi'] : u.stok <= esik(u.id) ? [`${u.stok} adet · Azalıyor`, 'kritik'] : [`${u.stok} adet`, 'normal'];
const tukenenSayisi = m.urunler.filter((u) => u.durum === 'yayinda' && u.stok === 0).length;
const toplamStok = m.urunler.filter((u) => u.durum === 'yayinda').reduce((n, u) => n + u.stok, 0);
const liste = m.urunler.filter((u) => {
  const gtin = urunGtin(u);
  const uygun = filtre === 'tumu' || u.durum === filtre
    || (filtre === 'kritik' && u.durum === 'yayinda' && u.stok <= esik(u.id))
    || (filtre === 'barkod' && u.durum === 'yayinda' && !gtin)
    || (filtre === 'fotosuz' && !u.gorseller.length)
    || (filtre === 'fiyatsiz' && fiyatGirilmedi(u));
  return uygun && (!kategori || u.kategoriler.includes(kategori))
    && (!aranan || [u.ad, u.kisaAd, u.sku, u.marka, gtin ?? ''].some((x) => x.toLocaleLowerCase('tr').includes(aranan)));
}).sort((a, b) => sira === 'stok' ? a.stok - b.stok : sira === 'fiyat' ? a.fiyat - b.fiyat : sira === 'ad' ? a.kisaAd.localeCompare(b.kisaAd, 'tr') : b.oncelik - a.oncelik);
const url = (id?: string) => '?' + new URLSearchParams({ filtre, q: soru, sira, ...(kategori ? { kategori } : {}), ...(id ? { duzenle: id } : {}) }) + (id ? '#u-' + id : '');
const acikEditor = liste.some((u) => u.id === duzenle);
// Etikete basılabilecek SKU (yalnız yazdırılabilir ASCII, en fazla 55 karakter).
// Not: regex şablonun içinde yazılırsa Astro derleyicisi onu etiket sanıp sayfa açılmaz; burada kalmalı.
const skuGecerli = (sku: string) => /^[ -~]{1,55}$/.test(sku);
---
<Yonetim baslik="Ürünler ve Stok" altBaslik="Kataloğu, fiyatları ve depodaki ürün adetlerini yönetin." aktif="urunler" basari={basari} hatalar={hatalar}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="#stok-gecmisi" data-ac="stok-gecmisi"><PIkon ad="gecmis" boyut={18} />Stok hareketleri</a>
    <a class="btn btn--cizgi" href="/yonetim/setler"><PIkon ad="set" boyut={18} />Setler</a>
    <a class="btn btn--cizgi" href="/yonetim/kategoriler"><PIkon ad="kategori" boyut={18} />Kategoriler</a>
    <a class="btn btn--sepet" href="/yonetim/urunler/yeni"><PIkon ad="arti" boyut={18} />Yeni ürün</a>
  </div>
  <div class="y-metrics y-metrics--finans">
    <a class="y-metric" href="?filtre=tumu"><PIkon ad="kutu" /><span>Toplam ürün</span><strong>{m.urunler.length}</strong><small>Katalogdaki tüm kayıtlar</small></a>
    <a class="y-metric y-metric--yesil" href="?filtre=yayinda"><PIkon ad="tik-daire" /><span>Yayında</span><strong>{m.urunler.filter((u) => u.durum === 'yayinda').length}</strong><small>Müşteri görüyor · depoda {toplamStok} adet</small></a>
    <a class="y-metric y-metric--turuncu" href="?filtre=kritik"><PIkon ad="uyari" /><span>Azalan / tükenen stok</span><strong>{azalan}</strong><small>{tukenenSayisi} tükendi · {azalan - tukenenSayisi} azalıyor · eşik {envanter.kritikVarsayilan}</small></a>
    <a class="y-metric" href="?filtre=taslak"><PIkon ad="kalem" /><span>Taslak</span><strong>{m.urunler.filter((u) => u.durum === 'taslak').length}</strong><small>Yayın dışı</small></a>
  </div>
  <BilgiKutusu baslik="Stok nasıl artar, nasıl azalır?" anahtar="urunler-stok" acik={false}>
    <p>Stok <strong>tek</strong> sayıdır: web sitesi, Trendyol ve Hepsiburada aynı depodan satar.</p>
    <ul>
      <li><strong>Azalır:</strong> web siparişinin ödemesi alınınca, Trendyol/Hepsiburada siparişi gelince (kendiliğinden).</li>
      <li><strong>Geri artar:</strong> sipariş iptal olunca (kendiliğinden). İade gelince ürünü kontrol edin; siparişin sayfasında iadeyi kaydedince (Trendyol/Hepsiburada’da “Satılabilir” seçince) stoğa eklenir.</li>
      <li><strong>Elle:</strong> yeni mal gelince ya da sayım yapınca “Hızlı düzenle” ile stok sayısını yazın.</li>
    </ul>
    <p>Her değişiklik sebebiyle birlikte aşağıdaki <a class="y-link" href="#stok-gecmisi">Stok hareketleri</a> listesine yazılır.</p>
  </BilgiKutusu>
  <form method="get" class="y-toolbar" data-filtre-form="urun">
    <input class="y-girdi" name="q" type="search" value={soru} placeholder="Ürün, marka, SKU veya barkod" aria-label="Ürün ara" />
    <select class="y-girdi" name="filtre" aria-label="Ürün filtresi">
      {Object.entries({
        tumu: 'Tümü',
        ...YAYIN_ADLARI,
        kritik: `Azalan / tükenen stok (${azalan})`,
        barkod: `Barkodu eksik (${barkodsuz})`,
        ...(fotosuz > 0 ? { fotosuz: `Fotoğrafı eksik (${fotosuz})` } : {}),
        ...(fiyatsiz > 0 ? { fiyatsiz: `Fiyatı girilmemiş (${fiyatsiz})` } : {}),
      }).map(([id, ad]) => <option value={id} selected={filtre === id}>{ad}</option>)}
    </select>
    {m.kategoriler.length > 0 && <select class="y-girdi" name="kategori" aria-label="Kategori">
      <option value="">Tüm kategoriler</option>
      {m.kategoriler.map((c) => <option value={c.id} selected={kategori === c.id}>{c.ad}</option>)}
    </select>}
    <select class="y-girdi" name="sira" aria-label="Ürün sıralaması">{Object.entries({ katalog: 'Katalog sırası', stok: 'En az stok', fiyat: 'En düşük fiyat', ad: 'Ürün adı' }).map(([id, ad]) => <option value={id} selected={sira === id}>{ad}</option>)}</select>
    <button class="btn btn--cizgi" type="submit"><PIkon ad="filtre" boyut={17} />Uygula</button>
  </form>
  {filtre === 'barkod' && <p class="y-help">Yayındaki ürünlerin barkodunu Detaylar → Teknik özellikler bölümüne “Barkod (EAN)” olarak girin.</p>}
  {liste.length ? <div class="y-liste-detay" data-panel-secim>
  <div class="y-liste-ana y-tablo-kap y-tablo-kap--kart urun-tablo"><table class="y-tablo"><thead><tr><th>Ürün</th><th>Fiyat</th><th>İndirim</th><th>Depo stoku</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>
    {liste.map((u) => { const fiyat = k.fiyatBilgisi(u); return (
      <tr id={'u-' + u.id}>
        <td class="urun-hucre"><div class="y-tablo-urun"><span class="y-tablo-urun__gorsel">{u.gorseller[0] && <img src={u.gorseller[0].src} alt="" loading="lazy" />}</span><span><a class="y-link" href={'/yonetim/urunler/' + u.id}>{u.marka} {u.kisaAd}</a><small class="y-table-note">{u.gorseller.length ? u.sku : 'Fotoğraf eksik'}</small></span></div></td>
        <td class="y-nowrap" data-etiket="Fiyat">{fiyatGirilmedi(u) ? <span class="y-stok-rozet y-stok-rozet--kritik">Fiyat girilmedi</span> : <strong>{formatTL(u.fiyat)}</strong>}{fiyat.onceki && <small class="y-table-note"><s>{formatTL(fiyat.onceki)}</s></small>}</td>
        <td data-etiket="İndirim">{fiyat.yuzde ? <span>%{fiyat.yuzde} fiyat indirimi</span> : null}{fiyat.sepette && <small class="y-table-note">Sepette %{fiyat.sepette.yuzde} · {formatTL(fiyat.sepette.fiyat)}</small>}{!fiyat.yuzde && !fiyat.sepette && '—'}</td>
        <td data-etiket="Depo stoku" class="y-stok-hucre"><span class={'y-stok-rozet y-stok-rozet--' + stokGorunumu(u)[1]} title={stokYazisi(u)}>{stokGorunumu(u)[0]}</span>{u.durum === 'yayinda' && <small class="y-table-note">Uyarı eşiği: {esik(u.id)} adet</small>}</td><td data-etiket="Durum"><span class={'y-yayin-rozet y-yayin-rozet--' + u.durum}>{YAYIN_ADLARI[u.durum]}</span>{u.durum !== 'yayinda' && <small class="y-table-note">Müşteri görmüyor</small>}</td>
        <td class="urun-islem"><div class="y-row-actions">
          <a class="btn btn--cizgi" href={url(duzenle === u.id ? undefined : u.id)} data-astro-prefetch="false" data-panel-sec={'urun-hizli-' + u.id} aria-controls={'urun-hizli-' + u.id} aria-expanded={duzenle === u.id ? 'true' : 'false'}>Hızlı düzenle</a>
          <details class="y-row-menu y-row-menu--sag"><summary aria-label="Ürün işlemleri">•••</summary><div>
          <a href={'/yonetim/urunler/' + u.id}>Ürünü düzenle</a>
          {skuGecerli(u.sku) && <a href={'/yonetim/finans/etiket?sku=' + encodeURIComponent(u.sku)} target="_blank" rel="noopener">SKU etiketi</a>}
          <form method="post" class="y-satir-form">
            <input type="hidden" name="id" value={u.id} />
            {u.durum === 'yayinda'
              ? <button class="btn btn--cizgi btn--kucuk" name="eylem" value="gizle" data-onayla={`"${u.kisaAd}" yayından kaldırılsın mı? Sitede görünmez olur, silinmez.`}>Yayından kaldır</button>
              : <button class="btn btn--kucuk y-yayinla-btn" name="eylem" value="yayinla">Yayına al</button>}
            <button class="y-link y-link--tehlike" name="eylem" value="sil" data-onayla={`"${u.marka} ${u.kisaAd}" KALICI olarak silinsin mi? Fotoğrafları da silinir, geri alınamaz.`}>Sil</button>
          </form>
          </div></details></div></td>
      </tr>
    ); })}
  </tbody></table></div>
  <aside class="y-kart y-liste-secim y-urun-secim" aria-label="Hızlı ürün düzenleme">
    <div data-panel-bos hidden={acikEditor}>
      <h2><PIkon ad="kalem" /> Hızlı düzenleme</h2>
      <p class="y-help">Bir ürünün <strong>Hızlı düzenle</strong> düğmesine basarak fiyatını, depo stokunu ve sepet indirimini listeden ayrılmadan güncelleyin.</p>
    </div>
    {liste.map((u) => {
      const ayrilan = ayrilanMap.get(u.id) ?? 0;
      const satilabilir = Math.max(0, u.stok - ayrilan);
      const bagliKanallar = KANAL_LISTESI.filter((kn) => envanter.kanallar[kn].urunler[u.id]?.kod);
      return <section id={'urun-hizli-' + u.id} data-panel-kayit hidden={duzenle !== u.id}>
        <div class="y-kart__bas"><h2><PIkon ad="kalem" /> Hızlı düzenleme</h2><a href={url()} class="y-icon-button" data-astro-prefetch="false" data-panel-kapat aria-label="Hızlı düzenlemeyi kapat"><Ikon ad="kapat" boyut={17} /></a></div>
        <div class="urun-hizli-baslik">
          {u.gorseller[0] ? <img src={u.gorseller[0].src} alt="" width="48" height="48" loading="lazy" /> : <span class="y-kalem-gorsel--yok"><PIkon ad="kutu" boyut={20} /></span>}
          <div>
            <strong>{u.marka} {u.kisaAd}</strong>
            <small class="y-table-note">SKU: {u.sku || '—'} · <span class={'y-yayin-rozet y-yayin-rozet--' + u.durum}>{YAYIN_ADLARI[u.durum]}</span></small>
          </div>
        </div>
        <dl class="urun-hizli-stoklar">
          <div><dt>Depo stoku</dt><dd>{u.stok} adet</dd></div>
          <div><dt>Ayrılan (web)</dt><dd>{ayrilan} adet</dd></div>
          <div><dt>Satılabilir</dt><dd>{satilabilir} adet</dd></div>
        </dl>
        <form method="post" class="y-izgara" data-editor>
          <input type="hidden" name="id" value={u.id} /><input type="hidden" name="eskiStok" value={u.stok} /><input type="hidden" name="eskiFiyat" value={u.fiyat} />
          <label class="y-alan">Satış fiyatı (TL)<input name="fiyat" type="number" min="1" step="1" inputmode="numeric" required value={String((duzenle === u.id ? form?.get('fiyat') : undefined) ?? u.fiyat)} /></label>
          <label class="y-alan">Depo stoku (adet)<input name="stok" type="number" min="0" required value={String((duzenle === u.id ? form?.get('stok') : undefined) ?? u.stok)} /></label>
          <label class="y-alan">Sepette indirim (%)<input name="sepetteIndirim" min="0" max="50" type="number" required value={String((duzenle === u.id ? form?.get('sepetteIndirim') : undefined) ?? u.sepetteIndirim)} /></label>
          <p class="y-bilgi-satiri urun-hizli-not"><PIkon ad="bilgi" boyut={16} /><span>{bagliKanallar.length ? `Bu ürün ${bagliKanallar.map((kn) => KANALLAR[kn]).join(' ve ')} kanalına bağlı. Fiyat/stok kaydı sonrası bağlı kanallara otomatik eşitleme başlatılır.` : 'Bu ürün henüz hiçbir pazaryeri ilanına bağlanmamış; değişiklik yalnız web sitesine yansır.'} <a class="y-link" href="/yonetim/siparisler/kanallar#eslestirmeler">Ürün eşleştirme</a></span></p>
          <div class="y-ust-aksiyonlar"><a class="btn btn--cizgi" href={'/yonetim/urunler/' + u.id}>Tüm alanları düzenle</a><button class="btn btn--sepet" type="submit">Değişiklikleri kaydet</button></div>
        </form>
      </section>;
    })}
    {kritikUrunler.length > 0 && <div class="urun-yan-uyarilar">
      <h3><PIkon ad="uyari" boyut={17} /> Stok uyarıları ({kritikUrunler.length})</h3>
      <ul>{kritikUrunler.slice(0, 5).map((u) => <li>
        <a href={'/yonetim/urunler/' + u.id + '?bolum=fiyat'}>{u.marka} {u.kisaAd}</a>
        <span class:list={['y-chip', u.stok === 0 ? 'y-chip--kirmizi' : 'y-chip--turuncu']}>{u.stok === 0 ? 'Tükendi' : `${u.stok} kaldı`}</span>
      </li>)}</ul>
      <a class="btn btn--cizgi btn--kucuk" href="#stok-gecmisi" data-ac="stok-gecmisi">Tüm stok hareketleri</a>
    </div>}
  </aside>
  </div> : <p class="y-kart muted">Bu görünümde ürün bulunamadı.</p>}
    <div class="y-urun-alt-izgara">
      <section class="y-kart" id="stok-uyari">
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad="zil" /> Stok Uyarı Ayarı</h2>
            <p class="y-kart__alt">Kritik stok eşiği ve e-posta uyarısı (şu an {envanter.kritikVarsayilan} adet).</p>
          </div>
          <span class="y-chip y-chip--altin">Eşik: {envanter.kritikVarsayilan} adet</span>
        </div>
        <form method="post" class="stok-uyari-form">
          <input type="hidden" name="eylem" value="stok-uyari" />
          <label class="y-alan" style="max-width:200px">Stok bu sayıya inince uyar
            <input name="kritikVarsayilan" type="number" min="0" max="1000" required value={envanter.kritikVarsayilan} inputmode="numeric" />
          </label>
          <label class="y-secim" style="padding-bottom:10px"><input type="checkbox" name="epostaBildirimi" checked={envanter.epostaBildirimi} /> Mağaza e-postasına da bildirim gönder</label>
          <button class="btn btn--sepet btn--kucuk" type="submit" style="margin-bottom:4px"><PIkon ad="tik" boyut={15} />Kaydet</button>
        </form>
        <p class="y-help" style="margin:6px 0 0">Bu eşiğin altına düşen ürünler İş Merkezi, Bugünkü İşler ve üstteki Stok Uyarısı kartında listelenir.</p>
      </section>

      <section class="y-kart" id="fiyat-gecmisi">
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad="etiket" /> Fiyat Geçmişi</h2>
            <p class="y-kart__alt">Katalog ürünlerinde yapılan son fiyat güncellemeleri.</p>
          </div>
          <span class="y-chip y-chip--gri">{gecmis.length} kayıt</span>
        </div>
        {gecmis.length ? (
          <div class="y-kaydir-kutu">
            <ul class="y-gecmis">
              {gecmis.slice(0, 15).map((g) => (
                <li>
                  <span>{yTarih.format(new Date(g.tarih))}</span>
                  <span><strong>{g.urunAd}</strong> · {g.eskiFiyat ? <s class="muted">{formatTL(g.eskiFiyat)}</s> : null} {g.eskiFiyat ? '→ ' : ''}<strong>{formatTL(g.yeniFiyat)}</strong></span>
                </li>
              ))}
            </ul>
          </div>
        ) : <p class="muted" style="margin:0">Henüz fiyat değişim kaydı yok.</p>}
      </section>

      <section class="y-kart" id="stok-gecmisi">
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad="gecmis" /> Stok Hareketleri (Son 40)</h2>
            <p class="y-kart__alt">Satış, iptal, iade ve elle yapılan tüm stok değişimleri.</p>
          </div>
          <span class="y-chip y-chip--gri">{hareketler.length} hareket</span>
        </div>
        {hareketler.length ? (
          <div class="y-kaydir-kutu">
            <ul class="y-gecmis stok-defteri">
              {hareketler.map((h) => (
                <li>
                  <span>{yTarih.format(new Date(h.tarih))}</span>
                  <span>
                    <strong>{urunAdi.get(h.urunId) ?? h.urunId}</strong> · {h.onceki} → {h.sonraki}
                    <b class:list={['stok-fark', h.sonraki < h.onceki ? 'stok-fark--eksi' : 'stok-fark--arti']}>{h.sonraki > h.onceki ? '+' : ''}{h.sonraki - h.onceki}</b>
                    <small class="y-table-note">{stokSebebi(h.sebep)}</small>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ) : <p class="muted" style="margin:0">Henüz stok hareketi kaydı yok.</p>}
      </section>

      <section class="y-kart" id="urun-satis-raporu">
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad="grafik" /> Ürün Satış Özeti (Web Sitesi)</h2>
            <p class="y-kart__alt">Ürün bazında onaylı, kargolanan, bekleyen ve iptal adetleri.</p>
          </div>
        </div>
        <div class="y-kaydir-kutu">
          <div class="y-tablo-kap">
            <table class="y-tablo">
              <thead><tr><th>Ürün</th><th class="y-sayi">Onaylı</th><th class="y-sayi">Kargoda/Teslim</th><th class="y-sayi">Bekleyen</th><th class="y-sayi">İptal/İade</th></tr></thead>
              <tbody>
                {rapor.map((r) => (
                  <tr>
                    <td><strong>{r.urun.kisaAd}</strong></td>
                    <td class="y-sayi"><strong>{r.onayliAdet}</strong></td>
                    <td class="y-sayi">{r.kargolananAdet}</td>
                    <td class="y-sayi">{r.bekleyenAdet}</td>
                    <td class="y-sayi">{r.iptalAdet}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
</Yonetim>

<style>
  .y-urun-alt-izgara { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 18px; align-items: start; }
  .y-urun-alt-izgara > .y-kart { margin: 0; }
  .y-kaydir-kutu { max-height: 290px; overflow: auto; padding-right: 4px; }
  @media (max-width: 1080px) { .y-urun-alt-izgara { grid-template-columns: 1fr; } }
  .urun-tablo .urun-hucre { min-width: 220px; white-space: normal; overflow-wrap: break-word; }
  .urun-tablo :is(td[data-etiket="İndirim"], td[data-etiket="Depo stoku"], td[data-etiket="Durum"], small.y-table-note) { white-space: normal; overflow-wrap: break-word; }
  .urun-tablo .urun-islem { width: 1%; white-space: nowrap; }
  .stok-defteri li { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); justify-content: start; align-items: baseline; text-align: left; }
  .stok-defteri li > span:first-child { color: var(--ink-3); white-space: nowrap; }
  @media (max-width: 600px) { .stok-defteri li { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
  /* Telefonda ürün tablosu kart olur (yatay kaydırma yok): ürün adı üstte, fiyat/indirim/stok/durum ikişer, işlemler altta */
  @media (max-width: 760px) {
    :global(.y-panel) .urun-tablo .urun-hucre, :global(.y-panel) .urun-tablo .urun-islem { grid-column: 1 / -1; }
    :global(.y-panel) .urun-tablo .urun-islem { padding-top: 8px; border-top: 1px solid var(--y-border); }
    :global(.y-panel) .urun-tablo .y-row-actions { align-items: center; gap: 8px 16px; }
  }
  .stok-fark { display: inline-block; min-width: 34px; margin-left: 6px; padding: 0 6px; border-radius: 999px; font-size: 12px; text-align: center; }
  .stok-fark--eksi { background: var(--y-kirmizi-zemin); color: var(--y-kirmizi); }
  .stok-fark--arti { background: var(--y-yesil-zemin); color: var(--y-yesil); }
  .stok-uyari-form { display: flex; flex-wrap: wrap; align-items: end; gap: 10px 14px; margin: 6px 0 8px; }
  .stok-uyari-form .y-alan { max-width: 220px; }
  .stok-uyari-onay { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; }
  .urun-hizli-baslik { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .urun-hizli-baslik img { width: 48px; height: 48px; border-radius: 10px; object-fit: contain; background: #faf7f2; border: 1px solid var(--y-border); }
  .urun-hizli-stoklar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin: 0 0 12px; }
  .urun-hizli-stoklar div { padding: 8px 10px; border-radius: 10px; background: var(--y-surface-2); border: 1px solid var(--y-border); }
  .urun-hizli-stoklar dt { font-size: 12px; color: var(--y-muted); }
  .urun-hizli-stoklar dd { margin: 2px 0 0; font-weight: 750; font-size: 14px; }
  .urun-hizli-not { margin: 4px 0 !important; font-size: 13px !important; }
  .urun-yan-uyarilar { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--y-border); display: grid; gap: 8px; justify-items: start; }
  .urun-yan-uyarilar h3 { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 15px; }
  .urun-yan-uyarilar ul { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; gap: 6px; }
  .urun-yan-uyarilar li { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--y-border); font-size: 13.5px; }
  .urun-yan-uyarilar li a { color: var(--y-ink); text-decoration: none; font-weight: 600; }
  .urun-yan-uyarilar li a:hover { text-decoration: underline; }
</style>
