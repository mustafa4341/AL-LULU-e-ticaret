---
/**
 * Bugünkü İşler rotası artık İş Merkezi (`/yonetim#otomasyon`) ile birleştirilmiştir.
 * Geriye dönük uyumluluk ve tek-sahip mutasyon ilkesi gereği:
 *  - POST (`eylem="ayarlar"` ve `eylem="hepsi"`) aynen çalışmaya devam eder ve güvenli `geri` adresine döner.
 *  - GET istekleri bildirim parametrelerini koruyarak `/yonetim#otomasyon` adresine yönlendirilir.
 */
import { DogrulamaHatasi } from '../../lib/depo';
import { evet, metin } from '../../lib/form';
import { yonetimGeriAdresi } from '../../lib/istek';
import { otomatikIsler } from '../../lib/otomasyon';
import { KANALLAR, KANAL_LISTESI } from '../../lib/pazaryeri';
import { pazaryeriApiDurumu } from '../../lib/pazaryeriApi';
import { envanterAyarlariGuncelle } from '../../lib/pazaryeriDepo';
import { pazaryeriSenkron } from '../../lib/pazaryeriSenkron';

const OTOMASYON_ANAHTARLARI = [
  'yeniSiparisBildir',
  'otoToplama',
  'faturaYenidenDene',
  'gunlukIsler',
  'otoBagla',
  'otoFiyat',
] as const;

if (Astro.request.method === 'POST') {
  let geriHam = '';
  try {
    const f = await Astro.request.formData();
    geriHam = metin(f, 'geri');
    const eylem = metin(f, 'eylem');
    const bagliKanallar = KANAL_LISTESI.filter((k) => ['canli', 'test'].includes(pazaryeriApiDurumu(k)));

    if (eylem === 'ayarlar') {
      await envanterAyarlariGuncelle((a) => {
        for (const k of OTOMASYON_ANAHTARLARI) a.otomasyon[k] = evet(f, k);
      });
      return Astro.redirect(
        yonetimGeriAdresi(geriHam, Astro.url, '/yonetim', { tur: 'ok', mesaj: 'Otomatik iş ayarları kaydedildi.' }, '#otomasyon'),
        303,
      );
    }

    if (eylem === 'hepsi') {
      const notlar: string[] = [];
      let calismaDurumu = 'Otomatik kontroller çalıştırıldı.';
      if (bagliKanallar.length) {
        const r = await pazaryeriSenkron('panel', true);
        if (r.durum === 'bekliyor') calismaDurumu = 'Eşitleme zaten çalışıyor. Bir dakika sonra yeniden kontrol edin.';
        else if (r.durum === 'kapali') calismaDurumu = 'Eşitleme için kanal kurulumu bekleniyor.';
        else if (r.durum === 'hata') calismaDurumu = 'Kanal işlemlerinde hata oluştu.';
        for (const [k, s] of Object.entries(r.kanallar)) {
          const ad = KANALLAR[k as keyof typeof KANALLAR];
          if (s.hata || s.stokHata) notlar.push(`${ad}: ${[s.hata, s.stokHata].filter(Boolean).join(' ')}`);
          else notlar.push(`${ad}: siparişler alındı${s.siparis ? ` (${s.siparis} yeni/güncel)` : ''}${s.stok !== undefined ? `, ${s.stok} ilanın stoğu güncellendi` : ''}.`);
        }
        notlar.push(...(r.otomasyon ?? []));
      } else {
        notlar.push(...(await otomatikIsler({ gunlukZorla: true, sureMs: 40_000 })));
      }
      const mesaj = [calismaDurumu, ...notlar].join(' · ').slice(0, 1500);
      return Astro.redirect(
        yonetimGeriAdresi(geriHam, Astro.url, '/yonetim', { tur: 'ok', mesaj }, '#otomasyon'),
        303,
      );
    }

    throw new DogrulamaHatasi(['Geçersiz işlem.']);
  } catch (e) {
    const mesaj = e instanceof DogrulamaHatasi ? e.hatalar.join(' ') : e instanceof Error ? e.message : 'İşlem tamamlanamadı.';
    return Astro.redirect(
      yonetimGeriAdresi(geriHam, Astro.url, '/yonetim', { tur: 'hata', mesaj }, '#otomasyon'),
      303,
    );
  }
}

const hedef = new URL('/yonetim', Astro.url.origin);
for (const k of ['ok', 'hata']) {
  const v = Astro.url.searchParams.get(k);
  if (v) hedef.searchParams.set(k, v);
}
return Astro.redirect(hedef.pathname + hedef.search + '#otomasyon', 302);
---
