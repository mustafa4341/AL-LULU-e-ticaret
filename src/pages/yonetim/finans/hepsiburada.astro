---
import Yonetim from '../../../layouts/Yonetim.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { magazaOku } from '../../../lib/depo';
import { finansGunu, finansPara, paraOku, type HbUrunAyar } from '../../../lib/finans';
import { finansOku, hbAyarKaydet, hbFinansKaydet, hbUrunKaydet } from '../../../lib/finansDepo';
import { metin } from '../../../lib/form';
import {
  HB_KATEGORILER, KARGO_FIRMALARI, KARGO_TABLO_TARIHI, ODEME_VADESI_IS_GUNU, hbKategori, hedefFiyat,
  isGunuEkle, kargoUstSiniri, kategoriOnerisi, satisHesabi,
} from '../../../lib/hepsiburadaTarife';
import { HB_GRUPLAR, hbGercekOrtalamalar, hbKayitOku, hbOzet, hbPerformansOku, hbSiparisMutabakati, type HbGrup } from '../../../lib/hepsiburadaFinans';
import { PazaryeriApiHatasi, hepsiburadaFinansCek, pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { hbKomisyonlariniGuncelle } from '../../../lib/hepsiburadaKomisyon';
import { kanalHedefFiyati } from '../../../lib/pazaryeri';
import { envanterAyarlariOku } from '../../../lib/pazaryeriDepo';

const q = { get: (k: string) => Astro.url.searchParams.get(k) || null };
let hatalar: string[] = [];
/** "3,5" → 3.5 ; boşsa undefined */
const ondalik = (v: string | null) => {
  const s = (v ?? '').trim().replace(/\s/g, '').replace(',', '.');
  if (!s) return undefined;
  const n = Number(s);
  return Number.isFinite(n) ? n : NaN;
};
const yuzdeBp = (v: string | null) => { const n = ondalik(v); return n === undefined || Number.isNaN(n) ? undefined : Math.round(n * 100); };
const tlKurus = (v: string | null) => { const s = (v ?? '').trim(); return s ? paraOku(s) : undefined; };
const geri = (ek: Record<string, string>) => Astro.redirect('/yonetim/finans/hepsiburada?' + new URLSearchParams(ek), 303);
const hesapParametreleri = (f: FormData) => Object.fromEntries(['urun', 'fiyat', 'kategori', 'oran', 'desi', 'kdv', 'maliyet', 'hedef'].map((k) => [k, metin(f, k)]).filter(([, v]) => v));

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const eylem = metin(f, 'eylem');
  try {
    if (eylem === 'ayar-kaydet') {
      const stopaj = yuzdeBp(metin(f, 'stopaj'));
      if (stopaj === undefined || Number.isNaN(stopaj) || stopaj < 0 || stopaj > 1000) throw new Error('Stopaj oranını % olarak girin (ör. 1).');
      const firma = metin(f, 'kargoFirmasi');
      if (firma && !KARGO_FIRMALARI.some((k) => k.kod === firma)) throw new Error('Kargo firmasını listeden seçin.');
      await hbAyarKaydet({ kargoFirmasi: firma, islemBedeli: tlKurus(metin(f, 'islemBedeli')) ?? 0, hizmetBedeli: tlKurus(metin(f, 'hizmetBedeli')) ?? 0, stopajBp: stopaj });
      return geri({ ...hesapParametreleri(f), ok: 'Hepsiburada ayarları kaydedildi.' });
    }
    if (eylem === 'urun-kaydet') {
      const urunId = metin(f, 'urun');
      const m = await magazaOku();
      if (!m.urunler.some((u) => u.id === urunId)) throw new Error('Kaydetmek için listeden bir ürün seçin.');
      const desi = ondalik(metin(f, 'desi'));
      if (desi === undefined || Number.isNaN(desi) || desi < 0 || desi > 4500) throw new Error('Desi 0 ile 4500 arasında olmalı.');
      const kategori = metin(f, 'kategori');
      const oran = yuzdeBp(metin(f, 'oran'));
      if (kategori !== 'elle' && !hbKategori(kategori)) throw new Error('Hepsiburada kategorisini seçin.');
      if (kategori === 'elle' && (oran === undefined || Number.isNaN(oran) || oran <= 0 || oran > 5000)) throw new Error('Komisyon oranını % olarak girin.');
      const kdv = Number(metin(f, 'kdv'));
      if (![0, 1, 10, 20].includes(kdv)) throw new Error('Ürün KDV oranını seçin.');
      const ayar: HbUrunAyar = { kategori, desi, kdv, maliyet: tlKurus(metin(f, 'maliyet')), oranBp: kategori === 'elle' ? oran : undefined };
      await hbUrunKaydet(urunId, ayar);
      return geri({ ...hesapParametreleri(f), ok: 'Ürünün Hepsiburada bilgileri kaydedildi.' });
    }
    if (eylem === 'komisyon-cek') {
      const r = await hbKomisyonlariniGuncelle(40_000);
      const parcalar = [
        r.guncellenen.length ? `${r.guncellenen.length} ürünün komisyon oranı Hepsiburada’dan alındı (${r.guncellenen.slice(0, 5).map((g) => `${g.ad} %${(g.yeni / 100).toLocaleString('tr-TR')}`).join(', ')}${r.guncellenen.length > 5 ? '…' : ''}).` : 'Sitedeki ürünlerle eşleşen Hepsiburada ilanı bulunamadı.',
        r.eslesmeyenIlanlar.length ? `Hepsiburada’da sitedeki ürüne bağlanmamış ${r.eslesmeyenIlanlar.length} ilan var (satıcı stok kodları: ${r.eslesmeyenIlanlar.slice(0, 6).map((i) => i.merchantSku).join(', ')}${r.eslesmeyenIlanlar.length > 6 ? '…' : ''}). Satış kanalları › Ürün eşleştirme’de bu kodlarla bağlayın.` : '',
      ].filter(Boolean);
      return Astro.redirect('/yonetim/finans/hepsiburada?' + new URLSearchParams({ [r.guncellenen.length ? 'ok' : 'hata']: parcalar.join(' ') }) + '#komisyonlar', 303);
    }
    if (eylem === 'cek') {
      const gun = Number(metin(f, 'gun'));
      if (![30, 60, 90].includes(gun)) throw new Error('Geçersiz dönem.');
      const son = Date.now();
      const bas = son - gun * 86_400_000;
      const ham = await hepsiburadaFinansCek(bas, son, AbortSignal.timeout(50_000));
      const kayitlar = ham.kayitlar.map(hbKayitOku);
      const performans = ham.performans.map(hbPerformansOku);
      const okunamayan = kayitlar.filter((x) => !x).length + performans.filter((x) => !x).length;
      await hbFinansKaydet(kayitlar.filter((x) => !!x), performans.filter((x) => !!x), { bas: new Date(bas).toISOString(), son: new Date(son).toISOString() });
      const mesaj = `${kayitlar.length} muhasebe kaydı ve ${performans.length} sipariş satırı alındı.`
        + (okunamayan ? ` ${okunamayan} satır okunamadı; bu satırlar toplamlara girmedi, Hepsiburada ekstresiyle karşılaştırın.` : '');
      return geri(okunamayan ? { hata: mesaj } : { ok: mesaj });
    }
    throw new Error('Geçersiz işlem.');
  } catch (e) {
    hatalar = [e instanceof PazaryeriApiHatasi ? e.message + ' Hepsiburada bağlantı bilgilerini ve servis yetkisini kontrol edin.'
      : e instanceof Error && e.name !== 'ZodError' ? e.message : 'Girilen değerleri kontrol edin.'];
  }
}

const [finans, magaza] = await Promise.all([finansOku(), magazaOku()]);
const urunler = [...magaza.urunler].sort((a, b) => a.ad.localeCompare(b.ad, 'tr'));
const ayar = finans.hbAyar;
const apiDurumu = pazaryeriApiDurumu('hepsiburada');
const gercek = hbGercekOrtalamalar(finans.hepsiburada);

/* ---- Hesap makinesi girdileri: URL > ürünün kayıtlı bilgisi > ürün/kategori varsayılanı ---- */
const secili = urunler.find((u) => u.id === q.get('urun'));
const kayitli = secili ? finans.hbUrunler[secili.id] : undefined;
const kategori = q.get('kategori') ?? kayitli?.kategori ?? (secili ? kategoriOnerisi(secili.kategoriler) : 'zuccaciye');
const oranGirdi = q.get('oran') ?? (kayitli?.oranBp !== undefined ? String(kayitli.oranBp / 100).replace('.', ',') : '');
const oranBp = kategori === 'elle' ? yuzdeBp(oranGirdi) : hbKategori(kategori)?.oranBp;
const fiyatGirdi = q.get('fiyat') ?? (secili ? String(secili.fiyat).replace('.', ',') : '');
const desiGirdi = q.get('desi') ?? (kayitli ? String(kayitli.desi).replace('.', ',') : '');
const kdv = Number(q.get('kdv') ?? kayitli?.kdv ?? 20);
const maliyetGirdi = q.get('maliyet') ?? (kayitli?.maliyet !== undefined ? (kayitli.maliyet / 100).toFixed(2).replace('.', ',') : '');
const hedefGirdi = q.get('hedef') ?? '';
let hesap: ReturnType<typeof satisHesabi> | undefined;
let hedef: number | undefined;
let basaBas: number | undefined;
const eksikler: string[] = [];
try {
  const fiyat = tlKurus(fiyatGirdi);
  const desi = ondalik(desiGirdi);
  const maliyet = tlKurus(maliyetGirdi);
  if (fiyat === undefined) eksikler.push('satış fiyatı');
  if (desi === undefined || Number.isNaN(desi)) eksikler.push('desi');
  if (oranBp === undefined || Number.isNaN(oranBp)) eksikler.push('komisyon oranı');
  if (!ayar.kargoFirmasi) eksikler.push('kargo firması (Ayarlar)');
  if (!eksikler.length && fiyat !== undefined && desi !== undefined && oranBp !== undefined) {
    const girdi = { oranBp, urunKdv: [0, 1, 10, 20].includes(kdv) ? kdv : 20, desi, kargoFirmasi: ayar.kargoFirmasi, islemBedeli: ayar.islemBedeli, hizmetBedeli: ayar.hizmetBedeli, stopajBp: ayar.stopajBp, maliyet };
    hesap = satisHesabi({ ...girdi, fiyat });
    const hedefKurus = tlKurus(hedefGirdi);
    if (hedefKurus !== undefined) hedef = hedefFiyat(girdi, hedefKurus);
    basaBas = hedefFiyat(girdi, 0);
  }
} catch (e) {
  hatalar.push((e as Error).message);
}
const vadeOrnegi = isGunuEkle(new Date(), ODEME_VADESI_IS_GUNU);

/* ---- Ürün başına komisyon ve net kâr (25.11.2026): her ürün kendi oranı + alış maliyetiyle ---- */
const hbKanal = await envanterAyarlariOku().then((a) => a.kanallar.hepsiburada, () => undefined);
const komisyonSatirlari = magaza.urunler
  .filter((u) => u.durum === 'yayinda' && hbKanal?.urunler[u.id]?.satista !== false)
  .map((u) => {
    const a = finans.hbUrunler[u.id];
    const oran = a ? (a.kategori === 'elle' ? a.oranBp : hbKategori(a.kategori)?.oranBp) : hbKategori(kategoriOnerisi(u.kategoriler))?.oranBp;
    const fiyat = Math.round(kanalHedefFiyati(u, hbKanal).hedef * 100);
    const girdi = oran === undefined ? undefined : {
      oranBp: oran, urunKdv: a?.kdv ?? 20, desi: a?.desi ?? 3, kargoFirmasi: ayar.kargoFirmasi,
      islemBedeli: ayar.islemBedeli, hizmetBedeli: ayar.hizmetBedeli, stopajBp: ayar.stopajBp, maliyet: a?.maliyet,
    };
    const h = girdi ? satisHesabi({ ...girdi, fiyat }) : undefined;
    const kaynak = a?.oranKaynak === 'hepsiburada' ? `Hepsiburada’dan okundu${a.oranTarih ? ' · ' + new Intl.DateTimeFormat('tr-TR', { dateStyle: 'medium', timeZone: 'Europe/Istanbul' }).format(new Date(a.oranTarih)) : ''}`
      : a?.oranKaynak === 'elle' ? 'Satıcı panelinden elle girildi' : a?.kategori === 'elle' ? undefined : 'Kategori tablosundaki genel oran (gerçek oran farklı olabilir)';
    return { id: u.id, ad: `${u.marka} ${u.kisaAd}`, oranBp: oran, vadeGun: a?.vadeGun, maliyet: a?.maliyet, fiyat, kar: h?.netKar, marj: h?.marj, basaBas: girdi ? hedefFiyat(girdi, 0) : undefined, kaynak };
  })
  .sort((x, y) => (x.kar ?? 0) - (y.kar ?? 0));

/* ---- Hepsiburada hesabı (muhasebe servisi) ---- */
const ozet = hbOzet(finans.hepsiburada);
const mutabakat = hbSiparisMutabakati(finans.hepsiburada, finans.hbPerformans);
const farkli = mutabakat.filter((s) => s.fark !== undefined && s.fark !== 0);
const tarihTr = (t?: string) => t ? new Intl.DateTimeFormat('tr-TR', { dateStyle: 'medium', timeZone: 'Europe/Istanbul' }).format(new Date(t)) : '—';
const gunTr = (g: string) => g === 'vadesiz' ? 'Vade bilgisi yok' : new Intl.DateTimeFormat('tr-TR', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(g));
const yuzde = (bp: number) => '%' + (bp / 100).toLocaleString('tr-TR', { maximumFractionDigits: 2 });
const isaretli = (k: number) => (k < 0 ? '−' : '') + finansPara(Math.abs(k));
const sekmeler = [['ozet', 'Özet'], ['belgeler', 'Belgeler'], ['giderler', 'Giderler'], ['trendyol', 'Trendyol'], ['raporlar', 'Raporlar']] as const;
const grupSirasi: HbGrup[] = ['satis', 'iade', 'komisyon', 'kampanya', 'kargo', 'islem', 'hizmet', 'odemeServisi', 'ceza', 'reklam', 'kdv', 'stopaj', 'diger'];
const bugun = finansGunu();
/* Sabit kargo tablosu eskidikçe uyarı (denetim AUD-024) */
const tarifeGun = Math.floor((Date.now() - Date.parse(KARGO_TABLO_TARIHI + 'T00:00:00+03:00')) / 864e5);
const tarifeEski = tarifeGun > 90;
---
<Yonetim baslik="Hepsiburada Finans ve Hakediş" altBaslik="Hepsiburada hakedişlerinizi, sipariş mutabakatını ve ürün bazlı net kâr simülasyonunu tek ekrandan yönetin." aktif="finans" basari={q.get('ok')} hatalar={[...hatalar, ...(q.get('hata') ? [q.get('hata')!] : [])]}>
  <KanalLogo slot="baslik-onu" kanal="hepsiburada" boyut="buyuk" />
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/finans"><PIkon ad="ok-sol" boyut={18} />Finans Özeti</a>
    <a class="btn btn--cizgi" href="#hesabim"><PIkon ad="banka" boyut={18} />Hakedişler</a>
    <a class="btn btn--sepet" href="#hesap"><PIkon ad="hedef" boyut={18} />Kâr Hesaplayıcı</a>
  </div>
  <nav class="y-sekmeler y-finans-nav" aria-label="Finans bölümleri">
    {sekmeler.map(([id, ad]) => <a href={'/yonetim/finans?sekme=' + id}>{ad}</a>)}
    <a href="/yonetim/finans/faturalar">Faturalar</a>
    <a href="/yonetim/finans/trendyol-karlilik">Trendyol Kârlılık</a>
    <a href="/yonetim/finans/hepsiburada" aria-current="page">Hepsiburada</a>
  </nav>

  <div class="y-metrics y-metrics--finans" id="hesabim">
    <div class="y-metric y-metric--altin">
      <PIkon ad="sepet" />
      <span>Cari Brüt Satış</span>
      <strong>{finansPara(Math.max(0, ozet.gruplar.satis))}</strong>
      <small>{mutabakat.length} sipariş mutabakat satırı</small>
    </div>
    <div class="y-metric y-metric--kirmizi">
      <PIkon ad="yuzde" />
      <span>Komisyon, Kargo ve Hizmet</span>
      <strong>{isaretli(ozet.gruplar.komisyon + ozet.gruplar.kargo + ozet.gruplar.islem + ozet.gruplar.hizmet + ozet.gruplar.odemeServisi + ozet.gruplar.stopaj)}</strong>
      <small>Platform kesintileri ve stopaj toplamı</small>
    </div>
    <div class="y-metric">
      <PIkon ad="uyari" />
      <span>İade, Kampanya ve Ceza</span>
      <strong>{isaretli(ozet.gruplar.iade + ozet.gruplar.kampanya + ozet.gruplar.ceza + ozet.gruplar.reklam)}</strong>
      <small>İade düşümleri ve kampanya katılımı</small>
    </div>
    <div class="y-metric y-metric--yesil">
      <PIkon ad="para" />
      <span>Toplam Net Hakediş</span>
      <strong>{isaretli(ozet.hakedis)}</strong>
      <small>Ödenen: {isaretli(ozet.odenen)} · Bekleyen: {isaretli(ozet.odenecek)}</small>
    </div>
  </div>

  <div class="hb-iki-sutun" style="margin-bottom:18px">
    <section class="y-kart">
      <div class="y-kart__bas">
        <div>
          <h2><PIkon ad="banka" /> Hepsiburada Hakediş ve Sipariş Mutabakatı</h2>
          <p class="y-kart__alt">Sipariş bazında brüt satış, kesintiler, net hakediş ve ödeme vadesi durumu.</p>
        </div>
        {finans.hbSonCekim && <small class="muted">Son çekim: {tarihTr(finans.hbSonCekim.tarih)}</small>}
      </div>

      {finans.hepsiburada.length > 0 ? <>
        <dl class="y-hesap" style="margin-bottom:14px">
          {grupSirasi.filter((g) => ozet.gruplar[g] !== 0).map((g) => <div class:list={{ eksi: ozet.gruplar[g] < 0 }}><dt>{HB_GRUPLAR[g]}</dt><dd>{isaretli(ozet.gruplar[g])}</dd></div>)}
          <div class="sonuc"><dt>Toplam net hakediş</dt><dd>{isaretli(ozet.hakedis)}</dd></div>
          <div><dt>Bankaya ödenen</dt><dd>{isaretli(ozet.odenen)}</dd></div>
          <div><dt>Vadesi bekleyen</dt><dd>{isaretli(ozet.odenecek)}</dd></div>
          {ozet.gruplar.aktarim > 0 && <div class="alt"><dt>{HB_GRUPLAR.aktarim}</dt><dd>{finansPara(ozet.gruplar.aktarim)}</dd></div>}
        </dl>

        <div class="y-tablo-kap">
          <table class="y-tablo">
            <thead><tr><th>Sipariş</th><th>Tarih</th><th class="y-sayi">Satış</th><th class="y-sayi">Kesintiler</th><th class="y-sayi">Net</th><th class="y-sayi">HB Hakediş</th><th>Vade / Durum</th></tr></thead>
            <tbody>{mutabakat.slice(0, 200).map((s) => <tr>
              <td data-etiket="Sipariş"><strong>{s.siparisNo}</strong>{s.urun && <small class="y-table-note">{s.urun}</small>}</td>
              <td data-etiket="Tarih" class="y-nowrap">{tarihTr(s.tarih)}</td>
              <td data-etiket="Satış" class="y-sayi y-nowrap">{isaretli(s.satis)}</td>
              <td data-etiket="Kesintiler" class="y-sayi y-nowrap">{isaretli(s.kesinti)}</td>
              <td data-etiket="Net" class="y-sayi y-nowrap"><strong>{isaretli(s.kayitToplami)}</strong></td>
              <td data-etiket="HB hakediş" class="y-sayi y-nowrap">{s.hakedis === undefined ? '—' : <span class:list={['y-chip', s.fark === 0 ? 'y-chip--yesil' : 'y-chip--kirmizi']} title={s.fark ? 'Fark: ' + isaretli(s.fark) : 'Aynı'}>{isaretli(s.hakedis)}</span>}</td>
              <td data-etiket="Vade" class="y-nowrap">{s.odendi ? <span class="y-chip y-chip--yesil">Ödendi</span> : <span class="y-chip y-chip--turuncu">{tarihTr(s.vade)}</span>}</td>
            </tr>)}</tbody>
          </table>
        </div>
      </> : (
        <div class="hb-bos-kutu">
          <PIkon ad="banka" boyut={24} />
          <strong>Henüz çekilmiş Hepsiburada hakediş kaydı bulunmuyor.</strong>
          <p>Siparişler teslim edildikten sonra sağdaki <em>Cari Hesap Çekimi</em> kartından dönem seçerek tüm satış, komisyon, kargo kesintisi ve vade tarihlerini tek tıkla getirebilirsiniz.</p>
          <div class="y-ust-aksiyonlar" style="justify-content:center;margin-top:10px">
            <a class="btn btn--cizgi btn--kucuk" href="/yonetim/siparisler?kanal=hepsiburada">Hepsiburada Siparişlerini Gör</a>
            <a class="btn btn--cizgi btn--kucuk" href="/yonetim/siparisler/kanallar?gorunum=hepsiburada">Kanal Ayarları</a>
          </div>
        </div>
      )}
    </section>

    <aside class="hb-yan-sutun">
      <section class="y-kart">
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad="yenile" /> Cari Hesap Çekimi</h2>
            <p class="y-kart__alt">Hepsiburada muhasebe servisinden kayıtları eşitleyin.</p>
          </div>
          {apiDurumu === 'test' && <span class="y-chip y-chip--turuncu">Test ortamı</span>}
        </div>
        {apiDurumu === 'kapali' || apiDurumu === 'eksik' ? (
          <div class="y-veri-not" style="margin:0">
            <PIkon ad="bilgi" boyut={18} />
            <p>
              <strong>API bağlantısı bekleniyor</strong>
              Hepsiburada satıcı entegrasyon bilgileri ve “Muhasebe entegrasyonu” yetkisi tanımlandığında buradan 30/60/90 günlük hakediş çekimi aktif olur.
            </p>
          </div>
        ) : (
          <form method="post" class="y-izgara">
            <input type="hidden" name="eylem" value="cek" />
            <label class="y-alan">Çekilecek dönem
              <select name="gun">
                <option value="30">Son 30 gün</option>
                <option value="60">Son 60 gün</option>
                <option value="90">Son 90 gün</option>
              </select>
            </label>
            <button class="btn btn--sepet" type="submit" style="width:100%;justify-content:center"><PIkon ad="indir" boyut={17} />Şimdi Hepsiburada'dan Çek</button>
          </form>
        )}
      </section>

      <section class:list={['y-kart', farkli.length > 0 ? 'hb-uyari-kart' : '']}>
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad={farkli.length > 0 ? 'uyari' : 'tik'} /> Mutabakat ve Vadeler</h2>
            <p class="y-kart__alt">Ödeme takvimi ve tutar kontrolü.</p>
          </div>
        </div>
        {farkli.length > 0
          ? <p class="y-uyari" style="margin-top:0">{farkli.length} siparişte muhasebe kayıtlarının toplamı Hepsiburada hakediş tutarından farklı. Fark birkaç gün içinde kapanmazsa satıcı ekstresiyle karşılaştırın.</p>
          : mutabakat.some((s) => s.fark === 0)
            ? <p class="y-help" style="margin-top:0">Muhasebe kayıtları Hepsiburada hakediş hesabıyla kuruşu kuruşuna uyumlu.</p>
            : <p class="y-help" style="margin-top:0">Teslimattan {ODEME_VADESI_IS_GUNU} iş günü sonra hakediş ödemesi oluşur (bugün teslim edilse tahmini vade: <strong>{gunTr(vadeOrnegi.toISOString().slice(0, 10))}</strong>).</p>}
        {ozet.vadeler.length > 0 && <>
          <h3>Yaklaşan Ödemeler</h3>
          <ul class="y-task-list">{ozet.vadeler.map(([g, t]) => <li><span>{gunTr(g)}{g !== 'vadesiz' && g < bugun ? ' (vadesi geçti)' : ''}</span><strong>{isaretli(t)}</strong></li>)}</ul>
        </>}
      </section>
    </aside>
  </div>

  <section class="y-kart" id="komisyonlar">
    <div class="y-kart__bas">
      <div>
        <h2><PIkon ad="yuzde" /> Ürün Başına Komisyon ve Net Kâr</h2>
        <p class="y-kart__alt">Her ürünün Hepsiburada’daki kendi komisyon oranıyla: hedef fiyattan satışta elinize kalan ve zarar etmeden inebileceğiniz en düşük fiyat.</p>
      </div>
      <form method="post"><button class="btn btn--cizgi btn--kucuk" name="eylem" value="komisyon-cek" type="submit" disabled={!['canli', 'test'].includes(apiDurumu)} title={['canli', 'test'].includes(apiDurumu) ? 'Hepsiburada Komisyon Bilgisi Sorgulama servisinden okunur' : 'Canlı Hepsiburada API bilgileri tanımlanınca çalışır'}><PIkon ad="yenile" boyut={16} />Komisyonları Hepsiburada’dan çek</button></form>
    </div>
    {!['canli', 'test'].includes(apiDurumu) && <p class="y-help">Hepsiburada bağlantısı kurulunca oranlar her gün kendiliğinden Hepsiburada’dan okunur. Şimdilik satıcı panelinde gördüğünüz oranlar kullanılıyor.</p>}
    {!ayar.kargoFirmasi && <p class="y-uyari">Kargo firması seçilmemiş; kargo ücreti bilinmediği için sahte net kâr gösterilmez. Aşağıdaki “Hepsiburada maliyet ayarları”ndan kargo firmasını seçin.</p>}
    <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo">
      <thead><tr><th>Ürün</th><th class="y-sayi">Komisyon</th><th class="y-sayi">Alış (KDV hariç)</th><th class="y-sayi">Hedef fiyat</th><th class="y-sayi">Satış başı net kâr</th><th class="y-sayi">Zararsız en düşük fiyat</th></tr></thead>
      <tbody>{komisyonSatirlari.map((r) => <tr>
        <td data-etiket="Ürün"><strong>{r.ad}</strong>{r.kaynak && <small class="y-table-note">{r.kaynak}</small>}</td>
        <td data-etiket="Komisyon" class="y-sayi">{r.oranBp !== undefined ? yuzde(r.oranBp) : '—'}{r.vadeGun !== undefined && <small class="y-table-note">{r.vadeGun} gün vade</small>}</td>
        <td data-etiket="Alış" class="y-sayi">{r.maliyet !== undefined ? finansPara(r.maliyet) : <span class="muted">girilmedi</span>}</td>
        <td data-etiket="Hedef fiyat" class="y-sayi">{finansPara(r.fiyat)}</td>
        <td data-etiket="Net kâr" class:list={['y-sayi', r.kar !== undefined && r.kar < 0 ? 'y-yazi-kirmizi' : '']}><strong>{r.kar !== undefined ? isaretli(r.kar) : (!ayar.kargoFirmasi && r.maliyet !== undefined ? 'Kargo seçilmedi' : '—')}</strong>{r.marj !== undefined && <small class="y-table-note">%{(r.marj * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 })} marj</small>}</td>
        <td data-etiket="En düşük fiyat" class="y-sayi">{r.basaBas !== undefined ? finansPara(r.basaBas) : '—'}</td>
      </tr>)}</tbody>
    </table></div>
    <p class="y-help">Net kâr = KDV hariç satış − komisyon − kargo − işlem/hizmet bedeli − alış maliyeti (KDV’ler ve %1 stopaj vergiden mahsup edildiği için düşülmez). Hepsiburada’nın “sepete özel” indirimini siz karşılıyorsanız müşterinin ödediği fiyat düşer; bu indirimle kârı hesaplayıcıda fiyatı düşürerek görün.</p>
  </section>

  <div class="y-hesap-izgara" id="hesap">
  <section class="y-kart">
    <div class="y-kart__bas"><div><h2><PIkon ad="kutu" /> Ürün Kâr ve Başabaş Hesaplayıcı</h2><p class="y-kart__alt">Bu fiyattan satarsam elime ne kalır? Ürünü seçin, eksik bilgileri girin.</p></div></div>
    <form method="get" class="y-izgara" action="#hesap">
      <label class="y-alan">Ürün
        <select name="urun" onchange="this.form.querySelectorAll('[data-urun-bagli]').forEach((e) => { e.disabled = true; }); this.form.submit()">
          <option value="">— Ürün seçmeden hesapla —</option>
          {urunler.map((u) => <option value={u.id} selected={u.id === secili?.id}>{u.ad}{finans.hbUrunler[u.id] ? ' ✓' : ''}</option>)}
        </select>
      </label>
      <div class="y-izgara y-izgara--2">
        <label class="y-alan">Hepsiburada satış fiyatı (KDV dahil, TL)<input name="fiyat" inputmode="decimal" value={fiyatGirdi} placeholder="1.499,90" data-urun-bagli /></label>
        <label class="y-alan">Desi<input name="desi" inputmode="decimal" value={desiGirdi} placeholder="ör. 4" data-urun-bagli /><small class="muted">En × boy × yükseklik (cm) ÷ 3000 ile kilogramdan büyük olanı. Küsurat yukarı yuvarlanır.</small></label>
      </div>
      <div class="y-izgara y-izgara--2">
        <label class="y-alan">Hepsiburada kategorisi
          <select name="kategori" data-urun-bagli>
            {HB_KATEGORILER.map((k) => <option value={k.kod} selected={k.kod === kategori}>{k.ad} — {yuzde(k.oranBp)}</option>)}
            <option value="elle" selected={kategori === 'elle'}>Elle oran gir</option>
          </select>
          <small class="muted">{hbKategori(kategori)?.kapsam ?? 'Satıcı panelinde yazan oranı girin.'}</small>
        </label>
        <label class="y-alan">Elle komisyon oranı (%, KDV hariç)<input name="oran" inputmode="decimal" value={oranGirdi} placeholder="Yalnızca &quot;Elle oran&quot; seçiliyse" data-urun-bagli /></label>
      </div>
      <div class="y-izgara y-izgara--2">
        <label class="y-alan">Ürünün KDV oranı
          <select name="kdv" data-urun-bagli>{[20, 10, 1, 0].map((o) => <option value={o} selected={o === kdv}>%{o}</option>)}</select>
        </label>
        <label class="y-alan">Ürünün alış maliyeti (KDV hariç, TL)<input name="maliyet" inputmode="decimal" value={maliyetGirdi} placeholder="Kâr için gerekli" data-urun-bagli /></label>
      </div>
      <label class="y-alan">Hedeflediğiniz net kâr (TL, isteğe bağlı)<input name="hedef" inputmode="decimal" value={hedefGirdi} placeholder="ör. 150" /></label>
      <div class="y-modal__alt">
        <button class="btn btn--sepet" type="submit"><PIkon ad="hedef" boyut={18} />Hesapla</button>
        {secili && <button class="btn btn--cizgi" type="submit" formmethod="post" name="eylem" value="urun-kaydet"><PIkon ad="tik" boyut={18} />Desi ve maliyeti bu ürün için kaydet</button>}
      </div>
      <p class="y-help" style="margin:4px 0 0">Buradaki satış fiyatı yalnızca kârlılık simülasyonu içindir; mağaza vitrin fiyatını değiştirmez. “Kaydet” düğmesi ürünün desi, kategori, KDV ve alış maliyetini sonraki hesaplamalar için saklar.</p>
    </form>
  </section>

  <section class="y-kart">
    <div class="y-kart__bas"><div><h2><PIkon ad="grafik" /> Hesaplama sonuçları</h2><p class="y-kart__alt">Girdiğiniz bilgilere göre tahmini kârlılık.</p></div></div>
    {eksikler.length > 0 && <p class="y-uyari">Hesap için eksik: {eksikler.join(', ')}.</p>}
    {hesap && <>
      {hesap.kargoBulunamadi && <p class="y-uyari">Seçili kargo firmasının tablosunda bu desi yok (en fazla {kargoUstSiniri(ayar.kargoFirmasi)} desi). Kargo 0 sayıldı; sonucu kullanmayın.</p>}
      <div class="y-sonuc-vurgu">
        <PIkon ad="para" />
        {hesap.netKar !== undefined
          ? <div><span>Tahmini net kâr (birim, gelir/kurumlar vergisi öncesi)</span><strong class:list={{ 'y-negatif': hesap.netKar < 0 }}>{isaretli(hesap.netKar)}</strong></div>
          : <div><span>Hesabınıza yatacak</span><strong>{finansPara(hesap.hesabaYatan)}</strong><small>Net kâr için alış maliyetini girin</small></div>}
      </div>
      <div class="y-sonuc-kutular">
        <div class="y-sonuc-kutu"><PIkon ad="yuzde" boyut={18} /><span>Kâr marjı</span><strong>{hesap.marj !== undefined ? '%' + (hesap.marj * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) : '—'}</strong><small>Net kârın KDV hariç satış tutarına oranı</small></div>
        <div class="y-sonuc-kutu"><PIkon ad="hedef" boyut={18} /><span>Başabaş fiyatı</span><strong>{basaBas !== undefined ? finansPara(basaBas) : '—'}</strong><small>Zarar etmemek için en düşük fiyat</small></div>
        <div class="y-sonuc-kutu"><PIkon ad="trend" boyut={18} /><span>Hedef kâr için fiyat</span><strong>{hedef !== undefined ? finansPara(hedef) : '—'}</strong><small>{hedef !== undefined ? finansPara(tlKurus(hedefGirdi)!) + ' net kâr için' : 'Hedef net kârı girin'}</small></div>
      </div>
      <h3>1. Hepsiburada kesintileri ve hesabınıza yatacak hakediş</h3>
      <dl class="y-hesap">
        <div><dt>Müşterinin ödediği satış fiyatı <small>KDV dahil</small></dt><dd>{finansPara(hesap.kdvHaricSatis + hesap.satisKdv)}</dd></div>
        {hesap.kalemler.map((k) => <div class="eksi"><dt>{k.ad} <small>{finansPara(k.net)} + %20 KDV</small></dt><dd>−{finansPara(k.net + k.kdv)}</dd></div>)}
        <div class="eksi"><dt>E-ticaret stopajı <small>{yuzde(ayar.stopajBp)}, KDV hariç satış üzerinden; yıllık vergiden düşülür</small></dt><dd>−{finansPara(hesap.stopaj)}</dd></div>
        <div class="sonuc"><dt>Hesabınıza yatacak (Hakediş) <small>teslimattan sonra {ODEME_VADESI_IS_GUNU} iş günü (bugün teslim edilse ≈ {gunTr(vadeOrnegi.toISOString().slice(0, 10))})</small></dt><dd>{finansPara(hesap.hesabaYatan)}</dd></div>
      </dl>
      <h3>2. Vergi ve alış maliyeti sonrası net kâr</h3>
      <dl class="y-hesap">
        <div class="alt"><dt>Devlete ödenecek KDV farkı <small>satış KDV'si − kesintilerin KDV'si; ürün alışındaki KDV ayrıca düşülür</small></dt><dd>{finansPara(hesap.kdvFarki)}</dd></div>
        {hesap.netKar !== undefined
          ? <div class="sonuc"><dt>Tahmini net kâr <small>KDV hariç satış − kesintiler − alış maliyeti{hesap.marj !== undefined ? ' · marj %' + (hesap.marj * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) : ''}</small></dt><dd class:list={{ 'y-negatif': hesap.netKar < 0 }}>{isaretli(hesap.netKar)}</dd></div>
          : <div class="alt"><dt>Tahmini net kâr</dt><dd>Hesaplamak için ürün alış maliyetini girin</dd></div>}
      </dl>
      <details class="y-block-gap"><summary>Bu satışta olası Hepsiburada cezaları</summary>
        <ul class="y-task-list">{hesap.cezalar.map((c) => <li><span>{c.ad}</span><span>{finansPara(c.tutar)}</span></li>)}</ul>
        <p class="y-help">Platform kılavuzundaki tablolar. Ayrıca stok yokken iptal edilen ürünün satışı askıya alınabilir; geciken veya tedarik edilemeyen sipariş başka satıcıya kaydırılırsa fiyat farkı size yansıtılır.</p>
      </details>
    </>}
  </section>

  <aside class="y-kart">
    <div class="y-kart__bas"><div><h2><PIkon ad="ayarlar-cubuk" /> Hesaplama varsayımları</h2><p class="y-kart__alt">Bu hesapta kullanılan temel değerler.</p></div></div>
    <ul class="y-varsayim">
      <li><PIkon ad="yuzde" /><span>Platform komisyonu<small>{kategori === 'elle' ? 'Elle girilen oran' : hbKategori(kategori)?.ad ?? 'Kategori seçilmedi'}</small></span><strong>{oranBp !== undefined && !Number.isNaN(oranBp) ? yuzde(oranBp) : '—'}</strong></li>
      <li><PIkon ad="kargo" /><span>Kargo firması<small>Hepsiburada anlaşmalı tablo fiyatı</small></span><strong>{KARGO_FIRMALARI.find((k) => k.kod === ayar.kargoFirmasi)?.ad ?? 'Seçilmedi'}</strong></li>
      <li><PIkon ad="fatura" /><span>İşlem bedeli<small>Sipariş başına, KDV hariç</small></span><strong>{finansPara(ayar.islemBedeli)}</strong></li>
      <li><PIkon ad="kutu" /><span>Hizmet bedeli<small>Ürün başına, KDV hariç</small></span><strong>{finansPara(ayar.hizmetBedeli)}</strong></li>
      <li><PIkon ad="banka" /><span>E-ticaret stopajı<small>KDV hariç satış üzerinden</small></span><strong>{yuzde(ayar.stopajBp)}</strong></li>
      <li><PIkon ad="belge" /><span>Ürün KDV oranı</span><strong>%{kdv}</strong></li>
      <li><PIkon ad="takvim" /><span>Ödeme vadesi<small>Teslimattan sonra</small></span><strong>{ODEME_VADESI_IS_GUNU} iş günü</strong></li>
    </ul>
    {tarifeEski && <p class="y-uyari">Kargo ücret tablosu {tarifeGun} gün önce alındı. Hepsiburada tarifeleri değişmiş olabilir; satıcı panelindeki güncel desi tablosuyla karşılaştırın.</p>}
    <div class="y-veri-not"><PIkon ad="saat" boyut={18} /><p><strong>Veri güncelliği</strong>Komisyon oranları Hepsiburada EK-4 tablosundan, kargo ücretleri {KARGO_TABLO_TARIHI.split('-').reverse().join('.')} tarihli desi tablosundan alındı. Ürünün kesin komisyon oranı Hepsiburada satıcı panelinde ürünün sayfasında yazar; farklıysa kategoriyi "Elle oran" yapın.</p></div>
    {gercek && <p class="y-help">Hepsiburada'nın gerçek kayıtlarına göre (son {gercek.siparis} sipariş): işlem bedeli ort. {finansPara(gercek.islem)}, hizmet bedeli ort. {finansPara(gercek.hizmet)}, komisyon oranı ort. {yuzde(gercek.komisyonBp)} (KDV hariç). Ayarlardaki tutarları bunlarla karşılaştırın.</p>}
    <a class="btn btn--cizgi" href="#ayarlar" data-ac="ayarlar"><PIkon ad="ayar" boyut={18} />Maliyet ayarlarını düzenle</a>
  </aside>
  </div>

  <details class="y-kart" id="ayarlar" open={!ayar.kargoFirmasi}>
    <summary><PIkon ad="ayar" /> <strong>Hepsiburada maliyet ayarları</strong></summary>
    <form method="post" class="y-izgara">
      <input type="hidden" name="eylem" value="ayar-kaydet" />
      {Object.entries(Object.fromEntries(['urun', 'fiyat', 'kategori', 'oran', 'desi', 'kdv', 'maliyet', 'hedef'].map((k) => [k, q.get(k) ?? '']))).filter(([, v]) => v).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <label class="y-alan">Kullandığınız kargo firması
        <select name="kargoFirmasi" required>
          <option value="">Seçin</option>
          {KARGO_FIRMALARI.map((k) => <option value={k.kod} selected={k.kod === ayar.kargoFirmasi}>{k.ad}</option>)}
        </select>
        <small class="muted">Hepsiburada'nın anlaşmalı tablo fiyatı. Kargo destek modelindeki indirimler bu tabloya dahil değildir.</small>
      </label>
      <div class="y-izgara y-izgara--2">
        <label class="y-alan">İşlem bedeli (sipariş başına, KDV hariç, TL)<input name="islemBedeli" inputmode="decimal" value={(ayar.islemBedeli / 100).toFixed(2).replace('.', ',')} /></label>
        <label class="y-alan">Hizmet bedeli (ürün başına, KDV hariç, TL)<input name="hizmetBedeli" inputmode="decimal" value={(ayar.hizmetBedeli / 100).toFixed(2).replace('.', ',')} /></label>
      </div>
      <p class="y-help">Bu iki tutar Hepsiburada'nın paylaştığı belgelerde yok. Sözleşmenizde ya da satıcı panelindeki ekstrede yazan tutarı girin. Muhasebe bağlantısı kurulunca gerçek ortalamalar hesap makinesinin altında görünür.</p>
      <label class="y-alan">E-ticaret stopaj oranı (%)<input name="stopaj" inputmode="decimal" value={(ayar.stopajBp / 100).toLocaleString('tr-TR')} /></label>
      <div class="y-modal__alt"><button class="btn btn--sepet" type="submit">Ayarları kaydet</button></div>
    </form>
  </details>
</Yonetim>
<style>
  .y-negatif { color: #8a2d22; }
  h3 { font-size: 15px; margin: 16px 0 6px; }
  .hb-iki-sutun {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.85fr);
    gap: 16px;
    align-items: start;
  }
  .hb-yan-sutun { display: flex; flex-direction: column; gap: 16px; }
  @media (max-width: 1080px) {
    .hb-iki-sutun { grid-template-columns: 1fr; }
  }
  .hb-bos-kutu {
    text-align: center;
    padding: 28px 20px;
    background: #faf7f2;
    border: 1px dashed #dfd3c3;
    border-radius: 12px;
    color: #6e6256;
  }
  .hb-bos-kutu strong { display: block; color: #2d2218; margin: 8px 0 6px; font-size: 14.5px; }
  .hb-bos-kutu p { margin: 0 auto; max-width: 520px; font-size: 13px; line-height: 1.5; }
  .hb-uyari-kart { border-color: #e6b980 !important; background: #fffaf2 !important; }
</style>
