---
import Yonetim from '../../../layouts/Yonetim.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { magazaOku } from '../../../lib/depo';
import { finansGunu, finansPara, paraOku, type HbUrunAyar } from '../../../lib/finans';
import { finansOku, hbAyarKaydet, hbFinansKaydet, hbUrunKaydet } from '../../../lib/finansDepo';
import { metin } from '../../../lib/form';
import {
  HB_KATEGORILER, KARGO_FIRMALARI, KARGO_TABLO_TARIHI, ODEME_VADESI_IS_GUNU, hbKategori, hedefFiyat,
  isGunuEkle, kargoUstSiniri, kategoriOnerisi, satisHesabi,
} from '../../../lib/hepsiburadaTarife';
import { HB_GRUPLAR, hbGercekOrtalamalar, hbKayitOku, hbOzet, hbPerformansOku, hbSiparisMutabakati, type HbGrup } from '../../../lib/hepsiburadaFinans';
import { PazaryeriApiHatasi, hepsiburadaFinansCek, pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { hbKomisyonlariniGuncelle } from '../../../lib/hepsiburadaKomisyon';
import { kanalHedefFiyati } from '../../../lib/pazaryeri';
import { envanterAyarlariOku } from '../../../lib/pazaryeriDepo';

const q = { get: (k: string) => Astro.url.searchParams.get(k) || null };
let hatalar: string[] = [];
/** "3,5" → 3.5 ; boşsa undefined */
const ondalik = (v: string | null) => {
  const s = (v ?? '').trim().replace(/\s/g, '').replace(',', '.');
  if (!s) return undefined;
  const n = Number(s);
  return Number.isFinite(n) ? n : NaN;
};
const yuzdeBp = (v: string | null) => { const n = ondalik(v); return n === undefined || Number.isNaN(n) ? undefined : Math.round(n * 100); };
const tlKurus = (v: string | null) => { const s = (v ?? '').trim(); return s ? paraOku(s) : undefined; };
const geri = (ek: Record<string, string>) => Astro.redirect('/yonetim/finans/hepsiburada?' + new URLSearchParams(ek), 303);
const hesapParametreleri = (f: FormData) => Object.fromEntries(['urun', 'fiyat', 'kategori', 'oran', 'desi', 'kdv', 'maliyet', 'hedef'].map((k) => [k, metin(f, k)]).filter(([, v]) => v));

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const eylem = metin(f, 'eylem');
  try {
    if (eylem === 'ayar-kaydet') {
      const stopaj = yuzdeBp(metin(f, 'stopaj'));
      if (stopaj === undefined || Number.isNaN(stopaj) || stopaj < 0 || stopaj > 1000) throw new Error('Stopaj oranını % olarak girin (ör. 1).');
      const firma = metin(f, 'kargoFirmasi');
      if (firma && !KARGO_FIRMALARI.some((k) => k.kod === firma)) throw new Error('Kargo firmasını listeden seçin.');
      await hbAyarKaydet({ kargoFirmasi: firma, islemBedeli: tlKurus(metin(f, 'islemBedeli')) ?? 0, hizmetBedeli: tlKurus(metin(f, 'hizmetBedeli')) ?? 0, stopajBp: stopaj });
      return geri({ ...hesapParametreleri(f), ok: 'Hepsiburada ayarları kaydedildi.' });
    }
    if (eylem === 'urun-kaydet') {
      const urunId = metin(f, 'urun');
      const m = await magazaOku();
      if (!m.urunler.some((u) => u.id === urunId)) throw new Error('Kaydetmek için listeden bir ürün seçin.');
      const desi = ondalik(metin(f, 'desi'));
      if (desi === undefined || Number.isNaN(desi) || desi < 0 || desi > 4500) throw new Error('Desi 0 ile 4500 arasında olmalı.');
      const kategori = metin(f, 'kategori');
      const oran = yuzdeBp(metin(f, 'oran'));
      if (kategori !== 'elle' && !hbKategori(kategori)) throw new Error('Hepsiburada kategorisini seçin.');
      if (kategori === 'elle' && (oran === undefined || Number.isNaN(oran) || oran <= 0 || oran > 5000)) throw new Error('Komisyon oranını % olarak girin.');
      const kdv = Number(metin(f, 'kdv'));
      if (![0, 1, 10, 20].includes(kdv)) throw new Error('Ürün KDV oranını seçin.');
      const ayar: HbUrunAyar = { kategori, desi, kdv, maliyet: tlKurus(metin(f, 'maliyet')), oranBp: kategori === 'elle' ? oran : undefined };
      await hbUrunKaydet(urunId, ayar);
      return geri({ ...hesapParametreleri(f), ok: 'Ürünün Hepsiburada bilgileri kaydedildi.' });
    }
    if (eylem === 'komisyon-cek') {
      const r = await hbKomisyonlariniGuncelle(40_000);
      const parcalar = [
        r.guncellenen.length ? `${r.guncellenen.length} ürünün komisyon oranı Hepsiburada’dan alındı (${r.guncellenen.slice(0, 5).map((g) => `${g.ad} %${(g.yeni / 100).toLocaleString('tr-TR')}`).join(', ')}${r.guncellenen.length > 5 ? '…' : ''}).` : 'Sitedeki ürünlerle eşleşen Hepsiburada ilanı bulunamadı.',
        r.eslesmeyenIlanlar.length ? `Hepsiburada’da sitedeki ürüne bağlanmamış ${r.eslesmeyenIlanlar.length} ilan var (satıcı stok kodları: ${r.eslesmeyenIlanlar.slice(0, 6).map((i) => i.merchantSku).join(', ')}${r.eslesmeyenIlanlar.length > 6 ? '…' : ''}). Satış kanalları › Ürün eşleştirme’de bu kodlarla bağlayın.` : '',
      ].filter(Boolean);
      return Astro.redirect('/yonetim/finans/hepsiburada?' + new URLSearchParams({ [r.guncellenen.length ? 'ok' : 'hata']: parcalar.join(' ') }) + '#komisyonlar', 303);
    }
    if (eylem === 'cek') {
      const gun = Number(metin(f, 'gun'));
      if (![30, 60, 90].includes(gun)) throw new Error('Geçersiz dönem.');
      const son = Date.now();
      const bas = son - gun * 86_400_000;
      const ham = await hepsiburadaFinansCek(bas, son, AbortSignal.timeout(50_000));
      const kayitlar = ham.kayitlar.map(hbKayitOku);
      const performans = ham.performans.map(hbPerformansOku);
      const okunamayan = kayitlar.filter((x) => !x).length + performans.filter((x) => !x).length;
      await hbFinansKaydet(kayitlar.filter((x) => !!x), performans.filter((x) => !!x), { bas: new Date(bas).toISOString(), son: new Date(son).toISOString() });
      const mesaj = `${kayitlar.length} muhasebe kaydı ve ${performans.length} sipariş satırı alındı.`
        + (okunamayan ? ` ${okunamayan} satır okunamadı; bu satırlar toplamlara girmedi, Hepsiburada ekstresiyle karşılaştırın.` : '');
      return geri(okunamayan ? { hata: mesaj } : { ok: mesaj });
    }
    throw new Error('Geçersiz işlem.');
  } catch (e) {
    hatalar = [e instanceof PazaryeriApiHatasi ? e.message + ' Hepsiburada bağlantı bilgilerini ve servis yetkisini kontrol edin.'
      : e instanceof Error && e.name !== 'ZodError' ? e.message : 'Girilen değerleri kontrol edin.'];
  }
}

const [finans, magaza, envAyar] = await Promise.all([
  finansOku(),
  magazaOku(),
  envanterAyarlariOku().catch(() => undefined),
]);
const hbKanal = envAyar?.kanallar.hepsiburada;
const urunler = [...magaza.urunler].sort((a, b) => a.ad.localeCompare(b.ad, 'tr'));
const ayar = finans.hbAyar;
const apiDurumu = pazaryeriApiDurumu('hepsiburada');
const gercek = hbGercekOrtalamalar(finans.hepsiburada);

/* ---- Ürün başına komisyon, HB eşleşme durumu ve net kâr ---- */
const yayindakiUrunler = magaza.urunler.filter((u) => u.durum === 'yayinda');
const hbBagliSayi = yayindakiUrunler.filter((u) => Boolean(hbKanal?.urunler[u.id]?.kod) && hbKanal?.urunler[u.id]?.satista !== false).length;
const hbSatisDisiSayi = yayindakiUrunler.filter((u) => hbKanal?.urunler[u.id]?.satista === false).length;
const hbEslesmeyenSayi = yayindakiUrunler.filter((u) => !hbKanal?.urunler[u.id]?.kod && hbKanal?.urunler[u.id]?.satista !== false).length;

const komisyonSatirlari = yayindakiUrunler
  .filter((u) => hbKanal?.urunler[u.id]?.satista !== false)
  .map((u) => {
    const a = finans.hbUrunler[u.id];
    const hbEslesme = hbKanal?.urunler[u.id];
    const hbKod = hbEslesme?.kod;
    const oran = a ? (a.kategori === 'elle' ? a.oranBp : hbKategori(a.kategori)?.oranBp) : hbKategori(kategoriOnerisi(u.kategoriler))?.oranBp;
    const fiyat = Math.round(kanalHedefFiyati(u, hbKanal).hedef * 100);
    const desi = a?.desi ?? 3;
    const girdi = oran === undefined ? undefined : {
      oranBp: oran, urunKdv: a?.kdv ?? 20, desi, kargoFirmasi: ayar.kargoFirmasi,
      islemBedeli: ayar.islemBedeli, hizmetBedeli: ayar.hizmetBedeli, stopajBp: ayar.stopajBp, maliyet: a?.maliyet,
    };
    const h = girdi ? satisHesabi({ ...girdi, fiyat }) : undefined;
    const komisyonTutar = h ? h.kalemler[0]!.net + h.kalemler[0]!.kdv : undefined;
    const kargoTutar = h && !h.kargoBulunamadi ? h.kalemler[1]!.net + h.kalemler[1]!.kdv : undefined;
    const kaynakTipi: 'hb' | 'elle' | 'tablo' = a?.oranKaynak === 'hepsiburada' ? 'hb' : (a?.oranKaynak === 'elle' || a?.kategori === 'elle') ? 'elle' : 'tablo';
    const kaynak = kaynakTipi === 'hb'
      ? `HB’den okundu${a?.oranTarih ? ' · ' + new Intl.DateTimeFormat('tr-TR', { dateStyle: 'medium', timeZone: 'Europe/Istanbul' }).format(new Date(a.oranTarih)) : ''}`
      : kaynakTipi === 'elle'
        ? 'Elle girilen oran'
        : 'Kategori tablosu varsayılanı';
    return {
      id: u.id,
      marka: u.marka,
      kisaAd: u.kisaAd,
      gorsel: u.gorseller[0]?.src,
      hbKod,
      stok: u.stok,
      desi,
      oranBp: oran,
      vadeGun: a?.vadeGun,
      maliyet: a?.maliyet,
      fiyat,
      komisyonTutar,
      kargoTutar,
      yatan: h?.hesabaYatan,
      kar: h?.netKar,
      marj: h?.marj,
      basaBas: girdi ? hedefFiyat(girdi, 0) : undefined,
      kaynak,
      kaynakTipi,
    };
  })
  .sort((x, y) => Number(Boolean(y.hbKod)) - Number(Boolean(x.hbKod)) || (y.kar ?? -1e12) - (x.kar ?? -1e12));

/* ---- Hesap makinesi girdileri: URL > ilk eşleşmiş/maliyetli ürün > kategori varsayılanı ---- */
const urunParam = q.get('urun');
const secili = urunParam === 'serbest'
  ? undefined
  : urunler.find((u) => u.id === urunParam)
    ?? urunler.find((u) => u.durum === 'yayinda' && hbKanal?.urunler[u.id]?.kod && finans.hbUrunler[u.id]?.maliyet !== undefined)
    ?? urunler.find((u) => u.durum === 'yayinda' && finans.hbUrunler[u.id]?.maliyet !== undefined)
    ?? urunler.find((u) => u.durum === 'yayinda');
const kayitli = secili ? finans.hbUrunler[secili.id] : undefined;
const kategori = q.get('kategori') ?? kayitli?.kategori ?? (secili ? kategoriOnerisi(secili.kategoriler) : 'zuccaciye');
const oranGirdi = q.get('oran') ?? (kayitli?.oranBp !== undefined ? String(kayitli.oranBp / 100).replace('.', ',') : '');
const oranBp = kategori === 'elle' ? yuzdeBp(oranGirdi) : hbKategori(kategori)?.oranBp;
const varsayilanHedefTL = secili ? kanalHedefFiyati(secili, hbKanal).hedef : undefined;
const fiyatGirdi = q.get('fiyat') ?? (varsayilanHedefTL !== undefined ? String(varsayilanHedefTL).replace('.', ',') : '');
const desiVarsayilanKullanildi = !q.get('desi') && !kayitli && Boolean(secili);
const desiGirdi = q.get('desi') ?? (kayitli ? String(kayitli.desi).replace('.', ',') : secili ? '3' : '');
const kdv = Number(q.get('kdv') ?? kayitli?.kdv ?? 20);
const maliyetGirdi = q.get('maliyet') ?? (kayitli?.maliyet !== undefined ? (kayitli.maliyet / 100).toFixed(2).replace('.', ',') : '');
const hedefGirdi = q.get('hedef') ?? '';
let hesap: ReturnType<typeof satisHesabi> | undefined;
let hedef: number | undefined;
let basaBas: number | undefined;
const eksikler: string[] = [];
try {
  const fiyat = tlKurus(fiyatGirdi);
  const desi = ondalik(desiGirdi);
  const maliyet = tlKurus(maliyetGirdi);
  if (fiyat === undefined) eksikler.push('satış fiyatı');
  if (desi === undefined || Number.isNaN(desi)) eksikler.push('desi');
  if (oranBp === undefined || Number.isNaN(oranBp)) eksikler.push('komisyon oranı');
  if (!ayar.kargoFirmasi) eksikler.push('kargo firması (Ayarlar)');
  if (!eksikler.length && fiyat !== undefined && desi !== undefined && oranBp !== undefined) {
    const girdi = { oranBp, urunKdv: [0, 1, 10, 20].includes(kdv) ? kdv : 20, desi, kargoFirmasi: ayar.kargoFirmasi, islemBedeli: ayar.islemBedeli, hizmetBedeli: ayar.hizmetBedeli, stopajBp: ayar.stopajBp, maliyet };
    hesap = satisHesabi({ ...girdi, fiyat });
    const hedefKurus = tlKurus(hedefGirdi);
    if (hedefKurus !== undefined) hedef = hedefFiyat(girdi, hedefKurus);
    basaBas = hedefFiyat(girdi, 0);
  }
} catch (e) {
  hatalar.push((e as Error).message);
}
const vadeOrnegi = isGunuEkle(new Date(), ODEME_VADESI_IS_GUNU);

/* ---- Hepsiburada hesabı (muhasebe servisi) ---- */
const ozet = hbOzet(finans.hepsiburada);
const mutabakat = hbSiparisMutabakati(finans.hepsiburada, finans.hbPerformans);
const farkli = mutabakat.filter((s) => s.fark !== undefined && s.fark !== 0);
const tarihTr = (t?: string) => t ? new Intl.DateTimeFormat('tr-TR', { dateStyle: 'medium', timeZone: 'Europe/Istanbul' }).format(new Date(t)) : '—';
const gunTr = (g: string) => g === 'vadesiz' ? 'Vade bilgisi yok' : new Intl.DateTimeFormat('tr-TR', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(g));
const yuzde = (bp: number) => '%' + (bp / 100).toLocaleString('tr-TR', { maximumFractionDigits: 2 });
const isaretli = (k: number) => (k < 0 ? '−' : '+') + finansPara(Math.abs(k));
const isaretliOzet = (k: number) => (k < 0 ? '−' : '') + finansPara(Math.abs(k));
const grupSirasi: HbGrup[] = ['satis', 'iade', 'komisyon', 'kampanya', 'kargo', 'islem', 'hizmet', 'odemeServisi', 'ceza', 'reklam', 'kdv', 'stopaj', 'diger'];
const bugun = finansGunu();
const tarifeGun = Math.floor((Date.now() - Date.parse(KARGO_TABLO_TARIHI + 'T00:00:00+03:00')) / 864e5);
const tarifeEski = tarifeGun > 90;
const zarardakiSayi = komisyonSatirlari.filter((r) => (r.kar ?? 0) < 0).length;
---
<Yonetim baslik="Hepsiburada Kârlılık ve Hakediş" altBaslik="Hepsiburada ürün/stok eşleşme durumunu, satış başı net kârınızı ve cari hakedişlerinizi tek ekrandan yönetin." aktif="finans" genis basari={q.get('ok')} hatalar={[...hatalar, ...(q.get('hata') ? [q.get('hata')!] : [])]}>
  <KanalLogo slot="baslik-onu" kanal="hepsiburada" boyut="buyuk" />
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/fiyatlar?gorunum=hepsiburada"><PIkon ad="etiket" boyut={17} />HB Fiyatlarını Düzenle</a>
    <a class="btn btn--cizgi" href="/yonetim/siparisler/kanallar?gorunum=hepsiburada"><PIkon ad="zincir" boyut={17} />Ürün Eşleştirme ({hbBagliSayi}/{yayindakiUrunler.length - hbSatisDisiSayi})</a>
    <a class="btn btn--sepet" href="#hesap"><PIkon ad="hedef" boyut={17} />Kâr Hesaplayıcı</a>
  </div>

  <nav class="y-sekmeler y-finans-nav" aria-label="Finans bölümleri" style="margin-bottom:16px">
    <a href="/yonetim/finans?sekme=ozet">Finans Özeti</a>
    <a href="/yonetim/finans/faturalar">Faturalar (e-Arşiv)</a>
    <a href="/yonetim/finans?sekme=giderler">Dış Giderler</a>
    <a href="/yonetim/finans?sekme=belgeler">Koli Belgeleri</a>
    <a href="/yonetim/finans?sekme=trendyol">Trendyol Hakediş</a>
    <a href="/yonetim/finans/trendyol-karlilik">Trendyol Kârlılık</a>
    <a href="/yonetim/finans/hepsiburada" aria-current="page">Hepsiburada</a>
    <a href="/yonetim/finans?sekme=raporlar">Muhasebe Raporu</a>
  </nav>

  {/* HEPSİBURADA EŞLEŞME VE BAĞLANTI ÖZET ŞERİDİ */}
  <section class="y-kart hb-durum-bant" aria-label="Hepsiburada stok ve eşleşme durumu">
    <div class="hb-durum-bant__sol">
      <PIkon ad="zincir" boyut={22} />
      <div>
        <strong>Hepsiburada Ortak Stok ve Eşleşme Durumu: {hbBagliSayi} ürün bağlı · {hbEslesmeyenSayi} ürün eşleşmemiş{hbSatisDisiSayi > 0 ? ` · ${hbSatisDisiSayi} ürün HB’de satış dışı` : ''}</strong>
        <p>
          {['canli', 'test'].includes(apiDurumu)
            ? `API bağlantısı açık (${apiDurumu === 'test' ? 'SIT test ortamı' : 'Canlı'}). Bağlı ürünlerin stoğu ortak depodan otomatik güncellenir.`
            : 'Ürün kodlarınız ve Hepsiburada özel fiyatlarınız kayıtlı; canlı Hepsiburada API anahtarları tanımlandığında stok ve hakedişler otomatik eşitlenir.'}
        </p>
      </div>
    </div>
    <div class="y-ust-aksiyonlar">
      {hbEslesmeyenSayi > 0 && <a class="btn btn--sepet btn--kucuk" href="/yonetim/siparisler/kanallar?gorunum=hepsiburada">{hbEslesmeyenSayi} Eşleşmemiş Ürünü Bağla →</a>}
      <a class="btn btn--cizgi btn--kucuk" href="#hesabim">Cari Hakediş Özeti ↓</a>
    </div>
  </section>

  {/* 1. BÖLÜM: ÜRÜN BAŞINA KOMİSYON VE NET KÂR TABLOSU */}
  <section class="y-kart" id="komisyonlar" style="margin-bottom:18px">
    <div class="y-kart__bas">
      <div>
        <h2><PIkon ad="yuzde" /> Ürün Başına Hepsiburada Fiyatı, Kesinti ve Net Kâr ({komisyonSatirlari.length} Ürün)</h2>
        <p class="y-kart__alt">Her ürünün Hepsiburada hedef satış fiyatından komisyon, kargo ve alış maliyeti düşüldükten sonra cebinize kalan tutar.</p>
      </div>
      <div class="y-ust-aksiyonlar">
        {zarardakiSayi > 0 && <span class="y-chip y-chip--kirmizi">{zarardakiSayi} ürün bu oranda zararda</span>}
        <form method="post"><button class="btn btn--cizgi btn--kucuk" name="eylem" value="komisyon-cek" type="submit" disabled={!['canli', 'test'].includes(apiDurumu)} title={['canli', 'test'].includes(apiDurumu) ? 'Hepsiburada Komisyon Bilgisi Sorgulama servisinden okunur' : 'Canlı Hepsiburada API bilgileri tanımlanınca çalışır'}><PIkon ad="yenile" boyut={16} />Komisyonları HB’den Çek</button></form>
      </div>
    </div>

    {!ayar.kargoFirmasi && <p class="y-uyari">Kargo firması seçilmemiş; kargo ücreti bilinmediği için sahte net kâr gösterilmez. Sayfa altındaki “Hepsiburada maliyet ayarları”ndan kargo firmasını seçin.</p>}
    {komisyonSatirlari.some((r) => r.kaynakTipi === 'tablo') && (
      <div class="y-veri-not" style="margin-bottom:12px">
        <PIkon ad="bilgi" boyut={18} />
        <p>
          <strong>Komisyon oranı bilgisi:</strong> “Kategori varsayılanı” yazan ürünlerde Hepsiburada EK-4 genel tablo oranı (ör. %18) kullanılmıştır. Hepsiburada satıcı panelinizde kampanya veya özel komisyon oranınız daha düşükse satırdaki <strong>Simüle Et / Düzenle</strong> düğmesine basıp gerçek oranı kaydedebilirsiniz.
        </p>
      </div>
    )}

    <div class="y-tablo-kap kr-tablo-kap">
      <table class="y-tablo kr-tablo">
        <thead>
          <tr class="kr-grup-baslik">
            <th>Ürün ve HB Eşleşmesi</th>
            <th colspan="2" class="kr-bolge-satis">HB Satışı ve Kesintiler</th>
            <th class="kr-bolge-yatan">Bankaya Giren</th>
            <th colspan="2" class="kr-bolge-kar">Maliyet ve Net Kazanç</th>
            <th class="kr-bolge-taban">Alt Sınır ve İşlem</th>
          </tr>
          <tr>
            <th>Ürün</th>
            <th class="y-sayi kr-bolge-satis">HB Hedef Fiyatı</th>
            <th class="y-sayi">Komisyon &amp; Kargo</th>
            <th class="y-sayi kr-bolge-yatan">Hesaba Yatan</th>
            <th class="y-sayi kr-bolge-kar">Alış (KDV Hrç)</th>
            <th class="y-sayi">Satış Başı Net Kâr</th>
            <th class="y-sayi kr-bolge-taban">Zararsız En Düşük</th>
          </tr>
        </thead>
        <tbody>
          {komisyonSatirlari.map((r) => {
            const zararda = r.kar !== undefined && r.kar < 0;
            return (
              <tr class:list={{ 'kr-satir--zarar': zararda }}>
                <td data-etiket="Ürün" class="kr-urun-hucre">
                  <div class="kr-urun">
                    <a class="kr-foto" href={'/yonetim/urunler/' + encodeURIComponent(r.id)} tabindex="-1" aria-hidden="true">
                      {r.gorsel ? <img src={r.gorsel} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <PIkon ad="kutu" boyut={22} />}
                    </a>
                    <div class="kr-urun__bilgi">
                      <span class="kr-marka">{r.marka}</span>
                      <a class="kr-ad" href={'/yonetim/urunler/' + encodeURIComponent(r.id)}>{r.kisaAd}</a>
                      <div class="kr-alt-etiketler">
                        {r.hbKod
                          ? <span class="y-chip y-chip--yesil">HB Bağlı: {r.hbKod}</span>
                          : <a class="y-chip y-chip--turuncu" href="/yonetim/siparisler/kanallar?gorunum=hepsiburada">HB Kodu Yok · Bağla →</a>}
                        <span class="kr-etiket">Stok: {r.stok}</span>
                      </div>
                    </div>
                  </div>
                </td>

                <td data-etiket="HB Hedef Fiyatı" class="y-sayi kr-bolge-satis">
                  <strong class="kr-tutar kr-tutar--satis">{finansPara(r.fiyat)}</strong>
                  <small class="kr-not">KDV dahil HB fiyatı</small>
                </td>

                <td data-etiket="Komisyon & Kargo" class="y-sayi">
                  <span class="kr-kesinti-oran">{r.oranBp !== undefined ? yuzde(r.oranBp) + ' (+KDV)' : '—'}</span>
                  {r.komisyonTutar !== undefined && (
                    <small class="kr-not">−{finansPara(r.komisyonTutar)} kom.{r.kargoTutar !== undefined ? ` · −${finansPara(r.kargoTutar)} krg` : ''}</small>
                  )}
                  <small class="kr-not">{r.kaynak}{r.vadeGun !== undefined ? ` · ${r.vadeGun} gün vade` : ''}</small>
                </td>

                <td data-etiket="Hesaba Yatan" class="y-sayi kr-bolge-yatan">
                  <strong class="kr-tutar kr-tutar--yatan">{r.yatan !== undefined ? finansPara(r.yatan) : '—'}</strong>
                  <small class="kr-not">Bankaya yatacak</small>
                </td>

                <td data-etiket="Alış (KDV hariç)" class="y-sayi kr-bolge-kar">
                  {r.maliyet !== undefined ? (
                    <>
                      <span class="kr-tutar">{finansPara(r.maliyet)}</span>
                      <small class="kr-not">Birim geliş</small>
                    </>
                  ) : (
                    <a class="y-chip y-chip--turuncu" href={'?urun=' + encodeURIComponent(r.id) + '#hesap'}>Maliyet Gir →</a>
                  )}
                </td>

                <td data-etiket="Net Kâr" class:list={['y-sayi', 'kr-kar-hucre', zararda ? 'is-zarar' : r.kar !== undefined ? 'is-kar' : '']}>
                  <strong class="kr-tutar kr-tutar--kar">
                    {r.kar !== undefined ? isaretli(r.kar) : (!ayar.kargoFirmasi && r.maliyet !== undefined ? 'Kargo seçilmedi' : '—')}
                  </strong>
                  {r.marj !== undefined && (
                    <span class:list={['kr-marj', zararda ? 'kr-marj--kirmizi' : 'kr-marj--yesil']}>
                      %{(r.marj * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 })} marj
                    </span>
                  )}
                </td>

                <td data-etiket="Zararsız En Düşük" class="y-sayi kr-bolge-taban">
                  <strong class="kr-tutar kr-tutar--taban">{r.basaBas !== undefined ? finansPara(r.basaBas) : '—'}</strong>
                  <small class="kr-not">Bu fiyatın altı zarar</small>
                  <a class="btn btn--cizgi btn--kucuk" style="margin-top:5px;padding:4px 9px;min-height:30px;font-size:12.5px" href={'?urun=' + encodeURIComponent(r.id) + '#hesap'}>Simüle Et / Düzenle</a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="y-help" style="margin-top:12px">Net kâr = KDV hariç satış − komisyon − kargo − işlem/hizmet bedeli − alış maliyeti (KDV’ler ve %1 stopaj vergiden mahsup edildiği için düşülmez).</p>
  </section>

  {/* 2. BÖLÜM: KÂR VE BAŞABAŞ HESAPLAYICI */}
  <div class="y-hesap-izgara" id="hesap" style="margin-bottom:18px">
    <section class="y-kart">
      <div class="y-kart__bas">
        <div>
          <h2><PIkon ad="kutu" /> Ürün Kâr ve Başabaş Hesaplayıcı</h2>
          <p class="y-kart__alt">“Bu fiyattan satarsam elime ne kalır?” — Ürünü seçin, komisyon veya fiyatı değiştirip anında görün.</p>
        </div>
      </div>
      <form method="get" class="y-izgara" action="#hesap">
        <label class="y-alan">Ürün seçin
          <select name="urun" onchange="this.form.querySelectorAll('[data-urun-bagli]').forEach((e) => { e.disabled = true; }); this.form.submit()">
            {urunler.filter((u) => u.durum === 'yayinda').map((u) => (
              <option value={u.id} selected={u.id === secili?.id}>{u.marka} {u.kisaAd}{finans.hbUrunler[u.id] ? ' ✓' : ''}</option>
            ))}
            <option value="serbest" selected={urunParam === 'serbest'}>— Ürün seçmeden serbest hesapla —</option>
          </select>
        </label>
        <div class="y-izgara y-izgara--2">
          <label class="y-alan">Hepsiburada satış fiyatı (KDV dahil, TL)<input name="fiyat" inputmode="decimal" value={fiyatGirdi} placeholder="1.499,90" data-urun-bagli /></label>
          <label class="y-alan">Desi<input name="desi" inputmode="decimal" value={desiGirdi} placeholder="ör. 3" data-urun-bagli /><small class="muted">{desiVarsayilanKullanildi ? 'Kayıtlı desi olmadığı için örnek 3 desi alındı; gerçek desiyi girip kaydedin.' : 'En × boy × yükseklik (cm) ÷ 3000 ile kg’dan büyük olanı.'}</small></label>
        </div>
        <div class="y-izgara y-izgara--2">
          <label class="y-alan">Hepsiburada kategorisi
            <select name="kategori" data-urun-bagli>
              {HB_KATEGORILER.map((k) => <option value={k.kod} selected={k.kod === kategori}>{k.ad} — {yuzde(k.oranBp)}</option>)}
              <option value="elle" selected={kategori === 'elle'}>Elle özel komisyon oranı gir</option>
            </select>
            <small class="muted">{hbKategori(kategori)?.kapsam ?? 'Satıcı panelinizde yazan gerçek komisyon oranını girin.'}</small>
          </label>
          <label class="y-alan">Elle komisyon oranı (%, KDV hariç)<input name="oran" inputmode="decimal" value={oranGirdi} placeholder="Ör. 12,5 (Elle seçiliyse)" data-urun-bagli /></label>
        </div>
        <div class="y-izgara y-izgara--2">
          <label class="y-alan">Ürünün KDV oranı
            <select name="kdv" data-urun-bagli>{[20, 10, 1, 0].map((o) => <option value={o} selected={o === kdv}>%{o}</option>)}</select>
          </label>
          <label class="y-alan">Ürünün alış maliyeti (KDV hariç, TL)<input name="maliyet" inputmode="decimal" value={maliyetGirdi} placeholder="Kâr için gerekli" data-urun-bagli /></label>
        </div>
        <label class="y-alan">Hedeflediğiniz net kâr (TL, isteğe bağlı)<input name="hedef" inputmode="decimal" value={hedefGirdi} placeholder="Ör. 500 TL kazanmak için kaça satmalıyım?" /></label>
        <div class="y-modal__alt">
          <button class="btn btn--sepet" type="submit"><PIkon ad="hedef" boyut={18} />Hesapla</button>
          {secili && <button class="btn btn--cizgi" type="submit" formmethod="post" name="eylem" value="urun-kaydet"><PIkon ad="tik" boyut={18} />Oran, Desi ve Maliyeti Kaydet</button>}
        </div>
        <p class="y-help" style="margin:4px 0 0">Buradaki satış fiyatı yalnızca simülasyon içindir; vitrin fiyatını değiştirmez. “Kaydet” düğmesi ürünün komisyon oranı, desi, KDV ve alış maliyetini yukarıdaki tabloya kaydeder.</p>
      </form>
    </section>

    <section class="y-kart">
      <div class="y-kart__bas">
        <div>
          <h2><PIkon ad="grafik" /> Hesaplama Sonucu{secili ? `: ${secili.marka} ${secili.kisaAd}` : ''}</h2>
          <p class="y-kart__alt">Seçili değerlerle 1 adet satışın adım adım dökümü.</p>
        </div>
      </div>
      {eksikler.length > 0 && <p class="y-uyari">Hesaplamak için soldaki formdan şu bilgileri girin: <strong>{eksikler.join(', ')}</strong>.</p>}
      {hesap && <>
        {hesap.kargoBulunamadi && <p class="y-uyari">Seçili kargo firmasının tablosunda bu desi yok (en fazla {kargoUstSiniri(ayar.kargoFirmasi)} desi). Kargo 0 sayıldı; sonucu kullanmayın.</p>}
        <div class="y-sonuc-vurgu">
          <PIkon ad="para" />
          {hesap.netKar !== undefined
            ? <div><span>Cebe kalan tahmini net kâr (1 adet satışta)</span><strong class:list={{ 'y-negatif': hesap.netKar < 0 }}>{isaretli(hesap.netKar)}</strong></div>
            : <div><span>Hesabınıza yatacak (Hakediş)</span><strong>{finansPara(hesap.hesabaYatan)}</strong><small>Net kârı görmek için alış maliyetini girin</small></div>}
        </div>
        <div class="y-sonuc-kutular">
          <div class="y-sonuc-kutu"><PIkon ad="yuzde" boyut={18} /><span>Kâr marjı</span><strong>{hesap.marj !== undefined ? '%' + (hesap.marj * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) : '—'}</strong><small>KDV hariç satışa oranı</small></div>
          <div class="y-sonuc-kutu"><PIkon ad="hedef" boyut={18} /><span>Zararsız en düşük fiyat</span><strong>{basaBas !== undefined ? finansPara(basaBas) : '—'}</strong><small>Başabaş satış sınırı</small></div>
          <div class="y-sonuc-kutu"><PIkon ad="trend" boyut={18} /><span>Hedef kâr için fiyat</span><strong>{hedef !== undefined ? finansPara(hedef) : '—'}</strong><small>{hedef !== undefined ? finansPara(tlKurus(hedefGirdi)!) + ' net kâr için' : 'Soldan hedef kâr girin'}</small></div>
        </div>
        <h3>1. Bankaya yatacak hakediş hesabı</h3>
        <dl class="y-hesap">
          <div><dt>Müşterinin ödediği satış fiyatı <small>KDV dahil</small></dt><dd>{finansPara(hesap.kdvHaricSatis + hesap.satisKdv)}</dd></div>
          {hesap.kalemler.filter((k) => k.net + k.kdv > 0).map((k) => <div class="eksi"><dt>{k.ad} <small>{finansPara(k.net)} + %20 KDV</small></dt><dd>−{finansPara(k.net + k.kdv)}</dd></div>)}
          <div class="eksi"><dt>E-ticaret stopajı <small>{yuzde(ayar.stopajBp)}, yıllık vergiden mahsup edilir</small></dt><dd>−{finansPara(hesap.stopaj)}</dd></div>
          <div class="sonuc"><dt>Bankaya yatacak (Hakediş) <small>teslimat + {ODEME_VADESI_IS_GUNU} iş günü</small></dt><dd>{finansPara(hesap.hesabaYatan)}</dd></div>
        </dl>
        <h3>2. Vergi ve alış maliyeti sonrası net kâr</h3>
        <dl class="y-hesap">
          <div class="alt"><dt>Devlete ödenecek KDV farkı <small>satış KDV'si − kesinti KDV'si (alış KDV'si hariç)</small></dt><dd>{finansPara(hesap.kdvFarki)}</dd></div>
          {hesap.netKar !== undefined
            ? <div class="sonuc"><dt>Cebe kalan tahmini net kâr <small>KDV hariç satış − kesintiler − alış maliyeti</small></dt><dd class:list={{ 'y-negatif': hesap.netKar < 0 }}>{isaretli(hesap.netKar)}</dd></div>
            : <div class="alt"><dt>Tahmini net kâr</dt><dd>Alış maliyetini girin</dd></div>}
        </dl>
        <details class="y-block-gap"><summary>Olası gecikme / iptal cezaları (bilgi amaçlı)</summary>
          <ul class="y-task-list">{hesap.cezalar.map((c) => <li><span>{c.ad}</span><span>{finansPara(c.tutar)}</span></li>)}</ul>
        </details>
      </>}
    </section>

    <aside class="y-kart">
      <div class="y-kart__bas"><div><h2><PIkon ad="ayarlar-cubuk" /> Hesaplama Varsayımları</h2><p class="y-kart__alt">Bu hesapta kullanılan temel oranlar.</p></div></div>
      <ul class="y-varsayim">
        <li><PIkon ad="yuzde" /><span>Platform komisyonu<small>{kategori === 'elle' ? 'Elle girilen oran' : hbKategori(kategori)?.ad ?? 'Kategori seçilmedi'}</small></span><strong>{oranBp !== undefined && !Number.isNaN(oranBp) ? yuzde(oranBp) : '—'}</strong></li>
        <li><PIkon ad="kargo" /><span>Kargo firması<small>HB anlaşmalı desi tablosu</small></span><strong>{KARGO_FIRMALARI.find((k) => k.kod === ayar.kargoFirmasi)?.ad ?? 'Seçilmedi'}</strong></li>
        <li><PIkon ad="fatura" /><span>İşlem / Hizmet bedeli<small>KDV hariç</small></span><strong>{finansPara(ayar.islemBedeli + ayar.hizmetBedeli)}</strong></li>
        <li><PIkon ad="banka" /><span>E-ticaret stopajı<small>KDV hariç satış üzerinden</small></span><strong>{yuzde(ayar.stopajBp)}</strong></li>
        <li><PIkon ad="belge" /><span>Ürün KDV oranı</span><strong>%{kdv}</strong></li>
        <li><PIkon ad="takvim" /><span>Ödeme vadesi<small>Teslimattan sonra</small></span><strong>{ODEME_VADESI_IS_GUNU} iş günü</strong></li>
      </ul>
      {tarifeEski && <p class="y-uyari">Kargo ücret tablosu {tarifeGun} gün önce alındı; satıcı panelindeki güncel desi tablosuyla karşılaştırın.</p>}
      {gercek && <p class="y-help">Gerçek HB kayıtlarınıza göre (son {gercek.siparis} sipariş): işlem bedeli ort. {finansPara(gercek.islem)}, hizmet bedeli ort. {finansPara(gercek.hizmet)}, komisyon ort. {yuzde(gercek.komisyonBp)}.</p>}
      <a class="btn btn--cizgi" href="#ayarlar" data-ac="ayarlar"><PIkon ad="ayar" boyut={18} />Kargo ve Hizmet Ayarlarını Düzenle</a>
    </aside>
  </div>

  {/* 3. BÖLÜM: HEPSİBURADA CARİ HAKEDİŞ VE MUTABAKAT */}
  <div class="y-metrics y-metrics--finans" id="hesabim">
    <div class="y-metric y-metric--altin">
      <PIkon ad="sepet" />
      <span>HB Cari Brüt Satış</span>
      <strong>{finansPara(Math.max(0, ozet.gruplar.satis))}</strong>
      <small>{mutabakat.length} sipariş mutabakat satırı</small>
    </div>
    <div class="y-metric y-metric--kirmizi">
      <PIkon ad="yuzde" />
      <span>Komisyon, Kargo ve Hizmet</span>
      <strong>{isaretliOzet(ozet.gruplar.komisyon + ozet.gruplar.kargo + ozet.gruplar.islem + ozet.gruplar.hizmet + ozet.gruplar.odemeServisi + ozet.gruplar.stopaj)}</strong>
      <small>Platform kesintileri ve stopaj</small>
    </div>
    <div class="y-metric">
      <PIkon ad="uyari" />
      <span>İade, Kampanya ve Ceza</span>
      <strong>{isaretliOzet(ozet.gruplar.iade + ozet.gruplar.kampanya + ozet.gruplar.ceza + ozet.gruplar.reklam)}</strong>
      <small>İade düşümleri ve kampanya payı</small>
    </div>
    <div class="y-metric y-metric--yesil">
      <PIkon ad="para" />
      <span>Toplam Net Hakediş</span>
      <strong>{isaretliOzet(ozet.hakedis)}</strong>
      <small>Ödenen: {isaretliOzet(ozet.odenen)} · Bekleyen: {isaretliOzet(ozet.odenecek)}</small>
    </div>
  </div>

  <div class="hb-iki-sutun" style="margin-bottom:18px">
    <section class="y-kart">
      <div class="y-kart__bas">
        <div>
          <h2><PIkon ad="banka" /> Hepsiburada Hakediş ve Sipariş Mutabakatı</h2>
          <p class="y-kart__alt">Teslim edilen siparişlerin kesinti ve ödeme vadesi takibi.</p>
        </div>
        {finans.hbSonCekim && <small class="muted">Son çekim: {tarihTr(finans.hbSonCekim.tarih)}</small>}
      </div>

      {finans.hepsiburada.length > 0 ? <>
        <dl class="y-hesap" style="margin-bottom:14px">
          {grupSirasi.filter((g) => ozet.gruplar[g] !== 0).map((g) => <div class:list={{ eksi: ozet.gruplar[g] < 0 }}><dt>{HB_GRUPLAR[g]}</dt><dd>{isaretliOzet(ozet.gruplar[g])}</dd></div>)}
          <div class="sonuc"><dt>Toplam net hakediş</dt><dd>{isaretliOzet(ozet.hakedis)}</dd></div>
          <div><dt>Bankaya ödenen</dt><dd>{isaretliOzet(ozet.odenen)}</dd></div>
          <div><dt>Vadesi bekleyen</dt><dd>{isaretliOzet(ozet.odenecek)}</dd></div>
          {ozet.gruplar.aktarim > 0 && <div class="alt"><dt>{HB_GRUPLAR.aktarim}</dt><dd>{finansPara(ozet.gruplar.aktarim)}</dd></div>}
        </dl>

        <div class="y-tablo-kap">
          <table class="y-tablo">
            <thead><tr><th>Sipariş</th><th>Tarih</th><th class="y-sayi">Satış</th><th class="y-sayi">Kesintiler</th><th class="y-sayi">Net</th><th class="y-sayi">HB Hakediş</th><th>Vade / Durum</th></tr></thead>
            <tbody>{mutabakat.slice(0, 200).map((s) => <tr>
              <td data-etiket="Sipariş"><strong>{s.siparisNo}</strong>{s.urun && <small class="y-table-note">{s.urun}</small>}</td>
              <td data-etiket="Tarih" class="y-nowrap">{tarihTr(s.tarih)}</td>
              <td data-etiket="Satış" class="y-sayi y-nowrap">{isaretliOzet(s.satis)}</td>
              <td data-etiket="Kesintiler" class="y-sayi y-nowrap">{isaretliOzet(s.kesinti)}</td>
              <td data-etiket="Net" class="y-sayi y-nowrap"><strong>{isaretliOzet(s.kayitToplami)}</strong></td>
              <td data-etiket="HB hakediş" class="y-sayi y-nowrap">{s.hakedis === undefined ? '—' : <span class:list={['y-chip', s.fark === 0 ? 'y-chip--yesil' : 'y-chip--kirmizi']} title={s.fark ? 'Fark: ' + isaretliOzet(s.fark) : 'Aynı'}>{isaretliOzet(s.hakedis)}</span>}</td>
              <td data-etiket="Vade" class="y-nowrap">{s.odendi ? <span class="y-chip y-chip--yesil">Ödendi</span> : <span class="y-chip y-chip--turuncu">{tarihTr(s.vade)}</span>}</td>
            </tr>)}</tbody>
          </table>
        </div>
      </> : (
        <div class="hb-bos-kutu">
          <PIkon ad="banka" boyut={24} />
          <strong>Henüz çekilmiş Hepsiburada cari hakediş kaydı yok.</strong>
          <p>Siparişler müşteriye teslim edildikten sonra sağdaki <em>Cari Hesap Çekimi</em> kartından satış, kesinti ve vade tarihlerini tek tıkla getirebilirsiniz.</p>
          <div class="y-ust-aksiyonlar" style="justify-content:center;margin-top:10px">
            <a class="btn btn--cizgi btn--kucuk" href="/yonetim/siparisler?kanal=hepsiburada">Hepsiburada Siparişlerini Gör</a>
            <a class="btn btn--cizgi btn--kucuk" href="/yonetim/siparisler/kanallar?gorunum=hepsiburada">Kanal Ayarları</a>
          </div>
        </div>
      )}
    </section>

    <aside class="hb-yan-sutun">
      <section class="y-kart">
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad="yenile" /> Cari Hesap Çekimi</h2>
            <p class="y-kart__alt">Hepsiburada muhasebe servisinden kayıtları eşitleyin.</p>
          </div>
          {apiDurumu === 'test' && <span class="y-chip y-chip--turuncu">Test ortamı</span>}
        </div>
        {apiDurumu === 'kapali' || apiDurumu === 'eksik' ? (
          <div class="y-veri-not" style="margin:0">
            <PIkon ad="bilgi" boyut={18} />
            <p>
              <strong>API bağlantısı bekleniyor</strong>
              Hepsiburada satıcı entegrasyon bilgileri ve “Muhasebe entegrasyonu” yetkisi tanımlandığında buradan 30/60/90 günlük hakediş çekimi aktif olur.
            </p>
          </div>
        ) : (
          <form method="post" class="y-izgara">
            <input type="hidden" name="eylem" value="cek" />
            <label class="y-alan">Çekilecek dönem
              <select name="gun">
                <option value="30">Son 30 gün</option>
                <option value="60">Son 60 gün</option>
                <option value="90">Son 90 gün</option>
              </select>
            </label>
            <button class="btn btn--sepet" type="submit" style="width:100%;justify-content:center"><PIkon ad="indir" boyut={17} />Şimdi Hepsiburada'dan Çek</button>
          </form>
        )}
      </section>

      <section class:list={['y-kart', farkli.length > 0 ? 'hb-uyari-kart' : '']}>
        <div class="y-kart__bas">
          <div>
            <h2><PIkon ad={farkli.length > 0 ? 'uyari' : 'tik'} /> Mutabakat ve Vadeler</h2>
            <p class="y-kart__alt">Ödeme takvimi ve tutar kontrolü.</p>
          </div>
        </div>
        {farkli.length > 0
          ? <p class="y-uyari" style="margin-top:0">{farkli.length} siparişte muhasebe kayıtlarının toplamı Hepsiburada hakediş tutarından farklı.</p>
          : mutabakat.some((s) => s.fark === 0)
            ? <p class="y-help" style="margin-top:0">Muhasebe kayıtları Hepsiburada hakediş hesabıyla kuruşu kuruşuna uyumlu.</p>
            : <p class="y-help" style="margin-top:0">Teslimattan {ODEME_VADESI_IS_GUNU} iş günü sonra hakediş ödemesi oluşur (bugün teslim edilse tahmini vade: <strong>{gunTr(vadeOrnegi.toISOString().slice(0, 10))}</strong>).</p>}
        {ozet.vadeler.length > 0 && <>
          <h3>Yaklaşan Ödemeler</h3>
          <ul class="y-task-list">{ozet.vadeler.map(([g, t]) => <li><span>{gunTr(g)}{g !== 'vadesiz' && g < bugun ? ' (vadesi geçti)' : ''}</span><strong>{isaretliOzet(t)}</strong></li>)}</ul>
        </>}
      </section>
    </aside>
  </div>

  <details class="y-kart" id="ayarlar" open={!ayar.kargoFirmasi}>
    <summary><PIkon ad="ayar" /> <strong>Hepsiburada kargo ve hizmet bedeli ayarları</strong></summary>
    <form method="post" class="y-izgara">
      <input type="hidden" name="eylem" value="ayar-kaydet" />
      {Object.entries(Object.fromEntries(['urun', 'fiyat', 'kategori', 'oran', 'desi', 'kdv', 'maliyet', 'hedef'].map((k) => [k, q.get(k) ?? '']))).filter(([, v]) => v).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <label class="y-alan">Kullandığınız kargo firması
        <select name="kargoFirmasi" required>
          <option value="">Seçin</option>
          {KARGO_FIRMALARI.map((k) => <option value={k.kod} selected={k.kod === ayar.kargoFirmasi}>{k.ad}</option>)}
        </select>
        <small class="muted">Hepsiburada'nın anlaşmalı desi tablo fiyatı.</small>
      </label>
      <div class="y-izgara y-izgara--2">
        <label class="y-alan">İşlem bedeli (sipariş başına, KDV hariç, TL)<input name="islemBedeli" inputmode="decimal" value={(ayar.islemBedeli / 100).toFixed(2).replace('.', ',')} /></label>
        <label class="y-alan">Hizmet bedeli (ürün başına, KDV hariç, TL)<input name="hizmetBedeli" inputmode="decimal" value={(ayar.hizmetBedeli / 100).toFixed(2).replace('.', ',')} /></label>
      </div>
      <label class="y-alan">E-ticaret stopaj oranı (%)<input name="stopaj" inputmode="decimal" value={(ayar.stopajBp / 100).toLocaleString('tr-TR')} /></label>
      <div class="y-modal__alt"><button class="btn btn--sepet" type="submit">Ayarları kaydet</button></div>
    </form>
  </details>
</Yonetim>

