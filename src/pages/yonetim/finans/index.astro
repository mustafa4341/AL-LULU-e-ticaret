---
import Yonetim from '../../../layouts/Yonetim.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import Ikon from '../../../components/Ikon.astro';
import { siparisleriOku } from '../../../lib/depo';
import { BELGE_DURUMLARI, BELGE_TURLERI, GIDER_KATEGORILERI, MANUEL_GIDER_KATEGORILERI, TRENDYOL_TUTARLARI, belgeGecerli, donem, finansGunu, finansPara, gecerliGun, hakEdis, kalanTutar, paraOku, raporla, type BelgeTuru, type Gider } from '../../../lib/finans';
import { finansOku, giderEkle, giderGuncelle, giderSil, trendyolKaydet } from '../../../lib/finansDepo';
import { aylar } from '../../../lib/finansDisari';
import { metin } from '../../../lib/form';
import { trendyolDosyasi } from '../../../lib/trendyolDosya';
import { pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { SATIS_DURUMLARI, satisTutari } from '../../../lib/pazaryeri';
import { envanterAyarlariOku, pazaryeriSiparisleriOku } from '../../../lib/pazaryeriDepo';
import { trendyolEkstreCek } from '../../../lib/trendyolApi';
import { trendyolEkstreSatirlari } from '../../../lib/trendyolFinans';
import { gonderilecek, onayliSatis, yTarih } from '../../../lib/yonetimRapor';

const sekmeler = [['ozet', 'Özet'], ['belgeler', 'Belgeler'], ['giderler', 'Giderler'], ['trendyol', 'Trendyol'], ['raporlar', 'Raporlar']] as const;
const q0 = Astro.url.searchParams;
let sekme = sekmeler.find(([id]) => id === q0.get('sekme'))?.[0] ?? 'ozet';
let hatalar: string[] = [];
let taslak: FormData | undefined;
let acikPencere = '';
const giderGirdisi = (f: FormData) => {
  const tarih = metin(f, 'tarih');
  const kategori = metin(f, 'kategori') as Gider['kategori'];
  const tutar = paraOku(metin(f, 'tutar'));
  if (!gecerliGun(tarih) || !Object.hasOwn(GIDER_KATEGORILERI, kategori) || tutar <= 0) throw new Error('Tarih, kategori ve sıfırdan büyük bir tutar girin.');
  return { tutar, tarih, kategori, not: metin(f, 'not').slice(0, 300) };
};
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  taslak = f;
  const eylem = metin(f, 'eylem');
  try {
    if (eylem === 'gider-ekle') {
      sekme = 'giderler'; acikPencere = 'gider-ekle';
      const dosya = f.get('belge');
      const g = giderGirdisi(f);
      await giderEkle(g, dosya instanceof File ? dosya : undefined);
      return Astro.redirect('/yonetim/finans?sekme=giderler&ay=' + g.tarih.slice(0, 7) + '&ok=' + encodeURIComponent('Gider kaydedildi.'), 303);
    }
    if (eylem === 'gider-duzenle') {
      sekme = 'giderler'; acikPencere = 'gider-duzenle';
      const g = giderGirdisi(f);
      await giderGuncelle(metin(f, 'id'), g);
      return Astro.redirect('/yonetim/finans?sekme=giderler&ay=' + g.tarih.slice(0, 7) + '&ok=' + encodeURIComponent('Gider güncellendi.'), 303);
    }
    if (eylem === 'gider-sil') {
      sekme = 'giderler';
      const g = await giderSil(metin(f, 'id'));
      return Astro.redirect('/yonetim/finans?sekme=giderler&ay=' + g.tarih.slice(0, 7) + '&ok=' + encodeURIComponent('Gider silindi.'), 303);
    }
    if (eylem === 'trendyol-al') {
      sekme = 'trendyol';
      const dosya = f.get('rapor');
      if (!(dosya instanceof File) || !dosya.size) throw new Error('Bir CSV veya XLSX dosyası seçin.');
      const satirlar = await trendyolDosyasi(dosya);
      await trendyolKaydet(satirlar);
      return Astro.redirect('/yonetim/finans?sekme=trendyol&ok=' + encodeURIComponent(satirlar.length + ' hakediş satırı işlendi.'), 303);
    }
    if (eylem === 'trendyol-cek') {
      sekme = 'trendyol';
      const gun = Number(metin(f, 'gun'));
      if (![15, 30, 60, 90].includes(gun)) throw new Error('Geçersiz dönem.');
      const sonT = Date.now();
      const basT = sonT - gun * 86_400_000;
      const ham = await trendyolEkstreCek(basT, sonT, AbortSignal.timeout(50_000));
      const ozet = trendyolEkstreSatirlari(ham.satislar, ham.diger);
      if (ozet.satirlar.length) await trendyolKaydet(ozet.satirlar);
      const mesaj = ozet.kayit
        ? `Trendyol'dan ${ozet.kayit} kayıt alındı, ${ozet.satirlar.length} satır güncellendi.` + (ozet.odenen ? ` Bu dönemde bankaya ödenen: ${finansPara(ozet.odenen)}.` : '')
          + (ozet.atlanan ? ` ${ozet.atlanan} kayıt okunamadı; satıcı panelindeki ekstreyle karşılaştırın.` : '')
        : `Son ${gun} günde Trendyol cari hesabında kayıt yok. Kayıtlar sipariş teslim edildikten sonra oluşur.`;
      return Astro.redirect('/yonetim/finans?sekme=trendyol&ok=' + encodeURIComponent(mesaj), 303);
    }
    throw new Error('Geçersiz finans işlemi.');
  } catch (e) {
    hatalar = [e instanceof Error && e.name !== 'ZodError' ? e.message : 'Girilen değerleri kontrol edin.'];
  }
}

const [finans, tum, pySiparisler, envAyar] = await Promise.all([
  finansOku(),
  siparisleriOku(),
  pazaryeriSiparisleriOku().catch(() => []),
  envanterAyarlariOku().catch(() => undefined),
]);
const siparisler = tum.filter((s) => !s.paytr?.test).sort((a, b) => Date.parse(b.tarih) - Date.parse(a.tarih));
const aktifPySiparisler = pySiparisler.filter((s) => SATIS_DURUMLARI.has(s.durum));
const pyTarihGun = (iso: string) => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Istanbul' }).format(new Date(iso));
const pyDonemOzet = (bGun: string, sGun: string, kanal?: 'trendyol' | 'hepsiburada') => {
  const secilen = aktifPySiparisler.filter((s) => {
    if (kanal && s.kanal !== kanal) return false;
    const g = pyTarihGun(s.tarih);
    return g >= bGun && g <= sGun;
  });
  return {
    adet: secilen.length,
    // Kısmi iptalde yalnız satış sayılan kalemler (Genel Bakış ve muhasebe dökümüyle aynı — denetim AUD-024)
    toplam: secilen.reduce((t, s) => t + satisTutari(s), 0),
  };
};
const bugun = finansGunu();

/* Seçili ay (Özet ve Giderler): ?ay=2026-11 */
const ay = /^\d{4}-\d{2}$/.test(q0.get('ay') ?? '') && q0.get('ay')! <= bugun.slice(0, 7) ? q0.get('ay')! : bugun.slice(0, 7);
const ayDonemi = aylar(ay + '-01', ay === bugun.slice(0, 7) ? bugun : new Date(Date.UTC(+ay.slice(0, 4), +ay.slice(5, 7), 0)).toISOString().slice(0, 10))[0]!;
const ayKaydir = (n: number) => { const d = new Date(Date.UTC(+ay.slice(0, 4), +ay.slice(5, 7) - 1 + n, 1)); return d.toISOString().slice(0, 7); };
const ayRaporu = raporla(finans, siparisler, ayDonemi.bas, ayDonemi.son, pySiparisler);
const ayTySiparis = pyDonemOzet(ayDonemi.bas, ayDonemi.son, 'trendyol');
const ayHbSiparis = pyDonemOzet(ayDonemi.bas, ayDonemi.son, 'hepsiburada');
const bugunPySiparis = pyDonemOzet(bugun, bugun);
const kalan = (r: ReturnType<typeof raporla>) => kalanTutar(r);
const bugunSatis = raporla(finans, siparisler, bugun, bugun, pySiparisler);
const buAy = raporla(finans, siparisler, bugun.slice(0, 7) + '-01', bugun, pySiparisler);
const buAyPySiparis = pyDonemOzet(bugun.slice(0, 7) + '-01', bugun);
const son6 = aylar(ayKaydir(-5) + '-01', ayDonemi.son).map((a) => ({
  ...a,
  r: raporla(finans, siparisler, a.bas, a.son, pySiparisler),
  py: pyDonemOzet(a.bas, a.son),
})).reverse();

const { bas, son } = donem(q0);
const rapor = raporla(finans, siparisler, bas, son, pySiparisler);
const donemTySiparis = pyDonemOzet(bas, son, 'trendyol');
const donemHbSiparis = pyDonemOzet(bas, son, 'hepsiburada');
const tyBulutAktif = !['canli', 'test'].includes(pazaryeriApiDurumu('trendyol')) && Boolean(envAyar?.kanallar.trendyol.sonApi);
const belgeGerekenler = siparisler.filter((s) => onayliSatis(s) && !finans.belgeler.some((b) => b.siparisNo === s.no && belgeGecerli(b)));
const isler = siparisler.filter((s) => gonderilecek(s) || belgeGerekenler.includes(s));
const q = (q0.get('q') ?? '').trim();
const aranan = q.toLocaleLowerCase('tr');
const ayAdi = (tarih: string) => new Intl.DateTimeFormat('tr-TR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(tarih));
const giderler = [...finans.giderler].sort((a, b) => b.tarih.localeCompare(a.tarih)).filter((g) =>
  aranan ? aranan.split(/\s+/).every((x) => (GIDER_KATEGORILERI[g.kategori] + ' ' + g.not + ' ' + g.tarih + ' ' + ayAdi(g.tarih)).toLocaleLowerCase('tr').includes(x))
    : g.tarih.startsWith(ay));
const giderToplam = giderler.reduce((t, g) => t + g.tutar, 0);
const giderKategori = Object.entries(giderler.reduce((t, g) => ({ ...t, [g.kategori]: (t[g.kategori] ?? 0) + g.tutar }), {} as Record<string, number>)).sort((a, b) => b[1] - a[1]);
const duzenlenen = finans.giderler.find((g) => g.id === q0.get('duzenle'));
if (duzenlenen && !acikPencere) acikPencere = 'gider-duzenle';
const duzenGider = acikPencere === 'gider-duzenle' && taslak ? { id: metin(taslak, 'id'), tarih: metin(taslak, 'tarih'), tutarYazi: metin(taslak, 'tutar'), kategori: metin(taslak, 'kategori'), not: metin(taslak, 'not') }
  : duzenlenen ? { id: duzenlenen.id, tarih: duzenlenen.tarih, tutarYazi: (duzenlenen.tutar / 100).toFixed(2).replace('.', ','), kategori: duzenlenen.kategori, not: duzenlenen.not } : undefined;

const belgeler = [...finans.belgeler].sort((a, b) => b.olusturma.localeCompare(a.olusturma))
  .filter((b) => !aranan || ((b.belgeNo ?? '') + ' ' + b.siparisNo + ' ' + BELGE_TURLERI[b.tur]).toLocaleLowerCase('tr').includes(aranan));
const disari = (tur: string, b = bas, s = son) => '/yonetim/finans/rapor?' + new URLSearchParams({ tur, baslangic: b, bitis: s });
const kalanlar = rapor.trendyol.filter((x) => x.banka === undefined).reduce((t, x) => t + hakEdis(x), 0);
const banka = rapor.trendyol.reduce((t, x) => t + (x.banka ?? 0), 0);
const farklar = rapor.trendyol.filter((x) => x.banka !== undefined && x.banka !== hakEdis(x)).length;
const ayar = finans.ayarlar;
const TURLER = Object.keys(BELGE_TURLERI) as BelgeTuru[];
const hazirAraliklar = (() => {
  const y = bugun.slice(0, 4);
  const gecen = new Date(Date.UTC(+bugun.slice(0, 4), +bugun.slice(5, 7) - 2, 1)).toISOString().slice(0, 7);
  const gecenSon = new Date(Date.UTC(+gecen.slice(0, 4), +gecen.slice(5, 7), 0)).toISOString().slice(0, 10);
  return [['Bu ay', bugun.slice(0, 7) + '-01', bugun], ['Geçen ay', gecen + '-01', gecenSon], ['Bu yıl', y + '-01-01', bugun]] as const;
})();
const durumSinifi = (d: string) => d === 'hata' ? 'kirmizi' : d === 'hazirlaniyor' ? 'turuncu' : d === 'iptal' ? 'gri' : 'yesil';
const SEKME_BASLIKLARI: Record<string, [string, string]> = {
  ozet: ['Finans Özeti ve Net Kazanç', 'Onaylı web satışları, kesinleşen pazaryeri hakedişleri, ürün alış maliyetleri ve dış giderlerden cebinize kalan net tutarı takip edin.'],
  belgeler: ['Koli ve Sipariş Belgeleri', 'Web siparişleri için paket içi fiş, sipariş özeti, toplama listesi ve iade formlarını tek tıkla üretin.'],
  giderler: ['Dış Giderler ve Maliyet', 'Kargo faturası, koli/paketleme, reklam ve muhasebe gibi dış giderlerinizi fişleriyle birlikte kaydedin.'],
  trendyol: ['Trendyol Cari Hakediş ve Mutabakat', 'Trendyol’dan yatan net ödemeleri, komisyon/kargo kesintilerini ve vade bekleyen alacakları kontrol edin.'],
  raporlar: ['Muhasebe Raporları ve Arşiv', 'Mali müşavirinize hazır Excel paketi, resmi fatura/belge ZIP arşivi ve yönetici dönem özetini indirin.'],
};
const [sayfaBaslik, sayfaAltBaslik] = SEKME_BASLIKLARI[sekme] ?? ['Finans ve Belgeler', 'Gelir, gider, belge ve muhasebe kayıtlarını takip edin.'];
---
<Yonetim baslik={sayfaBaslik} altBaslik={sayfaAltBaslik} aktif="finans" genis basari={q0.get('ok')} hatalar={[...hatalar, ...(q0.get('hata') ? [q0.get('hata')!] : [])]}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/finans/faturalar"><PIkon ad="fatura" boyut={17} />Faturalar (e-Arşiv)</a>
    <a class="btn btn--cizgi" href={'?sekme=giderler&ay=' + bugun.slice(0, 7) + '#gider-form-kart'}><PIkon ad="arti" boyut={17} />Gider Ekle</a>
    <a class="btn btn--sepet" href={disari('excel', ayDonemi.bas, ayDonemi.son)}><PIkon ad="indir" boyut={17} />Muhasebe Excel (.XLSX)</a>
  </div>

  <nav class="y-sekmeler y-finans-nav" aria-label="Finans bölümleri">
    <a href={'?sekme=ozet&ay=' + ay} aria-current={sekme === 'ozet' ? 'page' : undefined}>Finans Özeti</a>
    <a href="/yonetim/finans/faturalar">Faturalar (e-Arşiv)</a>
    <a href={'?sekme=giderler&ay=' + ay} aria-current={sekme === 'giderler' ? 'page' : undefined}>Dış Giderler</a>
    <a href="?sekme=belgeler" aria-current={sekme === 'belgeler' ? 'page' : undefined}>Koli Belgeleri</a>
    <a href="?sekme=trendyol" aria-current={sekme === 'trendyol' ? 'page' : undefined}>Trendyol Hakediş</a>
    <a href="/yonetim/finans/trendyol-karlilik">Trendyol Kârlılık</a>
    <a href="/yonetim/finans/hepsiburada">Hepsiburada</a>
    <a href="?sekme=raporlar" aria-current={sekme === 'raporlar' ? 'page' : undefined}>Muhasebe Raporu</a>
  </nav>

  <div class="fn-zincir" aria-label="Finans bölümleri nasıl birbirine bağlanır?">
    <a href="?sekme=belgeler" class:list={['fn-zincir__adim', { 'is-aktif': sekme === 'belgeler' }]}>
      <span class="fn-zincir__no">1</span>
      <div><strong>Sipariş & Belgeler</strong><small>Web satışları ve koli belgeleri</small></div>
    </a>
    <span class="fn-zincir__isaret" aria-hidden="true">+</span>
    <a href="?sekme=trendyol" class:list={['fn-zincir__adim', { 'is-aktif': sekme === 'trendyol' }]}>
      <span class="fn-zincir__no">2</span>
      <div><strong>Pazaryeri Hakedişleri</strong><small>Trendyol & HB net ödemeleri</small></div>
    </a>
    <span class="fn-zincir__isaret" aria-hidden="true">−</span>
    <a href={'?sekme=giderler&ay=' + ay} class:list={['fn-zincir__adim', { 'is-aktif': sekme === 'giderler' }]}>
      <span class="fn-zincir__no">3</span>
      <div><strong>Giderler & Maliyet</strong><small>Ürün alımı, kargo, reklam</small></div>
    </a>
    <span class="fn-zincir__isaret" aria-hidden="true">=</span>
    <a href={sekme === 'ozet' ? '?sekme=raporlar' : '?sekme=ozet&ay=' + ay} class:list={['fn-zincir__adim', { 'is-aktif': sekme === 'ozet' || sekme === 'raporlar' }]}>
      <span class="fn-zincir__no">4</span>
      <div><strong>Özet & Muhasebe Raporu</strong><small>Tahmini kalan ve Excel/ZIP</small></div>
    </a>
  </div>

  {sekme === 'ozet' && <>
    <div class="y-metrics y-metrics--finans">
      <a class="y-metric" href="/yonetim/siparisler?durum=tumu">
        <PIkon ad="trend" />
        <span>Bugünkü satış (Tüm kanallar)</span>
        <strong>{finansPara((bugunSatis.webSatis - bugunSatis.webIade) + bugunPySiparis.toplam)}</strong>
        <small>Web: {finansPara(bugunSatis.webSatis - bugunSatis.webIade)} · Pazaryeri: {finansPara(bugunPySiparis.toplam)}</small>
      </a>
      <a class="y-metric" href="/yonetim/siparisler?durum=tumu">
        <PIkon ad="sepet" />
        <span>Bu ay brüt sipariş satışı</span>
        <strong>{finansPara((buAy.webSatis - buAy.webIade) + buAyPySiparis.toplam)}</strong>
        <small>Web ({buAy.satislar.length}) + Pazaryeri ({buAyPySiparis.adet} sipariş)</small>
      </a>
      <a class="y-metric y-metric--kirmizi" href={'?sekme=giderler&ay=' + bugun.slice(0, 7)}>
        <PIkon ad="cuzdan" />
        <span>Bu ay maliyet ve gider</span>
        <strong>−{finansPara(buAy.gider + buAy.otoUrunMaliyeti)}</strong>
        <small>Ürün alış: {finansPara(buAy.otoUrunMaliyeti)} · Dış gider: {finansPara(buAy.gider)}</small>
      </a>
      <a class="y-metric y-metric--yesil" href={'?sekme=ozet&ay=' + bugun.slice(0, 7) + '#ay-hesabi'}>
        <PIkon ad="para" />
        <span>Cebe kalan tahmini net · bu ay</span>
        <strong>{finansPara(kalan(buAy))}</strong>
        {buAy.tahmini === undefined ? <small class="y-uyari-kucuk">Bazı ürünlerin alış maliyeti eksik</small> : <small>Web + kesinleşen hakediş − maliyet ve gider</small>}
      </a>
    </div>

    <div class="y-iki-sutun"><div>
    <section class="y-kart" id="ay-hesabi">
      <div class="y-kart__bas">
        <div class="y-ay-secici">
          <a class="y-icon-button" href={'?sekme=ozet&ay=' + ayKaydir(-1)} aria-label="Önceki ay">‹</a>
          <h2><PIkon ad="takvim" /> {ayDonemi.ad} Finans Özeti</h2>
          {ay < bugun.slice(0, 7) ? <a class="y-icon-button" href={'?sekme=ozet&ay=' + ayKaydir(1)} aria-label="Sonraki ay">›</a> : <span class="y-icon-button" aria-hidden="true"></span>}
        </div>
        <a class="y-link" href={disari('pdf', ayDonemi.bas, ayDonemi.son)}>Bu ayın özetini PDF indir</a>
      </div>

      <div class="y-veri-not" style="margin-bottom:12px">
        <PIkon ad="bilgi" boyut={18} />
        <p>
          <strong>Hesap nasıl yapılır? (Neden Brüt Sipariş ile Tahmini Kalan farklı?)</strong>
          Pazaryerinden gelen siparişler anında <em>Brüt sipariş satışı</em>nda görünür; ancak kargodaki veya yeni teslim edilmiş siparişlerin komisyon düşülmüş ödemesi henüz kesinleşmemiştir. Aşağıdaki <strong>Cebe kalan tahmini net</strong> tutarı; <em>Onaylı Web Satışı + Kesinleşen Pazaryeri Hakedişi − Satılan Ürünlerin Alış Maliyeti − Dış Giderler</em> formülüyle kuruşu kuruşuna hesaplanır.
        </p>
      </div>

      <dl class="y-hesap">
        <div><dt>Onaylı web satışları <small>{ayRaporu.satislar.length} sipariş · ödeme tarihine göre</small></dt><dd>{finansPara(ayRaporu.webSatis)}</dd></div>
        <div class="eksi"><dt>Web iade ve iptal geri ödemeleri <small>{ayRaporu.iadeler.filter((x) => x.tutar > 0).length} kayıt</small></dt><dd>−{finansPara(ayRaporu.webIade)}</dd></div>

        <div class="alt">
          <dt>
            Trendyol sipariş satışları (brüt)
            <small>{ayTySiparis.adet} aktif sipariş · <a class="y-link" href="/yonetim/siparisler?kanal=trendyol">siparişleri gör</a></small>
          </dt>
          <dd>{finansPara(ayTySiparis.toplam)}</dd>
        </div>
        {(ayHbSiparis.adet > 0 || ayRaporu.hepsiburada.length > 0) && (
          <div class="alt">
            <dt>
              Hepsiburada sipariş satışları (brüt)
              <small>{ayHbSiparis.adet} aktif sipariş · <a class="y-link" href="/yonetim/siparisler?kanal=hepsiburada">siparişleri gör</a></small>
            </dt>
            <dd>{finansPara(ayHbSiparis.toplam)}</dd>
          </div>
        )}

        <div>
          <dt>
            Trendyol beklenen hakediş (cari hesap)
            <small>
              {ayRaporu.trendyol.length > 0
                ? `${ayRaporu.trendyol.length} cari kayıt · kesintiler düşülmüş`
                : ayTySiparis.adet > 0
                  ? 'Sipariş teslim edildikten sonra cari hesaba düşer · '
                  : 'Bu ay cari hakediş kaydı yok · '}
              <a class="y-link" href="?sekme=trendyol">hakedişleri aç</a>
            </small>
          </dt>
          <dd>{finansPara(ayRaporu.trendyolBeklenen)}</dd>
        </div>

        {(ayRaporu.hepsiburada.length > 0 || ayHbSiparis.adet > 0) && (
          <div>
            <dt>
              Hepsiburada beklenen hakediş (cari hesap)
              <small><a class="y-link" href="/yonetim/finans/hepsiburada#hesabim">kesintiler düşülmüş · gör</a></small>
            </dt>
            <dd>{finansPara(ayRaporu.hepsiburadaBeklenen)}</dd>
          </div>
        )}

