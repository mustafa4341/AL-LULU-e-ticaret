---
import Yonetim from '../../../layouts/Yonetim.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { magazaOku } from '../../../lib/depo';
import { finansPara } from '../../../lib/finans';
import { finansOku } from '../../../lib/finansDepo';
import { trendyolKarlilik } from '../../../lib/karlilik';
import { envanterAyarlariOku, pazaryeriSiparisleriOku } from '../../../lib/pazaryeriDepo';
import { hedefFiyat, satisHesabi } from '../../../lib/hepsiburadaTarife';
import { kanalHedefFiyati } from '../../../lib/pazaryeri';

/** Trendyol ürün bazında satış, kesinti, hakediş ve (maliyet girildiyse) tahmini net kâr. */
const hatalar: string[] = [];
const gun = [30, 90, 365].includes(Number(Astro.url.searchParams.get('gun'))) ? Number(Astro.url.searchParams.get('gun')) : 90;
const [magaza, finans, py, ayar] = await Promise.all([
  magazaOku(),
  finansOku().catch(() => { hatalar.push('Finans kayıtları okunamadı.'); return undefined; }),
  pazaryeriSiparisleriOku().catch(() => { hatalar.push('Pazaryeri siparişleri okunamadı.'); return []; }),
  envanterAyarlariOku().catch(() => undefined),
]);
const urunMap = new Map(magaza.urunler.map((u) => [u.id, u]));
const kdv = (id?: string): number => (id ? ayar?.kanallar.trendyol.ilanlar[id]?.kdv ?? finans?.hbUrunler[id]?.kdv : undefined) ?? 20;
const tyUrunler = ayar?.kanallar.trendyol.urunler ?? {};
const komisyonOrani = (id?: string) => { const bp = id ? tyUrunler[id]?.komisyonBp : undefined; return bp === undefined ? undefined : bp / 10_000; };
const rapor = finans ? trendyolKarlilik(py, finans, magaza, gun, kdv, komisyonOrani) : undefined;

/* ---- Satış başı tahmini kâr: ilanın Trendyol komisyon oranı + alış maliyeti ---- */
const kargoFirmasi = finans?.hbAyar.kargoFirmasi || 'aras';
const birimSatirlar = magaza.urunler
  .filter((u) => tyUrunler[u.id]?.kod && tyUrunler[u.id]?.satista !== false)
  .map((u) => {
    const e = tyUrunler[u.id]!;
    const fiyatTL = e.kanalFiyat && e.kanalFiyat > 0
      ? e.kanalFiyat
      : e.ozelFiyat && e.ozelFiyat > 0
        ? e.ozelFiyat
        : kanalHedefFiyati(u, ayar?.kanallar.trendyol).hedef;
    const fiyat = Math.round(fiyatTL * 100);
    const hb = finans?.hbUrunler[u.id];
    const desi = ayar?.kanallar.trendyol.ilanlar[u.id]?.desi ?? hb?.desi ?? 3;
    const girdi = e.komisyonBp === undefined ? undefined : {
      oranBp: e.komisyonBp, komisyonKdvDahil: true, urunKdv: kdv(u.id), desi, kargoFirmasi,
      islemBedeli: 0, hizmetBedeli: 0, stopajBp: 100, maliyet: hb?.maliyet,
    };
    const h = girdi ? satisHesabi({ ...girdi, fiyat }) : undefined;
    const komisyonTutar = h ? h.kalemler[0]!.net + h.kalemler[0]!.kdv : undefined;
    const kargoTutar = h ? h.kalemler[1]!.net + h.kalemler[1]!.kdv : undefined;
    return {
      id: u.id,
      marka: u.marka,
      kisaAd: u.kisaAd,
      gorsel: u.gorseller[0]?.src,
      barkod: e.kod,
      stok: u.stok,
      desi,
      oranBp: e.komisyonBp,
      fiyat,
      komisyonTutar,
      kargoTutar,
      maliyet: hb?.maliyet,
      yatan: h?.hesabaYatan,
      kar: h?.netKar,
      marj: h?.marj,
      basaBas: girdi ? hedefFiyat(girdi, 0) : undefined,
    };
  })
  .sort((a, b) => (b.kar ?? -1e12) - (a.kar ?? -1e12));

const komisyonsuz = birimSatirlar.filter((r) => r.oranBp === undefined).length;
const zarardakiSayi = birimSatirlar.filter((r) => (r.kar ?? 0) < 0).length;
const yuzde = (n?: number) => n === undefined ? '—' : '%' + (n * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 });
const para = (n?: number) => n === undefined ? '—' : finansPara(n);
const isaretli = (n?: number) => n === undefined ? '—' : (n < 0 ? '−' : '+') + finansPara(Math.abs(n));
const maliyetsiz = rapor?.satirlar.filter((r) => r.urunId && r.maliyet === undefined).length ?? 0;
---
<Yonetim baslik="Trendyol Ürün Kârlılığı" altBaslik="Her üründe müşterinin ödediği fiyattan kesintiler ve alış maliyeti düşüldükten sonra cebinize ne kaldığını net görün." aktif="finans" genis {hatalar}>
  <KanalLogo slot="baslik-onu" kanal="trendyol" boyut="buyuk" />
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/fiyatlar?gorunum=trendyol"><PIkon ad="etiket" boyut={17} />Fiyat ve Maliyet Düzenle</a>
    <a class="btn btn--cizgi" href="/yonetim/finans?sekme=trendyol"><PIkon ad="banka" boyut={17} />Trendyol Cari Hakediş</a>
    {[30, 90, 365].map((g) => <a class:list={['btn', 'btn--kucuk', g === gun ? 'btn--sepet' : 'btn--cizgi']} href={'?gun=' + g}>Son {g} gün</a>)}
  </div>

  <nav class="y-sekmeler y-finans-nav" aria-label="Finans bölümleri" style="margin-bottom:16px">
    <a href="/yonetim/finans?sekme=ozet">Finans Özeti</a>
    <a href="/yonetim/finans/faturalar">Faturalar (e-Arşiv)</a>
    <a href="/yonetim/finans?sekme=giderler">Dış Giderler</a>
    <a href="/yonetim/finans?sekme=belgeler">Koli Belgeleri</a>
    <a href="/yonetim/finans?sekme=trendyol">Trendyol Hakediş</a>
    <a href="/yonetim/finans/trendyol-karlilik" aria-current="page">Trendyol Kârlılık</a>
    <a href="/yonetim/finans/hepsiburada">Hepsiburada</a>
    <a href="/yonetim/finans?sekme=raporlar">Muhasebe Raporu</a>
  </nav>

  {/* Nasıl hesaplanır şeridi */}
  <div class="kr-formul" aria-label="Kâr hesabı adımları">
    <div class="kr-formul__kutu">
      <span class="kr-formul__no">1</span>
      <div><strong>Trendyol Satış Fiyatı</strong><small>Müşterinin ödediği tutar</small></div>
    </div>
    <span class="kr-formul__isaret" aria-hidden="true">−</span>
    <div class="kr-formul__kutu kr-formul__kutu--kesinti">
      <span class="kr-formul__no">2</span>
      <div><strong>Komisyon + Kargo</strong><small>Trendyol kesintileri</small></div>
    </div>
    <span class="kr-formul__isaret" aria-hidden="true">=</span>
    <div class="kr-formul__kutu kr-formul__kutu--yatan">
      <span class="kr-formul__no">3</span>
      <div><strong>Bankaya Yatan</strong><small>Hesabınıza geçen hakediş</small></div>
    </div>
    <span class="kr-formul__isaret" aria-hidden="true">−</span>
    <div class="kr-formul__kutu">
      <span class="kr-formul__no">4</span>
      <div><strong>Ürün Alış Maliyeti</strong><small>KDV hariç geliş fiyatı</small></div>
    </div>
    <span class="kr-formul__isaret" aria-hidden="true">=</span>
    <div class="kr-formul__kutu kr-formul__kutu--kar">
      <span class="kr-formul__no">✓</span>
      <div><strong>Cebe Kalan Net Kâr</strong><small>Gerçek ürün kazancınız</small></div>
    </div>
  </div>

  {/* 1. TABLO: SATIŞ BAŞI GÜNCEL KÂRLILIK */}
  <section class="y-kart" id="birim">
    <div class="y-kart__bas">
      <div>
        <h2><PIkon ad="yuzde" /> 1 Adet Satışta Cebime Ne Kalır? ({birimSatirlar.length} Bağlı Ürün)</h2>
        <p class="y-kart__alt">Trendyol’daki güncel satış fiyatınız ve ürünün gerçek komisyon oranıyla 1 adet satıldığında oluşacak tablo.</p>
      </div>
      <div class="y-ust-aksiyonlar">
        {zarardakiSayi > 0
          ? <span class="y-chip y-chip--kirmizi">{zarardakiSayi} ürün zararda</span>
          : <span class="y-chip y-chip--yesil">Tüm bağlı ürünler kârda</span>}
        <a class="btn btn--cizgi btn--kucuk" href="/yonetim/siparisler/trendyol-ilanlar"><PIkon ad="zincir" boyut={15} />Trendyol İlanları</a>
      </div>
    </div>

    {komisyonsuz > 0 && <p class="y-uyari">{komisyonsuz} ürünün komisyon oranı henüz okunmadı; oranlar Trendyol’dan günde bir (ve “Trendyol ilanları” ekranı açılınca) otomatik alınır.</p>}

    {birimSatirlar.length ? (
      <div class="y-tablo-kap kr-tablo-kap">
        <table class="y-tablo kr-tablo">
          <thead>
            <tr class="kr-grup-baslik">
              <th>Ürün ve Bağlantı</th>
              <th colspan="2" class="kr-bolge-satis">Satış ve Trendyol Kesintileri</th>
              <th class="kr-bolge-yatan">Bankaya Giren</th>
              <th colspan="2" class="kr-bolge-kar">Maliyet ve Net Kazanç</th>
              <th class="kr-bolge-taban">Alt Sınır</th>
            </tr>
            <tr>
              <th>Ürün</th>
              <th class="y-sayi kr-bolge-satis">Trendyol Fiyatı</th>
              <th class="y-sayi">Komisyon &amp; Kargo</th>
              <th class="y-sayi kr-bolge-yatan">Hesaba Yatan</th>
              <th class="y-sayi kr-bolge-kar">Alış (KDV Hrç)</th>
              <th class="y-sayi">Net Kâr &amp; Marj</th>
              <th class="y-sayi kr-bolge-taban">Zararsız En Düşük</th>
            </tr>
          </thead>
          <tbody>
            {birimSatirlar.map((r) => {
              const zararda = (r.kar ?? 0) < 0;
              return (
                <tr class:list={{ 'kr-satir--zarar': zararda }}>
                  <td data-etiket="Ürün" class="kr-urun-hucre">
                    <div class="kr-urun">
                      <a class="kr-foto" href={'/yonetim/urunler/' + encodeURIComponent(r.id)} tabindex="-1" aria-hidden="true">
                        {r.gorsel ? <img src={r.gorsel} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <PIkon ad="kutu" boyut={22} />}
                      </a>
                      <div class="kr-urun__bilgi">
                        <span class="kr-marka">{r.marka}</span>
                        <a class="kr-ad" href={'/yonetim/urunler/' + encodeURIComponent(r.id)}>{r.kisaAd}</a>
                        <div class="kr-alt-etiketler">
                          <span class="kr-etiket">Barkod: {r.barkod}</span>
                          <span class="kr-etiket">Stok: {r.stok}</span>
                        </div>
                      </div>
                    </div>
                  </td>

                  <td data-etiket="Trendyol Fiyatı" class="y-sayi kr-bolge-satis">
                    <strong class="kr-tutar kr-tutar--satis">{para(r.fiyat)}</strong>
                    <small class="kr-not">KDV dahil satış</small>
                  </td>

                  <td data-etiket="Komisyon & Kargo" class="y-sayi">
                    <span class="kr-kesinti-oran">
                      {r.oranBp !== undefined ? '%' + (r.oranBp / 100).toLocaleString('tr-TR') + ' komisyon' : 'Oran bekleniyor'}
                    </span>
                    {r.komisyonTutar !== undefined && (
                      <small class="kr-not">−{para(r.komisyonTutar)} kom. · −{para(r.kargoTutar)} kargo ({r.desi} desi)</small>
                    )}
                  </td>

                  <td data-etiket="Hesaba Yatan" class="y-sayi kr-bolge-yatan">
                    <strong class="kr-tutar kr-tutar--yatan">{para(r.yatan)}</strong>
                    <small class="kr-not">Bankaya yatacak</small>
                  </td>

                  <td data-etiket="Alış (KDV hariç)" class="y-sayi kr-bolge-kar">
                    {r.maliyet !== undefined ? (
                      <>
                        <span class="kr-tutar">{para(r.maliyet)}</span>
                        <small class="kr-not">Birim geliş</small>
                      </>
                    ) : (
                      <a class="y-chip y-chip--turuncu" href={'/yonetim/fiyatlar?gorunum=trendyol#f-' + encodeURIComponent(r.id)}>Maliyet Gir →</a>
                    )}
                  </td>

                  <td data-etiket="Net Kâr" class:list={['y-sayi', 'kr-kar-hucre', zararda ? 'is-zarar' : r.kar !== undefined ? 'is-kar' : '']}>
                    <strong class="kr-tutar kr-tutar--kar">{r.kar !== undefined ? isaretli(r.kar) : '—'}</strong>
                    {r.marj !== undefined && (
                      <span class:list={['kr-marj', zararda ? 'kr-marj--kirmizi' : 'kr-marj--yesil']}>
                        {yuzde(r.marj)} marj
                      </span>
                    )}
                  </td>

                  <td data-etiket="Zararsız En Düşük Fiyat" class="y-sayi kr-bolge-taban">
                    <strong class="kr-tutar kr-tutar--taban">{para(r.basaBas)}</strong>
                    <small class="kr-not">Bu fiyatın altı zarar</small>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : <p class="y-bos">Trendyol’a bağlı ürün bulunmuyor.</p>}

    <p class="y-help" style="margin-top:12px">
      <strong>Not:</strong> Kargo kesintisi, sipariş sonrası kesinti faturasıyla kesinleştiği için burada {kargoFirmasi === 'aras' ? 'Aras Kargo' : kargoFirmasi} desi tarifesiyle tahmin edilir. Kesinleşen sipariş kesintileri aşağıdaki gerçekleşen satış tablosunda yer alır.
    </p>
  </section>

  {/* 2. BÖLÜM: DÖNEMDE GERÇEKLEŞEN SATIŞLAR */}
  {rapor && <>
    <div class="y-metrics y-metrics--finans">
      <div class="y-metric y-metric--altin"><PIkon ad="para" /><span>Son {gun} Gün Brüt Satış</span><strong>{para(rapor.toplam.brut)}</strong><small>Müşterilerin ödediği toplam</small></div>
      <div class="y-metric y-metric--kirmizi"><PIkon ad="yuzde" /><span>Komisyon + Kargo + Hizmet</span><strong>−{para(rapor.toplam.komisyon + rapor.toplam.kargo + rapor.toplam.diger)}</strong><small>Platform kesintileri</small></div>
      <div class="y-metric y-metric--mavi"><PIkon ad="banka" /><span>Hesaba Yatacak (Hakediş)</span><strong>{para(rapor.toplam.hakedis)}</strong><small>Maliyet düşülmemiş banka tutarı</small></div>
      <div class:list={['y-metric', (rapor.toplam.netKar ?? 0) < 0 ? 'y-metric--kirmizi' : 'y-metric--yesil']}><PIkon ad="grafik" /><span>Gerçekleşen Tahmini Net Kâr</span><strong>{para(rapor.toplam.netKar)}</strong><small>Alış maliyeti ve KDV sonrası</small></div>
    </div>

    {(rapor.ekstresiz > 0 || maliyetsiz > 0) && <div class="y-veri-not" role="status"><PIkon ad="bilgi" boyut={18} /><p>
      {rapor.ekstresiz > 0 && <><strong>{rapor.ekstresiz} siparişin Trendyol cari ekstresi henüz kesilmedi</strong> (müşteriye teslimat sonrası oluşur); komisyonu ürünün kendi komisyon oranıyla tahmin edildi (“tahmini” rozetli). </>}
      {maliyetsiz > 0 && <>{maliyetsiz} ürünün alış maliyeti girilmemiş; <a class="y-link" href="/yonetim/fiyatlar">Fiyat ve Maliyet Tablosu</a>ndan girerek net kârı tamamlayın.</>}
    </p></div>}

    <section class="y-kart">
      <div class="y-kart__bas">
        <div>
          <h2><PIkon ad="liste" /> Gerçekleşen Trendyol Satışları (Son {gun} Gün)</h2>
          <p class="y-kart__alt">Bu dönemde gerçekten satılan ürünlerin adet, kesinti, hakediş ve net kâr toplamları.</p>
        </div>
        <span class="y-chip y-chip--gri">{rapor.satirlar.length} satılan ürün</span>
      </div>
      {rapor.satirlar.length ? (
        <div class="y-tablo-kap kr-tablo-kap">
          <table class="y-tablo kr-tablo">
            <thead>
              <tr>
                <th>Satılan Ürün</th>
                <th class="y-sayi">Adet</th>
                <th class="y-sayi kr-bolge-satis">Brüt Satış</th>
                <th class="y-sayi">Komisyon &amp; Kargo</th>
                <th class="y-sayi kr-bolge-yatan">Hakediş</th>
                <th class="y-sayi kr-bolge-kar">Toplam Maliyet</th>
                <th class="y-sayi kr-bolge-kar">Net Kâr &amp; Marj</th>
              </tr>
            </thead>
            <tbody>
              {rapor.satirlar.map((r) => {
                const u = r.urunId ? urunMap.get(r.urunId) : undefined;
                const zararda = (r.netKar ?? 0) < 0;
                return (
                  <tr class:list={{ 'kr-satir--zarar': zararda }}>
                    <td data-etiket="Ürün" class="kr-urun-hucre">
                      <div class="kr-urun">
                        <span class="kr-foto">
                          {u?.gorseller[0]?.src ? <img src={u.gorseller[0].src} alt="" width="52" height="52" loading="lazy" decoding="async" /> : <PIkon ad="kutu" boyut={20} />}
                        </span>
                        <div class="kr-urun__bilgi">
                          {u && <span class="kr-marka">{u.marka}</span>}
                          {r.urunId
                            ? <a class="kr-ad" href={'/yonetim/urunler/' + encodeURIComponent(r.urunId)}>{u ? u.kisaAd : r.ad}</a>
                            : <strong class="kr-ad">{r.ad} <small class="muted">(eşleşmemiş)</small></strong>}
                          {r.tahmini > 0 && <span class="y-chip y-chip--turuncu" style="margin-top:3px">{r.tahmini} sipariş henüz ekstresiz (tahmini)</span>}
                        </div>
                      </div>
                    </td>
                    <td data-etiket="Adet" class="y-sayi"><strong class="kr-tutar">{r.adet}</strong><small class="kr-not">adet</small></td>
                    <td data-etiket="Brüt Satış" class="y-sayi kr-bolge-satis">
                      <strong class="kr-tutar">{para(r.brut)}</strong>
                      {(r.indirim + r.iade) > 0 && <small class="kr-not">İade/İnd: −{para(r.indirim + r.iade)}</small>}
                    </td>
                    <td data-etiket="Komisyon & Kargo" class="y-sayi">
                      <span class="kr-tutar">−{para(r.komisyon + r.kargo + r.diger)}</span>
                      <small class="kr-not">Kom: {para(r.komisyon)} · Krg/Hiz: {para(r.kargo + r.diger)}</small>
                    </td>
                    <td data-etiket="Hakediş" class="y-sayi kr-bolge-yatan">
                      <strong class="kr-tutar kr-tutar--yatan">{para(r.hakedis)}</strong>
                    </td>
                    <td data-etiket="Toplam Maliyet" class="y-sayi kr-bolge-kar">
                      <span class="kr-tutar">{para(r.maliyet)}</span>
                    </td>
                    <td data-etiket="Net Kâr" class:list={['y-sayi', 'kr-kar-hucre', zararda ? 'is-zarar' : r.netKar !== undefined ? 'is-kar' : '']}>
                      <strong class="kr-tutar kr-tutar--kar">{r.netKar !== undefined ? isaretli(r.netKar) : '—'}</strong>
                      {r.marj !== undefined && <span class:list={['kr-marj', zararda ? 'kr-marj--kirmizi' : 'kr-marj--yesil']}>{yuzde(r.marj)} marj</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : <p class="y-bos">Seçili {gun} günlük dönemde henüz Trendyol satışı bulunmuyor.</p>}
      {rapor.siparisDisi > 0 && <p class="y-help" style="margin-top:10px">Ayrıca tekil siparişe bağlı olmayan platform kesinti faturaları: <strong>{para(rapor.siparisDisi)}</strong>.</p>}
      <p class="y-help"><strong>Hesaba yatacak tutar (hakediş) net kâr değildir.</strong> Net kâr KDV hariç hesaplanır: satıştaki KDV ve kesinti faturalarındaki KDV mahsup edilir, ürün alış maliyeti düşülür.</p>
    </section>
  </>}
</Yonetim>

<style>
  .kr-formul {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid #e6dccf;
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 18px;
    overflow-x: auto;
  }
  .kr-formul__kutu {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 165px;
    padding: 9px 12px;
    border-radius: 10px;
    background: #faf7f2;
    border: 1px solid #ece3d6;
  }
  .kr-formul__kutu strong { display: block; font-size: 13.5px; color: #2b2017; }
  .kr-formul__kutu small { display: block; font-size: 12px; color: #75685a; margin-top: 1px; }
  .kr-formul__kutu--kesinti { background: #fff6f4; border-color: #f2d0ca; }
  .kr-formul__kutu--yatan { background: #f2f7fd; border-color: #cde0f5; }
  .kr-formul__kutu--kar { background: #effaf3; border-color: #bce5ca; }
  .kr-formul__no {
    width: 24px; height: 24px; border-radius: 999px;
    background: #3d2c1e; color: #fff; font-size: 12px; font-weight: 700;
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .kr-formul__kutu--kar .kr-formul__no { background: #0d7a3e; }
  .kr-formul__isaret { font-size: 18px; font-weight: 800; color: #8c7b69; padding: 0 2px; }

  .kr-tablo-kap { border-radius: 14px; border: 1px solid #e4d9ca; overflow-x: auto; }
