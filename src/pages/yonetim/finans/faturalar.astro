---
import Yonetim from '../../../layouts/Yonetim.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { epostaBagli } from '../../../lib/altyapi';
import { siparisleriOku } from '../../../lib/depo';
import { finansGunu, finansPara, gecerliGun, type FaturaKaydi } from '../../../lib/finans';
import { faturaDosyaKaydet, faturaEki, faturaGuncelle, faturaKaydet, finansOku } from '../../../lib/finansDepo';
import { FATURA_KANAL_ADLARI, GENEL_TCKN, GIB_PORTAL, faturaAdaylari, sayiYaz, tlYaz, type FaturaAdayi, type FaturaKanali } from '../../../lib/faturaMerkezi';
import { evet, metin } from '../../../lib/form';
import { yonetimGeriAdresi } from '../../../lib/istek';
import { pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { envanterAyarlariOku, pazaryeriSiparisleriOku } from '../../../lib/pazaryeriDepo';
import { faturaIlet } from '../../../lib/faturaIlet';
import { faturaKanalLinki, trendyolFaturalariniAl } from '../../../lib/faturaKanaldan';
import { yTarih } from '../../../lib/yonetimRapor';

const yol = '/yonetim/finans/faturalar';
const q = Astro.url.searchParams;
const hatalar: string[] = [];
const veriOku = async () => {
  const [finans, web, py, ayar] = await Promise.all([
    finansOku(), siparisleriOku(),
    pazaryeriSiparisleriOku().catch(() => { hatalar.push('Pazaryeri siparişleri okunamadı; yalnız web siparişleri listelendi.'); return []; }),
    envanterAyarlariOku().catch(() => undefined),
  ]);
  return { finans, adaylar: faturaAdaylari(finans, web, py, ayar) };
};
const tyBagli = ['canli', 'test'].includes(pazaryeriApiDurumu('trendyol'));
const smtpAcik = epostaBagli();
const waFaturaLinki = (a: FaturaAdayi, faturaNo: string) => {
  const tel = (a.web?.musteri.tel ?? '').replace(/\D/g, '');
  if (!tel) return undefined;
  const tamTel = tel.startsWith('90') ? tel : tel.startsWith('0') ? '9' + tel : '90' + tel;
  const mesaj = `Merhaba ${a.alici.ad}, ${a.siparisNo} numaralı Al Lulu Home siparişinizin ${faturaNo} numaralı e-Arşiv faturası hazırlanmıştır. Sipariş durumunuzu ${Astro.url.origin}/siparis-takip adresinden de görüntüleyebilirsiniz.`;
  return `https://wa.me/${tamTel}?text=${encodeURIComponent(mesaj)}`;
};

const ilet = (a: FaturaAdayi, k: FaturaKaydi, ek: { veri: Buffer; tur: string; ad: string } | undefined, zorla: boolean) => faturaIlet(a, k, ek, Astro.url.origin, zorla);

if (Astro.request.method === 'POST') {
  let geriHam = '';
  try {
    const f = await Astro.request.formData();
    geriHam = metin(f, 'geri');
    const don = (tur: 'ok' | 'hata', mesaj: string, varsayilan: string, varsayilanHash = '') =>
      Astro.redirect(yonetimGeriAdresi(geriHam, Astro.url, varsayilan, { tur, mesaj }, varsayilanHash), 303);
    const eylem = metin(f, 'eylem');
    const { finans, adaylar } = await veriOku();
    if (eylem === 'kaydet') {
      const a = adaylar.find((x) => x.anahtar === metin(f, 'anahtar'));
      if (!a) throw new Error('Sipariş bulunamadı. Listeyi yenileyin.');
      const no = metin(f, 'no').toUpperCase().replace(/\s+/g, ' ');
      if (!/^[A-Z0-9][A-Z0-9 ./-]{0,39}$/.test(no)) throw new Error('Fatura numarasını faturada yazdığı gibi girin (ör. GIB2026000000012).');
      const tarih = metin(f, 'tarih');
      if (!gecerliGun(tarih) || tarih > finansGunu()) throw new Error('Fatura tarihini girin (ileri tarih olamaz).');
      const dosya = f.get('dosya');
      const yuklenen = dosya instanceof File && dosya.size ? dosya : undefined;
      if (yuklenen && yuklenen.size > 4 * 1024 * 1024) throw new Error('Dosya en fazla 4 MB olmalı. PDF’i “küçük boyutlu” kaydedin ya da fotoğrafı daha düşük çözünürlükte çekin.');
      const { kayit, ek } = await faturaKaydet({
        kanal: a.kanal, kayit: a.kayit, siparisNo: a.siparisNo, no, tarih, alici: (a.alici.firma || a.alici.ad).slice(0, 200),
        matrah: a.toplam.matrah, kdv: a.toplam.kdv, toplam: a.toplam.genel,
      }, yuklenen);
      let mesaj = `Fatura ${no} kaydedildi.`;
      if (evet(f, 'ilet')) {
        const iletim = await ilet(a, kayit, ek && kayit.ek ? { ...ek, ad: kayit.ek.ad } : undefined, false);
        mesaj += ' ' + (iletim.mesaj ?? '');
        if (iletim.durum === 'hata') return don('hata', mesaj, `${yol}?sec=${encodeURIComponent(a.anahtar)}`, '#secili');
      }
      return don('ok', mesaj, yol);
    }
    if (eylem === 'trendyoldan-al') {
      if (!tyBagli) throw new Error('Bu işlem için Trendyol bağlantısı gerekir (canlı sitede çalışır).');
      const siparisNo = metin(f, 'siparisNo') || undefined;
      const r = await trendyolFaturalariniAl({ enFazlaSorgu: siparisNo ? 1 : 15, sureMs: 40_000, siparisNo });
      const mesaj = r.alinan.length
        ? `${r.alinan.length} faturanın Trendyol’daki kaydı siteye alındı: ${r.alinan.map((x) => `${x.siparisNo} (${x.no}${x.dosya ? '' : ', yalnız bağlantı'})`).join(', ')}.`
        : r.kontrolEdilen
          ? `Kontrol edilen ${r.kontrolEdilen} Trendyol siparişinin faturası Trendyol’a henüz yüklenmemiş; bu bir hata değil. Faturayı GİB’de kesip buradan kaydedin ya da Trendyol satıcı panelinden yükleyin, site birkaç dakika içinde kendiliğinden alır.`
          : 'Faturası beklenen Trendyol siparişi yok.';
      const dosyaNotu = r.dosyasiTamamlanan.length ? ` ${r.dosyasiTamamlanan.length} faturanın dosyası Trendyol’dan indirilip eklendi.` : '';
      const hata = r.hatalar.length ? ' Sorun: ' + r.hatalar.slice(0, 2).join(' · ') : '';
      const varsayilan = `${yol}${siparisNo ? '?sec=' + encodeURIComponent('trendyol:' + (adaylar.find((x) => x.kanal === 'trendyol' && x.siparisNo === siparisNo)?.kayit ?? '')) : ''}`;
      return don(r.alinan.length || !hata ? 'ok' : 'hata', mesaj + dosyaNotu + hata, varsayilan, siparisNo ? '#secili' : '');
    }
    const k = finans.faturalar.find((x) => x.id === metin(f, 'id'));
    if (!k) throw new Error('Fatura kaydı bulunamadı.');
    const seciliVarsayilan = `${yol}?sec=${encodeURIComponent(k.kanal + ':' + k.kayit)}`;
    if (eylem === 'no-duzelt') {
      const no = metin(f, 'no').toUpperCase().replace(/\s+/g, ' ');
      if (!/^[A-Z0-9][A-Z0-9 ./-]{0,39}$/.test(no)) throw new Error('Fatura numarasını faturada yazdığı gibi girin (ör. GIB2026000000012).');
      if (finans.faturalar.some((x) => x.id !== k.id && !x.iptal && x.no.toUpperCase() === no)) throw new Error('Bu fatura numarası başka bir siparişte kayıtlı.');
      await faturaGuncelle(k.id, (x) => { x.no = no; });
      return don('ok', `Fatura numarası ${no} olarak düzeltildi.`, seciliVarsayilan, '#secili');
    }
    const a = adaylar.find((x) => x.kanal === k.kanal && x.kayit === k.kayit);
    if (eylem === 'dosya-yukle') {
      const dosya = f.get('dosya');
      if (!(dosya instanceof File) || !dosya.size) throw new Error('Yüklenecek PDF veya görsel dosyasını seçin.');
      const { kayit: guncel, ek } = await faturaDosyaKaydet(k.id, dosya);
      let mesaj = 'Fatura dosyası kaydedildi.';
      if (a && evet(f, 'ilet')) {
        const iletim = await ilet(a, guncel, ek, true);
        mesaj += ' ' + (iletim.mesaj ?? '');
        return don(iletim.durum === 'hata' ? 'hata' : 'ok', mesaj, seciliVarsayilan, '#secili');
      }
      return don('ok', mesaj, seciliVarsayilan, '#secili');
    }
    if (eylem === 'ilet') {
      if (!a) throw new Error('Siparişi bulamadım; faturayı elle iletin.');
      const ek = await faturaEki(k.id);
      const iletim = await ilet(a, k, ek && ek.kayit.ek ? { veri: ek.veri, tur: ek.kayit.ek.tur, ad: ek.kayit.ek.ad } : undefined, true);
      return don(iletim.durum === 'hata' ? 'hata' : 'ok', iletim.mesaj ?? 'Tamam.', seciliVarsayilan, '#secili');
    }
    if (eylem === 'elle') {
      await faturaGuncelle(k.id, (x) => { x.iletim = { durum: 'elle', mesaj: 'Müşteriye / kanala iletildi olarak işaretlendi.', tarih: new Date().toISOString() }; });
      const donusDurum = metin(f, 'donusDurum');
      const varsayilanElle = donusDurum ? `${yol}?durum=${encodeURIComponent(donusDurum)}` : yol;
      return don('ok', 'Fatura 3. aşamaya (İletildi) taşındı.', varsayilanElle);
    }
    if (eylem === 'iptal') {
      if (!evet(f, 'onay')) throw new Error('İptal için kutucuğu işaretleyin.');
      await faturaGuncelle(k.id, (x) => { x.iptal = true; });
      return don('ok', 'Kayıt iptal edildi. GİB portalında da faturayı iptal etmeyi unutmayın.', seciliVarsayilan, '#secili');
    }
    throw new Error('Geçersiz işlem.');
  } catch (e) {
    const mesaj = e instanceof Error && e.name !== 'ZodError' ? e.message : 'İşlem tamamlanamadı.';
    if (geriHam) {
      const donus = yonetimGeriAdresi(geriHam, Astro.url, '', { tur: 'hata', mesaj });
      if (donus.startsWith('/yonetim/')) return Astro.redirect(donus, 303);
    }
    hatalar.push(mesaj);
  }
}

const { adaylar } = await veriOku();
const durum = ['kesilecek', 'iletilecek', 'kesildi', 'tumu'].includes(q.get('durum') ?? '') ? q.get('durum')! : 'kesilecek';
const kanal = (['web', 'trendyol', 'hepsiburada'] as const).find((k) => k === q.get('kanal'));
const kesilecek = adaylar.filter((a) => !a.fatura);
const iletilecek = adaylar.filter((a) => a.fatura && (a.fatura.iletim.durum === 'bekliyor' || a.fatura.iletim.durum === 'hata'));
const liste = adaylar
  .filter((a) => (durum === 'kesilecek' ? !a.fatura : durum === 'iletilecek' ? Boolean(a.fatura && (a.fatura.iletim.durum === 'bekliyor' || a.fatura.iletim.durum === 'hata')) : durum === 'kesildi' ? !!a.fatura : true) && (!kanal || a.kanal === kanal))
  .slice(0, 300);
const secili = adaylar.find((a) => a.anahtar === q.get('sec'));
const tarih = (t: string) => yTarih.format(new Date(t));
const filtre = (ek: Record<string, string | undefined>) => yol + '?' + new URLSearchParams(Object.entries({ durum, kanal, ...ek }).filter(([, v]) => v) as [string, string][]);
const ILETIM: Record<FaturaKaydi['iletim']['durum'], [string, string]> = {
  bekliyor: ['2. Aşama · İletim bekliyor', 'turuncu'], hata: ['2. Aşama · İletim hatası', 'kirmizi'], gonderildi: ['3. Aşama · İletildi', 'yesil'], elle: ['3. Aşama · Elle iletildi', 'yesil'], yok: ['2. Aşama · Kaydedildi', 'gri'],
};

const iletimAciklamasi = (k: FaturaKanali) => k === 'trendyol' ? (tyBagli ? 'Kaydedince Trendyol’a otomatik yükle' : 'Trendyol bağlantısı yok; canlı siteden veya satıcı panelinden yükleyin')
  : k === 'web' ? (smtpAcik ? 'Kaydedince müşteriye e-postayla otomatik gönder' : 'Otomatik e-posta (SMTP) kapalı; kaydettikten sonra WhatsApp/e-posta ile iletip “İletildi işaretle”ye basın')
  : 'Hepsiburada satıcı panelinden yükleyip “Yükledim” diye işaretleyin';
const bugun = finansGunu();
const tamamlananSayi = adaylar.filter((a) => a.fatura && (a.fatura.iletim.durum === 'gonderildi' || a.fatura.iletim.durum === 'elle')).length;
---
<Yonetim
  baslik="Faturalar (e-Arşiv)"
  altBaslik="GİB portalında kestiğiniz faturaları kaydedin, Trendyol faturalarını çekin ve müşteriye / pazaryerine iletim durumunu tek ekrandan tamamlayın."
  aktif="finans"
  genis
  basari={q.get('ok')}
  hatalar={[...hatalar, ...(q.get('hata') ? [q.get('hata')!] : [])]}
>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href={GIB_PORTAL} target="_blank" rel="noopener noreferrer"><PIkon ad="dis-baglanti" boyut={17} />GİB e-Arşiv Portalı ↗</a>
    {tyBagli && (
      <form method="post" style="display:inline">
        <button class="btn btn--cizgi" name="eylem" value="trendyoldan-al" type="submit"><PIkon ad="indir" boyut={17} />Trendyol Faturalarını Çek</button>
      </form>
    )}
    <a class="btn btn--sepet" href="/yonetim/siparisler?durum=faturasiz"><PIkon ad="sepet" boyut={17} />Sipariş Kuyruğu</a>
  </div>

  <nav class="y-sekmeler y-finans-nav" aria-label="Finans bölümleri">
    <a href="/yonetim/finans?sekme=ozet">Finans Özeti</a>
    <a href={yol} aria-current="page">Faturalar (e-Arşiv){kesilecek.length > 0 && ` (${kesilecek.length})`}</a>
    <a href="/yonetim/finans?sekme=giderler">Dış Giderler</a>
    <a href="/yonetim/finans?sekme=belgeler">Koli Belgeleri</a>
    <a href="/yonetim/finans?sekme=trendyol">Trendyol Hakediş</a>
    <a href="/yonetim/finans/trendyol-karlilik">Trendyol Kârlılık</a>
    <a href="/yonetim/finans/hepsiburada">Hepsiburada</a>
    <a href="/yonetim/finans?sekme=raporlar">Muhasebe Raporu</a>
  </nav>

  <details class="y-kart" open={!adaylar.some((a) => a.fatura)}>
    <summary><strong>Fatura nasıl kesilir ve iletilir? (3 kolay adım)</strong></summary>
    <ol class="fm-adimlar">
      <li>Aşağıdaki listeden siparişin <strong>“1. Bilgileri Aç &amp; Kaydet”</strong> düğmesine basın. Alıcı, TCKN/VKN, adres ve KDV hariç birim fiyatlar tek tıkla kopyalanmaya hazır açılır.</li>
      <li><a class="y-link" href={GIB_PORTAL} target="_blank" rel="noopener noreferrer">GİB e-Arşiv Portalı’nda</a> bilgileri yapıştırıp faturayı onaylayın ve PDF dosyasını indirin.</li>
      <li>Sağ kutudan 16 haneli fatura numarasını ve PDF’i kaydedin; Trendyol’a otomatik yüklenir veya müşteriye iletilir.</li>
    </ol>
    <p class="y-help">Bireysel alıcının TC kimlik numarası bilinmiyorsa GİB portalında <strong>{GENEL_TCKN}</strong> kullanılır.</p>
  </details>

  <div class="y-metrics y-metrics--finans">
    <a class:list={['y-metric', kesilecek.length > 0 ? 'y-metric--kirmizi' : 'y-metric--yesil']} href={filtre({ durum: 'kesilecek' })}><PIkon ad="fatura" /><span>1. Faturası Kesilecek</span><strong>{kesilecek.length}</strong><small>GİB'de düzenlenip kaydedilecek</small></a>
    <a class:list={['y-metric', iletilecek.length > 0 ? 'y-metric--turuncu' : '']} href={filtre({ durum: 'iletilecek' })}><PIkon ad="gonder" /><span>2. Müşteriye / Kanala İletilecek</span><strong>{iletilecek.length}</strong><small>Kaydedildi · iletim tamamlanacak</small></a>
    <a class="y-metric y-metric--yesil" href={filtre({ durum: 'kesildi' })}><PIkon ad="tik-daire" /><span>3. İletimi Tamamlanan</span><strong>{tamamlananSayi}</strong><small>Müşteriye veya kanala iletildi</small></a>
    <div class="y-metric"><PIkon ad="takvim" /><span>Bu Ay Kesilen Toplam</span><strong>{adaylar.filter((a) => a.fatura && a.fatura.tarih.slice(0, 7) === bugun.slice(0, 7)).length}</strong><small>Bu ayda düzenlenen e-Arşiv</small></div>
  </div>

  {tyBagli && kesilecek.some((a) => a.kanal === 'trendyol') && (
    <form method="post" class="y-veri-not fm-ty-al">
      <PIkon ad="indir" boyut={18} />
      <p><strong>Faturayı Trendyol satıcı panelinden mi yüklediniz?</strong> Site, Trendyol’a yüklenen faturaları her 5 dakikada bir kendiliğinden çeker ve “İletildi” olarak işaretler. Beklemeden almak için sağdaki düğmeye basın.</p>
      <button class="btn btn--cizgi btn--kucuk" name="eylem" value="trendyoldan-al" type="submit">Trendyol’daki Faturaları Şimdi Al</button>
    </form>
  )}

  {durum === 'iletilecek' && iletilecek.length > 0 && (
    <div class="y-veri-not" style="margin-bottom:14px">
      <PIkon ad="bilgi" boyut={18} />
      <p>
        <strong>2. Aşamadaki faturalar 3. aşamaya (İletildi) nasıl geçer?</strong>
        • <strong>Trendyol:</strong> PDF yüklüyse satırdaki <em>“Trendyol’a Yükle”</em> düğmesiyle otomatik gönderilir.<br />
        • <strong>Web Sitesi:</strong> {smtpAcik ? '“E-posta Gönder” ile müşteriye otomatik gider.' : 'PDF’i indirip WhatsApp veya e-postayla müşteriye ilettikten sonra “✓ İletildi İşaretle” düğmesine basın.'}<br />
        • <strong>Hepsiburada:</strong> Satıcı paneline yükledikten sonra <em>“✓ İletildi İşaretle”</em> düğmesine basın.
      </p>
    </div>
  )}

  <div class="fm-filtre-cubuk">
    <nav class="y-sekmeler" aria-label="Fatura aşaması filtresi" style="margin-bottom:0">
      {[['kesilecek', `1. Kesilecek (${kesilecek.length})`], ['iletilecek', `2. İletilecek (${iletilecek.length})`], ['kesildi', 'Kaydedilenler'], ['tumu', `Tümü (${adaylar.length})`]].map(([id, ad]) => <a href={filtre({ durum: id })} aria-current={durum === id ? 'page' : undefined}>{ad}</a>)}
    </nav>
    <nav class="y-sekmeler" aria-label="Kanal filtresi" style="margin-bottom:0">
      <a href={filtre({ kanal: undefined })} aria-current={!kanal ? 'page' : undefined}>Tüm Kanallar</a>
      {(['web', 'trendyol', 'hepsiburada'] as const).map((k) => <a href={filtre({ kanal: k })} aria-current={kanal === k ? 'page' : undefined}>{FATURA_KANAL_ADLARI[k]}</a>)}
    </nav>
  </div>

  {secili && (
    <section class="y-kart fm-secili" id="secili">
      <div class="y-kart__bas">
        <div style="display:flex;align-items:center;gap:12px">
          <KanalLogo kanal={secili.kanal} boyut="orta" />
          <div>
            <h2 style="margin:0">{FATURA_KANAL_ADLARI[secili.kanal]} · Sipariş {secili.siparisNo}</h2>
            <p class="y-kart__alt">{tarih(secili.tarih)} · {secili.durumAdi}{secili.paketNo && secili.paketNo !== secili.siparisNo ? ` · Paket ${secili.paketNo}` : ''}</p>
          </div>
        </div>
        <div class="y-ust-aksiyonlar">
          <a class="btn btn--cizgi btn--kucuk" href={GIB_PORTAL} target="_blank" rel="noopener noreferrer">GİB Portalını Aç ↗</a>
          <a class="btn btn--cizgi btn--kucuk" href={filtre({})}>Paneli Kapat ✕</a>
        </div>
      </div>

      {secili.eksikler.length > 0 && <p class="y-uyari" style="margin-bottom:14px">Eksik bilgi: {secili.eksikler.join(', ')}.</p>}

      <div class="fm-ikili-calisma">
        {/* SOL SÜTUN: GİB KOPYALAMA KARTI */}
        <div class="fm-calisma-kutu">
          <div class="fm-calisma-baslik">
            <span class="fm-adim-no">1</span>
            <div>
              <strong>GİB e-Arşiv Fatura Bilgileri</strong>
              <small>Her satırı sağdaki “Kopyala” düğmesiyle kopyalayıp GİB portalına yapıştırın.</small>
            </div>
          </div>

          <div class="fm-kopya-izgara">
            {secili.alici.tip === 'kurumsal' ? (
              <>
                <div class="fm-kopya-satir">
                  <div><span class="fm-etiket">Firma Unvanı (Kurumsal)</span><strong>{secili.alici.firma ?? secili.alici.ad}</strong></div>
                  <button type="button" class="y-kopya" data-kopyala={secili.alici.firma ?? secili.alici.ad}>Kopyala</button>
                </div>
                <div class="fm-kopya-satir">
                  <div><span class="fm-etiket">Vergi No (VKN) &amp; Vergi Dairesi</span><strong>{secili.alici.vergiNo ?? '—'} · {secili.alici.vergiDairesi ?? '—'}</strong></div>
                  {secili.alici.vergiNo && <button type="button" class="y-kopya" data-kopyala={secili.alici.vergiNo}>VKN Kopyala</button>}
                </div>
              </>
            ) : (
              <>
                <div class="fm-kopya-satir">
                  <div><span class="fm-etiket">Alıcı Ad Soyad (Bireysel)</span><strong>{secili.alici.ad}</strong></div>
                  <button type="button" class="y-kopya" data-kopyala={secili.alici.ad}>Kopyala</button>
                </div>
                <div class="fm-kopya-satir">
                  <div><span class="fm-etiket">TC Kimlik Numarası</span><strong>{secili.alici.tckn}</strong>{secili.alici.tcknBilinmiyor && <small class="muted"> (Bilinmiyor · genel numara)</small>}</div>
                  <button type="button" class="y-kopya" data-kopyala={secili.alici.tckn}>Kopyala</button>
                </div>
              </>
            )}

            <div class="fm-kopya-satir">
              <div>
                <span class="fm-etiket">Adres ({[secili.alici.ilce, secili.alici.il].filter(Boolean).join(' / ') || 'Türkiye'})</span>
                <span>{secili.alici.adres || '—'}</span>
              </div>
              {secili.alici.adres && <button type="button" class="y-kopya" data-kopyala={secili.alici.adres}>Kopyala</button>}
            </div>

            <div class="fm-kopya-satir">
              <div><span class="fm-etiket">Fatura Notu / Açıklama</span><span>{secili.aciklama}</span></div>
              <button type="button" class="y-kopya" data-kopyala={secili.aciklama}>Kopyala</button>
            </div>
          </div>

          <h3 style="margin:14px 0 8px">Mal / Hizmet Satırları</h3>
          <div class="fm-kalem-kutu">
            {secili.satirlar.map((s) => (
              <div class="fm-kalem-satir">
                <div class="fm-kalem-ust">
                  <strong>{s.adet} Adet × {s.ad}</strong>
                  <button type="button" class="y-kopya" data-kopyala={s.ad}>Ürün Adını Kopyala</button>
                </div>
                <div class="fm-kalem-alt">
                  <span>KDV: <strong>%{s.kdvOrani}</strong> · KDV Hariç Birim Fiyat: <strong>{sayiYaz(s.birimHaric)} TL</strong> · KDV Dahil: <strong>{tlYaz(s.dahil)}</strong></span>
                  <button type="button" class="y-kopya" data-kopyala={sayiYaz(s.birimHaric)}>Birim Fiyatı Kopyala</button>
                </div>
              </div>
            ))}
          </div>

          <dl class="y-hesap" style="margin-top:10px">
            <div><dt>Mal / hizmet toplamı (KDV hariç)</dt><dd>{finansPara(secili.toplam.matrah)}</dd></div>
            {secili.toplam.oranlar.map((o) => <div><dt>Hesaplanan KDV (%{o.oran})</dt><dd>{finansPara(o.kdv)}</dd></div>)}
            <div class="sonuc"><dt>Ödenecek Genel Toplam (KDV dahil)</dt><dd>{finansPara(secili.toplam.genel)}</dd></div>
          </dl>
          <p class="y-help" style="margin-top:8px">Kuruş farkı oluşursa portalda birim fiyatı “KDV dahil” ({secili.satirlar.map((s) => sayiYaz(s.birimDahil)).join(' / ')} TL) seçerek hesaplatabilirsiniz.</p>
        </div>

        {/* SAĞ SÜTUN: FATURA KAYIT VE İLETİM KARTI */}
        <div class="fm-calisma-kutu fm-calisma-kutu--sag">
          <div class="fm-calisma-baslik">
            <span class="fm-adim-no fm-adim-no--sag">{secili.fatura ? '2-3' : '2'}</span>
            <div>
              <strong>{secili.fatura ? 'Kaydedilen Fatura ve İletim Durumu' : 'Kestiğiniz Faturayı Panele Kaydedin'}</strong>
              <small>{secili.fatura ? 'PDF görüntüleme, kanala gönderme ve iletim tamamlama.' : 'GİB’den indirdiğiniz PDF dosyasını ve fatura numarasını girin.'}</small>
            </div>
          </div>

          {secili.fatura ? (
            <div class="fm-kesildi">
              <div class="fm-kopya-satir" style="background:#fff">
                <div>
                  <span class="fm-etiket">Kayıtlı Fatura No &amp; Tarih</span>
                  <strong style="font-size:16px">{secili.fatura.no}</strong> · {secili.fatura.tarih.split('-').reverse().join('.')} · <strong>{finansPara(secili.fatura.toplam)}</strong>
                </div>
                {secili.fatura.ek ? (
                  <a class="btn btn--cizgi btn--kucuk" href={'/yonetim/finans/fatura-dosya?id=' + secili.fatura.id} target="_blank" rel="noopener">PDF / Dosyayı Aç ↗</a>
                ) : faturaKanalLinki(secili.fatura) ? (
                  <span class="y-chip y-chip--yesil">✓ Trendyol’da Yüklü</span>
                ) : (
                  <span class="y-chip y-chip--turuncu">Dosya eklenmedi</span>
                )}
              </div>

              <div>
                <span class:list={['y-chip', 'y-chip--' + ILETIM[secili.fatura.iletim.durum][1]]}>{ILETIM[secili.fatura.iletim.durum][0]}</span>
                {secili.fatura.iletim.mesaj && <p class="y-help" style="margin:6px 0 0">{secili.fatura.iletim.mesaj}</p>}
              </div>

              {!secili.fatura.ek ? (
                <form method="post" enctype="multipart/form-data" class="fm-dosya-kutu">
                  <input type="hidden" name="eylem" value="dosya-yukle" />
                  <input type="hidden" name="id" value={secili.fatura.id} />
                  <strong>Fatura PDF veya Görselini Ekleyin</strong>
                  <small class="muted">GİB portalından indirdiğiniz PDF dosyasını seçin (en fazla 4 MB).</small>
                  <input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" required />
                  {secili.kanal !== 'hepsiburada' && (
                    <label class="y-secim"><input type="checkbox" name="ilet" checked={secili.kanal === 'trendyol' ? tyBagli : smtpAcik} /> {secili.kanal === 'trendyol' ? 'Yükleyince Trendyol’a otomatik gönder' : 'Yükleyince müşteriye e-postayla gönder'}</label>
                  )}
                  <button class="btn btn--sepet btn--kucuk" type="submit"><PIkon ad="indir" boyut={15} />Dosyayı Kaydet{secili.kanal !== 'hepsiburada' ? ' ve İlet' : ''}</button>
                </form>
              ) : (
                <details class="fm-dosya-yenile">
                  <summary>Fatura PDF dosyasını değiştir</summary>
                  <form method="post" enctype="multipart/form-data" class="fm-dosya-kutu" style="margin-top:8px">
                    <input type="hidden" name="eylem" value="dosya-yukle" />
                    <input type="hidden" name="id" value={secili.fatura.id} />
                    <input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" required />
                    <button class="btn btn--cizgi btn--kucuk" type="submit">Yeni Dosyayı Kaydet</button>
                  </form>
                </details>
              )}

              <div class="y-ust-aksiyonlar" style="margin-top:6px">
                {secili.kanal === 'trendyol' && secili.fatura.ek && (
                  <form method="post"><input type="hidden" name="id" value={secili.fatura.id} /><button class="btn btn--sepet" name="eylem" value="ilet" type="submit" disabled={!tyBagli}><PIkon ad="gonder" boyut={16} />{secili.fatura.iletim.durum === 'gonderildi' ? 'Trendyol’a Tekrar Yükle' : 'Trendyol’a Otomatik Yükle'}</button></form>
                )}
                {secili.kanal === 'web' && secili.fatura.ek && smtpAcik && (
                  <form method="post"><input type="hidden" name="id" value={secili.fatura.id} /><button class="btn btn--sepet" name="eylem" value="ilet" type="submit"><PIkon ad="gonder" boyut={16} />{secili.fatura.iletim.durum === 'gonderildi' ? 'E-postayı Tekrar Gönder' : 'Müşteriye E-posta Gönder'}</button></form>
                )}
                {secili.kanal === 'web' && waFaturaLinki(secili, secili.fatura.no) && (
                  <a class="btn btn--cizgi" href={waFaturaLinki(secili, secili.fatura.no)} target="_blank" rel="noopener"><PIkon ad="whatsapp" boyut={16} />WhatsApp ile Bildir ↗</a>
                )}
                {secili.kanal === 'hepsiburada' && (
                  <a class="btn btn--cizgi" href="https://merchant.hepsiburada.com" target="_blank" rel="noopener">Hepsiburada Panelini Aç ↗</a>
                )}
                {secili.fatura.iletim.durum !== 'gonderildi' && secili.fatura.iletim.durum !== 'elle' && (
                  <form method="post">
                    <input type="hidden" name="id" value={secili.fatura.id} />
                    <input type="hidden" name="donusDurum" value={durum} />
                    <button class="btn btn--sepet" name="eylem" value="elle" type="submit"><PIkon ad="tik" boyut={16} />{secili.kanal === 'hepsiburada' ? 'Hepsiburada’ya Yükledim (Tamamla)' : 'Müşteriye / Kanala İlettim (3/3)'}</button>
                  </form>
                )}
              </div>

              <details class="fm-dosya-yenile">
                <summary>Fatura numarasını düzelt veya kaydı iptal et</summary>
                <div style="display:grid;gap:10px;margin-top:10px">
                  <form method="post" class="fm-dosya-kutu">
                    <input type="hidden" name="id" value={secili.fatura.id} />
                    <label class="y-alan">Fatura numarası<input name="no" required maxlength="40" value={secili.fatura.no.startsWith('TY-') ? '' : secili.fatura.no} placeholder="GIB2026000000012" autocomplete="off" /></label>
                    <button class="btn btn--cizgi btn--kucuk" name="eylem" value="no-duzelt" type="submit">Numarayı Güncelle</button>
                  </form>
                  <form method="post" class="fm-iptal">
                    <input type="hidden" name="id" value={secili.fatura.id} />
                    <label class="y-secim"><input type="checkbox" name="onay" required /> Faturayı GİB portalında da iptal edeceğim / ettim.</label>
                    <button class="btn btn--cizgi btn--kucuk y-yazi-kirmizi" name="eylem" value="iptal" type="submit">Fatura Kaydını İptal Et</button>
                  </form>
                </div>
              </details>
            </div>
          ) : (
            <div style="display:grid;gap:12px">
              {secili.kanal === 'trendyol' && tyBagli && (
                <form method="post" class="fm-dosya-kutu" style="background:#f2f7fd;border-color:#cde0f5">
                  <input type="hidden" name="siparisNo" value={secili.siparisNo} />
                  <strong>Bu faturayı zaten Trendyol satıcı paneline yüklediniz mi?</strong>
                  <small class="muted">Tekrar girmenize gerek yok; Trendyol’daki kaydı tek tıkla çekip tamamlayın.</small>
                  <button class="btn btn--cizgi btn--kucuk" name="eylem" value="trendyoldan-al" type="submit"><PIkon ad="indir" boyut={15} />Trendyol’dan Şimdi Çek</button>
                </form>
              )}

              <form method="post" enctype="multipart/form-data" class="fm-form" style="border-top:0;margin-top:0;padding-top:0">
                <input type="hidden" name="eylem" value="kaydet" />
                <input type="hidden" name="anahtar" value={secili.anahtar} />
                <div class="y-izgara y-izgara--2">
                  <label class="y-alan">Fatura Numarası (16 hane)<input name="no" required maxlength="40" placeholder="GIB2026000000012" autocomplete="off" /></label>
                  <label class="y-alan">Fatura Tarihi<input type="date" name="tarih" value={bugun} max={bugun} required /></label>
                </div>
                <label class="fm-dosya-kutu" style="width:100%">
                  <strong>GİB Fatura PDF / Görselini Seçin</strong>
                  <small class="muted">En fazla 4 MB · Otomatik kanal/e-posta iletimi ve muhasebe ZIP arşivi için kullanılır.</small>
                  <input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" />
                </label>
                <label class="y-secim"><input type="checkbox" name="ilet" checked={secili.kanal === 'trendyol' ? tyBagli : secili.kanal === 'web' ? smtpAcik : false} disabled={secili.kanal === 'hepsiburada'} /> <span>{iletimAciklamasi(secili.kanal)}</span></label>
                <button class="btn btn--sepet" type="submit" style="width:100%;justify-content:center"><PIkon ad="tik" boyut={17} />Faturayı Kaydet{secili.kanal !== 'hepsiburada' ? ' ve İlet' : ''}</button>
              </form>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="y-kart">
    <div class="y-kart__bas">
      <div>
        <h2><PIkon ad="fatura" /> Fatura Kuyruğu ({liste.length} Sipariş)</h2>
        <p class="y-kart__alt">Her siparişte fatura durumu, alıcı ve tek tıkla yapılabilecek sıradaki işlem.</p>
      </div>
    </div>

    {liste.length ? (
      <div class="y-tablo-kap y-tablo-kap--kart fm-tablo-kap">
        <table class="y-tablo fm-tablo">
          <thead>
            <tr class="fm-grup-baslik">
              <th>Sipariş ve Satış Kanalı</th>
              <th class="fm-bolge-alici">Alıcı ve Sipariş İçeriği</th>
              <th class="fm-bolge-tutar">KDV ve Toplam</th>
              <th class="fm-bolge-durum">Fatura Aşaması (1 → 2 → 3)</th>
              <th class="fm-bolge-islem">Hızlı İşlem</th>
            </tr>
            <tr>
              <th>Sipariş No &amp; Tarih</th>
              <th class="fm-bolge-alici">Alıcı &amp; Ürünler</th>
              <th class="y-sayi fm-bolge-tutar">Fatura Tutarı</th>
              <th class="fm-bolge-durum">Durum</th>
              <th class="y-sayi fm-bolge-islem">İşlem</th>
            </tr>
          </thead>
          <tbody>
            {liste.map((a) => {
              const bekliyorMu = Boolean(a.fatura && (a.fatura.iletim.durum === 'bekliyor' || a.fatura.iletim.durum === 'hata'));
              const waLink = a.fatura && a.kanal === 'web' ? waFaturaLinki(a, a.fatura.no) : undefined;
              const urunOzeti = a.satirlar.map((s) => `${s.adet}× ${s.ad}`).join(', ');
              return (
                <tr class:list={{ 'is-secili': a.anahtar === secili?.anahtar }}>
                  <td data-etiket="Sipariş">
                    <div style="display:flex;align-items:center;gap:8px;white-space:nowrap">
                      <KanalLogo kanal={a.kanal} boyut="kucuk" />
                      <a class="fm-no-link" href={filtre({ sec: a.anahtar }) + '#secili'}>{a.siparisNo}</a>
                      <button type="button" class="y-kopya" data-kopyala={a.siparisNo} title="Sipariş numarasını kopyala">
                        <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v10H9zM5 15V5h10" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                      </button>
                    </div>
                    <small class="y-table-note" style="margin-top:4px">{FATURA_KANAL_ADLARI[a.kanal]} · {tarih(a.tarih)} · {a.durumAdi}</small>
                  </td>

                  <td data-etiket="Alıcı & Ürünler" class="fm-bolge-alici">
                    <strong style="display:block;font-size:15px;color:#241a11">{a.alici.firma || a.alici.ad || '—'}</strong>
                    <small class="fm-urun-ozet">{urunOzeti}</small>
                  </td>

                  <td data-etiket="Tutar" class="y-sayi y-nowrap fm-bolge-tutar">
                    <strong style="display:block;font-size:16px;font-weight:800">{finansPara(a.toplam.genel)}</strong>
                    <small class="y-table-note">KDV hrç: {finansPara(a.toplam.matrah)}</small>
                  </td>

                  <td data-etiket="Fatura Durumu" class="fm-bolge-durum">
                    {a.fatura ? (
                      <div>
                        <strong style="font-size:14.5px">{a.fatura.no}</strong>
                        <div style="margin-top:4px"><span class:list={['y-chip', 'y-chip--' + ILETIM[a.fatura.iletim.durum][1]]}>{ILETIM[a.fatura.iletim.durum][0]}</span></div>
                        {a.fatura.iletim.mesaj && <small class="y-table-note fm-durum-notu">{a.fatura.iletim.mesaj}</small>}
                      </div>
                    ) : (
                      <span class="y-chip y-chip--turuncu">1. Aşama · GİB’de Kesilecek</span>
                    )}
                  </td>

                  <td data-etiket="İşlem" class="y-sayi fm-bolge-islem">
                    <div class="fm-satir-butonlar">
                      {a.fatura && (a.fatura.ek || (faturaKanalLinki(a.fatura) && !a.fatura.kanalDeneme)) && <a class="btn btn--cizgi btn--kucuk" href={'/yonetim/finans/fatura-dosya?id=' + a.fatura.id} target="_blank" rel="noopener">PDF ↗</a>}
                      {a.fatura && !a.fatura.ek && faturaKanalLinki(a.fatura) && a.fatura.kanalDeneme && <span class="y-chip y-chip--yesil">✓ Trendyol’da</span>}
                      {bekliyorMu && a.fatura && !a.fatura.ek && (
                        <a class="btn btn--sepet btn--kucuk" href={filtre({ sec: a.anahtar }) + '#secili'}>PDF Ekle</a>
                      )}
                      {bekliyorMu && a.fatura?.ek && a.kanal === 'trendyol' && tyBagli && (
                        <form method="post" style="display:inline"><input type="hidden" name="id" value={a.fatura.id} /><button class="btn btn--sepet btn--kucuk" name="eylem" value="ilet" type="submit">Trendyol’a Yükle</button></form>
                      )}
                      {bekliyorMu && a.fatura?.ek && a.kanal === 'web' && smtpAcik && (
                        <form method="post" style="display:inline"><input type="hidden" name="id" value={a.fatura.id} /><button class="btn btn--sepet btn--kucuk" name="eylem" value="ilet" type="submit">E-posta Gönder</button></form>
                      )}
                      {bekliyorMu && waLink && (
                        <a class="btn btn--cizgi btn--kucuk" href={waLink} target="_blank" rel="noopener">WhatsApp ↗</a>
                      )}
                      {bekliyorMu && a.fatura && (
                        <form method="post" style="display:inline">
                          <input type="hidden" name="id" value={a.fatura.id} />
                          <input type="hidden" name="donusDurum" value={durum} />
                          <button class="btn btn--cizgi btn--kucuk" name="eylem" value="elle" type="submit">✓ İletildi İşaretle</button>
                        </form>
                      )}
                      <a class:list={['btn', 'btn--kucuk', !a.fatura ? 'btn--sepet' : 'btn--cizgi']} href={filtre({ sec: a.anahtar }) + '#secili'}>
                        {a.fatura ? 'Detay' : '1. Bilgileri Aç & Kaydet'}
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="y-bos">{durum === 'kesilecek' ? 'Faturası kesilecek sipariş kalmadı.' : durum === 'iletilecek' ? 'İletim bekleyen fatura kalmadı; tüm faturalar tamamlandı.' : 'Bu filtrede kayıt bulunmuyor.'}</p>
    )}
  </section>
</Yonetim>
<style>
  h3 { font-size: 15.5px; margin: 16px 0 8px; }
  .fm-adimlar { margin: 10px 0; padding-left: 20px; display: grid; gap: 8px; font-size: 14.5px; }
  .fm-filtre-cubuk { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 18px; }

  .fm-secili { scroll-margin-top: 5rem; border: 2px solid #d5ba92 !important; background: #fffdfa !important; }
  .fm-ikili-calisma {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.95fr);
    gap: 18px;
    align-items: start;
  }
  @media (max-width: 1060px) { .fm-ikili-calisma { grid-template-columns: 1fr; } }

  .fm-calisma-kutu {
    padding: 16px 18px;
    border-radius: 14px;
    background: #faf6ef;
    border: 1px solid #e6dccf;
  }
  .fm-calisma-kutu--sag { background: #fff; }
  .fm-calisma-baslik { display: flex; align-items: flex-start; gap: 11px; margin-bottom: 14px; }
  .fm-calisma-baslik strong { display: block; font-size: 15.5px; color: #22180f; }
  .fm-calisma-baslik small { display: block; font-size: 13px; color: #6e6152; margin-top: 2px; }
  .fm-adim-no {
    width: 28px; height: 28px; border-radius: 999px;
    background: #3b281b; color: #fff; font-size: 12.5px; font-weight: 800;
    display: inline-grid; place-items: center; flex: none; margin-top: 1px;
  }
  .fm-adim-no--sag { background: #9c6b30; }

  .fm-kopya-izgara { display: grid; gap: 8px; }
  .fm-kopya-satir {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 13px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #e5dbce;
    font-size: 14.5px;
  }
  .fm-etiket {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #7d6e5d;
    margin-bottom: 2px;
  }
  .fm-kalem-kutu { display: grid; gap: 8px; }
  .fm-kalem-satir {
    padding: 11px 13px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #e5dbce;
    display: grid;
    gap: 8px;
  }
  .fm-kalem-ust, .fm-kalem-alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 14px;
  }
  .fm-kalem-alt { padding-top: 6px; border-top: 1px dashed #ece3d6; color: #4d4033; }

  .fm-form, .fm-kesildi { display: grid; gap: 12px; }
  .fm-dosya-kutu { display: grid; gap: 8px; padding: 13px 15px; border: 1.5px dashed #cbbba6; border-radius: 12px; background: #faf7f2; justify-items: start; }
  .fm-dosya-yenile summary { cursor: pointer; font-size: 13.5px; font-weight: 600; color: #6b6154; }
  .fm-iptal { display: grid; gap: 8px; justify-items: start; padding-top: 8px; }

  /* Fatura Kuyruğu Tablosu (Kârlılık Tablosu Estetiği) */
  .fm-tablo-kap { border-radius: 14px; border: 1px solid #e4d9ca; }
  .fm-tablo { width: 100%; border-collapse: separate; border-spacing: 0; }
  .fm-tablo th, .fm-tablo td { padding: 16px 15px !important; vertical-align: middle; }
  .fm-grup-baslik th {
    padding: 8px 15px !important;
    font-size: 11.5px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
    color: #6b5d4f !important;
    background: #f6f1e9 !important;
    border-bottom: 1px solid #e6dccf;
    text-align: left;
  }
  .fm-grup-baslik .fm-bolge-tutar { background: #f2f7fd !important; color: #1f4f82 !important; text-align: right; }
  .fm-grup-baslik .fm-bolge-durum { background: #eaf6ee !important; color: #155e34 !important; }
  .fm-grup-baslik .fm-bolge-islem { background: #f7f0e2 !important; color: #6e5226 !important; text-align: right; }
