---
import Yonetim from '../../../layouts/Yonetim.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { epostaBagli } from '../../../lib/altyapi';
import { siparisleriOku } from '../../../lib/depo';
import { finansGunu, finansPara, gecerliGun, type FaturaKaydi } from '../../../lib/finans';
import { faturaDosyaKaydet, faturaEki, faturaGuncelle, faturaKaydet, finansOku } from '../../../lib/finansDepo';
import { FATURA_KANAL_ADLARI, GENEL_TCKN, GIB_PORTAL, faturaAdaylari, sayiYaz, tlYaz, type FaturaAdayi, type FaturaKanali } from '../../../lib/faturaMerkezi';
import { evet, metin } from '../../../lib/form';
import { pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { envanterAyarlariOku, pazaryeriSiparisleriOku } from '../../../lib/pazaryeriDepo';
import { faturaIlet } from '../../../lib/faturaIlet';
import { yTarih } from '../../../lib/yonetimRapor';

const yol = '/yonetim/finans/faturalar';
const q = Astro.url.searchParams;
const hatalar: string[] = [];
const veriOku = async () => {
  const [finans, web, py, ayar] = await Promise.all([
    finansOku(), siparisleriOku(),
    pazaryeriSiparisleriOku().catch(() => { hatalar.push('Pazaryeri siparişleri okunamadı; yalnız web siparişleri listelendi.'); return []; }),
    envanterAyarlariOku().catch(() => undefined),
  ]);
  return { finans, adaylar: faturaAdaylari(finans, web, py, ayar) };
};
const tyBagli = ['canli', 'test'].includes(pazaryeriApiDurumu('trendyol'));
const smtpAcik = epostaBagli();
const waFaturaLinki = (a: FaturaAdayi, faturaNo: string) => {
  const tel = (a.web?.musteri.tel ?? '').replace(/\D/g, '');
  if (!tel) return undefined;
  const tamTel = tel.startsWith('90') ? tel : tel.startsWith('0') ? '9' + tel : '90' + tel;
  const mesaj = `Merhaba ${a.alici.ad}, ${a.siparisNo} numaralı Al Lulu Home siparişinizin ${faturaNo} numaralı e-Arşiv faturası hazırlanmıştır. Sipariş durumunuzu ${Astro.url.origin}/siparis-takip adresinden de görüntüleyebilirsiniz.`;
  return `https://wa.me/${tamTel}?text=${encodeURIComponent(mesaj)}`;
};

const ilet = (a: FaturaAdayi, k: FaturaKaydi, ek: { veri: Buffer; tur: string; ad: string } | undefined, zorla: boolean) => faturaIlet(a, k, ek, Astro.url.origin, zorla);

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const eylem = metin(f, 'eylem');
    const { finans, adaylar } = await veriOku();
    if (eylem === 'kaydet') {
      const a = adaylar.find((x) => x.anahtar === metin(f, 'anahtar'));
      if (!a) throw new Error('Sipariş bulunamadı. Listeyi yenileyin.');
      const no = metin(f, 'no').toUpperCase().replace(/\s+/g, ' ');
      if (!/^[A-Z0-9][A-Z0-9 ./-]{0,39}$/.test(no)) throw new Error('Fatura numarasını faturada yazdığı gibi girin (ör. GIB2026000000012).');
      const tarih = metin(f, 'tarih');
      if (!gecerliGun(tarih) || tarih > finansGunu()) throw new Error('Fatura tarihini girin (ileri tarih olamaz).');
      const dosya = f.get('dosya');
      const yuklenen = dosya instanceof File && dosya.size ? dosya : undefined;
      if (yuklenen && yuklenen.size > 4 * 1024 * 1024) throw new Error('Dosya en fazla 4 MB olmalı. PDF’i “küçük boyutlu” kaydedin ya da fotoğrafı daha düşük çözünürlükte çekin.');
      const { kayit, ek } = await faturaKaydet({
        kanal: a.kanal, kayit: a.kayit, siparisNo: a.siparisNo, no, tarih, alici: (a.alici.firma || a.alici.ad).slice(0, 200),
        matrah: a.toplam.matrah, kdv: a.toplam.kdv, toplam: a.toplam.genel,
      }, yuklenen);
      let mesaj = `Fatura ${no} kaydedildi.`;
      if (evet(f, 'ilet')) {
        const iletim = await ilet(a, kayit, ek && kayit.ek ? { ...ek, ad: kayit.ek.ad } : undefined, false);
        mesaj += ' ' + (iletim.mesaj ?? '');
        if (iletim.durum === 'hata') return Astro.redirect(`${yol}?sec=${encodeURIComponent(a.anahtar)}&hata=${encodeURIComponent(mesaj)}#secili`, 303);
      }
      return Astro.redirect(`${yol}?ok=${encodeURIComponent(mesaj)}`, 303);
    }
    const k = finans.faturalar.find((x) => x.id === metin(f, 'id'));
    if (!k) throw new Error('Fatura kaydı bulunamadı.');
    const a = adaylar.find((x) => x.kanal === k.kanal && x.kayit === k.kayit);
    if (eylem === 'dosya-yukle') {
      const dosya = f.get('dosya');
      if (!(dosya instanceof File) || !dosya.size) throw new Error('Yüklenecek PDF veya görsel dosyasını seçin.');
      const { kayit: guncel, ek } = await faturaDosyaKaydet(k.id, dosya);
      let mesaj = 'Fatura dosyası kaydedildi.';
      if (a && evet(f, 'ilet')) {
        const iletim = await ilet(a, guncel, ek, true);
        mesaj += ' ' + (iletim.mesaj ?? '');
        return Astro.redirect(`${yol}?${iletim.durum === 'hata' ? 'hata' : 'ok'}=${encodeURIComponent(mesaj)}&sec=${encodeURIComponent(k.kanal + ':' + k.kayit)}#secili`, 303);
      }
      return Astro.redirect(`${yol}?ok=${encodeURIComponent(mesaj)}&sec=${encodeURIComponent(k.kanal + ':' + k.kayit)}#secili`, 303);
    }
    if (eylem === 'ilet') {
      if (!a) throw new Error('Siparişi bulamadım; faturayı elle iletin.');
      const ek = await faturaEki(k.id);
      const iletim = await ilet(a, k, ek && ek.kayit.ek ? { veri: ek.veri, tur: ek.kayit.ek.tur, ad: ek.kayit.ek.ad } : undefined, true);
      return Astro.redirect(`${yol}?${iletim.durum === 'hata' ? 'hata' : 'ok'}=${encodeURIComponent(iletim.mesaj ?? 'Tamam.')}&sec=${encodeURIComponent(k.kanal + ':' + k.kayit)}#secili`, 303);
    }
    if (eylem === 'elle') {
      await faturaGuncelle(k.id, (x) => { x.iletim = { durum: 'elle', mesaj: 'Müşteriye / kanala iletildi olarak işaretlendi.', tarih: new Date().toISOString() }; });
      const donusDurum = metin(f, 'donusDurum');
      const ekSorgu = donusDurum ? `&durum=${encodeURIComponent(donusDurum)}` : '';
      return Astro.redirect(`${yol}?ok=${encodeURIComponent('Fatura 3. aşamaya (İletildi) taşındı.')}${ekSorgu}`, 303);
    }
    if (eylem === 'iptal') {
      if (!evet(f, 'onay')) throw new Error('İptal için kutucuğu işaretleyin.');
      await faturaGuncelle(k.id, (x) => { x.iptal = true; });
      return Astro.redirect(`${yol}?sec=${encodeURIComponent(k.kanal + ':' + k.kayit)}&ok=${encodeURIComponent('Kayıt iptal edildi. GİB portalında da faturayı iptal etmeyi unutmayın.')}#secili`, 303);
    }
    throw new Error('Geçersiz işlem.');
  } catch (e) {
    hatalar.push(e instanceof Error && e.name !== 'ZodError' ? e.message : 'İşlem tamamlanamadı.');
  }
}

const { adaylar } = await veriOku();
const durum = ['kesilecek', 'iletilecek', 'kesildi', 'tumu'].includes(q.get('durum') ?? '') ? q.get('durum')! : 'kesilecek';
const kanal = (['web', 'trendyol', 'hepsiburada'] as const).find((k) => k === q.get('kanal'));
const kesilecek = adaylar.filter((a) => !a.fatura);
const iletilecek = adaylar.filter((a) => a.fatura && (a.fatura.iletim.durum === 'bekliyor' || a.fatura.iletim.durum === 'hata'));
const liste = adaylar
  .filter((a) => (durum === 'kesilecek' ? !a.fatura : durum === 'iletilecek' ? Boolean(a.fatura && (a.fatura.iletim.durum === 'bekliyor' || a.fatura.iletim.durum === 'hata')) : durum === 'kesildi' ? !!a.fatura : true) && (!kanal || a.kanal === kanal))
  .slice(0, 300);
const secili = adaylar.find((a) => a.anahtar === q.get('sec'));
const sekmeler = [['ozet', 'Özet'], ['belgeler', 'Belgeler'], ['giderler', 'Giderler'], ['trendyol', 'Trendyol'], ['raporlar', 'Raporlar']] as const;
const tarih = (t: string) => yTarih.format(new Date(t));
const filtre = (ek: Record<string, string | undefined>) => yol + '?' + new URLSearchParams(Object.entries({ durum, kanal, ...ek }).filter(([, v]) => v) as [string, string][]);
const ILETIM: Record<FaturaKaydi['iletim']['durum'], [string, string]> = {
  bekliyor: ['2. Aşama · İletim bekliyor', 'turuncu'], hata: ['2. Aşama · İletim hatası', 'kirmizi'], gonderildi: ['3. Aşama · İletildi', 'yesil'], elle: ['3. Aşama · Elle iletildi', 'yesil'], yok: ['2. Aşama · Kaydedildi', 'gri'],
};

const iletimAciklamasi = (k: FaturaKanali) => k === 'trendyol' ? (tyBagli ? 'Kaydedince Trendyol’a otomatik yükle' : 'Trendyol bağlantısı yok; canlı siteden veya satıcı panelinden yükleyin')
  : k === 'web' ? (smtpAcik ? 'Kaydedince müşteriye e-postayla otomatik gönder' : 'Otomatik e-posta (SMTP) kapalı; kaydettikten sonra WhatsApp/e-posta ile iletip “İletildi işaretle”ye basın')
  : 'Hepsiburada satıcı panelinden yükleyip “Yükledim” diye işaretleyin';
const bugun = finansGunu();
---
<Yonetim baslik="Faturalar" altBaslik="GİB’de düzenlenen faturaları kaydedin ve müşteriye / pazaryerine iletim durumunu tamamlayın." aktif="finans" basari={q.get('ok')} hatalar={[...hatalar, ...(q.get('hata') ? [q.get('hata')!] : [])]}>
  <nav class="y-sekmeler y-finans-nav" aria-label="Finans bölümleri">
    {sekmeler.map(([id, ad]) => <a href={'/yonetim/finans?sekme=' + id}>{ad}</a>)}
    <a href={yol} aria-current="page">Faturalar{kesilecek.length > 0 && ` (${kesilecek.length})`}</a>
    <a href="/yonetim/finans/trendyol-karlilik">Trendyol Kârlılık</a>
    <a href="/yonetim/finans/hepsiburada">Hepsiburada</a>
  </nav>

  <details class="y-kart" open={!adaylar.some((a) => a.fatura)}>
    <summary><strong>Fatura nasıl kesilir? (3 adım)</strong></summary>
    <ol class="fm-adimlar">
      <li>Aşağıdan siparişin <strong>“Fatura bilgileri”</strong>ne basın. Alıcı, ürünler, KDV hariç fiyat ve KDV hazır gelir; her birinin yanında “Kopyala” var.</li>
      <li><a class="y-link" href={GIB_PORTAL} target="_blank" rel="noopener noreferrer">GİB e-Arşiv Portalı’na</a> İnteraktif Vergi Dairesi kullanıcı kodu ve şifresiyle girin. <em>Belge İşlemleri › Fatura Oluştur</em>’da bilgileri yapıştırın, “Onayla”yın ve PDF’ini indirin.</li>
      <li>Fatura numarasını ve PDF’i kaydedin. Trendyol yüklemesini veya web müşterisine e-postayı ayrıca seçebilir, sonucunu faturanın iletim durumundan izleyebilirsiniz. Hepsiburada’da PDF’i satıcı panelinden yükleyip “Yükledim” deyin.</li>
    </ol>
    <p class="y-help">1 Ocak 2026’dan beri e-Fatura sistemine girmemiş satıcılar faturalarını GİB portalından e-Arşiv olarak keser; basit usul veya işletme defteri tutanlar için bu tarih 1 Ocak 2027. Hangisine tabi olduğunuzu muhasebecinize doğrulatın. Bireysel alıcının TC kimlik numarası bilinmiyorsa portalda {GENEL_TCKN} yazılır.</p>
  </details>

  <div class="y-metrics y-metrics--finans">
    <a class="y-metric y-metric--kirmizi" href={filtre({ durum: 'kesilecek' })}><PIkon ad="fatura" /><span>1. Faturası kesilecek</span><strong>{kesilecek.length}</strong><small>GİB'de düzenlenip kaydedilecek</small></a>
    <a class="y-metric y-metric--turuncu" href={filtre({ durum: 'iletilecek' })}><PIkon ad="gonder" /><span>2. Müşteriye / kanala iletilecek</span><strong>{iletilecek.length}</strong><small>Kaydedildi · iletim tamamlanacak</small></a>
    <a class="y-metric y-metric--yesil" href={filtre({ durum: 'kesildi' })}><PIkon ad="tik-daire" /><span>3. İletimi tamamlanan</span><strong>{adaylar.filter((a) => a.fatura && (a.fatura.iletim.durum === 'gonderildi' || a.fatura.iletim.durum === 'elle')).length}</strong><small>Müşteriye veya kanala iletildi</small></a>
    <div class="y-metric"><PIkon ad="takvim" /><span>Bu ay kesilen toplam</span><strong>{adaylar.filter((a) => a.fatura && a.fatura.tarih.slice(0, 7) === bugun.slice(0, 7)).length}</strong><small>Seçili ayda düzenlenen</small></div>
  </div>

  {durum === 'iletilecek' && iletilecek.length > 0 && (
    <div class="y-veri-not" style="margin-bottom:14px">
      <PIkon ad="bilgi" boyut={18} />
      <p>
        <strong>2. Aşamadaki faturalar 3. aşamaya (İletildi) nasıl geçer?</strong>
        • <strong>Trendyol:</strong> PDF yüklüyse satırdaki <em>“Trendyol’a Yükle”</em> düğmesiyle otomatik yüklenir (veya satıcı panelinden yükleyip <em>“✓ İletildi İşaretle”</em> deyin).<br />
        • <strong>Web Sitesi:</strong> {smtpAcik ? '“E-posta Gönder” ile müşteriye otomatik gider.' : 'Otomatik e-posta (SMTP) kapalı olduğu için PDF’i indirip “WhatsApp” veya kendi e-postanızla müşteriye gönderdikten sonra satırdaki “✓ İletildi İşaretle” düğmesine basın.'}<br />
        • <strong>Hepsiburada:</strong> Satıcı panelinde siparişe yükledikten sonra <em>“✓ İletildi İşaretle”</em> düğmesine basın.
      </p>
    </div>
  )}

  <nav class="y-sekmeler" aria-label="Fatura filtresi">
    {[['kesilecek', `1. Kesilecek (${kesilecek.length})`], ['iletilecek', `2. İletilecek (${iletilecek.length})`], ['kesildi', 'Kaydedilenler'], ['tumu', `Tümü (${adaylar.length})`]].map(([id, ad]) => <a href={filtre({ durum: id })} aria-current={durum === id ? 'page' : undefined}>{ad}</a>)}
    <span class="fm-ayrac"></span>
    <a href={filtre({ kanal: undefined })} aria-current={!kanal ? 'page' : undefined}>Tüm kanallar</a>
    {(['web', 'trendyol', 'hepsiburada'] as const).map((k) => <a href={filtre({ kanal: k })} aria-current={kanal === k ? 'page' : undefined}>{FATURA_KANAL_ADLARI[k]}</a>)}
  </nav>

  {secili && <section class="y-kart fm-secili" id="secili">
    <div class="y-kart__bas">
      <h2><PIkon ad="fatura" /> {FATURA_KANAL_ADLARI[secili.kanal]} · {secili.siparisNo}</h2>
      <a class="y-link" href={filtre({})}>Kapat</a>
    </div>
    <p class="y-help">{tarih(secili.tarih)} · {secili.durumAdi}{secili.paketNo && secili.paketNo !== secili.siparisNo ? ` · Paket ${secili.paketNo}` : ''}</p>
    {secili.eksikler.length > 0 && <p class="y-uyari">Eksik bilgi: {secili.eksikler.join(', ')}.</p>}

    <h3>Alıcı</h3>
    <dl class="fm-alanlar">
      <div><dt>Alıcı türü</dt><dd>{secili.alici.tip === 'kurumsal' ? 'Kurumsal (VKN ile)' : 'Bireysel (TCKN ile)'}</dd></div>
      {secili.alici.tip === 'kurumsal' ? <>
        <div><dt>Vergi no (VKN)</dt><dd>{secili.alici.vergiNo ?? '—'} {secili.alici.vergiNo && <button type="button" class="y-icon-button" data-kopyala={secili.alici.vergiNo}>Kopyala</button>}</dd></div>
        <div><dt>Unvan</dt><dd>{secili.alici.firma ?? secili.alici.ad} <button type="button" class="y-icon-button" data-kopyala={secili.alici.firma ?? secili.alici.ad}>Kopyala</button></dd></div>
        <div><dt>Vergi dairesi</dt><dd>{secili.alici.vergiDairesi ?? '—'} {secili.alici.vergiDairesi && <button type="button" class="y-icon-button" data-kopyala={secili.alici.vergiDairesi}>Kopyala</button>}</dd></div>
      </> : <>
        <div><dt>TC kimlik no</dt><dd>{secili.alici.tckn} <button type="button" class="y-icon-button" data-kopyala={secili.alici.tckn}>Kopyala</button>{secili.alici.tcknBilinmiyor && <small class="muted"> Bilinmiyor; genel numara</small>}</dd></div>
        <div><dt>Ad soyad</dt><dd>{secili.alici.ad} <button type="button" class="y-icon-button" data-kopyala={secili.alici.ad}>Kopyala</button></dd></div>
      </>}
      <div class="fm-genis"><dt>Adres</dt><dd>{secili.alici.adres || '—'} {secili.alici.adres && <button type="button" class="y-icon-button" data-kopyala={secili.alici.adres}>Kopyala</button>}</dd></div>
      <div><dt>İl / ilçe</dt><dd>{[secili.alici.il, secili.alici.ilce].filter(Boolean).join(' / ') || '—'}</dd></div>
      <div><dt>Ülke</dt><dd>Türkiye</dd></div>
    </dl>

    <h3>Mal / hizmet satırları</h3>
    <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo">
      <thead><tr><th>Mal / hizmet</th><th class="y-sayi">Miktar</th><th class="y-sayi">Birim fiyat (KDV hariç)</th><th class="y-sayi">KDV</th><th class="y-sayi">Tutar (KDV hariç)</th><th class="y-sayi">KDV tutarı</th><th class="y-sayi">Toplam (KDV dahil)</th></tr></thead>
      <tbody>{secili.satirlar.map((s) => <tr>
        <td data-etiket="Mal / hizmet">{s.ad} <button type="button" class="y-icon-button" data-kopyala={s.ad}>Kopyala</button></td>
        <td data-etiket="Miktar" class="y-sayi">{s.adet} Adet</td>
        <td data-etiket="Birim fiyat (KDV hariç)" class="y-sayi y-nowrap">{sayiYaz(s.birimHaric)} <button type="button" class="y-icon-button" data-kopyala={sayiYaz(s.birimHaric)}>Kopyala</button></td>
        <td data-etiket="KDV" class="y-sayi">%{s.kdvOrani}</td>
        <td data-etiket="Tutar (KDV hariç)" class="y-sayi y-nowrap">{tlYaz(s.haric)}</td>
        <td data-etiket="KDV tutarı" class="y-sayi y-nowrap">{tlYaz(s.kdv)}</td>
        <td data-etiket="Toplam" class="y-sayi y-nowrap"><strong>{tlYaz(s.dahil)}</strong></td>
      </tr>)}</tbody>
    </table></div>
    <dl class="y-hesap">
      <div><dt>Mal/hizmet toplamı (KDV hariç)</dt><dd>{finansPara(secili.toplam.matrah)}</dd></div>
      {secili.toplam.oranlar.map((o) => <div><dt>Hesaplanan KDV (%{o.oran})</dt><dd>{finansPara(o.kdv)}</dd></div>)}
      <div class="sonuc"><dt>Ödenecek tutar (KDV dahil)</dt><dd>{finansPara(secili.toplam.genel)}</dd></div>
    </dl>
    <p class="y-help">Portal toplamı kuruş kuruş bunun aynısı olmalı. Birkaç kuruş fark çıkarsa birim fiyatı portalda “KDV dahil” girip ({secili.satirlar.map((s) => sayiYaz(s.birimDahil)).join(' / ')} TL) portalın hesaplamasına bırakın.</p>
    <p class="y-help">Not alanına: <strong>{secili.aciklama}</strong> <button type="button" class="y-icon-button" data-kopyala={secili.aciklama}>Kopyala</button></p>

    {secili.fatura ? <div class="fm-kesildi">
      <h3>Kesilen fatura ve iletim işlemleri</h3>
      <p><strong>{secili.fatura.no}</strong> · {secili.fatura.tarih.split('-').reverse().join('.')} · {finansPara(secili.fatura.toplam)}
        {secili.fatura.ek ? <> · <a class="y-link" href={'/yonetim/finans/fatura-dosya?id=' + secili.fatura.id} target="_blank" rel="noopener">PDF / Dosyayı aç ↗</a></> : <span class="muted"> · Dosya eklenmedi</span>}</p>
      <p><span class:list={['y-chip', 'y-chip--' + ILETIM[secili.fatura.iletim.durum][1]]}>{ILETIM[secili.fatura.iletim.durum][0]}</span> {secili.fatura.iletim.mesaj}</p>

      {!secili.fatura.ek ? (
        <form method="post" enctype="multipart/form-data" class="fm-dosya-kutu">
          <input type="hidden" name="eylem" value="dosya-yukle" />
          <input type="hidden" name="id" value={secili.fatura.id} />
          <strong>Fatura PDF veya Görselini Ekleyin</strong>
          <small class="muted">GİB portalından indirdiğiniz e-Arşiv PDF dosyasını seçip kaydedin (en fazla 4 MB).</small>
          <input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" required />
          {secili.kanal !== 'hepsiburada' && (
            <label class="y-secim"><input type="checkbox" name="ilet" checked={secili.kanal === 'trendyol' ? tyBagli : smtpAcik} /> {secili.kanal === 'trendyol' ? 'Yükleyince Trendyol’a otomatik gönder' : 'Yükleyince müşteriye e-postayla gönder'}</label>
          )}
          <button class="btn btn--sepet btn--kucuk" type="submit"><PIkon ad="indir" boyut={15} />Dosyayı Kaydet{secili.kanal !== 'hepsiburada' ? ' ve İlet' : ''}</button>
        </form>
      ) : (
        <details class="fm-dosya-yenile">
          <summary>Fatura PDF dosyasını değiştir</summary>
          <form method="post" enctype="multipart/form-data" class="fm-dosya-kutu" style="margin-top:8px">
            <input type="hidden" name="eylem" value="dosya-yukle" />
            <input type="hidden" name="id" value={secili.fatura.id} />
            <input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" required />
            <button class="btn btn--cizgi btn--kucuk" type="submit">Yeni Dosyayı Kaydet</button>
          </form>
        </details>
      )}

      <div class="y-modal__alt" style="justify-content:flex-start;flex-wrap:wrap">
        {secili.kanal === 'trendyol' && secili.fatura.ek && (
          <form method="post"><input type="hidden" name="id" value={secili.fatura.id} /><button class="btn btn--sepet" name="eylem" value="ilet" type="submit" disabled={!tyBagli}><PIkon ad="gonder" boyut={16} />{secili.fatura.iletim.durum === 'gonderildi' ? 'Trendyol’a Tekrar Yükle' : 'Trendyol’a Otomatik Yükle'}</button></form>
        )}
        {secili.kanal === 'web' && secili.fatura.ek && smtpAcik && (
          <form method="post"><input type="hidden" name="id" value={secili.fatura.id} /><button class="btn btn--sepet" name="eylem" value="ilet" type="submit"><PIkon ad="gonder" boyut={16} />{secili.fatura.iletim.durum === 'gonderildi' ? 'E-postayı Tekrar Gönder' : 'Müşteriye E-posta Gönder'}</button></form>
        )}
        {secili.kanal === 'web' && waFaturaLinki(secili, secili.fatura.no) && (
          <a class="btn btn--cizgi" href={waFaturaLinki(secili, secili.fatura.no)} target="_blank" rel="noopener"><PIkon ad="whatsapp" boyut={16} />WhatsApp ile Müşteriye Bildir ↗</a>
        )}
        {secili.kanal === 'hepsiburada' && (
          <a class="btn btn--cizgi" href="https://merchant.hepsiburada.com" target="_blank" rel="noopener">Hepsiburada Panelini Aç ↗</a>
        )}
        {secili.fatura.iletim.durum !== 'gonderildi' && secili.fatura.iletim.durum !== 'elle' && (
          <form method="post">
            <input type="hidden" name="id" value={secili.fatura.id} />
            <input type="hidden" name="donusDurum" value={durum} />
            <button class="btn btn--sepet" name="eylem" value="elle" type="submit"><PIkon ad="tik" boyut={16} />{secili.kanal === 'hepsiburada' ? 'Hepsiburada’ya Yükledim (Tamamla)' : 'Müşteriye / Kanala İlettim (3. Aşamaya Taşı)'}</button>
          </form>
        )}
      </div>

      <details><summary>Faturayı iptal et</summary>
        <form method="post" class="fm-iptal">
          <input type="hidden" name="id" value={secili.fatura.id} />
          <label class="y-secim"><input type="checkbox" name="onay" required /> Faturayı GİB portalında da iptal edeceğim / ettim.</label>
          <button class="btn btn--cizgi" name="eylem" value="iptal" type="submit">Kaydı iptal et</button>
        </form>
      </details>
    </div> : <form method="post" enctype="multipart/form-data" class="fm-form">
      <h3>Kestiğiniz faturayı kaydedin</h3>
      <input type="hidden" name="eylem" value="kaydet" />
      <input type="hidden" name="anahtar" value={secili.anahtar} />
      <div class="y-izgara y-izgara--2">
        <label class="y-alan">Fatura numarası<input name="no" required maxlength="40" placeholder="GIB2026000000012" autocomplete="off" /><small class="muted">Portalın verdiği 16 haneli numara.</small></label>
        <label class="y-alan">Fatura tarihi<input type="date" name="tarih" value={bugun} max={bugun} required /></label>
      </div>
      <label class="y-alan">Fatura dosyası (PDF ya da fotoğraf)<input type="file" name="dosya" accept="application/pdf,image/jpeg,image/png" /><small class="muted">En fazla 4 MB. Portaldan “İndir” ile aldığınız PDF (otomatik iletim için gereklidir).</small></label>
      <label class="y-secim"><input type="checkbox" name="ilet" checked={secili.kanal === 'trendyol' ? tyBagli : secili.kanal === 'web' ? smtpAcik : false} disabled={secili.kanal === 'hepsiburada'} /> {iletimAciklamasi(secili.kanal)}</label>
      {secili.kanal !== 'hepsiburada' && <p class="y-help">Otomatik fatura iletimi açıksa PDF’i bulunan bekleyen kayıtlar da yeniden denenir. <a class="y-link" href="/yonetim/isler#otomatik-ayarlar">Otomatik iş ayarları</a></p>}
      <div class="y-modal__alt"><button class="btn btn--sepet" type="submit">Fatura kaydını oluştur</button></div>
    </form>}
  </section>}

  <section class="y-kart">
    {liste.length ? <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo">
      <thead><tr><th>Sipariş</th><th>Kanal</th><th>Tarih</th><th>Alıcı</th><th class="y-sayi">Tutar</th><th>Fatura ve İletim Durumu</th><th class="y-sayi">Hızlı İşlem</th></tr></thead>
      <tbody>{liste.map((a) => {
        const bekliyorMu = Boolean(a.fatura && (a.fatura.iletim.durum === 'bekliyor' || a.fatura.iletim.durum === 'hata'));
        const waLink = a.fatura && a.kanal === 'web' ? waFaturaLinki(a, a.fatura.no) : undefined;
        return (
          <tr class:list={{ 'is-secili': a.anahtar === secili?.anahtar }}>
            <td data-etiket="Sipariş"><strong>{a.siparisNo}</strong><small class="y-table-note">{a.durumAdi}</small></td>
            <td data-etiket="Kanal"><KanalLogo kanal={a.kanal} boyut="kucuk" ad /></td>
            <td data-etiket="Tarih" class="y-nowrap">{tarih(a.tarih)}</td>
            <td data-etiket="Alıcı">{a.alici.firma || a.alici.ad || '—'}</td>
            <td data-etiket="Tutar" class="y-sayi y-nowrap">{finansPara(a.toplam.genel)}</td>
            <td data-etiket="Fatura">
              {a.fatura ? (
                <div>
                  <strong>{a.fatura.no}</strong>
                  <div style="margin-top:3px"><span class:list={['y-chip', 'y-chip--' + ILETIM[a.fatura.iletim.durum][1]]}>{ILETIM[a.fatura.iletim.durum][0]}</span></div>
                  {a.fatura.iletim.mesaj && <small class="y-table-note fm-durum-notu">{a.fatura.iletim.mesaj}</small>}
                </div>
              ) : <span class="y-chip y-chip--turuncu">1. Kesilecek</span>}
            </td>
            <td data-etiket="İşlem" class="y-sayi">
              <div class="fm-satir-butonlar">
                {a.fatura?.ek && <a class="btn btn--cizgi btn--kucuk" href={'/yonetim/finans/fatura-dosya?id=' + a.fatura.id} target="_blank" rel="noopener">PDF ↗</a>}
                {bekliyorMu && a.fatura && !a.fatura.ek && (
                  <a class="btn btn--sepet btn--kucuk" href={filtre({ sec: a.anahtar }) + '#secili'}>PDF Ekle</a>
                )}
                {bekliyorMu && a.fatura?.ek && a.kanal === 'trendyol' && tyBagli && (
                  <form method="post" style="display:inline"><input type="hidden" name="id" value={a.fatura.id} /><button class="btn btn--sepet btn--kucuk" name="eylem" value="ilet" type="submit">Trendyol’a Yükle</button></form>
                )}
                {bekliyorMu && a.fatura?.ek && a.kanal === 'web' && smtpAcik && (
                  <form method="post" style="display:inline"><input type="hidden" name="id" value={a.fatura.id} /><button class="btn btn--sepet btn--kucuk" name="eylem" value="ilet" type="submit">E-posta Gönder</button></form>
                )}
                {bekliyorMu && waLink && (
                  <a class="btn btn--cizgi btn--kucuk" href={waLink} target="_blank" rel="noopener">WhatsApp ↗</a>
                )}
                {bekliyorMu && a.fatura && (
                  <form method="post" style="display:inline">
                    <input type="hidden" name="id" value={a.fatura.id} />
                    <input type="hidden" name="donusDurum" value={durum} />
                    <button class="btn btn--cizgi btn--kucuk" name="eylem" value="elle" type="submit">✓ İletildi İşaretle</button>
                  </form>
                )}
                <a class="btn btn--cizgi btn--kucuk" href={filtre({ sec: a.anahtar }) + '#secili'}>{a.fatura ? 'Detay' : 'Fatura bilgileri'}</a>
              </div>
            </td>
          </tr>
        );
      })}</tbody>
    </table></div> : <p class="muted">{durum === 'kesilecek' ? 'Faturası kesilecek sipariş yok.' : durum === 'iletilecek' ? 'İletim bekleyen fatura kalmadı; tüm faturalar tamamlandı.' : 'Kayıt yok.'}</p>}
  </section>
</Yonetim>
<style>
  h3 { font-size: 15px; margin: 18px 0 8px; }
  .fm-adimlar { margin: 8px 0; padding-left: 20px; display: grid; gap: 8px; }
  .fm-alanlar { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 10px 18px; margin: 0; }
  .fm-alanlar dt { font-size: .8rem; color: #6b6154; }
  .fm-alanlar dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .fm-alanlar .fm-genis { grid-column: 1 / -1; }
  .fm-alanlar .y-icon-button, .fm-secili td .y-icon-button, .fm-secili p .y-icon-button { height: auto; margin-left: 4px; padding: 3px 6px; font-size: .78rem; }
  .fm-form, .fm-kesildi { border-top: 1px solid var(--y-border); margin-top: 16px; padding-top: 4px; display: grid; gap: 10px; }
  .fm-dosya-kutu { display: grid; gap: 8px; padding: 12px 14px; border: 1.5px dashed #cbbba6; border-radius: 11px; background: #faf7f2; justify-items: start; }
  .fm-dosya-yenile summary { cursor: pointer; font-size: 13px; color: #6b6154; }
  .fm-iptal { display: grid; gap: 8px; justify-items: start; padding-top: 8px; }
  .fm-ayrac { flex: 0 0 12px; }
  .fm-secili { scroll-margin-top: 5rem; border-top: 4px solid var(--y-gold, #aa812e); }
  .fm-durum-notu { max-width: 360px; white-space: normal; line-height: 1.35; margin-top: 3px; }
  .fm-satir-butonlar { display: inline-flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; align-items: center; }
  tr.is-secili { background: var(--y-bg); }
</style>
