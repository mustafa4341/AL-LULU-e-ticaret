---
import Yonetim from '../../../layouts/Yonetim.astro';
import { guvenliBaglanti } from '../../../lib/istek';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { metin, liste } from '../../../lib/form';
import { PazaryeriApiHatasi, pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { envanterAyarlariGuncelle, envanterAyarlariOku } from '../../../lib/pazaryeriDepo';
import { tyIadeOnayla, tyIadeler, tySoruCevapla, tySorular, type TyIade, type TySoru } from '../../../lib/trendyolApi';
import { yTarih } from '../../../lib/yonetimRapor';

const yol = '/yonetim/siparisler/trendyol-iade-soru';
const q = Astro.url.searchParams;
const api = pazaryeriApiDurumu('trendyol');
const apiHazir = api === 'canli' || api === 'test';
const envAyar = !apiHazir ? await envanterAyarlariOku().catch(() => undefined) : undefined;
const tySonApi = envAyar?.kanallar.trendyol.sonApi ?? envAyar?.kanallar.trendyol.sonOtomatikApi;
const hatalar: string[] = [];
const hata = (e: unknown) => e instanceof PazaryeriApiHatasi ? e.message : 'Trendyol’a ulaşılamadı. Biraz sonra tekrar deneyin.';

if (Astro.request.method === 'POST' && apiHazir) {
  const f = await Astro.request.formData();
  const eylem = metin(f, 'eylem');
  try {
    if (eylem === 'iade-onayla') {
      const kalemler = liste(f, 'kalem').filter(Boolean);
      if (!kalemler.length) throw new PazaryeriApiHatasi('Onaylanacak ürünü işaretleyin.');
      if (f.get('kontrol') !== 'on') throw new PazaryeriApiHatasi('Önce ürünün depoya ulaştığını ve kontrol edildiğini onaylayın.');
      await tyIadeOnayla(metin(f, 'claim'), kalemler);
      return Astro.redirect(`${yol}?ok=${encodeURIComponent('İade onaylandı. Trendyol müşteriye ödemeyi yapar; ürünü stoğa eklemek için siparişin sayfasında “satılabilir / satılamaz” seçin.')}`, 303);
    }
    if (eylem === 'soru-cevapla') {
      const soruId = Number(metin(f, 'soru'));
      if (!Number.isSafeInteger(soruId) || soruId <= 0) throw new PazaryeriApiHatasi('Soru bulunamadı.');
      await tySoruCevapla(soruId, metin(f, 'cevap'));
      await envanterAyarlariGuncelle((a) => { const s = a.kanallar.trendyol.soru; s.bekleyen = Math.max(0, s.bekleyen - 1); }).catch(() => undefined);
      return Astro.redirect(`${yol}?ok=${encodeURIComponent('Cevap Trendyol’a gönderildi. Trendyol kontrol ettikten sonra ürün sayfasında yayınlar.')}#sorular`, 303);
    }
    throw new PazaryeriApiHatasi('Geçersiz işlem.');
  } catch (e) {
    hatalar.push(hata(e));
  }
}

let iadeler: TyIade[] = [];
let sorular: TySoru[] = [];
if (apiHazir) {
  const [i, s] = await Promise.allSettled([tyIadeler(30), tySorular('WAITING_FOR_ANSWER', 14)]);
  if (i.status === 'fulfilled') {
    iadeler = i.value;
    // İş Merkezi'ndeki iade sayıları sayfa açılınca da tazelenir (otomatik çekim 30 dakikada bir)
    const kalemler = iadeler.flatMap((x) => x.kalemler);
    await envanterAyarlariGuncelle((a) => {
      const x = a.kanallar.trendyol.iade;
      x.bekleyen = kalemler.filter((k) => k.durum === 'WaitingInAction').length;
      x.acik = kalemler.filter((k) => ['Created', 'WaitingFraudCheck', 'InAnalysis'].includes(k.durum)).length;
    }).catch(() => undefined);
  } else hatalar.push(hata(i.reason));
  if (s.status === 'fulfilled') {
    sorular = s.value.sort((a, b) => a.tarih - b.tarih);
    // İş Merkezi'ndeki "cevap bekleyen soru" sayısı sayfa açılınca da tazelenir
    await envanterAyarlariGuncelle((a) => { a.kanallar.trendyol.soru = { bekleyen: sorular.length, tarih: new Date().toISOString() }; }).catch(() => undefined);
  } else hatalar.push('Müşteri soruları: ' + hata(s.reason));
}
/* Ürüne özel iddia içermeyen hazır cevaplar (ürün bilgisi gerekiyorsa siz eklersiniz) */
const SABLONLAR = [
  'Merhaba, ilginiz için teşekkür ederiz. Ürünümüz orijinal ve faturalı olarak gönderilir. İyi alışverişler dileriz.',
  'Merhaba, ürün stoklarımızda mevcuttur; siparişiniz en kısa sürede özenle paketlenip kargoya verilir. İyi alışverişler dileriz.',
  'Merhaba, ürünün tüm teknik özellikleri ürün sayfasındaki “Ürün Özellikleri” bölümünde yer almaktadır. Başka sorunuz olursa memnuniyetle yardımcı oluruz.',
];
/* Not: "<" karşılaştırması ile şablon metni (backtick) aynı ifadede Astro derleyicisini bozuyor; düz birleştirme kullanılır */
const saatOnce = (ms: number) => {
  const saat = Math.floor((Date.now() - ms) / 3600_000);
  if (saat <= 0) return 'az önce';
  return saat >= 24 ? Math.floor(saat / 24) + ' gün önce' : saat + ' saat önce';
};
const DURUM: Record<string, [string, string]> = {
  Created: ['Müşteri iade başlattı', 'gri'], WaitingInAction: ['Depoya ulaştı, onayınız bekleniyor', 'turuncu'],
  WaitingFraudCheck: ['Trendyol kontrol ediyor', 'gri'], Accepted: ['Onaylandı', 'yesil'], Rejected: ['Reddedildi', 'kirmizi'],
  Cancelled: ['İptal', 'gri'], Unresolved: ['Çözülemedi (Trendyol inceliyor)', 'kirmizi'], InAnalysis: ['Trendyol inceliyor', 'gri'],
};
const durumu = (d: string) => DURUM[d] ?? [d || '—', 'gri'];
const zaman = (ms: number) => ms ? yTarih.format(new Date(ms)) : '—';
const para = (n?: number) => n === undefined ? '' : n.toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + ' TL';
const iadeSirasi = iadeler.map((iade, i) => ({
  iade, id: 'iade-talebi-' + i,
  bekleyen: iade.kalemler.filter((k) => k.durum === 'WaitingInAction').length,
})).sort((a, b) => Number(b.bekleyen > 0) - Number(a.bekleyen > 0) || b.iade.tarih - a.iade.tarih);
const acikIadeler = iadeSirasi.filter((x) => x.bekleyen > 0);
---
<Yonetim baslik="Trendyol İadeleri ve Soruları" altBaslik="İade taleplerini onaylayın, müşteri sorularını panelden cevaplayın." aktif="siparisler" basari={q.get('ok')} hatalar={hatalar}>
  <KanalLogo slot="baslik-onu" kanal="trendyol" boyut="buyuk" />
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/siparisler/kanallar#trendyol"><PIkon ad="zincir" boyut={18} />Satış kanalları</a>
  </div>
  {!apiHazir && (tySonApi ? (
    <div class="y-veri-not" role="status" style="margin-bottom:14px">
      <PIkon ad="bilgi" boyut={18} />
      <p>
        <strong>Canlı sunucuda (Vercel) Trendyol bağlantısı aktif</strong>
        Son başarılı bağlantı: <strong>{yTarih.format(new Date(tySonApi))}</strong>. Bu bilgisayardan (localhost) anlık Trendyol iade listesini çekmek ve onaylamak için Vercel'deki <code>TRENDYOL_*</code> anahtarlarını yerel <code>.env</code> dosyanıza ekleyebilir veya canlı yönetim panelini kullanabilirsiniz.
      </p>
    </div>
  ) : (
    <p class="y-uyari-satir" role="status">Trendyol bağlantısı kurulmamış.</p>
  ))}

    <p class="y-uyari">Hasarlı, eksik veya kullanılmış ürünler için Trendyol satıcı panelinden fotoğraflı ret talebi açın. Trendyol, 48 saat içinde işlem yapılmayan iadeyi otomatik kabul eder.</p>
    {iadeler.length === 0 && apiHazir && hatalar.length === 0 && <p class="y-kart muted">Son 30 günde iade yok.</p>}
    {iadeSirasi.length > 0 && <>
    <div class="y-metrics y-metrics--finans">
      <div class="y-metric"><PIkon ad="iade" /><span>Son 30 gün · iade talebi</span><strong>{iadeler.length}</strong></div>
      <div class="y-metric y-metric--turuncu"><PIkon ad="saat" /><span>Onay bekleyen talep</span><strong>{acikIadeler.length}</strong></div>
      <div class="y-metric y-metric--altin"><PIkon ad="kutu" /><span>Kontrol edilecek ürün kalemi</span><strong>{acikIadeler.reduce((n, x) => n + x.bekleyen, 0)}</strong></div>
    </div>
    <div class="y-operasyon-izgara iade-izgara">
    <section class="y-kart">
      <h2><PIkon ad="iade" /> İade talepleri</h2>
      <ul class="y-is-listesi">{iadeSirasi.map(({ iade, id, bekleyen }) => <li><a href={'#' + id} data-ac={id}>
        <span><strong>{iade.siparisNo}</strong><small class="y-table-note">{zaman(iade.tarih)}</small></span>
        <span class:list={['y-chip', bekleyen ? 'y-chip--turuncu' : 'y-chip--gri']}>{bekleyen ? 'Kontrol bekliyor' : 'Durumu gör'}</span>
      </a></li>)}</ul>
    </section>
    <div>
    {iadeSirasi.map(({ iade: c, id, bekleyen }, i) => (
      <details class="y-kart iade" {id} open={i === 0}>
        <summary><strong>Sipariş {c.siparisNo}</strong></summary>
        <p class="y-help">{c.musteri}{c.kargo ? ` · ${c.kargo}` : ''}{c.kargoTakip ? ` · Takip ${c.kargoTakip}` : ''}
          {guvenliBaglanti(c.kargoLink) && <> · <a class="y-link" href={guvenliBaglanti(c.kargoLink)} target="_blank" rel="noopener noreferrer">Kargoyu izle ↗</a></>}
          {c.paketId && <> · <a class="y-link" href={'/yonetim/siparisler/pazaryeri/trendyol-' + encodeURIComponent(c.paketId)}>Siparişi aç</a></>}</p>
        <form method="post">
          <input type="hidden" name="claim" value={c.id} />
          <ul class="iade-kalemler">{c.kalemler.map((k) => {
            const [ad, renk] = durumu(k.durum);
            return <li>
              {k.durum === 'WaitingInAction' ? <input type="checkbox" name="kalem" value={k.kalemId} checked aria-label="Onaylanacak" /> : <span class="iade-bos"></span>}
              <div><strong>{k.urun}</strong> {para(k.fiyat)}
                <small>{k.sebep ? 'Sebep: ' + k.sebep : ''}{k.musteriNotu ? ` · Müşteri notu: “${k.musteriNotu}”` : ''}{k.otomatik ? ' · Otomatik kabul edildi' : ''}</small></div>
              <span class:list={['y-chip', 'y-chip--' + renk]}>{ad}</span>
            </li>;
          })}</ul>
          {bekleyen > 0 && <div class="iade-onay">
            <label class="y-secim"><input type="checkbox" name="kontrol" required /> Ürün depoya ulaştı, kontrol ettim; sorun yok.</label>
            <button class="btn btn--sepet" type="submit" name="eylem" value="iade-onayla">İadeyi onayla</button>
          </div>}
        </form>
      </details>
    ))}
    </div>
    </div>
    </>}

  {apiHazir && <section class="y-kart" id="sorular" aria-labelledby="sorular-baslik">
    <div class="y-kart__bas">
      <h2 id="sorular-baslik"><PIkon ad="soru" /> Cevap bekleyen müşteri soruları</h2>
      <span class:list={['y-chip', sorular.length ? 'y-chip--turuncu' : 'y-chip--yesil']}>{sorular.length ? `${sorular.length} soru` : 'Bekleyen soru yok'}</span>
    </div>
    <p class="y-help">Hızlı cevap Trendyol mağaza puanınızı ve satışı etkiler. Cevap 10–2000 karakter olmalı; telefon, e-posta, site adresi yazmayın (Trendyol reddeder). Aşağıdaki hazır cevaplardan birine dokunup düzenleyebilirsiniz.</p>
    {sorular.map((s) => <form method="post" class="soru">
      <input type="hidden" name="soru" value={s.id} />
      <div class="soru__bas">
        {s.gorsel && <img src={s.gorsel} alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer" />}
        <div><strong>{s.urun}</strong><small class="muted">{saatOnce(s.tarih)}{s.kullanici ? ` · ${s.kullanici}` : ''}{s.webUrl && <> · <a class="y-link" href={s.webUrl} target="_blank" rel="noopener noreferrer">Trendyol’da gör ↗</a></>}</small></div>
      </div>
      <p class="soru__metin">“{s.metin}”</p>
      <div class="soru__sablon">{SABLONLAR.map((t, i) => <button type="button" class="btn btn--cizgi btn--kucuk" data-sablon={t}>Hazır cevap {i + 1}</button>)}</div>
      <label class="y-alan">Cevabınız<textarea name="cevap" rows="3" minlength="10" maxlength="2000" required placeholder="Merhaba, …"></textarea></label>
      <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="soru-cevapla">Cevabı gönder</button>
    </form>)}
  </section>}
</Yonetim>
<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-sablon]')) {
    b.addEventListener('click', () => {
      const alan = b.closest('form')?.querySelector<HTMLTextAreaElement>('textarea');
      if (alan) { alan.value = b.dataset.sablon ?? ''; alan.focus(); }
    });
  }
</script>
<style>
  .soru { display: grid; gap: 8px; padding: 12px 0; border-top: 1px solid var(--y-border); justify-items: start; }
  .soru > * { justify-self: stretch; }
  .soru > .btn { justify-self: start; }
  .soru__bas { display: flex; gap: 10px; align-items: center; }
  .soru__bas img { object-fit: contain; border: 1px solid var(--y-border); border-radius: 8px; background: #fff; }
  .soru__bas div { display: grid; }
  .soru__metin { margin: 0; padding: 10px 12px; background: var(--y-bg); border-radius: 10px; font-size: 15px; }
  .soru__sablon { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (min-width: 1000px) { .iade-izgara { grid-template-columns: minmax(230px, .72fr) minmax(0, 1.28fr); } }
  .iade-kalemler { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .iade-kalemler li { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 8px 0; border-top: 1px solid var(--y-border); }
  .iade-kalemler small { display: block; color: var(--ink-3); }
  .iade-kalemler input[type=checkbox] { width: 20px; height: 20px; }
  .iade-onay { display: grid; gap: 8px; justify-items: start; margin-top: 10px; }
  @media (max-width: 640px) { .iade-kalemler li { grid-template-columns: 24px minmax(0, 1fr); } .iade-kalemler .y-chip { grid-column: 2; justify-self: start; } }
</style>
