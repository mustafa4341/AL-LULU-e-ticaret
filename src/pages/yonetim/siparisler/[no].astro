---
import FinansSiparis from '../../../components/yonetim/FinansSiparis.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import SiparisSonraki from '../../../components/yonetim/SiparisSonraki.astro';
import SiparisAdimlari from '../../../components/yonetim/SiparisAdimlari.astro';
import { webYolculugu } from '../../../lib/siparisAdimlari';
import Ikon from '../../../components/Ikon.astro';
import { finansOku } from '../../../lib/finansDepo';
import Yonetim from '../../../layouts/Yonetim.astro';
import { magazaOku, siparisleriOku } from '../../../lib/depo';
import { formatTL } from '../../../lib/fiyat';
import { evet, istegeBagli, metin } from '../../../lib/form';
import { yonetimGeriAdresi } from '../../../lib/istek';
import { kargoFirmalari, siparisKargoBaglantisi } from '../../../lib/kargoTakip';
import { siparisDurumGuncelle } from '../../../lib/urunIslem';
import { BELGE_TURLERI, belgeGecerli } from '../../../lib/finans';
import { gonderildi, IADE_ISLEMI, iadeEdildi, iptalEdilebilir } from '../../../lib/siparisAkisi';
import { odemeEtiketi, yTarih } from '../../../lib/yonetimRapor';
import { SIPARIS_DURUM_ADLARI, type Siparis } from '../../../lib/sema';
import { EPOSTA_TUR_ADLARI, epostaKayitlari, epostaYenidenGonder } from '../../../lib/bildirim';
import { EPOSTA_GIDEN_DURUMLAR } from '../../../lib/epostaSablon';
import { epostaBagli } from '../../../lib/altyapi';

const no = Astro.params.no ?? '';
const s = (await siparisleriOku()).find((x) => x.no === no);
if (!s) return Astro.redirect('/yonetim/siparisler?hata=' + encodeURIComponent(no + ' numaralı sipariş bulunamadı.'));
let hatalar: string[] = [];
let forma: FormData | undefined;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  forma = f;
  const geriHam = metin(f, 'geri');
  const varsayilanAdres = '/yonetim/siparisler/' + no;
  try {
    if (metin(f, 'eylem') === 'eposta') {
      const r = await epostaYenidenGonder(no, metin(f, 'epostaTur'), Astro.url.origin);
      if (r === 'hata') throw new Error('E-posta gönderilemedi. Ayrıntı aşağıdaki E-postalar bölümünde.');
      if (r === 'kapali') throw new Error('E-posta gönderimi kapalı (SMTP ayarları eksik).');
      return Astro.redirect(yonetimGeriAdresi(geriHam, Astro.url, varsayilanAdres, { tur: 'ok', mesaj: 'E-posta gönderildi.' }, '#epostalar'), 303);
    }
    const sonuc = await siparisDurumGuncelle({
      no, eylem: metin(f, 'eylem'), durum: metin(f, 'durum'),
      kargoTakip: istegeBagli(f, 'kargoTakip'), kargoFirma: istegeBagli(f, 'kargoFirma'),
      yoneticiNotu: istegeBagli(f, 'yoneticiNotu'), iptalNotu: istegeBagli(f, 'iptalNotu'),
      odemeOnay: evet(f, 'odemeOnay'), iadeOnay: evet(f, 'iadeOnay'), origin: Astro.url.origin,
    });
    return Astro.redirect(yonetimGeriAdresi(geriHam, Astro.url, varsayilanAdres, { tur: 'ok', mesaj: sonuc.mesaj }), 303);
  } catch (e) {
    const mesaj = (e as Error).message;
    const temizMesaj = mesaj.startsWith('Supabase') ? 'Sipariş kaydedilemedi. Sayfayı yenileyerek tekrar deneyin.' : mesaj;
    if (geriHam) {
      const donus = yonetimGeriAdresi(geriHam, Astro.url, '', { tur: 'hata', mesaj: temizMesaj });
      if (donus.startsWith('/yonetim/')) return Astro.redirect(donus, 303);
    }
    hatalar = [temizMesaj];
  }
}
/* Sayfanın geri kalan verisi aynı anda okunur (sırayla beklenince sayfa her biri için bir tur gecikiyordu) */
const [magaza, finansKaydi, epostalar] = await Promise.all([
  magazaOku(), s.paytr?.test ? undefined : finansOku(), epostaKayitlari(s.no),
]);
const { site } = magaza;
/* Ürünler açıkça: fotoğraf, ad, model (SKU) ve setin içindeki her ürün */
const urunBilgi = (id: string) => magaza.urunler.find((u) => u.id === id);
const kalemGorseli = (k: Siparis['kalemler'][number]) => k.tip === 'set'
  ? magaza.setler.find((x) => x.id === k.id)?.gorsel?.src ?? urunBilgi(k.parcalar[0]?.urunId ?? '')?.gorseller[0]?.src
  : urunBilgi(k.id)?.gorseller[0]?.src;
const parcaAdi = (id: string) => { const u = urunBilgi(id); return u ? `${u.marka} ${u.kisaAd}` : id; };
/* Ürünler (liste fiyatı) − indirimler + kargo = Toplam. Satır tutarlarına indirim zaten yansıdığı için
   "Ürünler" satırı gösterilmezse indirim iki kez düşülmüş gibi görünür. */
const listeToplami = s.urunlerToplami + s.kampanyaIndirimi;
const indirimVar = s.kampanyaIndirimi + s.setIndirimi + s.sepetIndirimi > 0;
const belgeler = finansKaydi ? finansKaydi.belgeler.filter((b) => b.siparisNo === no) : [];
const kesilenFatura = finansKaydi?.faturalar.find((x) => x.kanal === 'web' && x.kayit === no && !x.iptal);
/* Ayrıntılı adımlar (stok, fatura kesimi/iletimi dahil): lib/siparisAdimlari.ts */
const yolculuk = webYolculugu(s, kesilenFatura, '/yonetim/finans/faturalar?sec=' + encodeURIComponent('web:' + no) + '#secili');
const iade = iadeEdildi(s);
const iptal = s.durum === 'iptal';
const kargolar = kargoFirmalari(site.kargo);
const kargo = siparisKargoBaglantisi(s, site.kargo);
const musteriTel = '90' + s.musteri.tel.replace(/\D/g, '').replace(/^(?:90|0)/, '');
const wa = /^90\d{10}$/.test(musteriTel) ? 'https://wa.me/' + musteriTel + '?text=' : undefined;
const takipMesaj = kargo && wa && wa + encodeURIComponent('Merhaba ' + s.musteri.ad + ', ' + s.no + ' numaralı siparişiniz ' + kargo.firma + ' ile gönderildi. Takip no: ' + s.kargoTakip + ' · ' + kargo.url);
const musteriSayfasi = '/siparis/' + s.no + '?t=' + s.token;
const epostaAcik = epostaBagli();
const yenidenSecenekler = [
  ...(s.musteri.eposta ? ['alindi', 'sozlesmeler'] : []),
  'magaza',
  ...(s.musteri.eposta && (EPOSTA_GIDEN_DURUMLAR as readonly string[]).includes(s.durum) ? ['durum-' + s.durum] : []),
];

/* Adım çizgisi: ödeme, hazırlık ve kargo ayrı ayrı izlenir */
const odemeTamam = ['odendi', 'hazirlaniyor', 'kargoda', 'teslim-edildi'].includes(s.durum) || (iptal && (s.paytr?.sonuc === 'odendi' || s.gecmis.some((g) => g.durum === 'odendi')));
const adimlar = [
  { ad: 'Sipariş alındı', tamam: true, tarih: s.tarih },
  { ad: 'Ödeme onaylandı', tamam: odemeTamam, tarih: s.gecmis.find((g) => g.durum === 'odendi')?.tarih },
  { ad: 'Hazırlık', tamam: ['hazirlaniyor', 'kargoda', 'teslim-edildi'].includes(s.durum), tarih: s.gecmis.find((g) => g.durum === 'hazirlaniyor')?.tarih },
  { ad: 'Kargoda', tamam: ['kargoda', 'teslim-edildi'].includes(s.durum), tarih: s.gecmis.find((g) => g.durum === 'kargoda')?.tarih },
  { ad: 'Teslim edildi', tamam: s.durum === 'teslim-edildi', tarih: s.gecmis.find((g) => g.durum === 'teslim-edildi')?.tarih },
];
const simdikiAdim = adimlar.findIndex((a) => !a.tamam);

/* Üç bağımsız durum: ödeme, kargo, belge */
const odemeYazi = odemeEtiketi(s);
const odemeRenk = s.paytr ? (s.paytr.sonuc === 'odendi' ? 'yesil' : s.paytr.sonuc === 'basarisiz' ? 'kirmizi' : 'turuncu')
  : iptal ? 'gri' : s.durum === 'odeme-bekliyor' ? 'turuncu' : 'yesil';
const kargoYazi = iade ? 'İade tamamlandı' : iptal ? 'Gönderilmeyecek' : s.durum === 'kargoda' ? 'Kargoda' : s.durum === 'teslim-edildi' ? 'Teslim edildi'
  : s.durum === 'hazirlaniyor' ? 'Kargoya verilecek' : s.durum === 'odendi' ? 'Hazırlanacak' : 'Ödeme bekleniyor';
const kargoRenk = iptal || iade ? 'gri' : ['kargoda', 'teslim-edildi'].includes(s.durum) ? 'yesil' : s.durum === 'odeme-bekliyor' ? 'gri' : 'turuncu';
const gecerliBelgeler = belgeler.filter(belgeGecerli);
const hataliBelge = belgeler.some((b) => b.durum === 'hata');
const belgeYazi = hataliBelge ? 'Hata oluştu' : gecerliBelgeler.length ? gecerliBelgeler.map((b) => BELGE_TURLERI[b.tur]).join(', ') : 'Hazırlanmadı';
const belgeRenk = hataliBelge ? 'kirmizi' : gecerliBelgeler.length ? 'yesil' : odemeTamam && !iptal ? 'turuncu' : 'gri';

/* Çelişkili durum uyarıları */
const uyarilar: string[] = [];
if (s.paytr?.stokEksik && !iptal) uyarilar.push('Ödeme alındı. Gönderime geçmek için stoğu ayırın veya geri ödemeyi doğrulayıp siparişi iptal edin.');
if (iptal && s.kargoTakip) uyarilar.push('Bu sipariş iptal edildi ancak kayıtlı bir kargo takip numarası var (' + s.kargoTakip + '). Gönderiyi kargo firmasından durdurun.');
if (iptal && gecerliBelgeler.some((b) => b.tur !== 'iade')) uyarilar.push('İptal edilen siparişin geçerli belgeleri var. Muhasebe kaydında iptal olarak dikkate alın.');
if (s.paytr && s.paytr.sonuc === 'bekliyor' && Date.now() - Date.parse(s.tarih) > 60 * 60_000) uyarilar.push('Bir saattir ödeme sonucu gelmedi. PayTR Mağaza Paneli’nden işlemi kontrol edin.');
if (s.paytr?.test) uyarilar.push('Bu bir test siparişidir; ciroya ve stoğa dahil edilmez.');

const takipDuzenlenebilir = s.durum === 'kargoda' && !s.paytr?.test && !iade;
const etiket = (bicim: string, tur?: string) => '/yonetim/finans/etiket?' + new URLSearchParams({ no: s.no, bicim, ...(tur ? { tur } : {}) });
---
<Yonetim baslik={'Sipariş ' + s.no} altBaslik={yTarih.format(new Date(s.tarih)) + ' · Web sitesi'} aktif="siparisler" basari={Astro.url.searchParams.get('ok')} hatalar={[...hatalar, ...(Astro.url.searchParams.get('hata') ? [Astro.url.searchParams.get('hata')!] : [])]}>
  <KanalLogo slot="baslik-onu" kanal="web" boyut="buyuk" />
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/siparisler"><PIkon ad="ok-sol" boyut={18} />Siparişlere dön</a>
    <button class="btn btn--cizgi" type="button" data-kopyala={s.no} title="Sipariş numarasını kopyala"><PIkon ad="kopya" boyut={18} />Numarayı kopyala</button>
    <details class="y-row-menu y-row-menu--sag">
      <summary class="btn btn--cizgi" aria-label="Diğer işlemler">•••</summary>
      <div>
        {!iptal && !iade && <>
          <a href={etiket('a4')} target="_blank" rel="noopener">Hazırlık etiketi · A4</a>
          <a href={etiket('etiket')} target="_blank" rel="noopener">Hazırlık etiketi · 10 × 15 cm</a>
          <a href={etiket('a4', 'toplama')} target="_blank" rel="noopener">Ürün toplama listesi</a>
        </>}
        {kargo && <a href={kargo.url} target="_blank" rel="noopener">Kargo takibini aç ↗</a>}
        <a href={musteriSayfasi} target="_blank" rel="noopener">Müşterinin gördüğü sayfa ↗</a>
        <a href={'/siparis/' + s.no + '/sozlesmeler?t=' + s.token} target="_blank" rel="noopener">Onaylanan sözleşmeler ↗</a>
        {wa && <a href={wa + encodeURIComponent('Merhaba, ' + s.no + ' numaralı siparişiniz hakkında yazıyoruz.')} target="_blank" rel="noopener">WhatsApp’tan yaz ↗</a>}
        {iptalEdilebilir(s) && <a href="#iptal" data-ac="iptal">Siparişi iptal et</a>}
        {gonderildi(s) && !iade && !s.paytr?.test && <a href="#iade" data-ac="iade">İade kaydı aç</a>}
      </div>
    </details>
  </div>

  {uyarilar.map((u) => <p class="y-uyari-satir" role="alert"><Ikon ad="kalkan" boyut={16} />{u}</p>)}

  <section class="y-kart y-durum-kart" id="kargo">
    <div class="y-kart__bas"><h2><PIkon ad="kargo" /> Sipariş Durumu</h2><a class="y-link" href="#urunler">Ürünler ve tutar</a></div>
    {iptal ? (
      <p class="y-iptal-bant"><strong>{s.paytr?.sonuc === 'basarisiz' ? 'Ödeme tamamlanamadı' : 'Sipariş iptal edildi'}</strong>{s.iptalNotu && <span> · {s.iptalNotu}</span>}</p>
    ) : (
      <ol class="y-surec-hatti" aria-label="Sipariş adımları">
        {adimlar.map((a, i) => {
          const ikonAd = i === 0 ? 'tik' : i === 1 ? 'cuzdan' : i === 2 ? 'kutu' : i === 3 ? 'kargo' : 'tik-daire';
          return (
            <li class:list={{ 'is-tamam': a.tamam, 'is-simdi': i === simdikiAdim }}>
              <div class="y-surec-hatti__ust">
                <span class="y-surec-hatti__daire" aria-hidden="true">
                  {a.tamam ? '✓' : <PIkon ad={ikonAd} boyut={18} />}
                </span>
              </div>
              <strong class="y-surec-hatti__etiket">{a.ad}</strong>
              <small class="y-surec-hatti__tarih">{a.tarih && a.tamam ? yTarih.format(new Date(a.tarih)) : i === simdikiAdim ? 'Devam ediyor' : '—'}</small>
            </li>
          );
        })}
      </ol>
    )}
    <div class="y-durum-serit">
      <div><span class="muted">Ödeme</span><b class:list={['y-chip', 'y-chip--' + odemeRenk]}>{odemeYazi}</b></div>
      <div><span class="muted">Kargo</span><b class:list={['y-chip', 'y-chip--' + kargoRenk]}>{kargoYazi}</b></div>
      <div><span class="muted">Belge</span><a href="#belgeler" class:list={['y-chip', 'y-chip--' + belgeRenk]}>{belgeYazi}</a></div>
      <div class="y-durum-serit__toplam"><span class="muted">Toplam Tutar</span><strong>{formatTL(s.toplam)}</strong></div>
    </div>
    <details class="y-web-adimlar" open={yolculuk.adimlar.some((a) => a.durum === 'sorun') || undefined}>
      <summary>Adım adım takip · {yolculuk.ilerleme.tamam}/{yolculuk.ilerleme.toplam} tamam{yolculuk.adimlar.some((a) => a.durum === 'sorun') ? ' · dikkat gereken adım var' : ''}</summary>
      <SiparisAdimlari {yolculuk} />
    </details>

    {s.paytr?.stokEksik && !s.paytr.test && s.durum === 'odendi' ? (
      <div class="y-siparis-sonraki y-sonraki--stok-uyari">
        <div>
          <strong><PIkon ad="uyari" boyut={18} /> Sıradaki işlem: Önce stoğu ayırın</strong>
          <p class="y-help">Bu siparişin ödemesi alındı ancak ürün stoğu ayrılamadı. Stok sorunu çözülmeden hazırlık ve kargo adımlarına geçilemez.</p>
        </div>
        <form method="post">
          <button type="submit" name="eylem" value="stok-tamamla" class="btn btn--sepet">Stoğu ayır</button>
        </form>
      </div>
    ) : (
      <div class="y-siparis-sonraki"><SiparisSonraki siparis={s} kargo={site.kargo} form={forma} /></div>
    )}
    {kargo && <p class="y-shipment"><Ikon ad="kargo" boyut={16} /><strong>{kargo.firma} · {s.kargoTakip}</strong>
      <a class="y-link" href={kargo.url} target="_blank" rel="noopener">Takibi aç ↗</a>
      {takipMesaj && !iade && <a class="y-link" href={takipMesaj} target="_blank" rel="noopener">Müşteriye WhatsApp’tan gönder ↗</a>}
      <button class="y-icon-button" type="button" data-kopyala={s.kargoTakip}>Takip no kopyala</button>
    </p>}
    {takipDuzenlenebilir && (
      <details class="y-order-secondary" open={metin(forma ?? new FormData(), 'durum') === 'kargoda'}>
        <summary>Takip bilgisini düzelt</summary>
        <form method="post" class="y-sonraki y-sonraki--kargo">
          <input type="hidden" name="eylem" value="durum" /><input type="hidden" name="durum" value="kargoda" />
          <label class="y-alan">Kargo firması<select name="kargoFirma" required>
            {kargolar.map((x) => <option value={x.ad} selected={x.ad === (s.kargoFirma || site.kargo.firma)}>{x.ad}</option>)}
          </select></label>
          <label class="y-alan">Takip numarası<input name="kargoTakip" required minlength="6" maxlength="40" value={s.kargoTakip ?? ''} /></label>
          <button class="btn btn--cizgi" type="submit">Kaydet</button>
        </form>
      </details>
    )}
    {iptalEdilebilir(s) && (
      <details class="y-order-secondary y-danger" id="iptal" open={forma?.get('durum') === 'iptal'}>
        <summary>Siparişi iptal et</summary>
        <form method="post" class="y-sonraki">
          <input type="hidden" name="eylem" value="durum" /><input type="hidden" name="durum" value="iptal" />
          <label class="y-alan">İptal nedeni<input name="iptalNotu" maxlength="500" value={String(forma?.get('iptalNotu') ?? '')} /></label>
          {(s.durum !== 'odeme-bekliyor' || s.paytr) && <label class="y-secim"><input type="checkbox" name="iadeOnay" required />Ödenen tutarı müşteriye geri ödedim.</label>}
          <button type="submit" class="btn btn--tehlike" data-onayla="Sipariş iptal edilsin mi? Ayrılan stok geri eklenir ve sipariş satış gelirinden çıkar.">İptali onayla</button>
        </form>
      </details>
    )}
    {gonderildi(s) && !iade && !s.paytr?.test && (
      <details class="y-order-secondary y-danger" id="iade" open={forma?.get('eylem') === 'iade'}>
        <summary>İade kaydı</summary>
        <form method="post" class="y-sonraki">
          <input type="hidden" name="eylem" value="iade" />
          <label class="y-alan">İade notu<input name="iptalNotu" maxlength="500" value={String(forma?.get('iptalNotu') ?? '')} /></label>
          <label class="y-secim"><input type="checkbox" name="iadeOnay" required />Ürünleri teslim alıp satışa uygun olduklarını kontrol ettim ve geri ödemeyi yaptım.</label>
          <button type="submit" class="btn btn--tehlike" data-onayla="İade tamamlandı olarak kaydedilsin mi? Ürünler stoğa geri eklenir, tutar iade olarak raporlanır.">İadeyi kaydet</button>
        </form>
      </details>
    )}
  </section>

  <div class="y-izgara y-izgara--2">
    <section class="y-kart">
      <div class="y-kart__bas">
        <h2><PIkon ad="kullanici" /> Müşteri ve Teslimat</h2>
        <button class="btn btn--cizgi btn--kucuk" type="button" data-kopyala={`${s.musteri.ad} ${s.musteri.soyad} · ${s.teslimat.adres} ${s.teslimat.ilce}/${s.teslimat.il}`}>Adresi kopyala</button>
      </div>
      <dl class="musteri-bilgileri">
        <div><dt>Müşteri</dt><dd><strong>{s.musteri.ad} {s.musteri.soyad}</strong></dd></div>
        <div><dt>Telefon</dt><dd><a class="y-link" href={'tel:' + s.musteri.tel}>{s.musteri.tel}</a>{wa && <> · <a class="y-link" href={wa + encodeURIComponent('Merhaba, ' + s.no + ' numaralı siparişiniz hakkında yazıyoruz.')} target="_blank" rel="noopener">WhatsApp ↗</a></>}</dd></div>
        {s.musteri.eposta && <div><dt>E-posta</dt><dd><a class="y-link" href={'mailto:' + s.musteri.eposta}>{s.musteri.eposta}</a></dd></div>}
        <div><dt>Teslimat adresi</dt><dd>{s.teslimat.adres}<br /><strong>{s.teslimat.ilce} / {s.teslimat.il}</strong></dd></div>
        {s.teslimat.not && <div><dt>Teslimat notu</dt><dd class="musteri-not">{s.teslimat.not}</dd></div>}
        <div><dt>Fatura türü</dt><dd>{s.fatura.tip === 'kurumsal' ? [s.fatura.firma, s.fatura.vd, s.fatura.vno].filter(Boolean).join(' · ') : 'Bireysel'}{s.fatura.adres && <> · {s.fatura.adres}</>}</dd></div>
        <div><dt>e-Arşiv fatura</dt><dd>{kesilenFatura ? <span class="y-chip y-chip--yesil">{kesilenFatura.no}</span> : <span class="y-chip y-chip--turuncu">Kesilmedi</span>} · <a class="y-link" href={'/yonetim/finans/faturalar?sec=' + encodeURIComponent('web:' + s.no) + '#secili'}>{kesilenFatura ? 'Faturayı görüntüle' : 'Fatura bilgileri'}</a></dd></div>
      </dl>
    </section>
    <section class="y-kart" id="urunler">
      <h2><PIkon ad="kutu" /> Ürünler ve Tutar</h2>
      <ul class="y-siparis-kalem-liste y-siparis-kalem-liste--gorselli">{s.kalemler.map((k) => {
        const gorsel = kalemGorseli(k);
        return <li>
          {gorsel ? <img class="y-kalem-gorsel" src={gorsel} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <span class="y-kalem-gorsel y-kalem-gorsel--yok" aria-hidden="true"><Ikon ad="kutu" boyut={22} /></span>}
          <span class="y-kalem-bilgi">
            <strong>{k.adet} × {k.tip === 'set' && <span class="y-chip y-chip--gri">Set</span>} {k.ad}</strong>
            {k.sku && <small class="muted">Model: {k.sku}</small>}
            {k.tip === 'set' && k.parcalar.length > 0 && <ul class="y-kalem-parcalar" aria-label="Set içeriği">
              {k.parcalar.map((p) => <li>{p.adet * k.adet} × {parcaAdi(p.urunId)}{urunBilgi(p.urunId)?.sku && <small class="muted"> · {urunBilgi(p.urunId)!.sku}</small>}</li>)}
            </ul>}
          </span>
          <span class="y-kalem-tutar">
            {k.oncekiBirim && <s class="muted">{formatTL(k.oncekiBirim * k.adet)}</s>}
            <strong>{formatTL(k.toplam)}</strong>
          </span>
        </li>;
      })}</ul>
      <dl class="y-money-lines y-money-lines--kucuk">
        {indirimVar && <div><dt>Ürünler (liste fiyatı)</dt><dd>{formatTL(listeToplami)}</dd></div>}
        {s.kampanyaIndirimi > 0 && <div><dt>Kampanya indirimi</dt><dd>−{formatTL(s.kampanyaIndirimi)}</dd></div>}
        {s.setIndirimi > 0 && <div><dt>Set indirimi</dt><dd>−{formatTL(s.setIndirimi)}</dd></div>}
        {s.sepetIndirimi > 0 && <div><dt>Sepette indirim</dt><dd>−{formatTL(s.sepetIndirimi)}</dd></div>}
        <div><dt>Kargo</dt><dd>{s.kargo ? formatTL(s.kargo) : 'Ücretsiz'}</dd></div>
        <div><dt><strong>Toplam</strong></dt><dd><strong>{formatTL(s.toplam)}</strong></dd></div>
      </dl>
    </section>
  </div>

  <div class="y-siparis-alt-uclu">
    <FinansSiparis siparis={s} belgeler={belgeler} />

    <section class="y-kart y-eposta-kart" id="epostalar">
      <div class="y-kart__bas">
        <div>
          <h2><PIkon ad="gonder" /> E-postalar</h2>
          <p class="y-kart__alt">Müşteriye gönderilen otomatik bildirimler.</p>
        </div>
        {epostalar.length > 0 && <span class:list={['y-chip', epostalar.some((e) => e.durum === 'hata') ? 'y-chip--kirmizi' : 'y-chip--yesil']}>{epostalar.filter((e) => e.durum === 'gonderildi').length}/{epostalar.length} gönderildi</span>}
      </div>
      {!epostaAcik && <p class="y-ipucu" style="margin:0 0 10px;padding:8px 10px;border-radius:8px;background:#faf7f2;border:1px solid var(--y-border)">E-posta gönderimi bu ortamda kapalı (<code>SMTP_PAROLA</code> tanımlı değil).</p>}

      <ul class="y-eposta-adimlar">
        {[
          // Türler lib/bildirim.ts'deki kayıt adlarıyla aynı olmalı ("alindi", "durum-<durum>"); eskiden farklı adlar
          // arandığı için e-postalar gönderilmiş olsa da hep "Gönderilmedi" görünüyordu (denetim AUD-020).
          { tur: 'alindi', baslik: 'Sipariş Onayı', bul: epostalar.find((e) => e.tur === 'alindi') },
          { tur: 'durum-odendi', baslik: 'Ödeme Onayı', bul: epostalar.find((e) => e.tur === 'durum-odendi') },
          { tur: 'durum-kargoda', baslik: 'Kargo Bilgisi', bul: epostalar.find((e) => e.tur === 'durum-kargoda') },
          // Diğer kayıtlı e-postalar (fatura, teslim/iptal bildirimi, mağaza bildirimi…) da görünsün
          ...epostalar.filter((e) => !['alindi', 'durum-odendi', 'durum-kargoda'].includes(e.tur)).map((e) => ({ tur: e.tur, baslik: e.ad, bul: e })),
        ].map((satir) => {
          const kayit = satir.bul;
          const okDurum = kayit?.durum === 'gonderildi';
          const hataDurum = kayit?.durum === 'hata';
          return (
            <li>
              <span class:list={['y-eposta-nokta', { 'is-ok': okDurum, 'is-hata': hataDurum }]} aria-hidden="true">
                {okDurum ? '✓' : hataDurum ? '!' : '○'}
              </span>
              <div class="y-eposta-bilgi">
                <strong>{satir.baslik}</strong>
                <small>{kayit ? yTarih.format(new Date(kayit.tarih)) + (kayit.sonHata ? ` · ${kayit.sonHata}` : '') : 'Gönderilmedi'}</small>
              </div>
              <span class:list={['y-chip', okDurum ? 'y-chip--yesil' : hataDurum ? 'y-chip--kirmizi' : 'y-chip--gri']}>
                {okDurum ? 'Gönderildi' : hataDurum ? 'Hata' : 'Bekliyor'}
              </span>
            </li>
          );
        })}
      </ul>

      {epostaAcik && yenidenSecenekler.length > 0 && <form method="post" class="y-eposta-form">
        <input type="hidden" name="eylem" value="eposta" />
        <select name="epostaTur" aria-label="Yeniden gönderilecek e-posta">{yenidenSecenekler.map((t) => <option value={t}>{EPOSTA_TUR_ADLARI[t]}</option>)}</select>
        <button class="btn btn--cizgi btn--kucuk" type="submit"><PIkon ad="gonder" boyut={15} />Gönder</button>
      </form>}
    </section>

    <section class="y-kart y-gecmis-kart" id="gecmis">
      <div class="y-kart__bas">
        <h2><PIkon ad="gecmis" /> İşlem Geçmişi / İç Not</h2>
        <div class="y-mini-sekmeler" role="group" aria-label="Geçmiş ve iç not">
          <button type="button" class="is-aktif" data-gecmis-sekme="zaman">İşlem Geçmişi</button>
          <button type="button" data-gecmis-sekme="not">İç Not{s.yoneticiNotu ? ' •' : ''}</button>
        </div>
      </div>

      <div data-gecmis-panel="zaman">
        <ul class="y-zaman-cizgisi">
          {[...s.gecmis].reverse().map((g, idx) => (
            <li class:list={{ 'is-ilk': idx === 0 }}>
              <span class="y-zaman-nokta" aria-hidden="true">✓</span>
              <div class="y-zaman-icerik">
                <strong>{g.islem === IADE_ISLEMI ? 'İade tamamlandı' : g.islem === 'manuel-odeme' ? 'Manuel ödeme onayı' : g.islem === 'takip-duzeltildi' ? 'Takip güncellendi' : SIPARIS_DURUM_ADLARI[g.durum]}</strong>
                {g.not && <small>{g.not}</small>}
              </div>
              <time>{yTarih.format(new Date(g.tarih))}</time>
            </li>
          ))}
        </ul>
      </div>

      <form method="post" class="y-ic-not-kutusu" data-gecmis-panel="not" hidden>
        <input type="hidden" name="eylem" value="not" />
        <label class="y-alan">Yönetici iç notu <span class="muted">(müşteri görmez)</span>
          <textarea name="yoneticiNotu" rows="3" maxlength="1000" placeholder="Sipariş hazırlığı, paketleme veya müşteri görüşmesi notu…">{s.yoneticiNotu ?? ''}</textarea>
        </label>
        <button class="btn btn--sepet btn--kucuk" type="submit"><PIkon ad="tik" boyut={15} />Notu kaydet</button>
      </form>
      {s.yoneticiNotu && <p class="y-mevcut-not" data-gecmis-panel="zaman"><strong>İç not:</strong> {s.yoneticiNotu}</p>}
    </section>
  </div>
</Yonetim>
<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-gecmis-sekme]')) {
    btn.addEventListener('click', () => {
      const hedef = btn.dataset.gecmisSekme;
      const kart = btn.closest('.y-gecmis-kart');
      if (!kart || !hedef) return;
      kart.querySelectorAll<HTMLButtonElement>('[data-gecmis-sekme]').forEach((b) => b.classList.toggle('is-aktif', b === btn));
      kart.querySelectorAll<HTMLElement>('[data-gecmis-panel]').forEach((p) => { p.hidden = p.dataset.gecmisPanel !== hedef; });
    });
  }
</script>
