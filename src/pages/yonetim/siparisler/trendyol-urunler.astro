---
import Yonetim from '../../../layouts/Yonetim.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import { DogrulamaHatasi, magazaOku, siparisleriOku, webAyrilanAdetleri } from '../../../lib/depo';
import { finansOku } from '../../../lib/finansDepo';
import { liste, metin } from '../../../lib/form';
import { fiyatOzeti, pazaryeriFiyatlariEsitle } from '../../../lib/kanalFiyat';
import { bosAyarlar, kanalHedefStok, type KanalIlanTaslagi } from '../../../lib/pazaryeri';
import { PazaryeriApiHatasi, pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { envanterAyarlariGuncelle, envanterAyarlariOku, pazaryeriHazirMi } from '../../../lib/pazaryeriDepo';
import { tyAdresler, tyKategoriAra, tyKategoriOzellikleri, tyMarkaAra, tyUrunGonder, type TyKategori, type TyOzellik } from '../../../lib/trendyolApi';
import { ilanAciklamasi, ilanFiyati, ilanGorselleri, ilanIstegi, ilanVarsayilani, ozellikOnerileri } from '../../../lib/trendyolIlan';
import { ilanBekliyor, ilanDurumlariniYenile } from '../../../lib/trendyolIlanIslem';
import { yTarih } from '../../../lib/yonetimRapor';

const yol = '/yonetim/siparisler/trendyol-urunler';
const q = Astro.url.searchParams;
const hatalar: string[] = [];
const api = pazaryeriApiDurumu('trendyol');
const apiHazir = api === 'canli' || api === 'test';
const depoHazir = await pazaryeriHazirMi();
const [magaza, webSiparisleri] = await Promise.all([magazaOku(true), siparisleriOku(true).catch(() => [])]);
const ayrilanMap = webAyrilanAdetleri(webSiparisleri, Date.now(), magaza.paytrStokIslemleri);
const urunler = [...magaza.urunler].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr'));
const secili = urunler.find((u) => u.id === q.get('urun'));
const geri = (ek: Record<string, string>, capa = '') => Astro.redirect(yol + '?' + new URLSearchParams(ek) + capa, 303);
const ondalik = (v: string) => { const s = v.trim().replace(',', '.'); if (!s) return undefined; const n = Number(s); return Number.isFinite(n) ? n : NaN; };
const hataMetni = (e: unknown) => e instanceof DogrulamaHatasi ? e.hatalar : e instanceof PazaryeriApiHatasi ? [e.message] : ['İşlem tamamlanamadı. Bağlantıyı kontrol edip tekrar deneyin.'];

let ayar = bosAyarlar();
try { ayar = await envanterAyarlariOku(); } catch { hatalar.push('Kanal ayarları okunamadı.'); }
let k = ayar.kanallar.trendyol;

/** Seçili ürünün kategori özellikleri (Trendyol'dan, 1 saat önbellekli) */
let ozellikler: TyOzellik[] | undefined;
const ozellikleriOku = async (kategoriId?: number) => {
  if (!kategoriId || !apiHazir) return undefined;
  try { return await tyKategoriOzellikleri(kategoriId); } catch (e) { hatalar.push(...hataMetni(e)); return undefined; }
};
const taslakAl = (urunId: string, desi?: number): KanalIlanTaslagi => {
  const u = urunler.find((x) => x.id === urunId)!;
  return structuredClone(k.ilanlar[urunId] ?? ilanVarsayilani(u, desi));
};
const formdanTaslak = (f: FormData, t: KanalIlanTaslagi, oz: TyOzellik[] | undefined): KanalIlanTaslagi => {
  const desi = ondalik(metin(f, 'desi'));
  if (desi !== undefined && (Number.isNaN(desi) || desi <= 0 || desi > 10_000)) throw new DogrulamaHatasi(['Desi 0’dan büyük bir sayı olmalı (ör. 4 veya 4,5).']);
  const ozelFiyat = ondalik(metin(f, 'ozelFiyat'));
  if (ozelFiyat !== undefined && (Number.isNaN(ozelFiyat) || ozelFiyat <= 0 || ozelFiyat > 10_000_000)) {
    throw new DogrulamaHatasi(['Trendyol özel satış fiyatı 0’dan büyük geçerli bir TL tutarı olmalı (site/kural fiyatını kullanmak için boş bırakın).']);
  }
  const kdv = Number(metin(f, 'kdv'));
  if (![0, 1, 10, 20].includes(kdv)) throw new DogrulamaHatasi(['KDV oranını seçin.']);
  const yeni: KanalIlanTaslagi = {
    ...t, barkod: metin(f, 'barkod').replace(/\s/g, '').slice(0, 40), stokKodu: metin(f, 'stokKodu').slice(0, 100),
    anaKod: metin(f, 'anaKod').slice(0, 40), baslik: metin(f, 'baslik').slice(0, 100), desi, kdv, fiyat: ozelFiyat,
  };
  if (oz) {
    yeni.ozellikler = [];
    for (const o of oz) {
      const ids = liste(f, 'oz-' + o.id).map(Number).filter((n) => Number.isSafeInteger(n) && n > 0 && o.degerler.some((d) => d.id === n));
      const ozel = metin(f, 'ozm-' + o.id).slice(0, 400);
      if (ids.length) yeni.ozellikler.push({ attributeId: o.id, ad: o.ad, attributeValueIds: o.coklu ? ids.slice(0, 20) : ids.slice(0, 1), degerAdi: ids.map((n) => o.degerler.find((d) => d.id === n)?.ad).join(', ') });
      else if (ozel && o.ozelDeger) yeni.ozellikler.push({ attributeId: o.id, ad: o.ad, attributeValue: ozel });
    }
  }
  return yeni;
};
const satilabilir = async (urunId: string) => {
  const u = urunler.find((x) => x.id === urunId)!;
  return kanalHedefStok(Math.max(0, u.stok - (ayrilanMap.get(urunId) ?? 0)), k);
};
const urunHedefStok = (u: (typeof urunler)[number]) => kanalHedefStok(Math.max(0, u.stok - (ayrilanMap.get(u.id) ?? 0)), k);

if (Astro.request.method === 'POST') {
  try {
    if (!depoHazir) throw new DogrulamaHatasi(['Kanal ayarları kullanılamıyor. Veritabanı bağlantısını kontrol edin.']);
    const f = await Astro.request.formData();
    const eylem = metin(f, 'eylem');
    if (eylem === 'fiyat-kurali') {
      const otoFiyat = f.get('otoFiyat') === 'on';
      const yuzde = Number(String(f.get('yuzde') ?? '0').replace(',', '.'));
      const ekTL = Number(String(f.get('ekTL') ?? '0').replace(',', '.'));
      const yuvarla = f.get('yuvarla') === 'on';
      if (!Number.isFinite(yuzde) || !Number.isFinite(ekTL) || yuzde < -50 || yuzde > 300 || ekTL < 0 || ekTL > 100_000) {
        throw new DogrulamaHatasi(['Yüzde farkı -%50 ile +%300, ek tutar 0 ile 100.000 TL arasında olmalı.']);
      }
      await envanterAyarlariGuncelle((a) => {
        a.otomasyon.otoFiyat = otoFiyat;
        a.kanallar.trendyol.fiyatKurali = { yuzde, ekTL, yuvarla };
      });
      return geri({ ok: 'Trendyol fiyat kuralı ve otomatik eşitleme tercihi kaydedildi.' }, '#fiyat');
    }
    if (!apiHazir && !['kaydet', 'taslak-sil'].includes(eylem)) throw new DogrulamaHatasi(['Bu işlem için bu sunucuda Trendyol API anahtarlarının tanımlı olması gerekir.']);
    if (eylem === 'fiyat-gonder') {
      const [r] = await pazaryeriFiyatlariEsitle({ kanallar: ['trendyol'] });
      if (r?.hata) throw new DogrulamaHatasi([r.hata]);
      const ozet = fiyatOzeti(r ? [r] : []).join(' ');
      return geri({ ok: r?.gonderilen.length ? ozet + ' Trendyol birkaç dakika içinde uygular.' : `Takipteki ürünlerin Trendyol fiyatı hedefle aynı (${r?.ayni ?? 0} ürün). Takipte olmayan bir ürünün fiyatını göndermek için o ürünü açıp “Fiyatı şimdi gönder”e basın.${ozet ? ' ' + ozet : ''}` }, '#fiyat');
    }
    if (eylem === 'durum-yenile') {
      const notlar = await ilanDurumlariniYenile(undefined, 12);
      return geri(notlar.length ? { hata: notlar.join(' ') } : { ok: 'Durumlar Trendyol’dan güncellendi.' });
    }
    const urunId = metin(f, 'urun');
    const u = urunler.find((x) => x.id === urunId);
    if (!u) throw new DogrulamaHatasi(['Ürün bulunamadı.']);
    const finans = await finansOku().catch(() => undefined);
    const t = taslakAl(urunId, finans?.hbUrunler[urunId]?.desi);
    if (t.durum === 'onaylandi' && ['gonder'].includes(eylem)) throw new DogrulamaHatasi(['Ürün Trendyol’da onaylı. Bilgilerini Trendyol satıcı panelinden değiştirin; fiyat ve stok buradan otomatik gider.']);
    if (eylem === 'kategori-sec') {
      const id = Number(metin(f, 'kategoriId'));
      if (!Number.isSafeInteger(id) || id <= 0) throw new DogrulamaHatasi(['Kategori seçin.']);
      const oz = await tyKategoriOzellikleri(id);
      const yeni: KanalIlanTaslagi = { ...t, kategoriId: id, kategoriAdi: metin(f, 'kategoriAdi').slice(0, 300), ozellikler: ozellikOnerileri(u, oz) };
      await envanterAyarlariGuncelle((a) => { a.kanallar.trendyol.ilanlar[urunId] = yeni; });
      return geri({ urun: urunId, ok: 'Kategori seçildi. Zorunlu özellikleri doldurun; sitedeki teknik bilgilerden bulunanlar dolduruldu.' }, '#ozellikler');
    }
    if (eylem === 'marka-sec') {
      const id = Number(metin(f, 'markaId'));
      if (!Number.isSafeInteger(id) || id <= 0) throw new DogrulamaHatasi(['Marka seçin.']);
      await envanterAyarlariGuncelle((a) => { a.kanallar.trendyol.ilanlar[urunId] = { ...t, markaId: id, markaAdi: metin(f, 'markaAdi').slice(0, 120) }; });
      return geri({ urun: urunId, ok: 'Marka seçildi.' }, '#marka');
    }
    if (eylem === 'kaydet' || eylem === 'gonder' || eylem === 'kaydet-fiyat') {
      const oz = await ozellikleriOku(t.kategoriId);
      const yeni = formdanTaslak(f, t, oz);
      if (eylem === 'kaydet' || eylem === 'kaydet-fiyat') {
        await envanterAyarlariGuncelle((a) => {
          a.kanallar.trendyol.ilanlar[urunId] = yeni;
          if (a.kanallar.trendyol.urunler[urunId]) a.kanallar.trendyol.urunler[urunId].ozelFiyat = yeni.fiyat;
        });
        if (eylem === 'kaydet-fiyat') {
          if (!apiHazir) throw new DogrulamaHatasi(['Kaydedildi; fiyat göndermek için bu sunucuda Trendyol bağlantısı gerekir.']);
          if (!k.urunler[urunId]?.kod) throw new DogrulamaHatasi(['Kaydedildi; ürün henüz bir Trendyol ilanına bağlı değil, fiyat gönderilemedi.']);
          const [r] = await pazaryeriFiyatlariEsitle({ kanallar: ['trendyol'], urunIdler: [urunId] });
          if (r?.hata) throw new DogrulamaHatasi(['Kaydedildi ama fiyat gönderilemedi: ' + r.hata]);
          return geri({ urun: urunId, ok: r?.gonderilen.length ? 'Kaydedildi. ' + fiyatOzeti([r]).join(' ') + ' Trendyol birkaç dakika içinde uygular.' : 'Kaydedildi. Trendyol fiyatı zaten hedefle aynı.' }, '#ilan');
        }
        return geri({ urun: urunId, ok: t.durum === 'onaylandi' ? 'Kaydedildi. Fiyat Trendyol’a gitmedi; göndermek için “Kaydet ve fiyatı şimdi gönder”e basın.' : 'Taslak kaydedildi.' }, '#ilan');
      }
      if (ilanBekliyor(t)) throw new DogrulamaHatasi(['Bu ürün zaten gönderildi, Trendyol’un yanıtı bekleniyor. “Durumları yenile”ye basın.']);
      if (Object.entries(k.urunler).some(([id, x]) => id !== urunId && x.kod === yeni.barkod)) throw new DogrulamaHatasi(['Bu barkod Trendyol’da başka bir ürüne bağlı.']);
      const adres = await tyAdresler().catch(() => ({ sevkiyat: undefined, iade: undefined }));
      const hazir = ilanIstegi(u, yeni, k, await satilabilir(urunId), oz, { sevkiyat: adres.sevkiyat?.id, iade: adres.iade?.id });
      if (!hazir.istek) {
        await envanterAyarlariGuncelle((a) => { a.kanallar.trendyol.ilanlar[urunId] = yeni; });
        throw new DogrulamaHatasi(['Gönderim için eksik: ' + hazir.eksikler.join(', ') + '.']);
      }
      const batchId = await tyUrunGonder([hazir.istek]);
      const tarih = new Date().toISOString();
      await envanterAyarlariGuncelle((a) => {
        a.kanallar.trendyol.ilanlar[urunId] = { ...yeni, durum: 'gonderildi', batchId, gonderim: tarih, mesajlar: [], sonFiyat: hazir.istek!.salePrice, sonFiyatTarih: tarih };
      });
      return geri({ urun: urunId, ok: 'Ürün Trendyol’a gönderildi. Trendyol önce kontrol eder, sonra onaya alır; durum bu sayfada kendiliğinden güncellenir.' }, '#ilan');
    }
    if (eylem === 'taslak-sil') {
      await envanterAyarlariGuncelle((a) => {
        const x = a.kanallar.trendyol.ilanlar[urunId];
        if (x && ilanBekliyor(x)) throw new DogrulamaHatasi(['Gönderilmiş ürünün kaydı silinemez; Trendyol yanıtını bekleyin.']);
        delete a.kanallar.trendyol.ilanlar[urunId];
      });
      return geri({ urun: urunId, ok: 'Taslak sıfırlandı.' });
    }
    throw new DogrulamaHatasi(['Geçersiz işlem.']);
  } catch (e) {
    hatalar.push(...hataMetni(e));
  }
}

/* Sayfa açılışında bekleyen ilanların durumunu sessizce yenile (en fazla 6, 2 dk'da bir). */
if (Astro.request.method === 'GET' && depoHazir && apiHazir) {
  const eskiler = Object.entries(k.ilanlar).filter(([, t]) => ilanBekliyor(t) && Date.now() - Date.parse(t.kontrol ?? t.gonderim ?? '') > 120_000).map(([id]) => id);
  if (eskiler.length) {
    const notlar = await ilanDurumlariniYenile(eskiler).catch(() => [] as string[]);
    hatalar.push(...notlar);
    ayar = await envanterAyarlariOku().catch(() => ayar);
    k = ayar.kanallar.trendyol;
  }
}

const finans = await finansOku().catch(() => undefined);
const taslak = secili ? (k.ilanlar[secili.id] ?? ilanVarsayilani(secili, finans?.hbUrunler[secili.id]?.desi)) : undefined;
if (secili && taslak?.kategoriId) ozellikler = await ozellikleriOku(taslak.kategoriId);
let kategoriSonuclari: TyKategori[] = [];
let markaSonuclari: { id: number; ad: string }[] = [];
const kategoriAra = q.get('kara')?.trim() ?? '';
const markaAra = q.get('mara')?.trim() ?? '';
if (secili && apiHazir) {
  try {
    if (kategoriAra) kategoriSonuclari = await tyKategoriAra(kategoriAra);
    if (markaAra) markaSonuclari = await tyMarkaAra(markaAra);
  } catch (e) { hatalar.push(...hataMetni(e)); }
}
const stokHedefi = secili ? await satilabilir(secili.id).catch(() => undefined) : undefined;
const hazirlik = secili && taslak ? ilanIstegi(secili, taslak, k, stokHedefi ?? 0, ozellikler, {}) : undefined;
const gorseller = secili ? ilanGorselleri(secili) : [];
const aciklama = secili ? ilanAciklamasi(secili) : '';

const DURUM: Record<KanalIlanTaslagi['durum'], [string, 'yesil' | 'turuncu' | 'kirmizi' | 'gri']> = {
  taslak: ['Taslak', 'gri'], gonderildi: ['Trendyol kontrol ediyor', 'turuncu'], 'onay-bekliyor': ['Onay bekliyor', 'turuncu'],
  reddedildi: ['Reddedildi', 'kirmizi'], hata: ['Gönderim hatası', 'kirmizi'], onaylandi: ['Satışta', 'yesil'],
};
const satirDurumu = (urunId: string): [string, 'yesil' | 'turuncu' | 'kirmizi' | 'gri'] => {
  const t = k.ilanlar[urunId];
  if (t) return DURUM[t.durum];
  return k.urunler[urunId]?.kod ? ['Bağlı (elle)', 'yesil'] : ['Gönderilmedi', 'gri'];
};
const para = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
const seciliDeger = (o: TyOzellik) => taslak?.ozellikler.find((x) => x.attributeId === o.id);
const zorunluOz = ozellikler?.filter((o) => o.zorunlu) ?? [];
const istegeOz = ozellikler?.filter((o) => !o.zorunlu) ?? [];
const ozellikAlanlari = [{ baslik: 'Zorunlu özellikler', liste: zorunluOz, acik: true }, { baslik: `İsteğe bağlı özellikler (${istegeOz.length})`, liste: istegeOz, acik: false }];
---
<Yonetim baslik={secili ? 'Trendyol İlan Düzenleyici' : 'Trendyol Ürünleri'} altBaslik="Sitedeki ürünlerinizi Trendyol'da satışa açın; fiyat ve stok buradan yönetilir." aktif="siparisler" basari={q.get('ok')} hatalar={[...hatalar, ...(q.get('hata') ? [q.get('hata')!] : [])]}>
  <KanalLogo slot="baslik-onu" kanal="trendyol" boyut="buyuk" />
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/siparisler/kanallar#trendyol"><PIkon ad="zincir" boyut={18} />Satış kanalları</a>
    {!secili && <a class="btn btn--cizgi" href="#fiyat" data-ac="fiyat"><PIkon ad="etiket" boyut={18} />Fiyatlar</a>}
    {apiHazir && depoHazir && <form method="post"><button class="btn btn--cizgi" name="eylem" value="durum-yenile" type="submit"><PIkon ad="yenile" boyut={18} />Durumları yenile</button></form>}
  </div>

  {!apiHazir && (k.sonApi || k.sonOtomatikApi ? (
    <div class="y-veri-not" role="status" style="margin-bottom:14px">
      <PIkon ad="bilgi" boyut={18} />
      <p>
        <strong>Canlı sunucuda (Vercel) Trendyol bağlantısı aktif</strong>
        Son başarılı bağlantı: <strong>{yTarih.format(new Date((k.sonApi ?? k.sonOtomatikApi)!))}</strong>. Otomatik sipariş, stok ve fiyat eşitlemesi canlı sunucuda çalışıyor. Bu bilgisayardan (localhost) anlık API gönderimi yapmak için Vercel'deki <code>TRENDYOL_*</code> anahtarlarını yerel <code>.env</code> dosyanıza da ekleyebilirsiniz (taslak ve fiyat kuralı kaydı yerel ortamda da açıktır).
      </p>
    </div>
  ) : (
    <p class="y-uyari-satir" role="status">Trendyol bağlantısı kurulmamış. Satış kanalları sayfasındaki “Mağazayı bağlama” adımlarını izleyin.</p>
  ))}
  {api === 'test' && <p class="y-uyari-satir" role="status">Test ortamına bağlısınız. Gönderilen ürünler canlı mağazada görünmez.</p>}

  {!secili && <div class="y-metrics y-metrics--finans">
    <div class="y-metric y-metric--altin"><PIkon ad="kutu" /><span>Toplam ürün</span><strong>{urunler.length}</strong></div>
    <div class="y-metric y-metric--yesil"><PIkon ad="tik-daire" /><span>Satışta / bağlı</span><strong>{urunler.filter((u) => satirDurumu(u.id)[1] === 'yesil').length}</strong></div>
    <div class="y-metric y-metric--turuncu"><PIkon ad="saat" /><span>Onay bekleyen</span><strong>{Object.values(k.ilanlar).filter(ilanBekliyor).length}</strong></div>
    <div class="y-metric y-metric--kirmizi"><PIkon ad="carpi-daire" /><span>Reddedilen / hatalı</span><strong>{Object.values(k.ilanlar).filter((x) => x.durum === 'reddedildi' || x.durum === 'hata').length}</strong></div>
  </div>}
  {secili && taslak && <div class="y-ilan-duzen" id="ilan">
  <section class="y-kart">
    <div class="y-kart__bas"><h2><PIkon ad="kalem" /> İlan bilgileri · {secili.marka} {secili.kisaAd}</h2><span class:list={['y-chip', 'y-chip--' + DURUM[taslak.durum][1]]}>{DURUM[taslak.durum][0]}</span></div>
    <ol class="ty-hazirlik-adimlari" aria-label="İlan hazırlık aşamaları">
      <li class:list={{ 'is-tamam': !!taslak.kategoriId }}>
        <a href="#kategori">
          <span class="ty-hazirlik-no">{taslak.kategoriId ? '✓' : '1'}</span>
          <div><strong>Kategori</strong><small>{taslak.kategoriAdi || 'Seçilmedi'}</small></div>
        </a>
      </li>
      <li class:list={{ 'is-tamam': !!taslak.markaId }}>
        <a href="#marka">
          <span class="ty-hazirlik-no">{taslak.markaId ? '✓' : '2'}</span>
          <div><strong>Marka</strong><small>{taslak.markaAdi || 'Seçilmedi'}</small></div>
        </a>
      </li>
      <li class:list={{ 'is-tamam': !!hazirlik && hazirlik.eksikler.length === 0 }}>
        <a href="#ozellikler">
          <span class="ty-hazirlik-no">{hazirlik && hazirlik.eksikler.length === 0 ? '✓' : '3'}</span>
          <div><strong>İlan Bilgileri ve Özellikler</strong><small>{hazirlik && hazirlik.eksikler.length > 0 ? `${hazirlik.eksikler.length} eksik alan` : 'Tamamlandı'}</small></div>
        </a>
      </li>
    </ol>
    {hazirlik && hazirlik.eksikler.length > 0 && taslak.durum !== 'onaylandi' && <div class="y-uyari ty-eksik-kutu" role="status">
      <div>
        <strong>İlan henüz gönderime hazır değil ({hazirlik.eksikler.length} eksik):</strong>
        <span> {hazirlik.eksikler.join(' · ')}</span>
      </div>
      <a class="btn btn--cizgi btn--kucuk" href={!taslak.kategoriId ? '#kategori' : !taslak.markaId ? '#marka' : '#ozellikler'}>Eksik alana git →</a>
    </div>}
    {taslak.mesajlar.length > 0 && <div class="y-uyari ty-ret-kutu" role="alert"><strong>Trendyol’un ret / hata notu:</strong><ul>{taslak.mesajlar.map((m) => <li>{m}</li>)}</ul></div>}
    {taslak.gonderim && <p class="y-help">Son gönderim: {yTarih.format(new Date(taslak.gonderim))}{taslak.kontrol ? ' · Son kontrol: ' + yTarih.format(new Date(taslak.kontrol)) : ''}</p>}

    <div class="ty-adim" id="kategori">
      <h3>Trendyol kategorisi</h3>
      <p>{taslak.kategoriAdi ? <strong>{taslak.kategoriAdi}</strong> : <span class="muted">Seçilmedi</span>}</p>
      <form method="get" action="#kategori" class="y-toolbar">
        <input type="hidden" name="urun" value={secili.id} />
        <label class="y-alan">Kategori ara<input name="kara" value={kategoriAra} placeholder="ör. Düdüklü Tencere" minlength="2" /></label>
        <button class="btn btn--cizgi" type="submit" disabled={!apiHazir}>Ara</button>
      </form>
      {kategoriAra && !kategoriSonuclari.length && <p class="y-help">Sonuç yok. Daha genel bir kelime deneyin (ör. “Tencere”).</p>}
      {kategoriSonuclari.length > 0 && <ul class="ty-secenekler">{kategoriSonuclari.map((c) => <li>
        <form method="post"><input type="hidden" name="urun" value={secili.id} /><input type="hidden" name="kategoriId" value={c.id} /><input type="hidden" name="kategoriAdi" value={c.yol} />
          <button class="ty-secenek" type="submit" name="eylem" value="kategori-sec">{c.yol}</button></form>
      </li>)}</ul>}
    </div>

    <div class="ty-adim" id="marka">
      <h3>Trendyol markası</h3>
      <p>{taslak.markaAdi ? <strong>{taslak.markaAdi}</strong> : <span class="muted">Seçilmedi</span>}</p>
      <form method="get" action="#marka" class="y-toolbar">
        <input type="hidden" name="urun" value={secili.id} />
        <label class="y-alan">Marka ara<input name="mara" value={markaAra || secili.marka} /></label>
        <button class="btn btn--cizgi" type="submit" disabled={!apiHazir}>Ara</button>
      </form>
      {markaAra && !markaSonuclari.length && <p class="y-help">Trendyol marka listesinde bulunamadı. Satıcı panelinden marka başvurusu yapmanız gerekebilir (markanın yetkili satıcı belgesi istenir).</p>}
      {markaSonuclari.length > 0 && <ul class="ty-secenekler">{markaSonuclari.map((m) => <li>
        <form method="post"><input type="hidden" name="urun" value={secili.id} /><input type="hidden" name="markaId" value={m.id} /><input type="hidden" name="markaAdi" value={m.ad} />
          <button class="ty-secenek" type="submit" name="eylem" value="marka-sec">{m.ad}</button></form>
      </li>)}</ul>}
    </div>

    <form method="post" class="ty-adim" id="ozellikler">
      <input type="hidden" name="urun" value={secili.id} />
      <h3>Fiyat, stok ve özellikler</h3>
      <div class="y-izgara y-izgara--2">
        <label class="y-alan">Barkod<input name="barkod" value={taslak.barkod} maxlength="40" required autocomplete="off" /><small class="muted">Kutudaki 13 haneli EAN. Sitedeki teknik özelliklerde “Barkod (EAN)” satırı varsa oradan gelir.</small></label>
        <label class="y-alan">Stok kodu<input name="stokKodu" value={taslak.stokKodu} maxlength="100" required /></label>
        <label class="y-alan">Ana ürün kodu<input name="anaKod" value={taslak.anaKod} maxlength="40" required /><small class="muted">Aynı ürünün renk/boy seçenekleri bu kodda birleşir.</small></label>
        <label class="y-alan">Başlık (en fazla 100 karakter)<input name="baslik" value={taslak.baslik} maxlength="100" required /></label>
        <label class="y-alan">Desi<input name="desi" inputmode="decimal" value={taslak.desi === undefined ? '' : String(taslak.desi).replace('.', ',')} placeholder="ör. 4" required /><small class="muted">En × boy × yükseklik (cm) ÷ 3000. Kargo ücreti buna göre kesilir.</small></label>
        <label class="y-alan">KDV<select name="kdv">{[20, 10, 1, 0].map((o) => <option value={o} selected={o === taslak.kdv}>%{o}</option>)}</select></label>
        <label class="y-alan">Trendyol özel satış fiyatı (TL, isteğe bağlı)<input name="ozelFiyat" inputmode="decimal" value={(taslak.fiyat ?? k.urunler[secili.id]?.ozelFiyat) !== undefined ? String(taslak.fiyat ?? k.urunler[secili.id]?.ozelFiyat).replace('.', ',') : ''} placeholder={`Site/kural fiyatı: ${para(ilanFiyati(secili, k))}`} /><small class="muted">Boş bırakırsanız sitedeki son fiyat (veya genel Trendyol kuralı) uygulanır: şu an <strong>{para(ilanFiyati(secili, k, taslak))}</strong>.</small></label>
        <div class="y-alan"><span>Gönderilecek stok</span><strong>{stokHedefi ?? '—'} adet</strong><small class="muted">Depodaki satılabilir stok − {k.guvenlikPayi} güvenlik payı. Sonra otomatik eşitlenir.</small></div>
      </div>

      {!taslak.kategoriId && <p class="y-help">Özellikleri görmek için önce kategori seçin.</p>}
      {taslak.kategoriId && !ozellikler && <p class="y-uyari">Kategori özellikleri Trendyol’dan okunamadı. Sayfayı yenileyin.</p>}
      {ozellikler && ozellikAlanlari.map((grup) => grup.liste.length > 0 && <details class="ty-ozellikler" open={grup.acik}>
        <summary>{grup.baslik}</summary>
        <div class="y-izgara y-izgara--2">{grup.liste.map((o) => {
          const g = seciliDeger(o);
          return <div class="y-alan">
            <span>{o.ad}{o.zorunlu && <b class="ty-zorunlu"> *</b>}</span>
            {o.degerler.length > 0 && (o.coklu ? <select name={'oz-' + o.id} multiple size={4}>
              {o.degerler.map((d) => <option value={d.id} selected={g?.attributeValueIds?.includes(d.id)}>{d.ad}</option>)}
            </select> : <select name={'oz-' + o.id}>
              <option value="">{o.ozelDeger ? '— Listeden seçin ya da aşağıya yazın —' : '— Seçin —'}</option>
              {o.degerler.map((d) => <option value={d.id} selected={g?.attributeValueIds?.includes(d.id)}>{d.ad}</option>)}
            </select>)}
            {(o.ozelDeger || !o.degerler.length) && <input name={'ozm-' + o.id} value={g?.attributeValue ?? ''} placeholder={o.degerler.length ? 'veya kendiniz yazın' : 'Değer yazın'} maxlength="400" />}
          </div>;
        })}</div>
      </details>)}

      <details class="ty-ozellikler">
        <summary>Trendyol’a gidecek görseller ve açıklama</summary>
        <div class="ty-gorseller">{gorseller.map((g) => <img src={g} alt="" loading="lazy" width="96" height="96" />)}</div>
        {!gorseller.length && <p class="y-uyari">Üründe görsel yok. Önce Ürünler sayfasından görsel ekleyin.</p>}
        <p class="y-help">Açıklama sitedeki ürün özeti, öne çıkan bilgiler, teknik özellikler, kutu içeriği ve garantiden otomatik oluşur. Değiştirmek için ürünü sitede düzenleyin.</p>
        <div class="ty-aciklama" set:html={aciklama} />
      </details>

      {hazirlik && hazirlik.eksikler.length > 0 && taslak.durum !== 'onaylandi' && <p class="y-uyari">Göndermeden önce tamamlanacak: {hazirlik.eksikler.join(', ')}.</p>}
      {hazirlik?.istek && taslak.durum !== 'onaylandi' && <p class="y-help">Hazır: {para(hazirlik.istek.salePrice)} · {hazirlik.istek.quantity} adet · {hazirlik.istek.images.length} görsel · {hazirlik.istek.attributes.length} özellik.</p>}
      {taslak.durum === 'onaylandi'
        ? <>
            <p class="y-help">Ürün Trendyol’da onaylı ve “Ürün eşleştirmeleri”ne bağlı. Stok ortak depodan otomatik gider. Fiyat yalnız aşağıdaki düğmeyle (ya da ürüne otomatik fiyat takibi açtıysanız kendiliğinden) gider. Başlık, açıklama ve görseli Trendyol satıcı panelinden değiştirin.</p>
            <div class="y-modal__alt">
              <button class="btn btn--cizgi" type="submit" name="eylem" value="kaydet" disabled={!depoHazir}>Özel fiyatı kaydet</button>
              <button class="btn btn--sepet" type="submit" name="eylem" value="kaydet-fiyat" disabled={!depoHazir || !apiHazir}>Kaydet ve fiyatı şimdi gönder</button>
            </div>
          </>
        : <div class="y-modal__alt">
            <button class="btn btn--cizgi" type="submit" name="eylem" value="kaydet" disabled={!depoHazir}>Kaydet</button>
            <button class="btn btn--sepet" type="submit" name="eylem" value="gonder" disabled={!depoHazir || !apiHazir || ilanBekliyor(taslak)}>{taslak.durum === 'reddedildi' || taslak.durum === 'hata' ? 'Düzeltip yeniden gönder' : 'Kaydet ve Trendyol’a gönder'}</button>
            {k.ilanlar[secili.id] && !ilanBekliyor(taslak) && <button class="btn btn--cizgi" type="submit" name="eylem" value="taslak-sil" formnovalidate>Taslağı sıfırla</button>}
          </div>}
    </form>
  </section>
  <aside class="y-kart ty-vitrin" aria-label="Kayıtlı ilan özeti">
    <h2><PIkon ad="grafik" /> Trendyol ilan özeti</h2>
    {gorseller[0] && <img src={gorseller[0]} alt="" width="260" height="180" loading="lazy" decoding="async" />}
    <p><strong>{taslak.baslik || [secili.marka, secili.kisaAd].join(' ')}</strong></p>
    <dl class="y-money-lines y-money-lines--kucuk">
      <div><dt>İlan fiyatı</dt><dd>{para(ilanFiyati(secili, k, taslak))}</dd></div>
      <div><dt>Hedef stok</dt><dd>{stokHedefi ?? '—'} adet</dd></div>
      <div><dt>İlan durumu</dt><dd><span class:list={['y-chip', 'y-chip--' + DURUM[taslak.durum][1]]}>{DURUM[taslak.durum][0]}</span></dd></div>
      <div><dt>Görseller</dt><dd>{gorseller.length} hazır</dd></div>
    </dl>
    <div class="ty-kontrol-kutu">
      <h3>Gönderim kontrolü</h3>
      <ul class="ty-kontrol-listesi">
        <li><span>Trendyol kategorisi</span><b class:list={['y-chip', taslak.kategoriId ? 'y-chip--yesil' : 'y-chip--turuncu']}>{taslak.kategoriId ? 'Tamam' : 'Eksik'}</b></li>
        <li><span>Trendyol markası</span><b class:list={['y-chip', taslak.markaId ? 'y-chip--yesil' : 'y-chip--turuncu']}>{taslak.markaId ? 'Tamam' : 'Eksik'}</b></li>
        <li><span>Barkod ve desi</span><b class:list={['y-chip', taslak.barkod && taslak.desi ? 'y-chip--yesil' : 'y-chip--turuncu']}>{taslak.barkod && taslak.desi ? 'Tamam' : 'Eksik'}</b></li>
        <li><span>Zorunlu özellikler</span><b class:list={['y-chip', !hazirlik?.eksikler.some((x) => x.includes('özelliği')) && taslak.kategoriId ? 'y-chip--yesil' : 'y-chip--turuncu']}>{!taslak.kategoriId ? 'Kategori seçin' : !hazirlik?.eksikler.some((x) => x.includes('özelliği')) ? 'Tamam' : 'Eksik var'}</b></li>
        <li><span>Ürün fotoğrafları</span><b class:list={['y-chip', gorseller.length > 0 ? 'y-chip--yesil' : 'y-chip--kirmizi']}>{gorseller.length > 0 ? 'Hazır' : 'Eksik'}</b></li>
      </ul>
    </div>
    <p class="y-help">Bu önizleme taslak verilerine göredir; Trendyol onayı gönderimden sonra kesinleşir.</p>
    <a class="btn btn--cizgi" href={yol + '#liste'}>Ürün kataloğuna dön</a>
  </aside>
  </div>}

  <details class="y-kart" id="fiyat" open={q.has('ok') && !secili}>
    <summary><strong>Trendyol fiyatları ve fiyat kuralı</strong></summary>
    <p class="y-help">Trendyol fiyatını ister sitedeki son fiyatla birebir aynı tutun (%0 ve +0 TL), ister komisyon/kargo farkı için genel bir yüzde/TL kuralı belirleyin. Tek bir ürüne özel fiyat vermek için o ürünün ilan düzenleyicisindeki “Trendyol özel satış fiyatı” alanını kullanabilirsiniz.</p>
    <form method="post" class="y-izgara" style="margin:10px 0;padding:12px;border:1px solid var(--y-border);border-radius:10px;background:var(--y-surface-2,#faf7f2)">
      <input type="hidden" name="eylem" value="fiyat-kurali" />
      <label class="y-secim">
        <input type="checkbox" name="otoFiyat" checked={ayar.otomasyon.otoFiyat} disabled={!depoHazir} />
        <span><strong>Otomatik fiyat takibi çalışsın</strong> <small class="muted">(Yalnız “Otomatik fiyat takibi” açık ürünler 5 dakika içinde hedef fiyata çekilir; diğer ürünlerin Trendyol fiyatı siz göndermedikçe değişmez)</small></span>
      </label>
      <div class="y-izgara y-izgara--3">
        <label class="y-alan">Yüzde fark (%)<input name="yuzde" inputmode="decimal" value={k.fiyatKurali.yuzde} disabled={!depoHazir} /><small class="muted">0 = siteyle aynı</small></label>
        <label class="y-alan">Ek tutar (+TL)<input name="ekTL" inputmode="decimal" value={k.fiyatKurali.ekTL} disabled={!depoHazir} /><small class="muted">0 = ek tutar yok</small></label>
        <label class="y-secim" style="align-self:center"><input type="checkbox" name="yuvarla" checked={k.fiyatKurali.yuvarla} disabled={!depoHazir} /> Sonucu ,90 TL’ye yuvarla</label>
      </div>
      <div class="y-modal__alt">
        <button class="btn btn--cizgi btn--kucuk" type="submit" disabled={!depoHazir}>Fiyat kuralını kaydet</button>
      </div>
    </form>
    <form method="post" class="y-modal__alt">
      <button class="btn btn--sepet" type="submit" name="eylem" value="fiyat-gonder" disabled={!depoHazir || !apiHazir}>Takipteki ürünlerin fiyatını şimdi gönder</button>
      <a class="btn btn--cizgi" href="/yonetim/siparisler/kanallar?eslestirme=trendyol#eslestirme-trendyol">Ürün seçip fiyat gönder / takibi aç</a>
    </form>
  </details>

  <section class="y-kart" id="liste">
    <div class="y-kart__bas"><h2><PIkon ad="liste" /> Trendyol ürün kataloğu</h2><span class="y-help" data-ty-adet>{urunler.length} ürün</span></div>
    <div class="y-toolbar" data-ty-filtre hidden>
      <input class="y-girdi" type="search" placeholder="Ürün, SKU veya barkod ara" aria-label="Trendyol ürünü ara" data-ty-ara />
      <select class="y-girdi" aria-label="Trendyol ilan durumu" data-ty-durum><option value="">Tüm ilan durumları</option>{Object.entries(DURUM).map(([id, [ad]]) => <option value={id}>{ad}</option>)}<option value="elle">Bağlı (elle)</option><option value="gonderilmedi">Gönderilmedi</option></select>
    </div>
    <p class="y-help" role="status" data-ty-bos hidden>Bu filtreye uyan ürün yok.</p>
    <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo ty-katalog-tablo">
      <thead><tr><th>Ürün / Barkod</th><th>Trendyol kategorisi</th><th class="y-sayi">Satış fiyatı</th><th class="y-sayi">Stok</th><th>İlan durumu</th><th class="y-islem">İşlem</th></tr></thead>
      <tbody>{urunler.map((u) => {
        const [ad, renk] = satirDurumu(u.id);
        const t = k.ilanlar[u.id];
        const kod = t?.barkod || k.urunler[u.id]?.kod;
        const sonTarih = t?.kontrol ?? t?.gonderim ?? k.urunler[u.id]?.tarih;
        return <tr class:list={{ 'is-secili': u.id === secili?.id }} data-ty-kayit={t?.durum ?? (kod ? 'elle' : 'gonderilmedi')} data-ty-aranan={[u.ad, u.marka, u.kisaAd, u.sku, kod ?? '', t?.kategoriAdi ?? ''].join(' ')}>
          <td data-etiket="Ürün" class="ty-hucre-urun"><div class="y-tablo-urun"><span class="y-tablo-urun__gorsel">{u.gorseller[0] && <img src={u.gorseller[0].src} alt="" loading="lazy" decoding="async" />}</span><span><strong>{u.marka} {u.kisaAd}</strong><small class="y-table-note">{[u.sku, kod && kod !== u.sku ? `Barkod: ${kod}` : undefined].filter(Boolean).join(' · ')}</small>{u.durum !== 'yayinda' && <small class="y-table-note y-yazi-turuncu">Sitede {u.durum === 'taslak' ? 'taslak' : 'gizli'}</small>}</span></div></td>
          <td data-etiket="Kategori" class="ty-hucre-kategori">{t?.kategoriAdi ? <span>{t.kategoriAdi}</span> : <span class="muted">Seçilmedi</span>}</td>
          <td data-etiket="Satış fiyatı" class="y-sayi y-nowrap"><strong>{para(ilanFiyati(u, k, t))}</strong>{(t?.fiyat ?? k.urunler[u.id]?.ozelFiyat) !== undefined ? <small class="y-table-note">Özel fiyat (Site: {para(u.fiyat)})</small> : ilanFiyati(u, k, t) !== u.fiyat && <small class="y-table-note">Site liste: {para(u.fiyat)}</small>}{(() => { const son = k.urunler[u.id]?.fiyat ?? t?.sonFiyat; return son !== undefined && son !== ilanFiyati(u, k, t) && <small class="y-table-note">Son gönderilen {para(son)}</small>; })()}</td>
          <td data-etiket="Stok" class="y-sayi y-nowrap"><strong>{urunHedefStok(u)} adet</strong><small class="y-table-note">Depo: {u.stok}</small></td>
          <td data-etiket="Durum" class="ty-hucre-durum"><span class:list={['y-chip', 'y-chip--' + renk]}>{ad}</span>{t?.mesajlar.length ? <small class="y-table-note y-yazi-kirmizi">{t.mesajlar[0]}</small> : null}{sonTarih && <small class="y-table-note">Son işlem: {yTarih.format(new Date(sonTarih))}</small>}</td>
          <td data-etiket="İşlem" class="y-islem y-nowrap"><a class="btn btn--cizgi btn--kucuk" href={`${yol}?urun=${encodeURIComponent(u.id)}#ilan`}>{t?.durum === 'onaylandi' ? 'Görüntüle' : t ? 'Düzenle' : 'Hazırla'}</a></td>
        </tr>;
      })}</tbody>
    </table></div>
  </section>
</Yonetim>
<script>
  const filtre = document.querySelector<HTMLElement>('[data-ty-filtre]');
  const ara = filtre?.querySelector<HTMLInputElement>('[data-ty-ara]');
  const durum = filtre?.querySelector<HTMLSelectElement>('[data-ty-durum]');
  const sayac = document.querySelector<HTMLElement>('[data-ty-adet]');
  const bos = document.querySelector<HTMLElement>('[data-ty-bos]');
  const kayitlar = [...document.querySelectorAll<HTMLElement>('[data-ty-kayit]')];
  if (filtre && ara && durum && sayac && bos && kayitlar.length) {
    filtre.hidden = false;
    const guncelle = () => {
      const sorgu = ara.value.trim().toLocaleLowerCase('tr');
      let adet = 0;
      for (const kayit of kayitlar) {
        kayit.hidden = !(kayit.dataset.tyAranan ?? '').toLocaleLowerCase('tr').includes(sorgu) || (!!durum.value && kayit.dataset.tyKayit !== durum.value);
        if (!kayit.hidden) adet++;
      }
      sayac.textContent = adet + ' ürün';
      bos.hidden = adet > 0;
    };
    ara.addEventListener('input', guncelle);
    durum.addEventListener('change', guncelle);
  }
</script>
<style>
  .ty-vitrin img { width: 100%; max-height: 250px; object-fit: contain; background: #f3ecdf; border-radius: 9px; margin-bottom: 10px; }
  .ty-vitrin .btn { margin-top: 10px; }
  .ty-hazirlik-adimlari { list-style: none; margin: 0 0 14px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .ty-hazirlik-adimlari li a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--y-border); border-radius: 12px; background: var(--y-surface-2); color: inherit; text-decoration: none; min-width: 0; }
  .ty-hazirlik-adimlari li a:hover { border-color: #d2b996; }
  .ty-hazirlik-adimlari li.is-tamam a { background: #f0f8f2; border-color: #cfe7d7; }
  .ty-hazirlik-no { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #e8dcc8; color: #5b4324; font-weight: 800; font-size: 13px; }
  .ty-hazirlik-adimlari li.is-tamam .ty-hazirlik-no { background: var(--y-yesil); color: #fff; }
  .ty-hazirlik-adimlari div { min-width: 0; display: grid; }
  .ty-hazirlik-adimlari strong { font-size: 13.5px; }
  .ty-hazirlik-adimlari small { color: var(--y-muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ty-eksik-kutu { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 14px; margin-bottom: 12px; }
  .ty-ret-kutu { border-color: #f1c4be !important; background: #fdf1ef !important; color: #7b1d14 !important; margin-bottom: 12px; }
