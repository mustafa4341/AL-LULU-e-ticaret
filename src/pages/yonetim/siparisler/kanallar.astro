---
import Yonetim from '../../../layouts/Yonetim.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import { DogrulamaHatasi, magazaOku, siparisleriOku, webAyrilanAdetleri } from '../../../lib/depo';
import { fiyatOzeti, pazaryeriFiyatlariEsitle, trendyolIlanlariniEsle, type IlanEslesmesi } from '../../../lib/kanalFiyat';
import { KANALLAR, KANAL_LISTESI, bosAyarlar, kanalHedefFiyati, kanalHedefStok, kanalMi, kodNormal, tarihOku } from '../../../lib/pazaryeri';
import { BILDIRIM_YOLU, PazaryeriApiHatasi, bildirimAnahtari, otomatikStokYazmaAcik, pazaryeriApiDurumu, pazaryeriOrtam } from '../../../lib/pazaryeriApi';
import { tyWebhookAktif, tyWebhookGuncelle, tyWebhookKur, tyWebhooklar } from '../../../lib/trendyolApi';
import { envanterAyarlariGuncelle, envanterAyarlariOku, pazaryeriHazirMi, pazaryeriSiparisleriOku, stokHareketleriOku } from '../../../lib/pazaryeriDepo';
import { pazaryeriSenkron } from '../../../lib/pazaryeriSenkron';
import { urunGtin } from '../../../lib/urunKimlik';
import { stokSebebi, yTarih } from '../../../lib/yonetimRapor';

const yol = '/yonetim/siparisler/kanallar';
const hatalar: string[] = [];
const ok = Astro.url.searchParams.get('ok');
let duzenlenenKanal = Astro.url.searchParams.get('eslestirme');
let ayar = bosAyarlar();
/* Üç okuma aynı anda: ayar satırı (iki çağrı tek isteği paylaşır) ve mağaza */
const [hazirSonuc, ayarSonuc, magaza] = await Promise.all([
  pazaryeriHazirMi(),
  envanterAyarlariOku().then((a) => ({ a }), () => undefined),
  magazaOku(),
]);
let depoHazir = hazirSonuc;
if (ayarSonuc) ayar = ayarSonuc.a;
else {
  depoHazir = false;
  hatalar.push('Kanal ayarları okunamadı. Bağlantıyı kontrol edip sayfayı yenileyin.');
}
const urunler = [...magaza.urunler].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr'));
const baglantiAdi = { kapali: 'Bağlı değil', eksik: 'API ayarları eksik', test: 'Test bağlantısı', canli: 'Canlı bağlantı' };
const panel = { trendyol: 'https://partner.trendyol.com/', hepsiburada: 'https://merchant.hepsiburada.com/' };
const ayarliKanal = KANAL_LISTESI.some((kanal) => {
  const api = pazaryeriApiDurumu(kanal);
  return ayar.kanallar[kanal].stokBaslangic && (api === 'canli' || api === 'test');
});
const senkronZamani = (p?: { id: string; tarih: string }) => p &&
  Date.now() - Date.parse(p.tarih) > (p.id === 'gonderim-bekleniyor' ? 15 * 60_000 : 5 * 3600_000);
if (Astro.request.method === 'POST' && depoHazir) {
  try {
    const f = await Astro.request.formData();
    const eylem = f.get('eylem');
    if (eylem === 'senkron') {
      const r = await pazaryeriSenkron('panel');
      if (r.durum === 'hata') throw new DogrulamaHatasi(Object.entries(r.kanallar).map(([id, s]) =>
        `${kanalMi(id) ? KANALLAR[id] : id} · ${[s.hata, s.stokHata].filter(Boolean).join(' ')}`).filter((s) => !s.endsWith(' · ')));
      if (r.durum === 'kapali') throw new DogrulamaHatasi(['Senkron için kanalın API ayarları ve stok başlangıcı gerekli.']);
      return Astro.redirect(yol + (r.durum === 'bekliyor' ? '?ok=bekliyor' : '?ok=senkron'), 303);
    }
    if (eylem === 'fiyat-esitle') {
      const sonuclar = await pazaryeriFiyatlariEsitle();
      const hata = sonuclar.filter((s) => s.hata).map((s) => `${KANALLAR[s.kanal]}: ${s.hata}`);
      if (hata.length) throw new DogrulamaHatasi(hata);
      const ozet = fiyatOzeti(sonuclar);
      const ayni = sonuclar.reduce((t, s) => t + s.ayni + s.bekleyen, 0);
      const takipli = KANAL_LISTESI.reduce((t, k) => t + Object.values(ayar.kanallar[k].urunler).filter((e) => e.kod && e.fiyatTakip).length, 0);
      const metin = ozet.length ? ozet.join(' ') + ' Kanal birkaç dakika içinde uygular.'
        : !takipli ? 'Fiyat takibi açık ürün yok. Ürün eşleştirme listesinde ürünü seçip “Seçilenlerin fiyatını gönder”e ya da satırdaki “Fiyatı şimdi gönder”e basın.'
        : sonuclar.length ? `Takipteki ürünlerin kanal fiyatı zaten hedefle aynı (${ayni} ilan).` : 'Fiyat göndermek için bağlı bir satış kanalı yok.';
      return Astro.redirect(`${yol}?m=${encodeURIComponent(metin.slice(0, 900))}#fiyatlar`, 303);
    }
    if (eylem === 'ilan-bagla') {
      const r = await trendyolIlanlariniEsle(true);
      return Astro.redirect(`${yol}?ilanlar=1&m=${encodeURIComponent(r.baglanan ? `${r.baglanan} Trendyol ilanı sitedeki ürünüyle bağlandı. Stok artık ortak depodan gider; Trendyol’daki fiyatlara dokunulmadı (fiyatı istediğiniz ürün için “Fiyatı şimdi gönder”le eşitleyin).` : 'Bağlanacak yeni ilan bulunamadı.')}#ty-ilanlar`, 303);
    }
    if (eylem === 'bildirim-kur' || eylem === 'bildirim-kontrol') {
      if (!['canli', 'test'].includes(pazaryeriApiDurumu('trendyol'))) throw new DogrulamaHatasi(['Anlık bildirim canlı sitede (Trendyol anahtarlarının olduğu sunucuda) kurulur.']);
      const anahtar = bildirimAnahtari('trendyol');
      if (!anahtar) throw new DogrulamaHatasi(['Sunucuda zamanlayıcı anahtarı (ZAMANLAYICI_ANAHTARI) tanımlı değil; bildirim anahtarı üretilemedi.']);
      const adres = new URL(BILDIRIM_YOLU.trendyol, import.meta.env.SITE || magaza.site.url).href;
      const mevcut = await tyWebhooklar();
      const bizim = mevcut.find((w) => w.url.replace(/\/$/, '') === adres.replace(/\/$/, ''));
      if (eylem === 'bildirim-kontrol') {
        const metin = bizim ? `Trendyol anlık bildirimi kayıtlı · durum: ${bizim.durum === 'ACTIVE' ? 'Aktif' : 'Pasif (yeniden açmak için “Anlık bildirimi aç”a basın)'}.`
          : `Trendyol’da bu siteye ait anlık bildirim kaydı yok${mevcut.length ? ` (başka ${mevcut.length} kayıt var)` : ''}.`;
        return Astro.redirect(`${yol}?m=${encodeURIComponent(metin)}#trendyol`, 303);
      }
      let id: string;
      if (bizim) {
        await tyWebhookGuncelle(bizim.id, adres, anahtar);
        if (bizim.durum !== 'ACTIVE') await tyWebhookAktif(bizim.id);
        id = bizim.id;
      } else {
        if (mevcut.length >= 15) throw new DogrulamaHatasi(['Trendyol en fazla 15 bildirim kaydına izin veriyor; satıcı panelinden/entegratörünüzden kullanılmayanı silin.']);
        id = await tyWebhookKur(adres, anahtar);
      }
      await envanterAyarlariGuncelle((a) => { a.kanallar.trendyol.bildirim.id = id; a.kanallar.trendyol.bildirim.kurulum = new Date().toISOString(); });
      return Astro.redirect(`${yol}?m=${encodeURIComponent('Trendyol anlık sipariş bildirimi açıldı. Yeni sipariş ve durum değişiklikleri artık saniyeler içinde panele düşer; 5 dakikalık otomatik kontrol yedek olarak sürer.')}#trendyol`, 303);
    }
    if (eylem === 'toplu-fiyat') {
      const kanal = f.get('kanal');
      if (!kanalMi(kanal)) throw new DogrulamaHatasi(['Geçerli bir satış kanalı seçin.']);
      duzenlenenKanal = kanal;
      const secili = f.getAll('secili').map(String).filter((id) => urunler.some((u) => u.id === id) && ayar.kanallar[kanal].urunler[id]?.kod);
      if (!secili.length) throw new DogrulamaHatasi(['Önce listeden eşleşmiş en az bir ürün seçin (satırdaki “Seç” kutusu).']);
      const islem = String(f.get('islem') ?? '');
      if (islem === 'takip-ac' || islem === 'takip-kapat') {
        await envanterAyarlariGuncelle((a) => {
          for (const id of secili) { const e = a.kanallar[kanal].urunler[id]; if (e) e.fiyatTakip = islem === 'takip-ac'; }
        });
        const metin = islem === 'takip-ac'
          ? `${secili.length} üründe otomatik fiyat takibi açıldı: hedef fiyat 5 dakika içinde ${KANALLAR[kanal]}’a gider ve sonra kendiliğinden aynı tutulur.`
          : `${secili.length} üründe otomatik fiyat takibi kapatıldı. ${KANALLAR[kanal]}’daki fiyatları artık yalnız siz değiştirirsiniz.`;
        return Astro.redirect(`${yol}?eslestirme=${kanal}&m=${encodeURIComponent(metin)}#eslestirme-${kanal}`, 303);
      }
      if (islem !== 'gonder') throw new DogrulamaHatasi(['Geçersiz toplu işlem.']);
      const [r] = await pazaryeriFiyatlariEsitle({ kanallar: [kanal], urunIdler: secili });
      if (!r) throw new DogrulamaHatasi([`${KANALLAR[kanal]} bağlantısı bu sunucuda kurulu değil.`]);
      if (r.hata) throw new DogrulamaHatasi([r.hata]);
      const ozet = fiyatOzeti([r]).join(' ');
      const metin = r.gonderilen.length ? ozet + ' Kanal birkaç dakika içinde uygular.' : `Seçilen ${secili.length} ürünün ${KANALLAR[kanal]} fiyatı zaten hedefle aynı.${ozet ? ' ' + ozet : ''}`;
      return Astro.redirect(`${yol}?eslestirme=${kanal}&m=${encodeURIComponent(metin.slice(0, 900))}#eslestirme-${kanal}`, 303);
    }
    if (eylem === 'otomasyon-kaydet') {
      await envanterAyarlariGuncelle((a) => {
        a.otomasyon.yeniSiparisBildir = f.get('yeniSiparisBildir') === 'on';
        a.otomasyon.otoToplama = f.get('otoToplama') === 'on';
        a.otomasyon.faturaYenidenDene = f.get('faturaYenidenDene') === 'on';
        a.otomasyon.gunlukIsler = f.get('gunlukIsler') === 'on';
        a.otomasyon.otoFiyat = f.get('otoFiyat') === 'on';
      });
      return Astro.redirect(`${yol}?m=${encodeURIComponent('Genel kanal otomasyon tercihleri kaydedildi.')}`, 303);
    }
    if (eylem === 'fiyat-kurali') {
      const otoFiyat = f.get('otoFiyat') === 'on';
      const tyYuzde = Number(String(f.get('ty_yuzde') ?? '0').replace(',', '.'));
      const tyEk = Number(String(f.get('ty_ekTL') ?? '0').replace(',', '.'));
      const tyYuvarla = f.get('ty_yuvarla') === 'on';
      const hbYuzde = Number(String(f.get('hb_yuzde') ?? '0').replace(',', '.'));
      const hbEk = Number(String(f.get('hb_ekTL') ?? '0').replace(',', '.'));
      const hbYuvarla = f.get('hb_yuvarla') === 'on';
      if ([tyYuzde, tyEk, hbYuzde, hbEk].some((n) => !Number.isFinite(n))) throw new DogrulamaHatasi(['Fiyat kuralı oran ve tutarlarını sayı olarak girin.']);
      if (tyYuzde < -50 || tyYuzde > 300 || hbYuzde < -50 || hbYuzde > 300) throw new DogrulamaHatasi(['Yüzde farkı -%50 ile +%300 arasında olmalı.']);
      if (tyEk < 0 || tyEk > 100_000 || hbEk < 0 || hbEk > 100_000) throw new DogrulamaHatasi(['Ek TL farkı 0 ile 100.000 TL arasında olmalı.']);
      await envanterAyarlariGuncelle((a) => {
        a.otomasyon.otoFiyat = otoFiyat;
        a.kanallar.trendyol.fiyatKurali = { yuzde: tyYuzde, ekTL: tyEk, yuvarla: tyYuvarla };
        a.kanallar.hepsiburada.fiyatKurali = { yuzde: hbYuzde, ekTL: hbEk, yuvarla: hbYuvarla };
      });
      return Astro.redirect(`${yol}?m=${encodeURIComponent('Kanal fiyat kuralları ve otomatik eşitleme tercihi kaydedildi.')}#fiyatlar`, 303);
    }
    const kanal = f.get('kanal');
    if (!kanalMi(kanal)) throw new DogrulamaHatasi(['Geçerli bir satış kanalı seçin.']);
    if (eylem === 'kanal-ayari') {
      const metin = String(f.get('stokBaslangic') ?? '');
      const baslangic = tarihOku(metin);
      const guvenlikPayi = String(f.get('guvenlikPayi') ?? '');
      if (!/^\d{1,4}$/.test(guvenlikPayi) || Number(guvenlikPayi) > 1000) throw new DogrulamaHatasi(['Güvenlik payı 0 ile 1.000 adet arasında olmalı.']);
      if (metin && (!baslangic || Date.parse(baslangic) > Date.now())) throw new DogrulamaHatasi(['Stok başlangıcı için geçmiş veya güncel bir tarih ve saat girin.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        if (!k.sonAktarim && baslangic) k.stokBaslangic = baslangic;
        k.guvenlikPayi = Number(guvenlikPayi);
      });
    } else if (eylem === 'stok-islemini-kapat') {
      if (f.get('dogrulandi') !== 'on') throw new DogrulamaHatasi(['Önce satıcı panelindeki işlem ve ilan adetlerini doğrulayın.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        const p = k.bekleyenStok;
        if (!p || !senkronZamani(p) || p.tarih !== f.get('bekleyenTarih') || p.id !== f.get('bekleyenId')) {
          throw new DogrulamaHatasi(['Bekleyen işlem değişti. Sayfayı yenileyip yeniden kontrol edin.']);
        }
        for (const kalem of p.kalemler) {
          const ilan = k.urunler[kalem.urunId];
          if (ilan?.kod === kalem.kod) ilan.sonHedef = Math.max(ilan.sonHedef ?? 0, kalem.stok);
        }
        delete k.bekleyenStok;
        k.sonStokHata = 'Satıcı paneli kontrolü sonrasında önceki stok işlemi kapatıldı. Yeni kanal okuması bekleniyor.';
      });
    } else if (eylem === 'urun-ayari') {
      duzenlenenKanal = kanal;
      const urunId = String(f.get('urunId') ?? '');
      const kod = String(f.get('kod') ?? '').trim();
      const satista = f.get('satista') === 'on';
      const fiyatTakip = f.get('fiyatTakip') === 'on';
      const ozelFiyatHam = String(f.get('ozelFiyat') ?? '').trim().replace(/\s/g, '').replace(',', '.');
      const ozelFiyat = ozelFiyatHam ? Number(ozelFiyatHam) : undefined;
      if (ozelFiyat !== undefined && (!Number.isFinite(ozelFiyat) || ozelFiyat <= 0 || ozelFiyat > 10_000_000)) {
        throw new DogrulamaHatasi(['Özel kanal fiyatı 0’dan büyük geçerli bir TL tutarı olmalı (site/kural fiyatını kullanmak için boş bırakın).']);
      }
      if (!urunler.some((u) => u.id === urunId) || kod.length > 120) throw new DogrulamaHatasi(['Ürün veya pazaryeri ilan kodu geçersiz.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        if (k.bekleyenStok) throw new DogrulamaHatasi(['Kanalın stok güncellemesi onaylanınca ürün kodunu düzenleyebilirsiniz.']);
        if (!kod && k.urunler[urunId]?.kod) throw new DogrulamaHatasi(['Kayıtlı ilanı sıfıra çekmek için kodunu koruyup “Satışa açık” seçimini kaldırın.']);
        if (!kod) throw new DogrulamaHatasi(['Satıcı panelindeki ilan kodunu girin.']);
        if (Object.entries(k.urunler).some(([id, u]) => id !== urunId && u.kod === kod)) {
          throw new DogrulamaHatasi(['Bu ilan kodu kanaldaki başka bir ürüne bağlı.']);
        }
        const onceki = k.urunler[urunId];
        if (onceki?.kod && onceki.kod !== kod && (onceki.bildirilen ?? 0) > 0) {
          throw new DogrulamaHatasi(['İlan kodunu değiştirmeden önce mevcut ilanı satışa kapatın ve stok onayını bekleyin.']);
        }
        k.urunler[urunId] = onceki?.kod === kod ? { ...onceki, kod, satista, ozelFiyat, fiyatTakip } : { kod, satista, ozelFiyat, fiyatTakip };
        if (k.ilanlar[urunId]) k.ilanlar[urunId].fiyat = ozelFiyat;
        a.eslesmeler[kodNormal(kod)] = urunId;
      });
      if (f.get('sonra') === 'fiyat') {
        const [r] = await pazaryeriFiyatlariEsitle({ kanallar: [kanal], urunIdler: [urunId] });
        const metin = !r ? `Kaydedildi. ${KANALLAR[kanal]} bağlantısı bu sunucuda kurulu olmadığı için fiyat gönderilemedi.`
          : r.hata ? `Kaydedildi ama fiyat gönderilemedi: ${r.hata}`
          : r.gonderilen.length ? `Kaydedildi. ${fiyatOzeti([r]).join(' ')} Kanal birkaç dakika içinde uygular.`
          : r.bulunamayan.length ? `Kaydedildi ama ilan ${KANALLAR[kanal]}’da bulunamadı (${r.bulunamayan.join(', ')}). Kodu kontrol edin.`
          : `Kaydedildi. ${KANALLAR[kanal]} fiyatı zaten hedefle aynı.`;
        return Astro.redirect(`${yol}?eslestirme=${kanal}&m=${encodeURIComponent(metin.slice(0, 900))}#${kanal}-${encodeURIComponent(urunId)}`, 303);
      }
      return Astro.redirect(`${yol}?ok=ayar&eslestirme=${kanal}#${kanal}-${encodeURIComponent(urunId)}`, 303);
    } else throw new DogrulamaHatasi(['Geçersiz işlem.']);
    return Astro.redirect(`${yol}?ok=ayar#${kanal}`, 303);
  } catch (e) {
    hatalar.push(...(e instanceof DogrulamaHatasi ? e.hatalar : e instanceof PazaryeriApiHatasi ? [e.message] : ['Kanal işlemi tamamlanamadı. Bağlantıyı kontrol edip tekrar deneyin.']));
    ayar = await envanterAyarlariOku().catch(() => ayar);
  }
}
/* Trendyol'daki tüm ilanlar ve sitedeki karşılıkları (yalnız istenince: ?ilanlar=1) */
const tyHazir = ['canli', 'test'].includes(pazaryeriApiDurumu('trendyol'));
let ilanSatirlari: IlanEslesmesi[] | undefined;
if (Astro.request.method === 'GET' && Astro.url.searchParams.has('ilanlar') && tyHazir && depoHazir) {
  try { ilanSatirlari = (await trendyolIlanlariniEsle(false)).satirlar; }
  catch (e) { hatalar.push(e instanceof PazaryeriApiHatasi ? e.message : 'Trendyol ilanları okunamadı. Biraz sonra tekrar deneyin.'); }
}
const [web, hareketler, pySiparisler] = await Promise.all([
  siparisleriOku(true).catch(() => {
    hatalar.push('Web rezervasyonları okunamadı. Yayın hedefleri geçici olarak gizlendi.');
    return undefined;
  }),
  stokHareketleriOku(undefined, 30).catch(() => {
    if (depoHazir) hatalar.push('Stok hareketleri okunamadı.');
    return [];
  }),
  pazaryeriSiparisleriOku().catch(() => []),
]);
const ayrilan = web && webAyrilanAdetleri(web, Date.now(), magaza.paytrStokIslemleri);
const urunAdlari = new Map(urunler.map((u) => [u.id, u.kisaAd]));
const yerelSaat = (t?: string) => t ? new Date(Date.parse(t) + 3 * 3600e3).toISOString().slice(0, 16) : '';
const zaman = (t?: string) => t ? yTarih.format(new Date(t)) : 'Henüz yok';
const basari = ok === 'senkron' ? 'Siparişler güncellendi.' : ok === 'bekliyor' ? 'Güncelleme zaten çalışıyor, birazdan tekrar bakın.' : ok === 'ayar' ? 'Kaydedildi.'
  : Astro.url.searchParams.get('m')?.slice(0, 900) || undefined;
const fiyatKanallari = KANAL_LISTESI.filter((kanal) => ['canli', 'test'].includes(pazaryeriApiDurumu(kanal)));
const tlYaz = (n?: number) => n === undefined ? '—' : n.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' TL';
const ILAN_DURUMU: Record<IlanEslesmesi['durum'], [string, string]> = {
  bagli: ['Bağlı', 'yesil'], yeni: ['Bağlanabilir', 'turuncu'], cakisma: ['Elle kontrol edin', 'kirmizi'], yok: ['Sitede karşılığı yok', 'gri'],
};

const API_YARDIM = {
  trendyol: 'Trendyol satıcı panelinde Hesap Bilgilerim → Entegrasyon Bilgileri bölümüne gidin. Satıcı ID, API Key ve API Secret değerlerini Vercel ortam ayarlarına girin.',
  hepsiburada: 'Hepsiburada satıcı panelinden kendi yazılımınız için entegrasyon erişimi isteyin. Canlı Merchant ID, kullanıcı adı, parola ve User-Agent değerlerini Vercel ortam ayarlarına girin.',
};
const KOD_YARDIM = {
  trendyol: 'Trendyol’da ürünü eklerken yazdığınız “Barkod”. Çoğu üründe kutunun üzerindeki çizgili kodun altındaki 13 haneli sayıdır (EAN). Trendyol satıcı panelinde Ürünler listesinde de görünür.',
  hepsiburada: 'Hepsiburada’ya ürünü yüklerken verdiğiniz “Satıcı stok kodu” (merchantSku). Kendi belirlediğiniz koddur; çoğu satıcı model kodunu kullanır.',
};
const zamanlayiciAnahtariVar = (pazaryeriOrtam('CRON_SECRET')?.length ?? 0) >= 32;
const otomatikYazma = otomatikStokYazmaAcik();
const simdi = Date.now();
---
<Yonetim baslik="Satış Kanalları" altBaslik="Trendyol ve Hepsiburada siparişlerini ve ortak stoğu yönetin." aktif="siparisler" {basari} {hatalar}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="#fiyatlar"><PIkon ad="etiket" boyut={18} />Fiyatlar</a>
    <a class="btn btn--cizgi" href="#eslestirmeler"><PIkon ad="degistir" boyut={18} />Ürün eşleştirme</a>
    {depoHazir && ayarliKanal && <form method="post"><button class="btn btn--sepet" name="eylem" value="senkron" type="submit"><PIkon ad="yenile" boyut={18} />Şimdi eşitle</button></form>}
  </div>

  {!depoHazir && <p class="y-uyari-satir" role="status">Kanal ayarları kullanılamıyor. Veritabanı bağlantısını ve pazaryeri tablolarını kontrol edin.</p>}

  <div class="kanal-izgara">
    <section class="y-kart kanal kanal--web" id="web">
      <div class="y-kart__bas"><h2><KanalLogo kanal="web" /> Web sitesi</h2><a class="y-link" href="/yonetim/siparisler?durum=tumu&amp;kanal=web">Siparişler</a></div>
