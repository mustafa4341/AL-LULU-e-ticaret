        <div><dt>Mağaza durumu</dt><dd>{magaza.site.tadilat.aktif ? 'Bakımda' : 'Yayında'}</dd></div>
        <div><dt>Stok kaynağı</dt><dd>Ortak depo</dd></div>
        <div><dt>Hazırlanacak</dt><dd>{web?.filter((s) => s.durum === 'odendi' && !s.paytr?.test && !s.paytr?.stokEksik).length ?? '—'}</dd></div>
        <div><dt>Kargolanacak</dt><dd>{web?.filter((s) => s.durum === 'hazirlaniyor' && !s.paytr?.test).length ?? '—'}</dd></div>
      </dl>
      <a class="btn btn--cizgi" href="/yonetim/site-duzeni">Mağaza görünümü</a>
    </section>
  {KANAL_LISTESI.map((kanal) => {
    const k = ayar.kanallar[kanal];
    const api = pazaryeriApiDurumu(kanal);
    const apiHazir = api === 'canli' || api === 'test';
    const bulutBagli = !apiHazir && Boolean(k.sonApi || k.sonOtomatikApi);
    const eslesen = Object.values(k.urunler).filter((u) => u.kod).length;
    const otomatikGecikti = k.sonOtomatikApi && simdi - Date.parse(k.sonOtomatikApi) > 30 * 60_000;
    const baglantiMetni = apiHazir ? baglantiAdi[api] : bulutBagli ? 'Canlı sunucuda aktif (Yerel .env yok)' : baglantiAdi[api];
    const otomatikDurum = bulutBagli
      ? (otomatikGecikti ? 'Canlı sunucuda gecikiyor' : 'Canlı sunucuda çalışıyor')
      : !apiHazir || !k.stokBaslangic ? 'Kurulum bekliyor' : !zamanlayiciAnahtariVar ? 'Kapalı'
      : !k.sonOtomatikApi ? 'İlk çalışma bekleniyor' : otomatikGecikti ? 'Gecikiyor' : 'Çalışıyor';
    const stokDurumu = bulutBagli
      ? (k.bekleyenStok ? 'Kanal onayı bekleniyor' : eslesen === 0 ? 'İlan eşleştirmesi bekliyor' : 'Canlı sunucuda otomatik')
      : !apiHazir || !k.stokBaslangic ? 'Kurulum bekliyor' : !otomatikYazma ? 'Elle'
      : k.bekleyenStok ? 'Kanal onayı bekleniyor' : eslesen === 0 ? 'İlan eşleştirmesi bekliyor' : 'Otomatik';
    return <section class:list={['y-kart', 'kanal', 'kanal--' + kanal]} id={kanal}>
      <div class="y-kart__bas">
        <h2><KanalLogo kanal={kanal} /> {KANALLAR[kanal]}</h2>
        <a class="y-link" href={panel[kanal]} target="_blank" rel="noopener noreferrer">Satıcı paneli</a>
      </div>
      <dl class="kanal-durum">
        <div><dt>Mağaza bağlantısı</dt><dd>{baglantiMetni}</dd></div>
        <div><dt>Otomatik eşitleme</dt><dd class:list={{ 'y-uyari-kucuk': otomatikGecikti }}>{otomatikDurum}</dd></div>
        <div><dt>Son otomatik çekim</dt><dd>{zaman(k.sonOtomatikApi)}</dd></div>
        <div><dt>Son başarılı çekim</dt><dd>{zaman(k.sonApi)}</dd></div>
        <div><dt>Stok gönderimi</dt><dd>{stokDurumu}</dd></div>
        <div><dt>Bağlı ürünler</dt><dd>{eslesen}</dd></div>
        <div><dt>Başlangıç sayımı</dt><dd class:list={{ 'y-uyari-kucuk': !k.stokBaslangic }}>{k.stokBaslangic ? zaman(k.stokBaslangic) : 'Girilmedi'}</dd></div>
        <div><dt>Güvenlik payı</dt><dd>{k.guvenlikPayi} adet</dd></div>
        {kanal === 'trendyol' && <div><dt>Anlık sipariş bildirimi</dt><dd>{k.bildirim.kurulum ? (k.bildirim.son ? `Açık · son ${zaman(k.bildirim.son)}` : 'Açık · henüz bildirim gelmedi') : 'Kapalı (5 dk kontrol)'}</dd></div>}
        {k.bekleyenStok && <div class="kanal-durum--uyari"><dt>Bekleyen stok işlemi</dt><dd class="y-uyari-kucuk">{k.bekleyenStok.kalemler.length} ürün · kanal onayı bekliyor</dd></div>}
      </dl>

      <a class="btn btn--cizgi" href={'?eslestirme=' + kanal + '#eslestirme-' + kanal} data-astro-prefetch="false" data-eslestirme-ac={'eslestirme-' + kanal}><PIkon ad="degistir" boyut={18} />Ürün eşleştirmelerini aç</a>
      {kanal === 'trendyol' && (apiHazir || bulutBagli) && <p class="kanal-kisayol">
        <a class="btn btn--sepet" href="/yonetim/siparisler/trendyol-urunler"><PIkon ad="gonder" boyut={18} />Trendyol’a ürün gönder</a>
        <a class="btn btn--cizgi" href="/yonetim/siparisler/trendyol-iade-soru"><PIkon ad="iade" boyut={18} />İadeler</a>
        <a class="btn btn--cizgi" href="/yonetim/finans/faturalar?kanal=trendyol"><PIkon ad="fatura" boyut={18} />Faturalar</a>
        <a class="btn btn--cizgi" href="/yonetim/siparisler/trendyol-ilanlar"><PIkon ad="indir" boyut={18} />Trendyol ilanları (bağla / siteye çek)</a>
        <span class="y-help">{Object.values(k.ilanlar).filter((x) => x.durum === 'onaylandi').length} ilan API ile açıldı</span>
      </p>}
      {kanal === 'trendyol' && apiHazir && depoHazir && <form method="post" class="kanal-kisayol">
        <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="bildirim-kur"><PIkon ad="zil" boyut={16} />{k.bildirim.kurulum ? 'Anlık bildirimi yenile' : 'Anlık sipariş bildirimini aç'}</button>
        <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="bildirim-kontrol">Bildirim durumunu kontrol et</button>
        <span class="y-help">Açıkken Trendyol siparişi oluştuğu an siteye haber verir; stok saniyeler içinde düşer.</span>
      </form>}
      {k.sonApiHata && <p class="y-uyari-satir" role="alert">Siparişler alınamadı: {k.sonApiHata}</p>}
      {k.sonStokHata && <p class="y-uyari-satir" role="alert">Stok gönderilemedi: {k.sonStokHata}</p>}
      {otomatikGecikti && (apiHazir || bulutBagli) && !k.sonApiHata && <p class="y-uyari-satir" role="status">30 dakikadır başarılı otomatik çekim yok. Gerekirse “Şimdi eşitle”yi kullanın.</p>}
      {k.sonAktarimOzet && <p class="y-help">Son aktarım · {k.sonAktarimOzet}</p>}
      {!apiHazir && (bulutBagli ? (
        <details class="kanal-bolum">
          <summary>Canlı sunucuda aktif · Yerel bilgisayar (.env) bilgisi</summary>
          <p>{KANALLAR[kanal]} bağlantınız canlı sunucuda (Vercel) kurulmuş ve sipariş/stok eşitlemesi çalışıyor (Son başarılı çekim: {zaman(k.sonApi)}). Bu bilgisayardan (localhost) anlık API çağrısı yapmak isterseniz Vercel ortam ayarlarındaki anahtarları yerel <code>.env</code> dosyanıza da ekleyebilirsiniz.</p>
        </details>
      ) : (
        <details class="kanal-bolum" open>
          <summary>Mağazayı bağlama</summary>
          <p>{API_YARDIM[kanal]}</p>
        </details>
      ))}

      {depoHazir && k.bekleyenStok && senkronZamani(k.bekleyenStok) && <details class="kanal-bolum">
        <summary>Bekleyen stok işlemini çöz</summary>
        <form method="post" class="kanal-kurtarma">
          <input type="hidden" name="kanal" value={kanal} />
          <input type="hidden" name="bekleyenId" value={k.bekleyenStok.id} />
          <input type="hidden" name="bekleyenTarih" value={k.bekleyenStok.tarih} />
          <ul>{k.bekleyenStok.kalemler.map((kalem) => <li>{kalem.kod} · Gönderilen hedef {kalem.stok}</li>)}</ul>
          <label><input type="checkbox" name="dogrulandi" required /> Satıcı panelinde ilan adetlerini kontrol ettim ve bu isteğin artık beklemediğini doğruladım.</label>
          <button class="btn btn--cizgi" type="submit" name="eylem" value="stok-islemini-kapat">Önceki işlemi kapat</button>
        </form>
      </details>}

      <details class="kanal-bolum" open={!k.stokBaslangic && apiHazir && depoHazir}>
        <summary>Başlangıç sayımı ve güvenlik payı</summary>
        <form method="post" class="kanal-form">
          <input type="hidden" name="kanal" value={kanal} />
          <label class="y-alan">Sayımı bitirdiğiniz gün ve saat
            <input type="datetime-local" name="stokBaslangic" value={yerelSaat(k.stokBaslangic)} disabled={!depoHazir || Boolean(k.sonAktarim)} />
            <small>Türkiye saati. İlk aktarımdan sonra kilitlenir. Yalnız bu andan sonraki siparişler stoğu etkiler.</small>
          </label>
          <label class="y-alan">Güvenlik payı (adet)
            <input type="number" name="guvenlikPayi" min="0" max="1000" value={k.guvenlikPayi} required disabled={!depoHazir} inputmode="numeric" />
            <small>Kanalda satışa açılan stoktan ayrılan adet.</small>
          </label>
          <button class="btn btn--cizgi" type="submit" name="eylem" value="kanal-ayari" disabled={!depoHazir}>Kaydet</button>
        </form>
      </details>


    </section>;
  })}
  </div>

  <section class="y-kart kanal-fiyatlar" id="fiyatlar" aria-labelledby="fiyatlar-baslik">
    <div class="y-kart__bas">
      <div>
        <h2 id="fiyatlar-baslik"><PIkon ad="etiket" /> Fiyatlar, Kanal Kuralları ve Trendyol İlanları</h2>
        <p class="y-kart__alt">Pazaryeri fiyatlarını ister web sitesiyle birebir aynı tutun, ister kanala özel komisyon/kargo farkı veya ürüne özel sabit fiyat belirleyin.</p>
      </div>
    </div>
    <ol class="kanal-kural-listesi">
      <li><strong>Eşleştirme yalnız bağlar.</strong> İlanı sitedeki ürüne bağlamak Trendyol/Hepsiburada fiyatını değiştirmez; yalnız <strong>stok ortak</strong> olur (hangi kanaldan satış olursa olsun depodaki adet düşer, diğer kanallara 5 dakika içinde yansır).</li>
      <li><strong>Kanal fiyatı farklı olabilir.</strong> Hedef fiyat sırasıyla: ürüne özel kanal fiyatı → kanalın genel kuralı (% / +TL) → sitedeki son fiyat.</li>
      <li><strong>Fiyat yalnız siz isteyince gider.</strong> Ürün eşleştirme listesinde satırdaki <strong>“Fiyatı şimdi gönder”</strong> ya da seçtiğiniz ürünler için <strong>“Seçilenlerin fiyatını gönder”</strong>. Bir ürünün fiyatının hep hedefte kalmasını istiyorsanız o üründe <strong>“Otomatik fiyat takibi”</strong>ni açın.</li>
    </ol>

    <form method="post" class="y-kart" style="margin:12px 0;background:var(--y-surface-2,#faf7f2);border:1px solid var(--y-border,#e5dec9)">
      <input type="hidden" name="eylem" value="fiyat-kurali" />
      <label class="y-secim" style="margin-bottom:12px">
        <input type="checkbox" name="otoFiyat" checked={ayar.otomasyon.otoFiyat} disabled={!depoHazir} />
        <span><strong>Otomatik fiyat takibi çalışsın</strong> <small class="muted">(ana anahtar: yalnız “Otomatik fiyat takibi” açık ürünlerin fiyatı 5 dakikada bir hedefle aynı tutulur; kapatırsanız hiçbir fiyat kendiliğinden gitmez)</small></span>
      </label>
      <div class="y-izgara y-izgara--2">
        <div style="padding:12px;border:1px solid var(--y-border,#e5dec9);border-radius:10px;background:#fff;display:grid;gap:8px">
          <strong><KanalLogo kanal="trendyol" boyut="kucuk" /> Trendyol genel fiyat kuralı</strong>
          <div class="y-izgara y-izgara--2">
            <label class="y-alan">Yüzde fark (%)<input name="ty_yuzde" inputmode="decimal" value={ayar.kanallar.trendyol.fiyatKurali.yuzde} disabled={!depoHazir} /><small class="muted">0 = siteyle aynı, örn. 15 = +%15</small></label>
            <label class="y-alan">Ek tutar (+TL)<input name="ty_ekTL" inputmode="decimal" value={ayar.kanallar.trendyol.fiyatKurali.ekTL} disabled={!depoHazir} /><small class="muted">Kargo/hizmet farkı (0 = yok)</small></label>
          </div>
          <label class="y-secim"><input type="checkbox" name="ty_yuvarla" checked={ayar.kanallar.trendyol.fiyatKurali.yuvarla} disabled={!depoHazir} /> Sonucu ,90 TL basamağına yuvarla</label>
        </div>
        <div style="padding:12px;border:1px solid var(--y-border,#e5dec9);border-radius:10px;background:#fff;display:grid;gap:8px">
          <strong><KanalLogo kanal="hepsiburada" boyut="kucuk" /> Hepsiburada genel fiyat kuralı</strong>
          <div class="y-izgara y-izgara--2">
            <label class="y-alan">Yüzde fark (%)<input name="hb_yuzde" inputmode="decimal" value={ayar.kanallar.hepsiburada.fiyatKurali.yuzde} disabled={!depoHazir} /><small class="muted">0 = siteyle aynı, örn. 15 = +%15</small></label>
            <label class="y-alan">Ek tutar (+TL)<input name="hb_ekTL" inputmode="decimal" value={ayar.kanallar.hepsiburada.fiyatKurali.ekTL} disabled={!depoHazir} /><small class="muted">Kargo/hizmet farkı (0 = yok)</small></label>
          </div>
          <label class="y-secim"><input type="checkbox" name="hb_yuvarla" checked={ayar.kanallar.hepsiburada.fiyatKurali.yuvarla} disabled={!depoHazir} /> Sonucu ,90 TL basamağına yuvarla</label>
        </div>
      </div>
      <div class="y-modal__alt" style="margin-top:10px">
        <button class="btn btn--cizgi btn--kucuk" type="submit" disabled={!depoHazir}><PIkon ad="tik" boyut={16} />Fiyat kurallarını kaydet</button>
      </div>
    </form>

    <div class="kanal-kisayol">
      <form method="post"><button class="btn btn--cizgi" type="submit" name="eylem" value="fiyat-esitle" disabled={!depoHazir || !fiyatKanallari.length}>Takipteki ürünlerin fiyatını şimdi gönder</button></form>
      <a class="btn btn--sepet" href="/yonetim/siparisler/trendyol-ilanlar">Trendyol ilanları: bağla / siteye çek</a>
      {tyHazir && <a class="btn btn--cizgi" href="?ilanlar=1#ty-ilanlar" data-astro-prefetch="false">Hızlı liste</a>}
      <span class="y-help">Otomatik fiyat takibi: <strong>{ayar.otomasyon.otoFiyat ? 'çalışıyor' : 'kapalı'}</strong> · takipte {KANAL_LISTESI.reduce((t, k) => t + Object.values(ayar.kanallar[k].urunler).filter((e) => e.kod && e.fiyatTakip).length, 0)} ürün · <a class="y-link" href="/yonetim/isler">Bugünkü işler</a></span>
    </div>
    {ilanSatirlari && <div id="ty-ilanlar" class="kanal-ilanlar">
      {(() => {
        const say = (d: IlanEslesmesi['durum']) => ilanSatirlari!.filter((s) => s.durum === d).length;
        const yeni = say('yeni');
        return <>
          <p class="y-help">Trendyol’da {ilanSatirlari!.length} ilan var: {say('bagli')} bağlı, {yeni} bağlanabilir, {say('cakisma')} elle kontrol edilecek, {say('yok')} ilanın sitede karşılığı bulunamadı. Eşleşme; barkodun ürünün teknik özelliklerindeki “Barkod” satırıyla ya da SKU ile aynı olmasına göre yapılır.</p>
          {yeni > 0 && <form method="post" class="kanal-kurtarma">
            <p class="y-uyari-satir uyari--turuncu" role="note">Bağlanan ilanların stoğu bundan sonra ortak depodan yönetilir (Trendyol stoğu = depodaki satılabilir stok − güvenlik payı). Trendyol fiyatına dokunulmaz; isterseniz sonra ürün bazında gönderirsiniz.</p>
            <button class="btn btn--sepet" type="submit" name="eylem" value="ilan-bagla" disabled={!depoHazir}>{yeni} ilanı sitedeki ürünüyle bağla</button>
          </form>}
          {say('yok') > 0 && <p class="y-help">Sitede karşılığı bulunamayan ilanı bağlamak için “Ürün eşleştirme” bölümünde ürünün satırına ilanın barkodunu yazın.</p>}
        </>;
      })()}
      <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo">
        <thead><tr><th>Trendyol ilanı</th><th class="y-sayi">Trendyol fiyatı</th><th class="y-sayi">Trendyol stok</th><th>Sitedeki ürün</th><th class="y-sayi">Site fiyatı</th><th>Durum</th></tr></thead>
        <tbody>{ilanSatirlari.map((s) => {
          const [ad, renk] = ILAN_DURUMU[s.durum];
          const fark = s.siteFiyat !== undefined && s.kanalFiyat !== undefined && Math.abs(s.siteFiyat - s.kanalFiyat) >= 0.005;
          return <tr>
            <td data-etiket="Trendyol ilanı"><strong>{s.barkod}</strong>{s.stokKodu && s.stokKodu !== s.barkod && <small class="y-table-note">Stok kodu {s.stokKodu}</small>}</td>
            <td data-etiket="Trendyol fiyatı" class="y-sayi y-nowrap">{tlYaz(s.kanalFiyat)}</td>
            <td data-etiket="Trendyol stok" class="y-sayi">{s.kanalStok ?? '—'}</td>
            <td data-etiket="Sitedeki ürün">{s.urunId ? <a class="y-link" href={'/yonetim/urunler/' + encodeURIComponent(s.urunId)}>{s.urunAdi}</a> : '—'}</td>
            <td data-etiket="Site fiyatı" class="y-sayi y-nowrap">{tlYaz(s.siteFiyat)}{fark && <small class="y-table-note">{s.durum === 'bagli' ? 'Eşitlenecek' : 'Bağlanınca eşitlenir'}</small>}</td>
            <td data-etiket="Durum"><span class:list={['y-chip', 'y-chip--' + renk]}>{ad}</span>{s.not && <small class="y-table-note">{s.not}</small>}</td>
          </tr>;
        })}</tbody>
      </table></div>
      {!ilanSatirlari.length && <p>Trendyol’da onaylı ilan bulunamadı.</p>}
    </div>}
  </section>

  <section id="eslestirmeler" class="kanal-eslesmeler">
    <div class="y-kart__bas"><h2><PIkon ad="degistir" /> Ürün Eşleştirme</h2><a class="y-link" href="#hareketler">Stok hareketleri</a></div>
    <p class="y-help">Buradaki eşleştirme pazaryeri ilanını mağazadaki gerçek ürün kaydına bağlar (geçmiş siparişlerden stok düşürmez). Bekleyen bir pazaryeri siparişinin ürününü bağlayıp o sipariş için stok ayırmak istediğinizde ilgili siparişin detay sayfasındaki <strong>“Eşleştir ve bu sipariş için stok ayır”</strong> işlemini kullanın.</p>
    {KANAL_LISTESI.map((kanal) => {
      const k = ayar.kanallar[kanal];
      const eslesen = Object.values(k.urunler).filter((u) => u.kod).length;
      const eslesmeyen = urunler.length - eslesen;
      const stokFarkli = urunler.filter((u) => {
        const es = k.urunler[u.id];
        if (!es?.kod || !ayrilan) return false;
        const sat = Math.max(0, u.stok - (ayrilan.get(u.id) ?? 0));
        const hdf = es.satista ? kanalHedefStok(sat, k) : 0;
        return es.bildirilen !== undefined && es.bildirilen !== hdf;
      }).length;
      return <details class="y-kart kanal-eslesme" id={'eslestirme-' + kanal} open={duzenlenenKanal === kanal || kanal === 'trendyol'} data-eslestirmeler>
        <summary><KanalLogo kanal={kanal} boyut="kucuk" /> {KANALLAR[kanal]} <span class="y-chip y-chip--yesil">{eslesen} eşleşen</span><span class="y-chip y-chip--turuncu">{eslesmeyen} eşleşmeyen</span>{stokFarkli > 0 && <span class="y-chip y-chip--kirmizi">{stokFarkli} stok farkı</span>}</summary>
        <p class="y-help">{KOD_YARDIM[kanal]}</p>
        {urunler.length > 0 && <div class="y-toolbar kanal-ara" hidden>
          <input class="y-girdi" type="search" placeholder="Barkod, SKU veya ürün adı ara…" aria-label="Ürün veya ilan kodu ara" data-eslestirme-ara />
          <div class="kanal-durum-filtreler" role="group" aria-label="Eşleştirme durumu filtresi">
            <button type="button" class="btn btn--cizgi btn--kucuk is-aktif" data-eslestirme-durum="">Tümü ({urunler.length})</button>
            <button type="button" class="btn btn--cizgi btn--kucuk" data-eslestirme-durum="bekliyor">Eşleşmeyen ({eslesmeyen})</button>
            <button type="button" class="btn btn--cizgi btn--kucuk" data-eslestirme-durum="bagli">Eşleşen ({eslesen})</button>
            <button type="button" class="btn btn--cizgi btn--kucuk" data-eslestirme-durum="fark">Stok farkı ({stokFarkli})</button>
          </div>
        </div>}
        <p class="y-help" role="status" data-eslestirme-bos hidden>Aramanıza veya seçili filtreye uyan ürün yok.</p>
        {eslesen > 0 && <form method="post" id={'toplu-' + kanal} class="kanal-toplu">
          <input type="hidden" name="eylem" value="toplu-fiyat" />
          <input type="hidden" name="kanal" value={kanal} />
          <span class="y-help">Seçili ürünler için:</span>
          <button class="btn btn--sepet btn--kucuk" type="submit" name="islem" value="gonder" disabled={!depoHazir || !fiyatKanallari.includes(kanal)}>Seçilenlerin fiyatını gönder</button>
          <button class="btn btn--cizgi btn--kucuk" type="submit" name="islem" value="takip-ac" disabled={!depoHazir}>Otomatik fiyat takibini aç</button>
          <button class="btn btn--cizgi btn--kucuk" type="submit" name="islem" value="takip-kapat" disabled={!depoHazir}>Takibi kapat</button>
          <button class="btn btn--cizgi btn--kucuk" type="button" data-hepsini-sec={'toplu-' + kanal}>Eşleşenlerin hepsini seç</button>
        </form>}
        <div>
          {urunler.map((u) => {
            const eslesme = k.urunler[u.id];
            const satilabilir = ayrilan && Math.max(0, u.stok - (ayrilan.get(u.id) ?? 0));
            const hedef = satilabilir === undefined ? undefined : kanalHedefStok(satilabilir, k);
            const aktifHedef = eslesme?.kod && hedef !== undefined ? (eslesme.satista ? hedef : 0) : undefined;
            const stokFarki = aktifHedef !== undefined && eslesme?.bildirilen !== undefined ? Math.abs(aktifHedef - eslesme.bildirilen) : 0;
            const oneri = kanal === 'trendyol' ? urunGtin(u) : u.sku || undefined;
            const bagliDurum = eslesme?.kod ? 'bagli' : 'bekliyor';
            const fiyatBilgi = kanalHedefFiyati(u, k);
            const mevcutOzelFiyat = eslesme?.ozelFiyat ?? k.ilanlar[u.id]?.fiyat;
            return <form method="post" id={`${kanal}-${u.id}`} class:list={['kanal-urun', { 'is-bagli': eslesme?.kod }]} data-eslestirme-urun={`${u.marka} ${u.ad} ${u.kisaAd} ${u.sku} ${oneri ?? ''} ${eslesme?.kod ?? ''}`} data-eslestirme-durumu={bagliDurum} data-eslestirme-fark={stokFarki > 0 ? '1' : '0'}>
              <input type="hidden" name="kanal" value={kanal} />
              <input type="hidden" name="urunId" value={u.id} />
              <input type="hidden" name="eylem" value="urun-ayari" />
              <div class="kanal-urun__ad">
                <div class="kanal-urun__baslik">
                  <a class="y-link" href={'/yonetim/urunler/' + u.id}>
                    {u.gorseller[0] && <img src={u.gorseller[0].src} alt="" width="40" height="40" loading="lazy" decoding="async" />}
                    <span><strong>{u.marka} {u.kisaAd}</strong><small class="muted">Mağaza SKU: {u.sku}{oneri && oneri !== u.sku ? ` · Önerilen barkod: ${oneri}` : ''}</small></span>
                  </a>
                  <div class="kanal-urun__rozetler">
                    <span class:list={['y-chip', eslesme?.kod ? 'y-chip--yesil' : 'y-chip--turuncu']}>{eslesme?.kod ? 'Eşleşti' : 'Eşleşme bekliyor'}</span>
                    {stokFarki > 0 && <span class="y-chip y-chip--kirmizi">Stok farkı: {stokFarki}</span>}
                    <span class="y-chip y-chip--gri" title="Bu kanalda uygulanacak hedef satış fiyatı">
                      Hedef fiyat: {tlYaz(fiyatBilgi.hedef)} ({fiyatBilgi.kaynak === 'ozel' ? 'Özel' : fiyatBilgi.kaynak === 'kural' ? 'Kural' : 'Siteyle aynı'})
                    </span>
                    {eslesme?.kanalFiyat !== undefined && <span class:list={['y-chip', Math.abs(eslesme.kanalFiyat - fiyatBilgi.hedef) < 0.005 ? 'y-chip--yesil' : 'y-chip--turuncu']} title={eslesme.kanalFiyatTarih ? 'Okunma: ' + zaman(eslesme.kanalFiyatTarih) : undefined}>
                      {KANALLAR[kanal]}’daki fiyat: {tlYaz(eslesme.kanalFiyat)}
                    </span>}
                    {eslesme?.kod && <span class:list={['y-chip', eslesme.fiyatTakip ? 'y-chip--yesil' : 'y-chip--gri']}>{eslesme.fiyatTakip ? 'Fiyat takipte' : 'Fiyat elle'}</span>}
                    {eslesme?.kod && <label class="kanal-sec"><input type="checkbox" name="secili" value={u.id} form={'toplu-' + kanal} data-toplu-secim={'toplu-' + kanal} /> Seç</label>}
                  </div>
                </div>
                <dl class="kanal-stok"><div><dt>Depo stoku</dt><dd>{u.stok}</dd></div><div><dt>Ayrılan (web)</dt><dd>{ayrilan ? ayrilan.get(u.id) ?? 0 : '—'}</dd></div><div><dt>Satılabilir</dt><dd>{satilabilir ?? '—'}</dd></div><div><dt>Kanal hedefi (−{k.guvenlikPayi} pay)</dt><dd>{aktifHedef ?? '—'}</dd></div><div><dt>Kanala son bildirilen</dt><dd>{eslesme?.bildirilen ?? '—'}</dd></div></dl>
              </div>
              <label class="y-alan">{kanal === 'trendyol' ? 'Trendyol barkodu (EAN)' : 'Hepsiburada satıcı stok kodu'}
                <input name="kod" value={eslesme?.kod ?? ''} placeholder={oneri ? `Öneri: ${oneri}` : 'Kodu girin'} maxlength="120" required disabled={!depoHazir || Boolean(k.bekleyenStok)} autocomplete="off" />
              </label>
              <label class="y-alan">Özel kanal fiyatı (TL, isteğe bağlı)
                <input name="ozelFiyat" inputmode="decimal" value={mevcutOzelFiyat !== undefined ? String(mevcutOzelFiyat).replace('.', ',') : ''} placeholder={`Site: ${tlYaz(fiyatBilgi.site)}`} disabled={!depoHazir || Boolean(k.bekleyenStok)} autocomplete="off" />
              </label>
              <div class="kanal-secimler">
                <label class="kanal-onay"><input type="checkbox" name="satista" checked={eslesme?.satista ?? true} disabled={!depoHazir || Boolean(k.bekleyenStok)} /> Kanalda satışa açık</label>
                <label class="kanal-onay" title="Açıkken hedef fiyat 5 dakikada bir kanala gönderilir ve hep aynı tutulur"><input type="checkbox" name="fiyatTakip" checked={eslesme?.fiyatTakip ?? false} disabled={!depoHazir || Boolean(k.bekleyenStok)} /> Otomatik fiyat takibi</label>
              </div>
              <div class="kanal-dugmeler">
                <button class:list={['btn', eslesme?.kod ? 'btn--cizgi' : 'btn--sepet']} type="submit" name="eylem" value="urun-ayari" disabled={!depoHazir || Boolean(k.bekleyenStok)}>{eslesme?.kod ? 'Kaydet' : 'Ürünü eşleştir'}</button>
                {eslesme?.kod && <button class="btn btn--cizgi" type="submit" name="sonra" value="fiyat" disabled={!depoHazir || Boolean(k.bekleyenStok) || !fiyatKanallari.includes(kanal)} title={`Hedef fiyatı (${tlYaz(fiyatBilgi.hedef)}) ${KANALLAR[kanal]}’a şimdi gönderir`}>Kaydet ve fiyatı şimdi gönder</button>}
              </div>
            </form>;
          })}
          {!urunler.length && <p>Katalogda ürün yok.</p>}
        </div>
      </details>;
    })}
  </section>

  <details class="y-kart kanal-bolum" id="hareketler">
    <summary><PIkon ad="gecmis" /> Son stok hareketleri</summary>
    {hareketler.length > 0 ? <ul class="kanal-hareketler">
      {hareketler.map((h) => <li><time datetime={h.tarih}>{zaman(h.tarih)}</time><strong>{urunAdlari.get(h.urunId) ?? h.urunId}</strong><span>{h.onceki} → {h.sonraki}</span><span>{stokSebebi(h.sebep)}</span></li>)}
    </ul> : <p>Henüz stok hareketi yok.</p>}
  </details>
</Yonetim>

<script>
  for (const dugme of document.querySelectorAll<HTMLButtonElement>('[data-hepsini-sec]')) {
    dugme.addEventListener('click', () => {
      const kutular = [...document.querySelectorAll<HTMLInputElement>(`[data-toplu-secim="${dugme.dataset.hepsiniSec}"]`)]
        .filter((k) => !k.closest<HTMLElement>('[data-eslestirme-urun]')?.hidden);
      const hepsi = kutular.every((k) => k.checked);
      for (const k of kutular) k.checked = !hepsi;
      dugme.textContent = hepsi ? 'Eşleşenlerin hepsini seç' : 'Seçimi kaldır';
    });
  }
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-eslestirme-ac]')) {
    link.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      const bolum = document.getElementById(link.dataset.eslestirmeAc ?? '');
      if (!(bolum instanceof HTMLDetailsElement)) return;
      e.preventDefault();
      bolum.open = true;
      bolum.scrollIntoView();
      bolum.querySelector('summary')?.focus({ preventScroll: true });
    });
  }
  for (const bolum of document.querySelectorAll('[data-eslestirmeler]')) {
    const ara = bolum.querySelector<HTMLInputElement>('[data-eslestirme-ara]');
    const bos = bolum.querySelector<HTMLElement>('[data-eslestirme-bos]');
    const dugmeler = [...bolum.querySelectorAll<HTMLButtonElement>('[data-eslestirme-durum]')];
    if (!ara || !bos) continue;
    ara.closest('.kanal-ara')?.removeAttribute('hidden');
    const satirlar = [...bolum.querySelectorAll<HTMLElement>('[data-eslestirme-urun]')];
    let seciliDurum = '';
    const suz = () => {
      const sorgu = ara.value.trim().toLocaleLowerCase('tr');
      for (const satir of satirlar) {
        const metinUygun = satir.dataset.eslestirmeUrun!.toLocaleLowerCase('tr').includes(sorgu);
        const durumUygun = !seciliDurum
          || (seciliDurum === 'fark' ? satir.dataset.eslestirmeFark === '1' : satir.dataset.eslestirmeDurumu === seciliDurum);
        satir.hidden = !(metinUygun && durumUygun);
      }
      bos.hidden = satirlar.some((satir) => !satir.hidden);
    };
    ara.addEventListener('input', suz);
    for (const b of dugmeler) {
      b.addEventListener('click', () => {
        seciliDurum = b.dataset.eslestirmeDurum ?? '';
        for (const x of dugmeler) x.classList.toggle('is-aktif', x === b);
        suz();
      });
    }
  }
</script>

