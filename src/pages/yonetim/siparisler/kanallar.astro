---
import Yonetim from '../../../layouts/Yonetim.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import { DogrulamaHatasi, magazaOku, siparisleriOku, webAyrilanAdetleri } from '../../../lib/depo';
import { fiyatOzeti, pazaryeriFiyatlariEsitle, trendyolIlanlariniEsle, type IlanEslesmesi } from '../../../lib/kanalFiyat';
import { KANALLAR, KANAL_LISTESI, bosAyarlar, kanalHedefFiyati, kanalHedefStok, kanalMi, kodNormal, tarihOku } from '../../../lib/pazaryeri';
import { BILDIRIM_YOLU, PazaryeriApiHatasi, bildirimAnahtari, otomatikStokYazmaAcik, pazaryeriApiDurumu, pazaryeriOrtam } from '../../../lib/pazaryeriApi';
import { tyWebhookAktif, tyWebhookGuncelle, tyWebhookKur, tyWebhooklar } from '../../../lib/trendyolApi';
import { envanterAyarlariGuncelle, envanterAyarlariOku, pazaryeriHazirMi, pazaryeriSiparisleriOku, stokHareketleriOku } from '../../../lib/pazaryeriDepo';
import { pazaryeriSenkron } from '../../../lib/pazaryeriSenkron';
import { urunGtin } from '../../../lib/urunKimlik';
import { stokSebebi, yTarih } from '../../../lib/yonetimRapor';

const yol = '/yonetim/siparisler/kanallar';
const hatalar: string[] = [];
const ok = Astro.url.searchParams.get('ok');
let duzenlenenKanal = Astro.url.searchParams.get('eslestirme');
let ayar = bosAyarlar();
/* Üç okuma aynı anda: ayar satırı (iki çağrı tek isteği paylaşır) ve mağaza */
const [hazirSonuc, ayarSonuc, magaza] = await Promise.all([
  pazaryeriHazirMi(),
  envanterAyarlariOku().then((a) => ({ a }), () => undefined),
  magazaOku(),
]);
let depoHazir = hazirSonuc;
if (ayarSonuc) ayar = ayarSonuc.a;
else {
  depoHazir = false;
  hatalar.push('Kanal ayarları okunamadı. Bağlantıyı kontrol edip sayfayı yenileyin.');
}
const urunler = [...magaza.urunler].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr'));
const baglantiAdi = { kapali: 'Bağlı değil', eksik: 'API ayarları eksik', test: 'Test bağlantısı', canli: 'Canlı bağlantı' };
/** Vercel dışında (bilgisayardaki kopya) çalışıyor mu? Pazaryeri anahtarları yalnız canlı sunucuda tanımlı. */
const yerelKopya = !process.env.VERCEL;
const panel = { trendyol: 'https://partner.trendyol.com/', hepsiburada: 'https://merchant.hepsiburada.com/' };
const ayarliKanal = KANAL_LISTESI.some((kanal) => {
  const api = pazaryeriApiDurumu(kanal);
  return ayar.kanallar[kanal].stokBaslangic && (api === 'canli' || api === 'test');
});
const senkronZamani = (p?: { id: string; tarih: string }) => p &&
  Date.now() - Date.parse(p.tarih) > (p.id === 'gonderim-bekleniyor' ? 15 * 60_000 : 5 * 3600_000);
if (Astro.request.method === 'POST' && depoHazir) {
  try {
    const f = await Astro.request.formData();
    const eylem = f.get('eylem');
    if (eylem === 'senkron') {
      const r = await pazaryeriSenkron('panel');
      if (r.durum === 'hata') throw new DogrulamaHatasi(Object.entries(r.kanallar).map(([id, s]) =>
        `${kanalMi(id) ? KANALLAR[id] : id} · ${[s.hata, s.stokHata].filter(Boolean).join(' ')}`).filter((s) => !s.endsWith(' · ')));
      if (r.durum === 'kapali') throw new DogrulamaHatasi(['Senkron için kanalın API ayarları ve stok başlangıcı gerekli.']);
      return Astro.redirect(yol + (r.durum === 'bekliyor' ? '?ok=bekliyor' : '?ok=senkron'), 303);
    }
    if (eylem === 'fiyat-esitle') {
      const sonuclar = await pazaryeriFiyatlariEsitle();
      const hata = sonuclar.filter((s) => s.hata).map((s) => `${KANALLAR[s.kanal]}: ${s.hata}`);
      if (hata.length) throw new DogrulamaHatasi(hata);
      const ozet = fiyatOzeti(sonuclar);
      const ayni = sonuclar.reduce((t, s) => t + s.ayni + s.bekleyen, 0);
      const takipli = KANAL_LISTESI.reduce((t, k) => t + Object.values(ayar.kanallar[k].urunler).filter((e) => e.kod && e.fiyatTakip).length, 0);
      const metin = ozet.length ? ozet.join(' ') + ' Kanal birkaç dakika içinde uygular.'
        : !takipli ? 'Fiyat takibi açık ürün yok. Ürün eşleştirme listesinde ürünü seçip “Seçilenlerin fiyatını gönder”e ya da satırdaki “Fiyatı şimdi gönder”e basın.'
        : sonuclar.length ? `Takipteki ürünlerin kanal fiyatı zaten hedefle aynı (${ayni} ilan).` : 'Fiyat göndermek için bağlı bir satış kanalı yok.';
      return Astro.redirect(`${yol}?m=${encodeURIComponent(metin.slice(0, 900))}#fiyatlar`, 303);
    }
    if (eylem === 'ilan-bagla') {
      const r = await trendyolIlanlariniEsle(true);
      return Astro.redirect(`${yol}?ilanlar=1&m=${encodeURIComponent(r.baglanan ? `${r.baglanan} Trendyol ilanı sitedeki ürünüyle bağlandı. Stok artık ortak depodan gider; Trendyol’daki fiyatlara dokunulmadı (fiyatı istediğiniz ürün için “Fiyatı şimdi gönder”le eşitleyin).` : 'Bağlanacak yeni ilan bulunamadı.')}#ty-ilanlar`, 303);
    }
    if (eylem === 'bildirim-kur' || eylem === 'bildirim-kontrol') {
      if (!['canli', 'test'].includes(pazaryeriApiDurumu('trendyol'))) throw new DogrulamaHatasi(['Anlık bildirim canlı sitede (Trendyol anahtarlarının olduğu sunucuda) kurulur.']);
      const anahtar = bildirimAnahtari('trendyol');
      if (!anahtar) throw new DogrulamaHatasi(['Sunucuda zamanlayıcı anahtarı (ZAMANLAYICI_ANAHTARI) tanımlı değil; bildirim anahtarı üretilemedi.']);
      const adres = new URL(BILDIRIM_YOLU.trendyol, import.meta.env.SITE || magaza.site.url).href;
      const mevcut = await tyWebhooklar();
      const bizim = mevcut.find((w) => w.url.replace(/\/$/, '') === adres.replace(/\/$/, ''));
      if (eylem === 'bildirim-kontrol') {
        const metin = bizim ? `Trendyol anlık bildirimi kayıtlı · durum: ${bizim.durum === 'ACTIVE' ? 'Aktif' : 'Pasif (yeniden açmak için “Anlık bildirimi aç”a basın)'}.`
          : `Trendyol’da bu siteye ait anlık bildirim kaydı yok${mevcut.length ? ` (başka ${mevcut.length} kayıt var)` : ''}.`;
        return Astro.redirect(`${yol}?m=${encodeURIComponent(metin)}#trendyol`, 303);
      }
      let id: string;
      if (bizim) {
        await tyWebhookGuncelle(bizim.id, adres, anahtar);
        if (bizim.durum !== 'ACTIVE') await tyWebhookAktif(bizim.id);
        id = bizim.id;
      } else {
        if (mevcut.length >= 15) throw new DogrulamaHatasi(['Trendyol en fazla 15 bildirim kaydına izin veriyor; satıcı panelinden/entegratörünüzden kullanılmayanı silin.']);
        id = await tyWebhookKur(adres, anahtar);
      }
      await envanterAyarlariGuncelle((a) => { a.kanallar.trendyol.bildirim.id = id; a.kanallar.trendyol.bildirim.kurulum = new Date().toISOString(); });
      return Astro.redirect(`${yol}?m=${encodeURIComponent('Trendyol anlık sipariş bildirimi açıldı. Yeni sipariş ve durum değişiklikleri artık saniyeler içinde panele düşer; 5 dakikalık otomatik kontrol yedek olarak sürer.')}#trendyol`, 303);
    }
    if (eylem === 'toplu-fiyat') {
      const kanal = f.get('kanal');
      if (!kanalMi(kanal)) throw new DogrulamaHatasi(['Geçerli bir satış kanalı seçin.']);
      duzenlenenKanal = kanal;
      const secili = f.getAll('secili').map(String).filter((id) => urunler.some((u) => u.id === id) && ayar.kanallar[kanal].urunler[id]?.kod);
      if (!secili.length) throw new DogrulamaHatasi(['Önce listeden eşleşmiş en az bir ürün seçin (satırdaki “Seç” kutusu).']);
      const islem = String(f.get('islem') ?? '');
      if (islem === 'takip-ac' || islem === 'takip-kapat') {
        await envanterAyarlariGuncelle((a) => {
          for (const id of secili) { const e = a.kanallar[kanal].urunler[id]; if (e) e.fiyatTakip = islem === 'takip-ac'; }
        });
        const metin = islem === 'takip-ac'
          ? `${secili.length} üründe otomatik fiyat takibi açıldı: hedef fiyat 5 dakika içinde ${KANALLAR[kanal]}’a gider ve sonra kendiliğinden aynı tutulur.`
          : `${secili.length} üründe otomatik fiyat takibi kapatıldı. ${KANALLAR[kanal]}’daki fiyatları artık yalnız siz değiştirirsiniz.`;
        return Astro.redirect(`${yol}?eslestirme=${kanal}&m=${encodeURIComponent(metin)}#eslestirme-${kanal}`, 303);
      }
      if (islem !== 'gonder') throw new DogrulamaHatasi(['Geçersiz toplu işlem.']);
      const [r] = await pazaryeriFiyatlariEsitle({ kanallar: [kanal], urunIdler: secili });
      if (!r) throw new DogrulamaHatasi([`${KANALLAR[kanal]} bağlantısı bu sunucuda kurulu değil.`]);
      if (r.hata) throw new DogrulamaHatasi([r.hata]);
      const ozet = fiyatOzeti([r]).join(' ');
      const metin = r.gonderilen.length ? ozet + ' Kanal birkaç dakika içinde uygular.' : `Seçilen ${secili.length} ürünün ${KANALLAR[kanal]} fiyatı zaten hedefle aynı.${ozet ? ' ' + ozet : ''}`;
      return Astro.redirect(`${yol}?eslestirme=${kanal}&m=${encodeURIComponent(metin.slice(0, 900))}#eslestirme-${kanal}`, 303);
    }
    if (eylem === 'otomasyon-kaydet') {
      await envanterAyarlariGuncelle((a) => {
        a.otomasyon.yeniSiparisBildir = f.get('yeniSiparisBildir') === 'on';
        a.otomasyon.otoToplama = f.get('otoToplama') === 'on';
        a.otomasyon.faturaYenidenDene = f.get('faturaYenidenDene') === 'on';
        a.otomasyon.gunlukIsler = f.get('gunlukIsler') === 'on';
        a.otomasyon.otoFiyat = f.get('otoFiyat') === 'on';
      });
      return Astro.redirect(`${yol}?m=${encodeURIComponent('Genel kanal otomasyon tercihleri kaydedildi.')}`, 303);
    }
    if (eylem === 'fiyat-kurali') {
      const otoFiyat = f.get('otoFiyat') === 'on';
      const tyYuzde = Number(String(f.get('ty_yuzde') ?? '0').replace(',', '.'));
      const tyEk = Number(String(f.get('ty_ekTL') ?? '0').replace(',', '.'));
      const tyYuvarla = f.get('ty_yuvarla') === 'on';
      const hbYuzde = Number(String(f.get('hb_yuzde') ?? '0').replace(',', '.'));
      const hbEk = Number(String(f.get('hb_ekTL') ?? '0').replace(',', '.'));
      const hbYuvarla = f.get('hb_yuvarla') === 'on';
      if ([tyYuzde, tyEk, hbYuzde, hbEk].some((n) => !Number.isFinite(n))) throw new DogrulamaHatasi(['Fiyat kuralı oran ve tutarlarını sayı olarak girin.']);
      if (tyYuzde < -50 || tyYuzde > 300 || hbYuzde < -50 || hbYuzde > 300) throw new DogrulamaHatasi(['Yüzde farkı -%50 ile +%300 arasında olmalı.']);
      if (tyEk < 0 || tyEk > 100_000 || hbEk < 0 || hbEk > 100_000) throw new DogrulamaHatasi(['Ek TL farkı 0 ile 100.000 TL arasında olmalı.']);
      await envanterAyarlariGuncelle((a) => {
        a.otomasyon.otoFiyat = otoFiyat;
        a.kanallar.trendyol.fiyatKurali = { yuzde: tyYuzde, ekTL: tyEk, yuvarla: tyYuvarla };
        a.kanallar.hepsiburada.fiyatKurali = { yuzde: hbYuzde, ekTL: hbEk, yuvarla: hbYuvarla };
      });
      return Astro.redirect(`${yol}?m=${encodeURIComponent('Kanal fiyat kuralları ve otomatik eşitleme tercihi kaydedildi.')}#fiyatlar`, 303);
    }
    const kanal = f.get('kanal');
    if (!kanalMi(kanal)) throw new DogrulamaHatasi(['Geçerli bir satış kanalı seçin.']);
    if (eylem === 'kanal-ayari') {
      const metin = String(f.get('stokBaslangic') ?? '');
      const baslangic = tarihOku(metin);
      const guvenlikPayi = String(f.get('guvenlikPayi') ?? '');
      if (!/^\d{1,4}$/.test(guvenlikPayi) || Number(guvenlikPayi) > 1000) throw new DogrulamaHatasi(['Güvenlik payı 0 ile 1.000 adet arasında olmalı.']);
      if (metin && (!baslangic || Date.parse(baslangic) > Date.now())) throw new DogrulamaHatasi(['Stok başlangıcı için geçmiş veya güncel bir tarih ve saat girin.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        if (!k.sonAktarim && baslangic) k.stokBaslangic = baslangic;
        k.guvenlikPayi = Number(guvenlikPayi);
      });
    } else if (eylem === 'stok-islemini-kapat') {
      if (f.get('dogrulandi') !== 'on') throw new DogrulamaHatasi(['Önce satıcı panelindeki işlem ve ilan adetlerini doğrulayın.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        const p = k.bekleyenStok;
        if (!p || !senkronZamani(p) || p.tarih !== f.get('bekleyenTarih') || p.id !== f.get('bekleyenId')) {
          throw new DogrulamaHatasi(['Bekleyen işlem değişti. Sayfayı yenileyip yeniden kontrol edin.']);
        }
        for (const kalem of p.kalemler) {
          const ilan = k.urunler[kalem.urunId];
          if (ilan?.kod === kalem.kod) ilan.sonHedef = Math.max(ilan.sonHedef ?? 0, kalem.stok);
        }
        delete k.bekleyenStok;
        k.sonStokHata = 'Satıcı paneli kontrolü sonrasında önceki stok işlemi kapatıldı. Yeni kanal okuması bekleniyor.';
      });
    } else if (eylem === 'kanal-disi') {
      // Ürün bu kanalda hiç satılmıyor (ilanı yok): eşleşme bekleyen sayılmaz. Geri alınabilir.
      duzenlenenKanal = kanal;
      const urunId = String(f.get('urunId') ?? '');
      const disarida = String(f.get('deger') ?? '') === 'ac';
      if (!urunler.some((u) => u.id === urunId)) throw new DogrulamaHatasi(['Ürün bulunamadı.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        if (k.urunler[urunId]?.kod) throw new DogrulamaHatasi(['Bu ürün bir ilana bağlı. Satışı durdurmak için ••• menüsünden “Kanalda satışa açık” seçimini kaldırın.']);
        if (disarida) k.urunler[urunId] = { satista: false };
        else delete k.urunler[urunId];
      });
      const ad = urunler.find((u) => u.id === urunId);
      return Astro.redirect(`${yol}?eslestirme=${kanal}&m=${encodeURIComponent(`${ad?.marka} ${ad?.kisaAd}: ${disarida ? `${KANALLAR[kanal]}’da satılmıyor olarak işaretlendi.` : `yeniden ${KANALLAR[kanal]} eşleşmesi bekliyor.`}`)}#${kanal}-${encodeURIComponent(urunId)}`, 303);
    } else if (eylem === 'urun-ayari') {
      duzenlenenKanal = kanal;
      const urunId = String(f.get('urunId') ?? '');
      const kod = String(f.get('kod') ?? '').trim();
      const satista = f.get('satista') === 'on';
      const fiyatTakip = f.get('fiyatTakip') === 'on';
      const ozelFiyatHam = String(f.get('ozelFiyat') ?? '').trim().replace(/\s/g, '').replace(',', '.');
      const ozelFiyat = ozelFiyatHam ? Number(ozelFiyatHam) : undefined;
      if (ozelFiyat !== undefined && (!Number.isFinite(ozelFiyat) || ozelFiyat <= 0 || ozelFiyat > 10_000_000)) {
        throw new DogrulamaHatasi(['Özel kanal fiyatı 0’dan büyük geçerli bir TL tutarı olmalı (site/kural fiyatını kullanmak için boş bırakın).']);
      }
      if (!urunler.some((u) => u.id === urunId) || kod.length > 120) throw new DogrulamaHatasi(['Ürün veya pazaryeri ilan kodu geçersiz.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        if (k.bekleyenStok) throw new DogrulamaHatasi(['Kanalın stok güncellemesi onaylanınca ürün kodunu düzenleyebilirsiniz.']);
        if (!kod && k.urunler[urunId]?.kod) throw new DogrulamaHatasi(['Kayıtlı ilanı sıfıra çekmek için kodunu koruyup “Satışa açık” seçimini kaldırın.']);
        if (!kod) throw new DogrulamaHatasi(['Satıcı panelindeki ilan kodunu girin.']);
        if (Object.entries(k.urunler).some(([id, u]) => id !== urunId && u.kod === kod)) {
          throw new DogrulamaHatasi(['Bu ilan kodu kanaldaki başka bir ürüne bağlı.']);
        }
        const onceki = k.urunler[urunId];
        if (onceki?.kod && onceki.kod !== kod && (onceki.bildirilen ?? 0) > 0) {
          throw new DogrulamaHatasi(['İlan kodunu değiştirmeden önce mevcut ilanı satışa kapatın ve stok onayını bekleyin.']);
        }
        k.urunler[urunId] = onceki?.kod === kod ? { ...onceki, kod, satista, ozelFiyat, fiyatTakip } : { kod, satista, ozelFiyat, fiyatTakip };
        if (k.ilanlar[urunId]) k.ilanlar[urunId].fiyat = ozelFiyat;
        a.eslesmeler[kodNormal(kod)] = urunId;
      });
      if (f.get('sonra') === 'fiyat') {
        const [r] = await pazaryeriFiyatlariEsitle({ kanallar: [kanal], urunIdler: [urunId] });
        const metin = !r ? `Kaydedildi. ${KANALLAR[kanal]} bağlantısı bu sunucuda kurulu olmadığı için fiyat gönderilemedi.`
          : r.hata ? `Kaydedildi ama fiyat gönderilemedi: ${r.hata}`
          : r.gonderilen.length ? `Kaydedildi. ${fiyatOzeti([r]).join(' ')} Kanal birkaç dakika içinde uygular.`
          : r.bulunamayan.length ? `Kaydedildi ama ilan ${KANALLAR[kanal]}’da bulunamadı (${r.bulunamayan.join(', ')}). Kodu kontrol edin.`
          : `Kaydedildi. ${KANALLAR[kanal]} fiyatı zaten hedefle aynı.`;
        return Astro.redirect(`${yol}?eslestirme=${kanal}&m=${encodeURIComponent(metin.slice(0, 900))}#${kanal}-${encodeURIComponent(urunId)}`, 303);
      }
      return Astro.redirect(`${yol}?ok=ayar&eslestirme=${kanal}#${kanal}-${encodeURIComponent(urunId)}`, 303);
    } else throw new DogrulamaHatasi(['Geçersiz işlem.']);
    return Astro.redirect(`${yol}?ok=ayar#${kanal}`, 303);
  } catch (e) {
    hatalar.push(...(e instanceof DogrulamaHatasi ? e.hatalar : e instanceof PazaryeriApiHatasi ? [e.message] : ['Kanal işlemi tamamlanamadı. Bağlantıyı kontrol edip tekrar deneyin.']));
    ayar = await envanterAyarlariOku().catch(() => ayar);
  }
}
/* Trendyol'daki tüm ilanlar ve sitedeki karşılıkları (yalnız istenince: ?ilanlar=1) */
const tyHazir = ['canli', 'test'].includes(pazaryeriApiDurumu('trendyol'));
let ilanSatirlari: IlanEslesmesi[] | undefined;
if (Astro.request.method === 'GET' && Astro.url.searchParams.has('ilanlar') && tyHazir && depoHazir) {
  try { ilanSatirlari = (await trendyolIlanlariniEsle(false)).satirlar; }
  catch (e) { hatalar.push(e instanceof PazaryeriApiHatasi ? e.message : 'Trendyol ilanları okunamadı. Biraz sonra tekrar deneyin.'); }
}
const [web, hareketler, pySiparisler] = await Promise.all([
  siparisleriOku(true).catch(() => {
    hatalar.push('Web rezervasyonları okunamadı. Yayın hedefleri geçici olarak gizlendi.');
    return undefined;
  }),
  stokHareketleriOku(undefined, 30).catch(() => {
    if (depoHazir) hatalar.push('Stok hareketleri okunamadı.');
    return [];
  }),
  pazaryeriSiparisleriOku().catch(() => []),
]);
const ayrilan = web && webAyrilanAdetleri(web, Date.now(), magaza.paytrStokIslemleri);
const urunAdlari = new Map(urunler.map((u) => [u.id, u.kisaAd]));
const yerelSaat = (t?: string) => t ? new Date(Date.parse(t) + 3 * 3600e3).toISOString().slice(0, 16) : '';
const zaman = (t?: string) => t ? yTarih.format(new Date(t)) : 'Henüz yok';
const basari = ok === 'senkron' ? 'Siparişler güncellendi.' : ok === 'bekliyor' ? 'Güncelleme zaten çalışıyor, birazdan tekrar bakın.' : ok === 'ayar' ? 'Kaydedildi.'
  : Astro.url.searchParams.get('m')?.slice(0, 900) || undefined;
const fiyatKanallari = KANAL_LISTESI.filter((kanal) => ['canli', 'test'].includes(pazaryeriApiDurumu(kanal)));
const tlYaz = (n?: number) => n === undefined ? '—' : n.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' TL';
const ILAN_DURUMU: Record<IlanEslesmesi['durum'], [string, string]> = {
  bagli: ['Bağlı', 'yesil'], yeni: ['Bağlanabilir', 'turuncu'], cakisma: ['Elle kontrol edin', 'kirmizi'], yok: ['Sitede karşılığı yok', 'gri'],
};

const API_YARDIM = {
  trendyol: 'Trendyol satıcı panelinde Hesap Bilgilerim → Entegrasyon Bilgileri bölümüne gidin. Satıcı ID, API Key ve API Secret değerlerini Vercel ortam ayarlarına girin.',
  hepsiburada: 'Hepsiburada satıcı panelinden kendi yazılımınız için entegrasyon erişimi isteyin. Canlı Merchant ID, kullanıcı adı, parola ve User-Agent değerlerini Vercel ortam ayarlarına girin.',
};
const KOD_YARDIM = {
  trendyol: 'Trendyol’da ürünü eklerken yazdığınız “Barkod”. Çoğu üründe kutunun üzerindeki çizgili kodun altındaki 13 haneli sayıdır (EAN). Trendyol satıcı panelinde Ürünler listesinde de görünür.',
  hepsiburada: 'Hepsiburada’ya ürünü yüklerken verdiğiniz “Satıcı stok kodu” (merchantSku). Kendi belirlediğiniz koddur; çoğu satıcı model kodunu kullanır.',
};
// Asıl zamanlayıcı Supabase pg_cron (ZAMANLAYICI_ANAHTARI); GitHub yedeği CRON_SECRET. Biri varsa zamanlayıcı açıktır (denetim AUD-020)
const zamanlayiciAnahtariVar = [pazaryeriOrtam('ZAMANLAYICI_ANAHTARI'), pazaryeriOrtam('CRON_SECRET')].some((x) => (x?.length ?? 0) >= 32);
const otomatikYazma = otomatikStokYazmaAcik();
const simdi = Date.now();
const GORUNUMLER = ['genel', 'web', 'trendyol', 'hepsiburada', 'eslestirme', 'fiyatlar'] as const;
type Gorunum = (typeof GORUNUMLER)[number];
const hamGorunum = Astro.url.searchParams.get('gorunum');
const aktifGorunum: Gorunum = Astro.url.searchParams.has('ilanlar') ? 'fiyatlar'
  : duzenlenenKanal ? 'eslestirme'
  : (GORUNUMLER as readonly string[]).includes(hamGorunum ?? '') ? (hamGorunum as Gorunum)
  : 'genel';

const webHazirlanacak = web?.filter((s) => s.durum === 'odendi' && !s.paytr?.test && !s.paytr?.stokEksik).length ?? 0;
const webKargolanacak = web?.filter((s) => s.durum === 'hazirlaniyor' && !s.paytr?.test).length ?? 0;
const webStokEksik = web?.filter((s) => s.paytr?.stokEksik && s.durum !== 'iptal').length ?? 0;
const pyBekleyen = (kanal: 'trendyol' | 'hepsiburada') => pySiparisler.filter((s) => s.kanal === kanal && ['onay-bekliyor', 'yeni', 'hazirlaniyor'].includes(s.durum)).length;
const kanalIstatistik = (kanal: 'trendyol' | 'hepsiburada') => {
  const k = ayar.kanallar[kanal];
  const eslesen = urunler.filter((u) => k.urunler[u.id]?.kod).length;
  // Taslak ürünler ve "bu kanalda satılmıyor" işaretlenenler eşleşme bekleyen sayılmaz (25.11.2026)
  const eslesmeyen = urunler.filter((u) => !k.urunler[u.id]?.kod && k.urunler[u.id]?.satista !== false && u.durum !== 'taslak').length;
  const stokFarkli = urunler.filter((u) => {
    const es = k.urunler[u.id];
    if (!es?.kod || !ayrilan) return false;
    const sat = Math.max(0, u.stok - (ayrilan.get(u.id) ?? 0));
    const hdf = es.satista ? kanalHedefStok(sat, k) : 0;
    return es.bildirilen !== undefined && es.bildirilen !== hdf;
  }).length;
  return { eslesen, eslesmeyen, stokFarkli };
};
const gosterilecekEslesmeKanallari = aktifGorunum === 'trendyol' ? (['trendyol'] as const)
  : aktifGorunum === 'hepsiburada' ? (['hepsiburada'] as const)
  : KANAL_LISTESI;
---
<Yonetim baslik={aktifGorunum === 'web' ? 'Satış Kanalları · Web Sitesi' : aktifGorunum === 'trendyol' ? 'Satış Kanalları · Trendyol' : aktifGorunum === 'hepsiburada' ? 'Satış Kanalları · Hepsiburada' : aktifGorunum === 'eslestirme' ? 'Ürün Eşleştirme' : aktifGorunum === 'fiyatlar' ? 'Kanal Fiyatları ve Kurallar' : 'Satış Kanalları'} altBaslik="Pazaryeri ve web sitesi bağlantılarınızı yönetin, stok/fiyat senkronizasyonlarını ve eşleştirmeleri tek merkezden kontrol edin." aktif="siparisler" {basari} {hatalar}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/servis-kontrol" data-astro-prefetch="false"><PIkon ad="hedef" boyut={18} />Servis ve API Tanılama</a>
    <a class="btn btn--cizgi" href="?gorunum=fiyatlar"><PIkon ad="etiket" boyut={18} />Fiyatlar</a>
    <a class="btn btn--cizgi" href="?gorunum=eslestirme"><PIkon ad="degistir" boyut={18} />Ürün eşleştirme</a>
    {depoHazir && ayarliKanal && <form method="post"><button class="btn btn--sepet" name="eylem" value="senkron" type="submit"><PIkon ad="yenile" boyut={18} />Şimdi eşitle</button></form>}
  </div>

  <nav class="y-sekmeler y-kanal-nav" aria-label="Satış kanalları bölümleri" style="margin-bottom:16px">
    <a href={yol} aria-current={aktifGorunum === 'genel' ? 'page' : undefined}>Genel Durum</a>
    <a href="?gorunum=web" aria-current={aktifGorunum === 'web' ? 'page' : undefined}>Web Sitesi</a>
    <a href="?gorunum=trendyol" aria-current={aktifGorunum === 'trendyol' ? 'page' : undefined}>Trendyol</a>
    <a href="?gorunum=hepsiburada" aria-current={aktifGorunum === 'hepsiburada' ? 'page' : undefined}>Hepsiburada</a>
    <a href="?gorunum=eslestirme" aria-current={aktifGorunum === 'eslestirme' ? 'page' : undefined}>Ürün Eşleştirme</a>
    <a href="?gorunum=fiyatlar" aria-current={aktifGorunum === 'fiyatlar' ? 'page' : undefined}>Fiyatlar ve Kurallar</a>
  </nav>

  {!depoHazir && <p class="y-uyari-satir" role="status">Kanal ayarları kullanılamıyor. Veritabanı bağlantısını ve pazaryeri tablolarını kontrol edin.</p>}

  {/* ==================== 1. GENEL BAKIŞ (15_03_00-8.png DÜZENİ) ==================== */}
  {aktifGorunum === 'genel' && <>
    <div class="sk-genel-izgara">
      <section class="y-kart sk-ozet-kart sk-ozet-kart--web">
        <div class="sk-ozet-ust">
          <div class="sk-ozet-kimlik">
            <KanalLogo kanal="web" boyut="orta" />
            <div>
              <h2>Web Sitesi</h2>
              <small>{magaza.site.url.replace(/^https?:\/\//, '')}</small>
            </div>
          </div>
          <span class:list={['y-chip', magaza.site.tadilat.aktif ? 'y-chip--turuncu' : 'y-chip--yesil']}>
            {magaza.site.tadilat.aktif ? '● Bakımda' : '● Bağlı ve Aktif'}
          </span>
        </div>
        <a class="sk-son-esitleme" href="/yonetim/siparisler?kanal=web&durum=tumu">
          <span><PIkon ad="yenile" boyut={15} /> Ortak depo · Anlık canlı stok</span>
          <span>›</span>
        </a>
        <div class="sk-sayac-ikili">
          <a href="/yonetim/siparisler?kanal=web&durum=islem" class="sk-sayac-kutu">
            <strong><PIkon ad="sepet" boyut={18} /> {webHazirlanacak + webKargolanacak}</strong>
            <small>Bekleyen Sipariş</small>
          </a>
          <a href="/yonetim/urunler?filtre=kritik" class:list={['sk-sayac-kutu', { 'is-uyari': webStokEksik > 0 }]}>
            <strong><PIkon ad="katman" boyut={18} /> {webStokEksik}</strong>
            <small>{webStokEksik > 0 ? 'Stok Uyuşmazlığı' : 'Stok Sorunu Yok'}</small>
          </a>
        </div>
        <a class="btn btn--sepet sk-detay-btn" href="?gorunum=web">Detayı Aç ↗</a>
      </section>

      {KANAL_LISTESI.map((kanal) => {
        const k = ayar.kanallar[kanal];
        const api = pazaryeriApiDurumu(kanal);
        const apiHazir = api === 'canli' || api === 'test';
        // "Canlıda aktif" tahmini yalnız yerel kopyada anlamlı (anahtarlar yalnız canlı sunucuda); canlı sunucuda anahtar yoksa kanal kapalıdır
        const bulutBagli = yerelKopya && !apiHazir && Boolean(k.sonApi || k.sonOtomatikApi);
        const otomatikGecikti = Boolean((apiHazir || bulutBagli) && k.sonOtomatikApi && simdi - Date.parse(k.sonOtomatikApi) > 30 * 60_000);
        const ist = kanalIstatistik(kanal);
        const bekleyen = pyBekleyen(kanal);
        const sorunSayisi = ist.eslesmeyen + ist.stokFarkli;
        const rozetRenk = k.sonApiHata || k.sonStokHata ? 'kirmizi' : api === 'test' ? 'turuncu' : otomatikGecikti ? 'turuncu' : (apiHazir || bulutBagli) ? 'yesil' : 'gri';
        const rozetYazi = k.sonApiHata || k.sonStokHata ? '⚠ Bağlantı Hatası' : api === 'test' ? '● Test Ortamı (SIT)' : otomatikGecikti ? '⚠ Eşitleme Gecikiyor' : apiHazir ? '● Canlı · Bağlı' : bulutBagli ? '● Canlıda Aktif' : k.sonApi ? '○ Bağlantı Kapalı' : '○ Kurulum Bekliyor';
        const siparisGuncellik = api === 'test' ? `SIT test · son ${zaman(k.sonApi)}` : otomatikGecikti ? `Gecikti · son ${zaman(k.sonApi)}` : k.sonApi ? `Güncel · ${zaman(k.sonApi)}` : 'Henüz çekilmedi';
        const stokFiyatDurum = api === 'test' ? 'İzole test (canlı stoğa dokunmaz)' : ist.stokFarkli > 0 ? `${ist.stokFarkli} üründe stok farkı` : `${ist.eslesen}/${urunler.length} ürün bağlı · ortak stok`;
        return (
          <section class:list={['y-kart', 'sk-ozet-kart', 'sk-ozet-kart--' + kanal]}>
            <div class="sk-ozet-ust">
              <div class="sk-ozet-kimlik">
                <KanalLogo kanal={kanal} boyut="orta" />
                <div>
                  <h2>{KANALLAR[kanal]}</h2>
                  <small>1. Bağlantı: {rozetYazi.replace(/^[⚠●○]\s*/, '')}</small>
                </div>
              </div>
              <span class:list={['y-chip', 'y-chip--' + rozetRenk]}>{rozetYazi}</span>
            </div>
            <a class="sk-son-esitleme" href={`?gorunum=${kanal}`}>
              <span><PIkon ad="yenile" boyut={15} /> 2. Sipariş: {siparisGuncellik} · 3. Stok: {stokFiyatDurum}</span>
              <span>›</span>
            </a>
            <div class="sk-sayac-ikili">
              <a href={`/yonetim/siparisler?kanal=${kanal}&durum=islem`} class="sk-sayac-kutu">
                <strong><PIkon ad="sepet" boyut={18} /> {bekleyen}</strong>
                <small>İşlem Bekleyen Sipariş</small>
              </a>
              <a href={`?gorunum=eslestirme#eslestirme-${kanal}`} class:list={['sk-sayac-kutu', { 'is-uyari': sorunSayisi > 0 }]}>
                <strong><PIkon ad="katman" boyut={18} /> {sorunSayisi}</strong>
                <small>{[ist.eslesmeyen > 0 ? `${ist.eslesmeyen} eşleşmiyor` : '', ist.stokFarkli > 0 ? `${ist.stokFarkli} stok farkı` : ''].filter(Boolean).join(' · ') || 'Stok uyumlu'}</small>
              </a>
            </div>
            <a class="btn btn--cizgi sk-detay-btn" href={`?gorunum=${kanal}`}>Kanal Ayarları ve Eşleştirme ↗</a>
          </section>
        );
      })}
    </div>

    <section class="y-kart sk-otomasyon-bant" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px">
      <div>
        <h2 style="margin:0 0 4px"><PIkon ad="simsek" /> Otomasyonlar ve 3 Kanal Fiyat Tablosu</h2>
        <p class="y-kart__alt" style="margin:0">
          5 dakikalık arka plan kuralları tek yerden <strong>İş Merkezi</strong>’nde, ürün bazlı 3 kanal fiyatları ve net kâr ise <strong>Fiyat, Stok ve Kâr Tablosu</strong>’nda yönetilir.
        </p>
      </div>
      <div class="y-ust-aksiyonlar">
        <a class="btn btn--cizgi btn--kucuk" href="/yonetim#otomasyon"><PIkon ad="ayar" boyut={15} />Otomasyon Ayarları ({[ayar.otomasyon.yeniSiparisBildir, ayar.otomasyon.otoToplama, ayar.otomasyon.faturaYenidenDene, ayar.otomasyon.gunlukIsler, ayar.otomasyon.otoBagla, ayar.otomasyon.otoFiyat].filter(Boolean).length}/6 açık)</a>
        <a class="btn btn--sepet btn--kucuk" href="/yonetim/fiyatlar"><PIkon ad="etiket" boyut={15} />Fiyat, Stok ve Kâr Tablosu</a>
      </div>
    </section>

    <div class="sk-alt-ikili">
      <section class="y-kart" id="hareketler">
        <div class="y-kart__bas">
          <h2><PIkon ad="gecmis" /> Son İşlem ve Stok Kayıtları</h2>
          <a class="y-link" href="/yonetim#otomasyon">Otomasyon günlüğü →</a>
        </div>
        {hareketler.length > 0 ? (
          <div class="y-tablo-kap y-tablo-kap--kart">
            <table class="y-tablo">
              <thead><tr><th>Tarih / Saat</th><th>Ürün</th><th>Stok Değişimi</th><th>İşlem / Sebep</th></tr></thead>
              <tbody>
                {hareketler.slice(0, 10).map((h) => (
                  <tr>
                    <td data-etiket="Tarih" class="y-nowrap">{zaman(h.tarih)}</td>
                    <td data-etiket="Ürün"><strong>{urunAdlari.get(h.urunId) ?? h.urunId}</strong></td>
                    <td data-etiket="Değişim" class="y-nowrap"><span class="y-chip y-chip--gri">{h.onceki} → {h.sonraki}</span></td>
                    <td data-etiket="İşlem">{stokSebebi(h.sebep)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p class="muted" style="margin:0">Henüz kayıtlı stok hareketi yok.</p>}
      </section>

      <section class="y-kart">
        <div class="y-kart__bas">
          <h2><PIkon ad="uyari" /> Sorun Gerektiren Kayıtlar</h2>
          <a class="y-link" href="?gorunum=eslestirme">Tümünü Gör →</a>
        </div>
        <div class="sk-sorun-liste">
          {KANAL_LISTESI.map((kanal) => {
            const ist = kanalIstatistik(kanal);
            const k = ayar.kanallar[kanal];
            return (
              <>
                {ist.eslesmeyen > 0 && (
                  <div class="sk-sorun-kutu">
                    <div>
                      <strong><KanalLogo kanal={kanal} boyut="kucuk" /> {KANALLAR[kanal]} · Ürün Eşleşmiyor</strong>
                      <small>{KANALLAR[kanal]}’da {ist.eslesmeyen} mağaza ürünü henüz bir ilan koduna bağlanmadı.</small>
                    </div>
                    <span class="y-chip y-chip--turuncu">{ist.eslesmeyen} ürün</span>
                    <a class="btn btn--sepet btn--kucuk" href={`?gorunum=${kanal}#eslestirme-${kanal}`}>Ürünleri Gör</a>
                  </div>
                )}
                {ist.stokFarkli > 0 && (
                  <div class="sk-sorun-kutu is-kirmizi">
                    <div>
                      <strong><KanalLogo kanal={kanal} boyut="kucuk" /> {KANALLAR[kanal]} · Stok Farkı Var</strong>
                      <small>{ist.stokFarkli} üründe kanala son bildirilen stok ile mağaza hedef stoğu farklı.</small>
                    </div>
                    <span class="y-chip y-chip--kirmizi">{ist.stokFarkli} ürün</span>
                    <a class="btn btn--sepet btn--kucuk" href={`?gorunum=${kanal}#eslestirme-${kanal}`}>Eşitle / Gör</a>
                  </div>
                )}
                {k.sonApiHata && (
                  <div class="sk-sorun-kutu is-kirmizi">
                    <div>
                      <strong><KanalLogo kanal={kanal} boyut="kucuk" /> Bağlantı Uyarısı</strong>
                      <small>{k.sonApiHata}</small>
                    </div>
                    <a class="btn btn--cizgi btn--kucuk" href={`?gorunum=${kanal}`}>Kontrol Et</a>
                  </div>
                )}
              </>
            );
          })}
          {KANAL_LISTESI.every((kanal) => { const i = kanalIstatistik(kanal); return i.eslesmeyen === 0 && i.stokFarkli === 0 && !ayar.kanallar[kanal].sonApiHata; }) && (
            <p class="y-bos-satir"><PIkon ad="tik-daire" boyut={20} />Tüm kanallar ve ürün stokları uyumlu görünüyor.</p>
          )}
        </div>
      </section>
    </div>
  </>}

  {/* ==================== 2. WEB SİTESİ AYRINTILI ÖZET ==================== */}
  {aktifGorunum === 'web' && (
    <section class="y-kart">
      <div class="y-kart__bas">
        <div style="display:flex;align-items:center;gap:12px">
          <KanalLogo kanal="web" boyut="buyuk" />
          <div>
            <h2>Web Sitesi Kanal Özeti ({magaza.site.ad})</h2>
            <p class="y-kart__alt">{magaza.site.url} · Ana stok deposu ve doğrudan müşteri satış kanalı.</p>
          </div>
        </div>
        <span class:list={['y-chip', magaza.site.tadilat.aktif ? 'y-chip--turuncu' : 'y-chip--yesil']}>{magaza.site.tadilat.aktif ? 'Bakım Modunda' : 'Yayında'}</span>
      </div>
      <div class="y-metrics y-metrics--finans" style="margin:12px 0">
        <div class="y-metric y-metric--yesil"><PIkon ad="kutu" /><span>Yayındaki ürünler</span><strong>{urunler.filter((u) => u.durum === 'yayinda').length}</strong><small>Toplam {urunler.length} katalog ürünü</small></div>
        <a class="y-metric y-metric--turuncu" href="/yonetim/siparisler?kanal=web&durum=odendi"><PIkon ad="sepet" /><span>Hazırlanacak sipariş</span><strong>{webHazirlanacak}</strong><small>Ödemesi onaylanmış</small></a>
        <a class="y-metric" href="/yonetim/siparisler?kanal=web&durum=hazirlaniyor"><PIkon ad="kargo" /><span>Kargoya verilecek</span><strong>{webKargolanacak}</strong><small>Paketi hazırlanmış</small></a>
        <div class="y-metric"><PIkon ad="katman" /><span>Ayrılan (rezerve) stok</span><strong>{ayrilan ? [...ayrilan.values()].reduce((a, b) => a + b, 0) : 0} adet</strong><small>Açık web siparişleri için</small></div>
      </div>
      <div class="y-ust-aksiyonlar">
        <a class="btn btn--sepet" href="/yonetim/siparisler?kanal=web&durum=islem"><PIkon ad="sepet" boyut={18} />Web Siparişlerini Aç</a>
        <a class="btn btn--cizgi" href="/yonetim/fiyatlar?gorunum=web"><PIkon ad="etiket" boyut={18} />Web Fiyat ve Kâr Tablosu</a>
        <a class="btn btn--cizgi" href="/yonetim/urunler"><PIkon ad="kutu" boyut={18} />Ürün Kataloğu</a>
        <a class="btn btn--cizgi" href="/yonetim/site-duzeni"><PIkon ad="magaza" boyut={18} />Mağaza Görünümü Ayarları</a>
        <a class="btn btn--cizgi" href="/" target="_blank" rel="noopener"><PIkon ad="dis-baglanti" boyut={18} />Canlı Mağazayı Aç ↗</a>
      </div>
    </section>
  )}

  {/* ==================== 3. TRENDYOL VEYA HEPSİBURADA AYRINTILI ÖZET ==================== */}
  {(aktifGorunum === 'trendyol' || aktifGorunum === 'hepsiburada') && (() => {
    const kanal = aktifGorunum;
    const k = ayar.kanallar[kanal];
    const api = pazaryeriApiDurumu(kanal);
    const apiHazir = api === 'canli' || api === 'test';
    const bulutBagli = yerelKopya && !apiHazir && Boolean(k.sonApi || k.sonOtomatikApi);
    const eslesen = Object.values(k.urunler).filter((u) => u.kod).length;
    const otomatikGecikti = k.sonOtomatikApi && simdi - Date.parse(k.sonOtomatikApi) > 30 * 60_000;
    const baglantiMetni = apiHazir ? baglantiAdi[api] : bulutBagli ? 'Canlı sunucuda aktif (Yerel .env yok)' : baglantiAdi[api];
    const otomatikDurum = bulutBagli
      ? (otomatikGecikti ? 'Canlı sunucuda gecikiyor' : 'Canlı sunucuda çalışıyor')
      : !apiHazir || !k.stokBaslangic ? 'Kurulum bekliyor' : !zamanlayiciAnahtariVar ? 'Kapalı'
      : !k.sonOtomatikApi ? 'İlk çalışma bekleniyor' : otomatikGecikti ? 'Gecikiyor' : 'Çalışıyor';
    const stokDurumu = bulutBagli
      ? (k.bekleyenStok ? 'Kanal onayı bekleniyor' : eslesen === 0 ? 'İlan eşleştirmesi bekliyor' : 'Canlı sunucuda otomatik')
      : !apiHazir || !k.stokBaslangic ? 'Kurulum bekliyor' : !otomatikYazma ? 'Elle'
      : k.bekleyenStok ? 'Kanal onayı bekleniyor' : eslesen === 0 ? 'İlan eşleştirmesi bekliyor' : 'Otomatik';

    return (
      <section class:list={['y-kart', 'kanal', 'kanal--' + kanal]} id={kanal} style="margin-bottom:16px">
        <div class="y-kart__bas">
          <div style="display:flex;align-items:center;gap:12px">
            <KanalLogo kanal={kanal} boyut="buyuk" />
            <div>
              <h2>{KANALLAR[kanal]} Kanal Özeti ve Bağlantı Ayarları</h2>
              <p class="y-kart__alt">{KANALLAR[kanal]} sipariş çekimi, ortak stok bildirimi, güvenlik payı ve ürün eşleştirme yönetimi.</p>
            </div>
          </div>
          <a class="btn btn--cizgi btn--kucuk" href={panel[kanal]} target="_blank" rel="noopener noreferrer">{KANALLAR[kanal]} Satıcı Paneli ↗</a>
        </div>

        <dl class="kanal-durum" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
          <div><dt>Mağaza bağlantısı</dt><dd>{baglantiMetni}</dd></div>
          <div><dt>Otomatik eşitleme</dt><dd class:list={{ 'y-uyari-kucuk': otomatikGecikti }}>{otomatikDurum}</dd></div>
          <div><dt>Son otomatik çekim</dt><dd>{zaman(k.sonOtomatikApi)}</dd></div>
          <div><dt>Son başarılı çekim</dt><dd>{zaman(k.sonApi)}</dd></div>
          <div><dt>Stok gönderimi</dt><dd>{stokDurumu}</dd></div>
          <div><dt>Bağlı ürünler</dt><dd>{eslesen} / {urunler.length} ürün</dd></div>
          <div><dt>Başlangıç sayımı</dt><dd class:list={{ 'y-uyari-kucuk': !k.stokBaslangic }}>{k.stokBaslangic ? zaman(k.stokBaslangic) : 'Girilmedi'}</dd></div>
          <div><dt>Güvenlik payı</dt><dd>{k.guvenlikPayi} adet</dd></div>
          {kanal === 'trendyol' && <div><dt>Anlık sipariş bildirimi</dt><dd>{k.bildirim.kurulum ? (k.bildirim.son ? `Açık · son ${zaman(k.bildirim.son)}` : 'Açık · henüz bildirim gelmedi') : 'Kapalı (5 dk kontrol)'}</dd></div>}
        </dl>

        <div class="kanal-kisayol">
          {kanal === 'trendyol' ? (
            <>
              <a class="btn btn--sepet" href="/yonetim/siparisler?kanal=trendyol&durum=islem"><PIkon ad="sepet" boyut={18} />Trendyol Siparişleri</a>
              <a class="btn btn--cizgi" href="/yonetim/siparisler/trendyol-urunler"><PIkon ad="gonder" boyut={18} />Trendyol’a Ürün Gönder / İlan Aç</a>
              <a class="btn btn--cizgi" href="/yonetim/siparisler/trendyol-ilanlar"><PIkon ad="indir" boyut={18} />Trendyol İlanları (Bağla / Çek)</a>
              <a class="btn btn--cizgi" href="/yonetim/siparisler/trendyol-iade-soru"><PIkon ad="iade" boyut={18} />Trendyol İadeleri &amp; Sorular</a>
              <a class="btn btn--cizgi" href="/yonetim/fiyatlar?gorunum=trendyol"><PIkon ad="etiket" boyut={18} />Trendyol Fiyat &amp; Kâr</a>
            </>
          ) : (
            <>
              <a class="btn btn--sepet" href="/yonetim/siparisler?kanal=hepsiburada&durum=islem"><PIkon ad="sepet" boyut={18} />Hepsiburada Siparişleri</a>
              <a class="btn btn--cizgi" href="/yonetim/fiyatlar?gorunum=hepsiburada"><PIkon ad="etiket" boyut={18} />Hepsiburada Fiyat &amp; Kâr</a>
              <a class="btn btn--cizgi" href="/yonetim/finans/hepsiburada"><PIkon ad="grafik" boyut={18} />Hepsiburada Hakedişler</a>
              <a class="btn btn--cizgi" href="?gorunum=fiyatlar"><PIkon ad="ayar" boyut={18} />Genel Fiyat Kuralı</a>
            </>
          )}
        </div>

        {kanal === 'hepsiburada' && (
          <div class="y-veri-not" style="margin-bottom:12px">
            <PIkon ad="bilgi" boyut={18} />
            <p>
              <strong>Hepsiburada ürünleri nasıl yönetilir?</strong>
              Hepsiburada’da ürün kartları önce Hepsiburada Satıcı Paneli’nde açılır; ardından aşağıdaki <strong>Hepsiburada Ürün Eşleştirme</strong> tablosunda ürünün <em>Satıcı Stok Kodu (merchantSku)</em> eşleştirildiğinde stok ve fiyatlar bu panelden otomatik yönetilir.
            </p>
          </div>
        )}

        {kanal === 'trendyol' && apiHazir && depoHazir && <form method="post" class="kanal-kisayol">
          <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="bildirim-kur"><PIkon ad="zil" boyut={16} />{k.bildirim.kurulum ? 'Anlık bildirimi yenile' : 'Anlık sipariş bildirimini aç'}</button>
          <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="bildirim-kontrol">Bildirim durumunu kontrol et</button>
          <span class="y-help">Açıkken Trendyol siparişi oluştuğu an siteye haber verir; stok saniyeler içinde düşer.</span>
        </form>}

        {k.sonApiHata && <p class="y-uyari-satir" role="alert">Siparişler alınamadı: {k.sonApiHata}</p>}
        {k.sonStokHata && <p class="y-uyari-satir" role="alert">Stok gönderilemedi: {k.sonStokHata}</p>}
        {k.sonStokNot && <p class="y-help" role="status">Bilgi: {k.sonStokNot}</p>}
        {kanal === 'trendyol' && (k.ciftIlanlar?.length ?? 0) > 0 && <p class="y-uyari-satir" role="alert">Trendyol’da {k.ciftIlanlar.length} ürün birden fazla ilanla satışta (çift ilan). <a class="y-link" href="/yonetim/siparisler/trendyol-ilanlar#cift">Kalacak ilanı seçin</a>.</p>}

        <details style="margin-top:10px;padding:12px;border:1px solid var(--y-border,#e5dec9);border-radius:12px;background:var(--y-surface-2,#faf7f2)" open={!k.stokBaslangic || Boolean(k.bekleyenStok && senkronZamani(k.bekleyenStok))}>
          <summary style="cursor:pointer;font-weight:650;font-size:14px">Gelişmiş Kurulum Ayarları (Başlangıç Sayımı, Güvenlik Payı ve API Rehberi)</summary>
          <div class="y-izgara y-izgara--2" style="margin-top:12px">
            <form method="post" class="y-kart" style="margin:0;background:#fff">
              <input type="hidden" name="kanal" value={kanal} />
              <h3 style="margin:0 0 8px;font-size:15px">Başlangıç sayımı ve güvenlik payı</h3>
              <div class="y-izgara y-izgara--2">
                <label class="y-alan">Sayım tarihi ve saati
                  <input type="datetime-local" name="stokBaslangic" value={yerelSaat(k.stokBaslangic)} disabled={!depoHazir || Boolean(k.sonAktarim)} />
                  <small class="muted">İlk aktarımdan sonra kilitlenir.</small>
                </label>
                <label class="y-alan">Güvenlik payı (adet)
                  <input type="number" name="guvenlikPayi" min="0" max="1000" value={k.guvenlikPayi} required disabled={!depoHazir} inputmode="numeric" />
                  <small class="muted">Depodaki adetten bu kadar düşülüp kanala gönderilir. 0 önerilir: 1 yazarsanız 1 adetlik ürünler kanalda 0 görünür ve pasife düşer.</small>
                </label>
              </div>
              <div style="margin-top:10px"><button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="kanal-ayari" disabled={!depoHazir}>Ayarları Kaydet</button></div>
            </form>

            <div class="y-kart" style="margin:0;background:#fff">
              <h3 style="margin:0 0 8px;font-size:15px">Bağlantı Rehberi</h3>
              <p class="y-help" style="margin:0">{bulutBagli ? `${KANALLAR[kanal]} bağlantınız canlı sunucuda (Vercel) aktif (Son çekim: ${zaman(k.sonApi)}). Yerel bilgisayardan anlık API çağrısı için anahtarları yerel .env dosyanıza da ekleyebilirsiniz.` : API_YARDIM[kanal]}</p>
              {depoHazir && k.bekleyenStok && senkronZamani(k.bekleyenStok) && (
                <form method="post" class="kanal-kurtarma" style="margin-top:10px">
                  <input type="hidden" name="kanal" value={kanal} />
                  <input type="hidden" name="bekleyenId" value={k.bekleyenStok.id} />
                  <input type="hidden" name="bekleyenTarih" value={k.bekleyenStok.tarih} />
                  <label class="y-secim"><input type="checkbox" name="dogrulandi" required /> Bekleyen stok isteğini satıcı panelinde kontrol ettim.</label>
                  <button class="btn btn--cizgi btn--kucuk" type="submit" name="eylem" value="stok-islemini-kapat">Önceki işlemi kapat</button>
                </form>
              )}
            </div>
          </div>
        </details>
      </section>
    );
  })()}

  {/* ==================== 4. FİYATLAR VE KANAL KURALLARI ==================== */}
  {aktifGorunum === 'fiyatlar' && (
    <section class="y-kart kanal-fiyatlar" id="fiyatlar" aria-labelledby="fiyatlar-baslik">
      <div class="y-kart__bas">
        <div>
          <h2 id="fiyatlar-baslik"><PIkon ad="etiket" /> Fiyatlar, Kanal Kuralları ve Trendyol İlanları</h2>
          <p class="y-kart__alt">Pazaryeri fiyatlarını ister web sitesiyle birebir aynı tutun, ister kanala özel komisyon/kargo farkı veya ürüne özel sabit fiyat belirleyin.</p>
        </div>
      </div>
      <ol class="kanal-kural-listesi">
        <li><strong>Eşleştirme yalnız bağlar.</strong> İlanı sitedeki ürüne bağlamak Trendyol/Hepsiburada fiyatını değiştirmez; yalnız <strong>stok ortak</strong> olur.</li>
        <li><strong>Kanal fiyatı farklı olabilir.</strong> Hedef fiyat sırasıyla: ürüne özel kanal fiyatı → kanalın genel kuralı (% / +TL) → sitedeki son fiyat.</li>
        <li><strong>Fiyat yalnız siz isteyince gider.</strong> Satırdaki <strong>“Fiyatı şimdi gönder”</strong>, toplu <strong>“Seçilenlerin fiyatını gönder”</strong> veya üründe <strong>“Otomatik fiyat takibi”</strong> açıldığında güncellenir.</li>
      </ol>

      <form method="post" class="y-kart" style="margin:12px 0;background:var(--y-surface-2,#faf7f2);border:1px solid var(--y-border,#e5dec9)">
        <input type="hidden" name="eylem" value="fiyat-kurali" />
        <label class="y-secim" style="margin-bottom:12px">
          <input type="checkbox" name="otoFiyat" checked={ayar.otomasyon.otoFiyat} disabled={!depoHazir} />
          <span><strong>Otomatik fiyat takibi çalışsın</strong> <small class="muted">(yalnız “Otomatik fiyat takibi” açık ürünlerin fiyatı 5 dakikada bir hedefle aynı tutulur)</small></span>
        </label>
        <div class="y-izgara y-izgara--2">
          <div style="padding:12px;border:1px solid var(--y-border,#e5dec9);border-radius:10px;background:#fff;display:grid;gap:8px">
            <strong><KanalLogo kanal="trendyol" boyut="kucuk" /> Trendyol genel fiyat kuralı</strong>
            <div class="y-izgara y-izgara--2">
              <label class="y-alan">Yüzde fark (%)<input name="ty_yuzde" inputmode="decimal" value={ayar.kanallar.trendyol.fiyatKurali.yuzde} disabled={!depoHazir} /><small class="muted">0 = siteyle aynı, örn. 15 = +%15</small></label>
              <label class="y-alan">Ek tutar (+TL)<input name="ty_ekTL" inputmode="decimal" value={ayar.kanallar.trendyol.fiyatKurali.ekTL} disabled={!depoHazir} /><small class="muted">Kargo/hizmet farkı (0 = yok)</small></label>
            </div>
            <label class="y-secim"><input type="checkbox" name="ty_yuvarla" checked={ayar.kanallar.trendyol.fiyatKurali.yuvarla} disabled={!depoHazir} /> Sonucu ,90 TL basamağına yuvarla</label>
          </div>
          <div style="padding:12px;border:1px solid var(--y-border,#e5dec9);border-radius:10px;background:#fff;display:grid;gap:8px">
            <strong><KanalLogo kanal="hepsiburada" boyut="kucuk" /> Hepsiburada genel fiyat kuralı</strong>
            <div class="y-izgara y-izgara--2">
              <label class="y-alan">Yüzde fark (%)<input name="hb_yuzde" inputmode="decimal" value={ayar.kanallar.hepsiburada.fiyatKurali.yuzde} disabled={!depoHazir} /><small class="muted">0 = siteyle aynı, örn. 15 = +%15</small></label>
              <label class="y-alan">Ek tutar (+TL)<input name="hb_ekTL" inputmode="decimal" value={ayar.kanallar.hepsiburada.fiyatKurali.ekTL} disabled={!depoHazir} /><small class="muted">Kargo/hizmet farkı (0 = yok)</small></label>
            </div>
            <label class="y-secim"><input type="checkbox" name="hb_yuvarla" checked={ayar.kanallar.hepsiburada.fiyatKurali.yuvarla} disabled={!depoHazir} /> Sonucu ,90 TL basamağına yuvarla</label>
          </div>
        </div>
        <div class="y-modal__alt" style="margin-top:10px">
          <button class="btn btn--cizgi btn--kucuk" type="submit" disabled={!depoHazir}><PIkon ad="tik" boyut={16} />Fiyat kurallarını kaydet</button>
        </div>
      </form>

      <div class="kanal-kisayol">
        <form method="post"><button class="btn btn--cizgi" type="submit" name="eylem" value="fiyat-esitle" disabled={!depoHazir || !fiyatKanallari.length}>Takipteki ürünlerin fiyatını şimdi gönder</button></form>
        <a class="btn btn--sepet" href="/yonetim/siparisler/trendyol-ilanlar">Trendyol ilanları: bağla / siteye çek</a>
        {tyHazir && <a class="btn btn--cizgi" href="?gorunum=fiyatlar&ilanlar=1#ty-ilanlar" data-astro-prefetch="false">Hızlı liste</a>}
        <span class="y-help">Otomatik fiyat takibi: <strong>{ayar.otomasyon.otoFiyat ? 'çalışıyor' : 'kapalı'}</strong> · takipte {KANAL_LISTESI.reduce((t, k) => t + Object.values(ayar.kanallar[k].urunler).filter((e) => e.kod && e.fiyatTakip).length, 0)} ürün</span>
      </div>

      {ilanSatirlari && <div id="ty-ilanlar" class="kanal-ilanlar">
        {(() => {
          const say = (d: IlanEslesmesi['durum']) => ilanSatirlari!.filter((s) => s.durum === d).length;
          const yeni = say('yeni');
          return <>
            <p class="y-help">Trendyol’da {ilanSatirlari!.length} ilan var: {say('bagli')} bağlı, {yeni} bağlanabilir, {say('cakisma')} elle kontrol edilecek, {say('yok')} ilanın sitede karşılığı bulunamadı.</p>
            {yeni > 0 && <form method="post" class="kanal-kurtarma">
              <p class="y-uyari-satir uyari--turuncu" role="note">Bağlanan ilanların stoğu ortak depodan yönetilir; Trendyol fiyatına dokunulmaz.</p>
              <button class="btn btn--sepet" type="submit" name="eylem" value="ilan-bagla" disabled={!depoHazir}>{yeni} ilanı sitedeki ürünüyle bağla</button>
            </form>}
          </>;
        })()}
        <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo">
          <thead><tr><th>Trendyol ilanı</th><th class="y-sayi">Trendyol fiyatı</th><th class="y-sayi">Trendyol stok</th><th>Sitedeki ürün</th><th class="y-sayi">Site fiyatı</th><th>Durum</th></tr></thead>
          <tbody>{ilanSatirlari.map((s) => {
            const [ad, renk] = ILAN_DURUMU[s.durum];
            const fark = s.siteFiyat !== undefined && s.kanalFiyat !== undefined && Math.abs(s.siteFiyat - s.kanalFiyat) >= 0.005;
            return <tr>
              <td data-etiket="Trendyol ilanı"><strong>{s.barkod}</strong>{s.stokKodu && s.stokKodu !== s.barkod && <small class="y-table-note">Stok kodu {s.stokKodu}</small>}</td>
              <td data-etiket="Trendyol fiyatı" class="y-sayi y-nowrap">{tlYaz(s.kanalFiyat)}</td>
              <td data-etiket="Trendyol stok" class="y-sayi">{s.kanalStok ?? '—'}</td>
              <td data-etiket="Sitedeki ürün">{s.urunId ? <a class="y-link" href={'/yonetim/urunler/' + encodeURIComponent(s.urunId)}>{s.urunAdi}</a> : '—'}</td>
              <td data-etiket="Site fiyatı" class="y-sayi y-nowrap">{tlYaz(s.siteFiyat)}{fark && <small class="y-table-note">{s.durum === 'bagli' ? 'Eşitlenecek' : 'Bağlanınca eşitlenir'}</small>}</td>
              <td data-etiket="Durum"><span class:list={['y-chip', 'y-chip--' + renk]}>{ad}</span>{s.not && <small class="y-table-note">{s.not}</small>}</td>
            </tr>;
          })}</tbody>
        </table></div>
      </div>}
    </section>
  )}

  {/* ==================== 5. GÖRSEL ÜRÜN EŞLEŞTİRME TABLOSU (IMAGE 5 DÜZENİ) ==================== */}
  {(aktifGorunum === 'eslestirme' || aktifGorunum === 'trendyol' || aktifGorunum === 'hepsiburada') && (
    <section id="eslestirmeler" class="kanal-eslesmeler">
      <div class="y-kart__bas">
        <div>
          <h2><PIkon ad="degistir" /> {aktifGorunum === 'trendyol' ? 'Trendyol Ürünleri ve Eşleştirme' : aktifGorunum === 'hepsiburada' ? 'Hepsiburada Ürünleri ve Eşleştirme' : 'Ürün Eşleştirme (Pazaryeri ↔ Mağaza)'}</h2>
          <p class="y-kart__alt">Sol sütunda pazaryeri ilanı ve kanal stoğu, orta sütunda bağlandığı mağaza ürünü ve depo stoğu yer alır.</p>
        </div>
      </div>

      {gosterilecekEslesmeKanallari.map((kanal) => {
        const k = ayar.kanallar[kanal];
        const { eslesen, eslesmeyen, stokFarkli } = kanalIstatistik(kanal);
        return (
          <section class="y-kart sk-eslesme-panel" id={'eslestirme-' + kanal} data-eslestirmeler style="margin-bottom:16px">
            <div class="y-kart__bas">
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <KanalLogo kanal={kanal} boyut="kucuk" />
                <strong style="font-size:17px">{KANALLAR[kanal]} Eşleştirme Tablosu</strong>
                <span class="y-chip y-chip--yesil">{eslesen} bağlı</span>
                <span class="y-chip y-chip--turuncu">{eslesmeyen} eşleşme bekliyor</span>
                {stokFarkli > 0 && <span class="y-chip y-chip--kirmizi">{stokFarkli} stok farkı</span>}
              </div>
            </div>
            <p class="y-help" style="margin-top:0">{KOD_YARDIM[kanal]}</p>

            {urunler.length > 0 && (
              <div class="y-toolbar kanal-ara" hidden>
                <input class="y-girdi" type="search" placeholder="Ürün adı, SKU veya barkod ara…" aria-label="Ürün veya ilan kodu ara" data-eslestirme-ara />
                <div class="kanal-durum-filtreler" role="group" aria-label="Eşleştirme durumu filtresi">
                  <button type="button" class="btn btn--cizgi btn--kucuk is-aktif" data-eslestirme-durum="">Tümü ({urunler.length})</button>
                  <button type="button" class="btn btn--cizgi btn--kucuk" data-eslestirme-durum="bekliyor">Eşleşme Bekleyen ({eslesmeyen})</button>
                  <button type="button" class="btn btn--cizgi btn--kucuk" data-eslestirme-durum="bagli">Bağlı ({eslesen})</button>
                  <button type="button" class="btn btn--cizgi btn--kucuk" data-eslestirme-durum="fark">Stok Farkı ({stokFarkli})</button>
                </div>
              </div>
            )}
            <p class="y-help" role="status" data-eslestirme-bos hidden>Aramanıza veya seçili filtreye uyan ürün yok.</p>

            {eslesen > 0 && (
              <form method="post" id={'toplu-' + kanal} class="kanal-toplu">
                <input type="hidden" name="eylem" value="toplu-fiyat" />
                <input type="hidden" name="kanal" value={kanal} />
                <span class="y-help">Seçili bağlı ürünler:</span>
                <button class="btn btn--sepet btn--kucuk" type="submit" name="islem" value="gonder" disabled={!depoHazir || !fiyatKanallari.includes(kanal)}>Seçilenlerin fiyatını gönder</button>
                <button class="btn btn--cizgi btn--kucuk" type="submit" name="islem" value="takip-ac" disabled={!depoHazir}>Otomatik fiyat takibini aç</button>
                <button class="btn btn--cizgi btn--kucuk" type="submit" name="islem" value="takip-kapat" disabled={!depoHazir}>Takibi kapat</button>
                <button class="btn btn--cizgi btn--kucuk" type="button" data-hepsini-sec={'toplu-' + kanal}>Eşleşenlerin hepsini seç</button>
              </form>
            )}

            <div class="sk-eslesme-tablo">
              <div class="sk-eslesme-baslik" aria-hidden="true">
                <span></span>
                <span>Pazaryeri Ürünü (Kaynak)</span>
                <span>Mağaza Ürünü (Eşleştirme)</span>
                <span>Durum ve İşlem</span>
              </div>

              {urunler.map((u) => {
                const eslesme = k.urunler[u.id];
                const satilabilir = ayrilan && Math.max(0, u.stok - (ayrilan.get(u.id) ?? 0));
                const hedef = satilabilir === undefined ? undefined : kanalHedefStok(satilabilir, k);
                const aktifHedef = eslesme?.kod && hedef !== undefined ? (eslesme.satista ? hedef : 0) : undefined;
                const stokFarki = aktifHedef !== undefined && eslesme?.bildirilen !== undefined ? Math.abs(aktifHedef - eslesme.bildirilen) : 0;
                const oneri = kanal === 'trendyol' ? urunGtin(u) : u.sku || undefined;
                const bagliDurum = eslesme?.kod ? 'bagli' : 'bekliyor';
                const fiyatBilgi = kanalHedefFiyati(u, k);
                const mevcutOzelFiyat = eslesme?.ozelFiyat ?? k.ilanlar[u.id]?.fiyat;
                const gorunenKod = eslesme?.kod ?? oneri ?? '';

                return (
                  <div id={`${kanal}-${u.id}`} class:list={['sk-eslesme-satir', { 'is-bagli': Boolean(eslesme?.kod), 'is-fark': stokFarki > 0 }]} data-eslestirme-urun={`${u.marka} ${u.ad} ${u.kisaAd} ${u.sku} ${oneri ?? ''} ${eslesme?.kod ?? ''}`} data-eslestirme-durumu={bagliDurum} data-eslestirme-fark={stokFarki > 0 ? '1' : '0'}>
                    <div class="sk-eslesme-sec">
                      {eslesme?.kod ? (
                        <input type="checkbox" name="secili" value={u.id} form={'toplu-' + kanal} data-toplu-secim={'toplu-' + kanal} aria-label={`${u.kisaAd} seç`} />
                      ) : <span class="sk-bos-kutu"></span>}
                    </div>

                    {/* SOL: PAZARYERİ ÜRÜNÜ (KAYNAK) */}
                    <div class="sk-kaynak-hucre">
                      <span class:list={['sk-kanal-etiket', 'sk-kanal-etiket--' + kanal]}>{KANALLAR[kanal]}</span>
                      <span class="sk-urun-gorsel">
                        {u.gorseller[0] ? <img src={u.gorseller[0].src} alt="" width="44" height="44" loading="lazy" decoding="async" /> : <PIkon ad="kutu" boyut={20} />}
                      </span>
                      <div class="sk-kaynak-bilgi">
                        <strong>{k.ilanlar[u.id]?.baslik || `${u.marka} ${u.kisaAd}`}</strong>
                        <small>{eslesme?.kod ? `${kanal === 'trendyol' ? 'Barkod' : 'HB Stok Kodu'}: ${eslesme.kod}` : oneri ? `Önerilen kod: ${oneri}` : 'Henüz kod girilmedi'}</small>
                      </div>
                      <div class="sk-kaynak-stok">
                        <small>Kanal Stoğu</small>
                        <strong>{eslesme?.bildirilen !== undefined ? `${eslesme.bildirilen} adet` : eslesme?.kod ? `Hedef ${aktifHedef ?? '—'}` : '—'}</strong>
                      </div>
                    </div>

                    {/* ORTA: MAĞAZA ÜRÜNÜ (EŞLEŞTİRME KARTI) */}
                    <div class="sk-hedef-hucre">
                      {eslesme?.kod ? (
                        <div class:list={['sk-bagli-kutu', { 'is-uyari': stokFarki > 0 }]}>
                          <a class="sk-bagli-urun" href={'/yonetim/urunler/' + u.id}>
                            {u.gorseller[0] && <img src={u.gorseller[0].src} alt="" width="38" height="38" loading="lazy" />}
                            <div>
                              <strong>{u.sku} — {u.kisaAd}</strong>
                              <small>Mağaza Depo: {u.stok} · Satılabilir: {satilabilir ?? '—'} · Hedef Fiyat: {tlYaz(fiyatBilgi.hedef)}{eslesme.kanalFiyat !== undefined ? ` (Kanalda: ${tlYaz(eslesme.kanalFiyat)})` : ''}</small>
                            </div>
                          </a>
                          <span class:list={['y-chip', stokFarki > 0 ? 'y-chip--turuncu' : 'y-chip--yesil']}>
                            {stokFarki > 0 ? `⇄ Stok Farkı: ${stokFarki}` : '✓ Bağlandı'}
                          </span>
                        </div>
                      ) : (
                        <form method="post" class="sk-oneri-kutu">
                          <input type="hidden" name="kanal" value={kanal} />
                          <input type="hidden" name="urunId" value={u.id} />
                          <input type="hidden" name="eylem" value="urun-ayari" />
                          <input type="hidden" name="satista" value="on" />
                          <div class="sk-oneri-ust">
                            <span class="sk-oneri-etiket">✨ {oneri ? 'Önerilen Eşleşme' : 'Mağaza Ürünü Eşleştir'}</span>
                            <small class="muted">Mağaza SKU: {u.sku} · Depo: {u.stok} adet</small>
                          </div>
                          <div class="sk-oneri-alt">
                            <input class="y-girdi" name="kod" value={gorunenKod} placeholder={kanal === 'trendyol' ? 'Trendyol 13 haneli barkodu girin…' : 'Hepsiburada satıcı stok kodunu girin…'} maxlength="120" required disabled={!depoHazir || Boolean(k.bekleyenStok)} autocomplete="off" />
                            <button class="btn btn--sepet btn--kucuk" type="submit" disabled={!depoHazir || Boolean(k.bekleyenStok)}><PIkon ad="zincir" boyut={15} />Eşleştir</button>
                          </div>
                        </form>
                      )}
                    </div>

                    {/* SAĞ: DURUM VE DÜZENLEME MENÜSÜ */}
                    <div class="sk-durum-hucre">
                      {eslesme?.kod ? (
                        <div class="sk-durum-etiketler">
                          <span class="muted" style="font-size:12.5px">Stok Farkı: <strong>{stokFarki}</strong></span>
                          {eslesme.fiyatTakip && <span class="y-chip y-chip--yesil">Oto-Fiyat</span>}
                          {!eslesme.satista && <span class="y-chip y-chip--gri">Kapalı</span>}
                        </div>
                      ) : eslesme?.satista === false ? (
                        <form method="post" class="sk-durum-etiketler">
                          <input type="hidden" name="kanal" value={kanal} /><input type="hidden" name="urunId" value={u.id} /><input type="hidden" name="deger" value="kapat" />
                          <span class="y-chip y-chip--gri">Bu kanalda satılmıyor</span>
                          <button class="btn btn--cizgi btn--kucuk" name="eylem" value="kanal-disi" type="submit" disabled={!depoHazir}>Geri al</button>
                        </form>
                      ) : (
                        <form method="post" class="sk-durum-etiketler">
                          <input type="hidden" name="kanal" value={kanal} /><input type="hidden" name="urunId" value={u.id} /><input type="hidden" name="deger" value="ac" />
                          <span class="y-chip y-chip--turuncu">● Eşleşme Bekliyor</span>
                          <button class="btn btn--cizgi btn--kucuk" name="eylem" value="kanal-disi" type="submit" disabled={!depoHazir} title={`Bu ürünün ${KANALLAR[kanal]}’da ilanı yoksa işaretleyin; eşleşme bekleyenlerden çıkar`}>Bu kanalda satmıyorum</button>
                        </form>
                      )}

                      <details class="sk-duzenle-ac">
                        <summary class="btn btn--cizgi btn--kucuk" aria-label="Eşleştirme ve fiyat ayarları">•••</summary>
                        <form method="post" class="sk-duzenle-form">
                          <input type="hidden" name="kanal" value={kanal} />
                          <input type="hidden" name="urunId" value={u.id} />
                          <input type="hidden" name="eylem" value="urun-ayari" />
                          <strong>{u.kisaAd} · {KANALLAR[kanal]} Ayarı</strong>
                          <label class="y-alan">{kanal === 'trendyol' ? 'Trendyol barkodu (EAN)' : 'Hepsiburada satıcı stok kodu'}
                            <input name="kod" value={eslesme?.kod ?? oneri ?? ''} maxlength="120" required disabled={!depoHazir || Boolean(k.bekleyenStok)} autocomplete="off" />
                          </label>
                          <label class="y-alan">Özel kanal fiyatı (TL, boşsa {tlYaz(fiyatBilgi.site)})
                            <input name="ozelFiyat" inputmode="decimal" value={mevcutOzelFiyat !== undefined ? String(mevcutOzelFiyat).replace('.', ',') : ''} placeholder={`Site: ${tlYaz(fiyatBilgi.site)}`} disabled={!depoHazir || Boolean(k.bekleyenStok)} autocomplete="off" />
                          </label>
                          <label class="y-secim"><input type="checkbox" name="satista" checked={eslesme?.satista ?? true} disabled={!depoHazir || Boolean(k.bekleyenStok)} /> Kanalda satışa açık</label>
                          <label class="y-secim"><input type="checkbox" name="fiyatTakip" checked={eslesme?.fiyatTakip ?? false} disabled={!depoHazir || Boolean(k.bekleyenStok)} /> Otomatik fiyat takibi</label>
                          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:4px">
                            <button class="btn btn--sepet btn--kucuk" type="submit" disabled={!depoHazir || Boolean(k.bekleyenStok)}>Kaydet</button>
                            {eslesme?.kod && <button class="btn btn--cizgi btn--kucuk" type="submit" name="sonra" value="fiyat" disabled={!depoHazir || Boolean(k.bekleyenStok) || !fiyatKanallari.includes(kanal)}>Kaydet + Fiyat Gönder</button>}
                          </div>
                        </form>
                      </details>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </section>
  )}
</Yonetim>

<script>
  // Menüdeki alt bağlantılar (?gorunum=eslestirme | fiyatlar | hepsiburada): ilgili bölümü açıp oraya kaydır
  {
    const gorunum = new URLSearchParams(location.search).get('gorunum');
    const hedef = gorunum === 'fiyatlar' ? 'fiyatlar' : gorunum === 'hepsiburada' ? 'eslestirme-hepsiburada' : gorunum === 'eslestirme' ? 'eslestirmeler' : '';
    const el = hedef && document.getElementById(hedef);
    if (el) {
      if (el instanceof HTMLDetailsElement) el.open = true;
      requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
    }
  }
  for (const dugme of document.querySelectorAll<HTMLButtonElement>('[data-hepsini-sec]')) {
    dugme.addEventListener('click', () => {
      const kutular = [...document.querySelectorAll<HTMLInputElement>(`[data-toplu-secim="${dugme.dataset.hepsiniSec}"]`)]
        .filter((k) => !k.closest<HTMLElement>('[data-eslestirme-urun]')?.hidden);
      const hepsi = kutular.every((k) => k.checked);
      for (const k of kutular) k.checked = !hepsi;
      dugme.textContent = hepsi ? 'Eşleşenlerin hepsini seç' : 'Seçimi kaldır';
    });
  }
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-eslestirme-ac]')) {
    link.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      const bolum = document.getElementById(link.dataset.eslestirmeAc ?? '');
      if (!(bolum instanceof HTMLDetailsElement)) return;
      e.preventDefault();
      bolum.open = true;
      bolum.scrollIntoView();
      bolum.querySelector('summary')?.focus({ preventScroll: true });
    });
  }
  for (const bolum of document.querySelectorAll('[data-eslestirmeler]')) {
    const ara = bolum.querySelector<HTMLInputElement>('[data-eslestirme-ara]');
    const bos = bolum.querySelector<HTMLElement>('[data-eslestirme-bos]');
    const dugmeler = [...bolum.querySelectorAll<HTMLButtonElement>('[data-eslestirme-durum]')];
    if (!ara || !bos) continue;
    ara.closest('.kanal-ara')?.removeAttribute('hidden');
    const satirlar = [...bolum.querySelectorAll<HTMLElement>('[data-eslestirme-urun]')];
    let seciliDurum = '';
    const suz = () => {
      const sorgu = ara.value.trim().toLocaleLowerCase('tr');
      for (const satir of satirlar) {
        const metinUygun = satir.dataset.eslestirmeUrun!.toLocaleLowerCase('tr').includes(sorgu);
        const durumUygun = !seciliDurum
          || (seciliDurum === 'fark' ? satir.dataset.eslestirmeFark === '1' : satir.dataset.eslestirmeDurumu === seciliDurum);
        satir.hidden = !(metinUygun && durumUygun);
      }
      bos.hidden = satirlar.some((satir) => !satir.hidden);
    };
    ara.addEventListener('input', suz);
    for (const b of dugmeler) {
      b.addEventListener('click', () => {
        seciliDurum = b.dataset.eslestirmeDurum ?? '';
        for (const x of dugmeler) x.classList.toggle('is-aktif', x === b);
        suz();
      });
    }
  }
</script>

