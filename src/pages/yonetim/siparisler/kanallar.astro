  .kanal-form .btn { justify-self: start; }
  .kanal-urun { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto; align-items: end; padding-block: .75rem; border-bottom: 1px solid var(--y-border); scroll-margin-top: 5rem; }
  .kanal-urun:target { outline: 2px solid var(--y-gold); outline-offset: 4px; }
  .kanal-ara[hidden], .kanal-urun[hidden], [data-eslestirme-bos][hidden] { display: none; }
