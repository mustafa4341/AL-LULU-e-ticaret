  .kanal-urun__ad { grid-column: 1 / -1; }
  .kanal-urun__ad .y-link { display: inline-flex; align-items: center; min-height: 44px; gap: 8px; margin-right: 9px; }
  .kanal-urun__ad img { flex: none; object-fit: contain; border: 1px solid var(--y-border); border-radius: 7px; }
  .kanal-stok { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 115px), 1fr)); gap: 6px; margin: 8px 0; }
