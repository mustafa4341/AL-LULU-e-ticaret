---
import Yonetim from '../../../layouts/Yonetim.astro';
import { DogrulamaHatasi, magazaOku, siparisleriOku, supabaseBagliMi, webAyrilanAdetleri } from '../../../lib/depo';
import { KANALLAR, KANAL_LISTESI, bosAyarlar, kanalHedefStok, kanalMi, tarihOku } from '../../../lib/pazaryeri';
import { otomatikStokYazmaAcik, pazaryeriApiDurumu, pazaryeriOrtam } from '../../../lib/pazaryeriApi';
import { envanterAyarlariGuncelle, envanterAyarlariOku, pazaryeriHazirMi, stokHareketleriOku } from '../../../lib/pazaryeriDepo';
import { pazaryeriSenkron } from '../../../lib/pazaryeriSenkron';
import { urunGtin } from '../../../lib/urunKimlik';
import { stokSebebi, yTarih } from '../../../lib/yonetimRapor';

const yol = '/yonetim/siparisler/kanallar';
const hatalar: string[] = [];
const ok = Astro.url.searchParams.get('ok');
const duzenlenenKanal = Astro.url.searchParams.get('eslestirme');
const bagli = supabaseBagliMi();
let ayar = bosAyarlar();
let depoHazir = bagli && await pazaryeriHazirMi();
try {
  ayar = await envanterAyarlariOku();
} catch {
  depoHazir = false;
  hatalar.push('Kanal ayarları okunamadı. Bağlantıyı kontrol edip sayfayı yenileyin.');
}
const magaza = await magazaOku();
const urunler = [...magaza.urunler].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr'));
const baglantiAdi = { kapali: 'Bağlı değil', eksik: 'API ayarları eksik', test: 'Test bağlantısı', canli: 'Canlı bağlantı' };
const panel = { trendyol: 'https://partner.trendyol.com/', hepsiburada: 'https://merchant.hepsiburada.com/' };
const ayarliKanal = KANAL_LISTESI.some((kanal) => {
  const api = pazaryeriApiDurumu(kanal);
  return ayar.kanallar[kanal].stokBaslangic && (api === 'canli' || api === 'test');
});
const senkronZamani = (p?: { id: string; tarih: string }) => p &&
  Date.now() - Date.parse(p.tarih) > (p.id === 'gonderim-bekleniyor' ? 15 * 60_000 : 5 * 3600_000);
if (Astro.request.method === 'POST' && depoHazir) {
  try {
    const f = await Astro.request.formData();
    const eylem = f.get('eylem');
    if (eylem === 'senkron') {
      const r = await pazaryeriSenkron('panel');
      if (r.durum === 'hata') throw new DogrulamaHatasi(Object.entries(r.kanallar).map(([id, s]) =>
        `${kanalMi(id) ? KANALLAR[id] : id} · ${[s.hata, s.stokHata].filter(Boolean).join(' ')}`).filter((s) => !s.endsWith(' · ')));
      if (r.durum === 'kapali') throw new DogrulamaHatasi(['Senkron için kanalın API ayarları ve stok başlangıcı gerekli.']);
      return Astro.redirect(yol + (r.durum === 'bekliyor' ? '?ok=bekliyor' : '?ok=senkron'), 303);
    }
    const kanal = f.get('kanal');
    if (!kanalMi(kanal)) throw new DogrulamaHatasi(['Geçerli bir satış kanalı seçin.']);
    if (eylem === 'kanal-ayari') {
      const metin = String(f.get('stokBaslangic') ?? '');
      const baslangic = tarihOku(metin);
      const guvenlikPayi = String(f.get('guvenlikPayi') ?? '');
      if (!/^\d{1,4}$/.test(guvenlikPayi) || Number(guvenlikPayi) > 1000) throw new DogrulamaHatasi(['Güvenlik payı 0 ile 1.000 adet arasında olmalı.']);
      if (metin && (!baslangic || Date.parse(baslangic) > Date.now())) throw new DogrulamaHatasi(['Stok başlangıcı için geçmiş veya güncel bir tarih ve saat girin.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        if (!k.sonAktarim && baslangic) k.stokBaslangic = baslangic;
        k.guvenlikPayi = Number(guvenlikPayi);
      });
    } else if (eylem === 'stok-islemini-kapat') {
      if (f.get('dogrulandi') !== 'on') throw new DogrulamaHatasi(['Önce satıcı panelindeki işlem ve ilan adetlerini doğrulayın.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        const p = k.bekleyenStok;
        if (!p || !senkronZamani(p) || p.tarih !== f.get('bekleyenTarih') || p.id !== f.get('bekleyenId')) {
          throw new DogrulamaHatasi(['Bekleyen işlem değişti. Sayfayı yenileyip yeniden kontrol edin.']);
        }
        for (const kalem of p.kalemler) {
          const ilan = k.urunler[kalem.urunId];
          if (ilan?.kod === kalem.kod) ilan.sonHedef = Math.max(ilan.sonHedef ?? 0, kalem.stok);
        }
        delete k.bekleyenStok;
        k.sonStokHata = 'Satıcı paneli kontrolü sonrasında önceki stok işlemi kapatıldı. Yeni kanal okuması bekleniyor.';
      });
    } else if (eylem === 'urun-ayari') {
      const urunId = String(f.get('urunId') ?? '');
      const kod = String(f.get('kod') ?? '').trim();
      const satista = f.get('satista') === 'on';
      if (!urunler.some((u) => u.id === urunId) || kod.length > 120) throw new DogrulamaHatasi(['Ürün veya pazaryeri ilan kodu geçersiz.']);
      await envanterAyarlariGuncelle((a) => {
        const k = a.kanallar[kanal];
        if (k.bekleyenStok) throw new DogrulamaHatasi(['Kanalın stok güncellemesi onaylanınca ürün kodunu düzenleyebilirsiniz.']);
        if (!kod && k.urunler[urunId]?.kod) throw new DogrulamaHatasi(['Kayıtlı ilanı sıfıra çekmek için kodunu koruyup “Satışa açık” seçimini kaldırın.']);
        if (!kod) throw new DogrulamaHatasi(['Satıcı panelindeki ilan kodunu girin.']);
        if (Object.entries(k.urunler).some(([id, u]) => id !== urunId && u.kod === kod)) {
          throw new DogrulamaHatasi(['Bu ilan kodu kanaldaki başka bir ürüne bağlı.']);
        }
        const onceki = k.urunler[urunId];
        if (onceki?.kod && onceki.kod !== kod && (onceki.bildirilen ?? 0) > 0) {
          throw new DogrulamaHatasi(['İlan kodunu değiştirmeden önce mevcut ilanı satışa kapatın ve stok onayını bekleyin.']);
        }
        k.urunler[urunId] = onceki?.kod === kod ? { ...onceki, kod, satista } : { kod, satista };
      });
      return Astro.redirect(`${yol}?ok=ayar&eslestirme=${kanal}#${kanal}-${encodeURIComponent(urunId)}`, 303);
    } else throw new DogrulamaHatasi(['Geçersiz işlem.']);
    return Astro.redirect(`${yol}?ok=ayar#${kanal}`, 303);
  } catch (e) {
    hatalar.push(...(e instanceof DogrulamaHatasi ? e.hatalar : ['Kanal işlemi tamamlanamadı. Bağlantıyı kontrol edip tekrar deneyin.']));
    ayar = await envanterAyarlariOku().catch(() => ayar);
  }
}
const [web, hareketler] = await Promise.all([
  siparisleriOku(true).catch(() => {
    hatalar.push('Web rezervasyonları okunamadı. Yayın hedefleri geçici olarak gizlendi.');
    return undefined;
  }),
  stokHareketleriOku(undefined, 30).catch(() => {
    if (depoHazir) hatalar.push('Stok hareketleri okunamadı.');
    return [];
  }),
]);
const ayrilan = web && webAyrilanAdetleri(web, Date.now(), magaza.paytrStokIslemleri);
const urunAdlari = new Map(urunler.map((u) => [u.id, u.kisaAd]));
const yerelSaat = (t?: string) => t ? new Date(Date.parse(t) + 3 * 3600e3).toISOString().slice(0, 16) : '';
const zaman = (t?: string) => t ? yTarih.format(new Date(t)) : 'Henüz yok';
const basari = ok === 'senkron' ? 'Siparişler güncellendi.' : ok === 'bekliyor' ? 'Güncelleme zaten çalışıyor, birazdan tekrar bakın.' : ok === 'ayar' ? 'Kaydedildi.' : undefined;

const API_YARDIM = {
  trendyol: 'Trendyol satıcı panelinde Hesap Bilgilerim → Entegrasyon Bilgileri bölümüne gidin. Satıcı ID, API Key ve API Secret değerlerini Vercel ortam ayarlarına girin.',
  hepsiburada: 'Hepsiburada satıcı panelinden kendi yazılımınız için entegrasyon erişimi isteyin. Canlı Merchant ID, kullanıcı adı, parola ve User-Agent değerlerini Vercel ortam ayarlarına girin.',
};
const KOD_YARDIM = {
  trendyol: 'Trendyol’da ürünü eklerken yazdığınız “Barkod”. Çoğu üründe kutunun üzerindeki çizgili kodun altındaki 13 haneli sayıdır (EAN). Trendyol satıcı panelinde Ürünler listesinde de görünür.',
  hepsiburada: 'Hepsiburada’ya ürünü yüklerken verdiğiniz “Satıcı stok kodu” (merchantSku). Kendi belirlediğiniz koddur; çoğu satıcı model kodunu kullanır.',
};
const zamanlayiciAnahtariVar = (pazaryeriOrtam('CRON_SECRET')?.length ?? 0) >= 32;
const otomatikYazma = otomatikStokYazmaAcik();
const simdi = Date.now();
---
<Yonetim baslik="Satış kanalları" altBaslik="Trendyol ve Hepsiburada siparişlerini ve ortak stoğu yönetin." aktif="siparisler" {basari} {hatalar}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/siparisler">Siparişlere dön</a>
    {depoHazir && ayarliKanal && <form method="post"><button class="btn btn--sepet" name="eylem" value="senkron" type="submit">Şimdi eşitle</button></form>}
  </div>

  {!depoHazir && <p class="y-uyari-satir" role="status">Kanal ayarları kullanılamıyor. Veritabanı bağlantısını ve pazaryeri tablolarını kontrol edin.</p>}

  <div class="kanal-izgara">
  {KANAL_LISTESI.map((kanal) => {
    const k = ayar.kanallar[kanal];
    const api = pazaryeriApiDurumu(kanal);
    const apiHazir = api === 'canli' || api === 'test';
    const eslesen = Object.values(k.urunler).filter((u) => u.kod).length;
    const otomatikGecikti = k.sonOtomatikApi && simdi - Date.parse(k.sonOtomatikApi) > 30 * 60_000;
    const otomatikDurum = !apiHazir || !k.stokBaslangic ? 'Kurulum bekliyor' : !zamanlayiciAnahtariVar ? 'Kapalı'
      : !k.sonOtomatikApi ? 'İlk çalışma bekleniyor' : otomatikGecikti ? 'Gecikiyor' : 'Çalışıyor';
    const stokDurumu = !apiHazir || !k.stokBaslangic ? 'Kurulum bekliyor' : !otomatikYazma ? 'Elle'
      : k.bekleyenStok ? 'Kanal onayı bekleniyor' : eslesen === 0 ? 'İlan eşleştirmesi bekliyor' : 'Otomatik';
    return <section class:list={['y-kart', 'kanal', 'kanal--' + kanal]} id={kanal}>
      <div class="y-kart__bas">
        <h2>{KANALLAR[kanal]}</h2>
        <a class="y-link" href={panel[kanal]} target="_blank" rel="noopener noreferrer">Satıcı paneli ↗</a>
      </div>
      <dl class="kanal-durum">
        <div><dt>Mağaza bağlantısı</dt><dd>{baglantiAdi[api]}</dd></div>
        <div><dt>Otomatik eşitleme</dt><dd class:list={{ 'y-uyari-kucuk': otomatikGecikti }}>{otomatikDurum}</dd></div>
        <div><dt>Son otomatik çekim</dt><dd>{zaman(k.sonOtomatikApi)}</dd></div>
        <div><dt>Son başarılı çekim</dt><dd>{zaman(k.sonApi)}</dd></div>
        <div><dt>Stok gönderimi</dt><dd>{stokDurumu}</dd></div>
      </dl>

      {kanal === 'trendyol' && apiHazir && <p class="kanal-kisayol">
        <a class="btn btn--sepet" href="/yonetim/siparisler/trendyol-urunler">Trendyol’a ürün gönder</a>
        <a class="btn btn--cizgi" href="/yonetim/siparisler/trendyol-iade-soru">İadeler</a>
        <a class="btn btn--cizgi" href="/yonetim/finans/faturalar?kanal=trendyol">Faturalar</a>
        <span class="y-help">{Object.values(k.ilanlar).filter((x) => x.durum === 'onaylandi').length} ilan API ile açıldı · fiyat kuralı {k.fiyatKurali.yuzde ? '%' + k.fiyatKurali.yuzde.toLocaleString('tr-TR') : 'site fiyatı'}</span>
      </p>}
      {k.sonApiHata && <p class="y-uyari-satir" role="alert">Siparişler alınamadı: {k.sonApiHata}</p>}
      {k.sonStokHata && <p class="y-uyari-satir" role="alert">Stok gönderilemedi: {k.sonStokHata}</p>}
      {otomatikGecikti && apiHazir && zamanlayiciAnahtariVar && !k.sonApiHata && <p class="y-uyari-satir" role="status">30 dakikadır başarılı otomatik çekim yok. Gerekirse “Şimdi eşitle”yi kullanın.</p>}
      {k.sonAktarimOzet && <p class="y-help">Son aktarım · {k.sonAktarimOzet}</p>}
      {!apiHazir && <details class="kanal-bolum" open>
        <summary>Mağazayı bağlama</summary>
        <p>{API_YARDIM[kanal]}</p>
      </details>}

      {depoHazir && k.bekleyenStok && senkronZamani(k.bekleyenStok) && <details class="kanal-bolum">
        <summary>Bekleyen stok işlemini çöz</summary>
        <form method="post" class="kanal-kurtarma">
          <input type="hidden" name="kanal" value={kanal} />
          <input type="hidden" name="bekleyenId" value={k.bekleyenStok.id} />
          <input type="hidden" name="bekleyenTarih" value={k.bekleyenStok.tarih} />
          <ul>{k.bekleyenStok.kalemler.map((kalem) => <li>{kalem.kod} · Gönderilen hedef {kalem.stok}</li>)}</ul>
          <label><input type="checkbox" name="dogrulandi" required /> Satıcı panelinde ilan adetlerini kontrol ettim ve bu isteğin artık beklemediğini doğruladım.</label>
          <button class="btn btn--cizgi" type="submit" name="eylem" value="stok-islemini-kapat">Önceki işlemi kapat</button>
        </form>
      </details>}

      <details class="kanal-bolum" open={!k.stokBaslangic && apiHazir && depoHazir}>
        <summary>Başlangıç sayımı ve güvenlik payı</summary>
        <form method="post" class="kanal-form">
          <input type="hidden" name="kanal" value={kanal} />
          <label class="y-alan">Sayımı bitirdiğiniz gün ve saat
            <input type="datetime-local" name="stokBaslangic" value={yerelSaat(k.stokBaslangic)} disabled={!depoHazir || Boolean(k.sonAktarim)} />
            <small>Türkiye saati. İlk aktarımdan sonra kilitlenir. Yalnız bu andan sonraki siparişler stoğu etkiler.</small>
          </label>
          <label class="y-alan">Güvenlik payı (adet)
            <input type="number" name="guvenlikPayi" min="0" max="1000" value={k.guvenlikPayi} required disabled={!depoHazir} inputmode="numeric" />
            <small>Kanalda satışa açılan stoktan ayrılan adet.</small>
          </label>
          <button class="btn btn--cizgi" type="submit" name="eylem" value="kanal-ayari" disabled={!depoHazir}>Kaydet</button>
        </form>
      </details>

      <details class="kanal-bolum" open={duzenlenenKanal === kanal} data-eslestirmeler>
        <summary>Ürün eşleştirmeleri ({eslesen} bağlı)</summary>
        <p class="y-help">{KOD_YARDIM[kanal]}</p>
        {urunler.length > 0 && <label class="y-alan kanal-ara" hidden>Ürün veya ilan kodu ara
          <input type="search" data-eslestirme-ara />
        </label>}
        <p class="y-help" role="status" data-eslestirme-bos hidden>Aramanıza uyan ürün yok.</p>
        <div>
          {urunler.map((u) => {
            const eslesme = k.urunler[u.id];
            const hedef = ayrilan && kanalHedefStok(Math.max(0, u.stok - (ayrilan.get(u.id) ?? 0)), k);
            const oneri = kanal === 'trendyol' ? urunGtin(u) : u.sku || undefined;
            return <form method="post" id={`${kanal}-${u.id}`} class:list={['kanal-urun', { 'is-bagli': eslesme?.kod }]} data-eslestirme-urun={`${u.marka} ${u.ad} ${u.sku} ${oneri ?? ''} ${eslesme?.kod ?? ''}`}>
              <input type="hidden" name="kanal" value={kanal} />
              <input type="hidden" name="urunId" value={u.id} />
              <div class="kanal-urun__ad">
                <strong>{u.marka} {u.kisaAd}</strong>
                <small>{eslesme?.kod ? 'Bağlı' : 'Bağlı değil'} · Depo {u.stok}{eslesme?.kod && hedef !== undefined ? ` · Hedef ${eslesme.satista ? hedef : 0}` : ''}{eslesme?.bildirilen !== undefined ? ` · Kanalda ${eslesme.bildirilen}` : ''}</small>
              </div>
              <label class="y-alan">{kanal === 'trendyol' ? 'Barkod' : 'Satıcı stok kodu'}
                <input name="kod" value={eslesme?.kod ?? ''} placeholder={oneri} maxlength="120" required disabled={!depoHazir || Boolean(k.bekleyenStok)} autocomplete="off" />
              </label>
              <label class="kanal-onay"><input type="checkbox" name="satista" checked={eslesme?.satista ?? true} disabled={!depoHazir || Boolean(k.bekleyenStok)} /> Satışa açık</label>
              <button class="btn btn--cizgi" type="submit" name="eylem" value="urun-ayari" disabled={!depoHazir || Boolean(k.bekleyenStok)}>Kaydet</button>
            </form>;
          })}
          {!urunler.length && <p>Katalogda ürün yok.</p>}
        </div>
      </details>

    </section>;
  })}
  </div>

  <details class="y-kart kanal-bolum" id="hareketler">
    <summary>Son stok hareketleri</summary>
    {hareketler.length > 0 ? <ul class="kanal-hareketler">
      {hareketler.map((h) => <li><time datetime={h.tarih}>{zaman(h.tarih)}</time><strong>{urunAdlari.get(h.urunId) ?? h.urunId}</strong><span>{h.onceki} → {h.sonraki}</span><span>{stokSebebi(h.sebep)}</span></li>)}
    </ul> : <p>Henüz stok hareketi yok.</p>}
  </details>
</Yonetim>

<script>
  for (const bolum of document.querySelectorAll('[data-eslestirmeler]')) {
    const ara = bolum.querySelector<HTMLInputElement>('[data-eslestirme-ara]');
    const bos = bolum.querySelector<HTMLElement>('[data-eslestirme-bos]');
    if (!ara || !bos) continue;
    ara.closest('label')!.hidden = false;
    const satirlar = [...bolum.querySelectorAll<HTMLElement>('[data-eslestirme-urun]')];
    ara.addEventListener('input', () => {
      const sorgu = ara.value.trim().toLocaleLowerCase('tr');
      for (const satir of satirlar) {
        satir.hidden = !satir.dataset.eslestirmeUrun!.toLocaleLowerCase('tr').includes(sorgu);
      }
      bos.hidden = satirlar.some((satir) => !satir.hidden);
    });
  }
</script>

<style>
  .kanal-izgara { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 390px), 1fr)); gap: 14px; align-items: start; margin-bottom: 14px; }
  .kanal { margin: 0; scroll-margin: 5rem; border-top: 4px solid #f27a1a; }
  .kanal--hepsiburada { border-top-color: #6b4fbb; }
  .kanal h2 { font-size: 18px; }
  .kanal-bolum { border-top: 1px solid var(--y-border); }
  .kanal-bolum > summary { cursor: pointer; padding-block: .8rem; font-weight: 700; min-height: 44px; }
  .kanal-bolum > p { margin-bottom: .8rem; }
  .kanal-durum, .kanal-form, .kanal-urun, .kanal-hareketler li { display: grid; gap: .8rem; }
  .kanal-durum { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-block: 0 1rem; padding: 12px; background: var(--y-bg); border-radius: 8px; }
  .kanal-durum dt, .kanal-form small, .kanal-urun small, .kanal-hareketler time { color: var(--ink-3); font-size: .85rem; }
  .kanal-durum dd { margin: .25rem 0 0; font-weight: 650; }
  .kanal-form { grid-template-columns: minmax(0, 1fr); align-items: start; padding-bottom: 1rem; }
  .kanal-form .btn { justify-self: start; }
  .kanal-urun { grid-template-columns: minmax(0, 1fr) auto auto; align-items: end; padding-block: .75rem; border-bottom: 1px solid var(--y-border); scroll-margin-top: 5rem; }
  .kanal-urun:target { outline: 2px solid var(--y-gold); outline-offset: 4px; }
  .kanal-ara[hidden], .kanal-urun[hidden], [data-eslestirme-bos][hidden] { display: none; }
  .kanal-urun__ad { grid-column: 1 / -1; }
  .kanal-urun.is-bagli .kanal-urun__ad small:first-of-type { color: #0a7f3f; }
  .kanal-urun small { display: block; margin-top: .25rem; }
  .kanal-onay { white-space: nowrap; padding-block: .55rem; display: inline-flex; gap: 6px; align-items: center; min-height: 44px; }
  .kanal-hareketler { list-style: none; padding: 0; margin: 0; }
  .kanal-hareketler li { grid-template-columns: minmax(0, 9rem) minmax(0, 1.5fr) 4rem minmax(0, 1.5fr); padding-block: .6rem; border-top: 1px solid var(--y-border); }
  .kanal-kisayol { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 0 0 1rem; }
  .kanal-kurtarma { display: grid; justify-items: start; gap: .7rem; padding-bottom: 1rem; }
  @media (max-width: 700px) {
    .kanal-urun { grid-template-columns: minmax(0, 1fr) auto; }
    .kanal-urun .y-alan { grid-column: 1 / -1; }
    .kanal-hareketler li { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
</style>
