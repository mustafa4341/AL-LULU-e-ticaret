  .sayfa-alt { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin: 10px 0; }
  .sayfa-alt .y-help { margin: 0; }
  .siparis-kanal-uyari { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 14px; background: var(--y-turuncu-zemin); color: var(--y-turuncu); border-color: #efd5a4; }
  .siparis-kanal-uyari > span { flex: 1 1 280px; }

  @media (min-width: 1100px) {
    .sm-calisma-duzeni:has([data-panel-kayit]:not([hidden])) {
