---
import Yonetim from '../../../layouts/Yonetim.astro';
import Ikon from '../../../components/Ikon.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import SiparisCalismaPaneli from '../../../components/yonetim/SiparisCalismaPaneli.astro';
import type { PanelIkonAdi } from '../../../components/yonetim/panelIkon';
import { magazaOku, siparisleriOku, webAyrilanAdetleri } from '../../../lib/depo';
import { BELGE_TURLERI, finansGunu, gecerliGun } from '../../../lib/finans';
import { finansOku } from '../../../lib/finansDepo';
import { KANALLAR, KANAL_LISTESI, kanalMi, kurusTL } from '../../../lib/pazaryeri';
import { pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { envanterAyarlariOku, pazaryeriSiparisleriOku } from '../../../lib/pazaryeriDepo';
import {
  siparisMerkeziOlustur,
  siparisSekmesiCoz,
  siparisSekmeyeUyar,
  type SiparisSekmesi,
} from '../../../lib/siparisMerkezi';
import { yTarih } from '../../../lib/yonetimRapor';

/* Adres boşsa son seçilen kanal ve sıralama çerezden okunur; varsayılan sekme her zaman "İşlem Bekleyen"dir. */
const cerezSorgusu = !Astro.url.search ? (Astro.cookies.get('y-filtre-siparis')?.value ?? '').slice(0, 300) : Astro.url.search;
const p = new URLSearchParams(cerezSorgusu);
const q = (p.get('q') ?? '').trim();
const sira = p.get('sira') ?? 'oncelik';
const bas = p.get('baslangic') ?? '';
const son = p.get('bitis') ?? '';
const secilenKanal = p.get('kanal');
const kanal = secilenKanal === 'web' || kanalMi(secilenKanal) ? secilenKanal : 'tumu';
const secParam = Astro.url.searchParams.get('sec') ?? '';
const hizliParam = Astro.url.searchParams.get('hizli');

const [webSiparisleri, finans, magaza, pazaryeri, envanter] = await Promise.all([
  siparisleriOku(),
  finansOku(),
  magazaOku(),
  pazaryeriSiparisleriOku().catch(() => undefined),
  envanterAyarlariOku().catch(() => undefined),
]);

const simdi = Date.now();
const ayrilan = webAyrilanAdetleri(webSiparisleri, simdi, magaza.paytrStokIslemleri);
const urunSecenekleri = [...magaza.urunler].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr'));
const kullanilabilirStok = (u: { id: string; stok: number }) => Math.max(0, u.stok - (ayrilan.get(u.id) ?? 0));

const sorunluKanallar = envanter ? KANAL_LISTESI.filter((k) => {
  const a = envanter.kanallar[k];
  return a.sonApiHata || a.sonStokHata || (pazaryeriApiDurumu(k) === 'canli' && a.stokBaslangic && (!a.sonOtomatikApi || simdi - Date.parse(a.sonOtomatikApi) > 30 * 60_000));
}) : [];

const tumKayitlar = siparisMerkeziOlustur({
  webSiparisleri,
  pazaryeriSiparisleri: pazaryeri ?? [],
  magaza,
  finans,
  envanter,
  simdi,
});

/* Barkod okuyucu / sipariş numarası ile doğrudan çalışma panelinde açma */
const numaraCoz = (v: string) => {
  const m = /^(?:AL)?(\d{6})-?(\d{4})$/.exec(v.toUpperCase().replace(/[\s#]/g, ''));
  return m ? `AL${m[1]}-${m[2]}` : undefined;
};
const tarama = p.get('tara') === '1';
let taramaUyarisi = 'Bu numarayla eşleşen sipariş bulunamadı.';
if (tarama && q) {
  const webNo = numaraCoz(q);
  const eslesenWeb = webNo && tumKayitlar.find((x) => x.kanal === 'web' && x.no === webNo);
  if (eslesenWeb) {
    return Astro.redirect(`/yonetim/siparisler?durum=tumu&sec=${encodeURIComponent(eslesenWeb.anahtar)}`, 303);
  }
  const eslesenPy = tumKayitlar.filter((x) => x.kanal !== 'web' && [x.no, x.paketNo, x.kargo.takipNo].includes(q));
  if (eslesenPy.length === 1) {
    return Astro.redirect(`/yonetim/siparisler?durum=tumu&sec=${encodeURIComponent(eslesenPy[0]!.anahtar)}`, 303);
  }
  if (eslesenPy.length > 1) taramaUyarisi = 'Bu numara birden çok paketle eşleşiyor; listeden paketi seçin.';
  else if (!pazaryeri) taramaUyarisi = 'Web siparişi bulunamadı ve pazaryeri siparişleri okunamadı.';
}

const acikDurumParam = Astro.url.searchParams.get('durum') ?? p.get('durum');
const sekme: SiparisSekmesi = acikDurumParam ? siparisSekmesiCoz(acikDurumParam) : (q ? 'tumu' : 'islem');

const aranan = q.toLocaleLowerCase('tr-TR');
const rakam = /^(?:al)?[\s()+#\d-]+$/.test(aranan) ? aranan.replace(/\D/g, '') : '';
const basGecerli = gecerliGun(bas);
const sonGecerli = gecerliGun(son);

const kanalVeAramaUygun = tumKayitlar.filter((k) => {
  if (kanal !== 'tumu' && k.kanal !== kanal) return false;
  const gun = finansGunu(new Date(k.tarih));
  if ((basGecerli && gun < bas) || (sonGecerli && gun > son)) return false;
  if (!aranan) return true;
  if (k.aramaMetni.includes(aranan)) return true;
  return rakam.length >= 4 && k.aramaMetni.replace(/\D/g, '').includes(rakam);
});

const ANA_SEKMELER: { id: SiparisSekmesi; ad: string; ikon: PanelIkonAdi }[] = [
  { id: 'islem', ad: 'İşlem Bekleyen', ikon: 'simsek' },
  { id: 'hazirlanacak', ad: 'Hazırlanacak', ikon: 'kutu' },
  { id: 'hazirlaniyor', ad: 'Hazırlanıyor', ikon: 'saat' },
  { id: 'kargoya-hazir', ad: 'Kargoya Hazır', ikon: 'yazici' },
  { id: 'kargoda', ad: 'Kargoda', ikon: 'kargo' },
  { id: 'tamamlandi', ad: 'Tamamlandı', ikon: 'tik-daire' },
];

const DIGER_SEKMELER: { id: SiparisSekmesi; ad: string }[] = [
  { id: 'kontrol', ad: 'Kontrol / Sorunlu' },
  { id: 'faturasiz', ad: 'Faturası Bekleyen (1-2/3)' },
  { id: 'odeme-bekleyen', ad: 'Ödeme / Onay Bekleyen' },
  { id: 'iptal', ad: 'İptal / İade' },
  { id: 'tumu', ad: 'Tüm Siparişler (Test Dahil)' },
];

const tumSekmeTanimlari = [...ANA_SEKMELER, ...DIGER_SEKMELER];
const sayilar = Object.fromEntries(
  tumSekmeTanimlari.map((t) => [t.id, kanalVeAramaUygun.filter((s) => siparisSekmeyeUyar(s, t.id)).length]),
) as Record<SiparisSekmesi, number>;

const seciliDigerSekme = DIGER_SEKMELER.find((d) => d.id === sekme);

const filtrelenmis = kanalVeAramaUygun.filter((s) => siparisSekmeyeUyar(s, sekme));
if (secParam && !filtrelenmis.some((x) => x.anahtar === secParam)) {
  const seciliKayit = tumKayitlar.find((x) => x.anahtar === secParam);
  if (seciliKayit) filtrelenmis.unshift(seciliKayit);
}

filtrelenmis.sort((a, b) => {
  if (secParam && a.anahtar === secParam) return -1;
  if (secParam && b.anahtar === secParam) return 1;
  if (sira === 'tutar') return b.tutarKurus - a.tutarKurus || b.zamanMs - a.zamanMs;
  if (sira === 'eski') return a.zamanMs - b.zamanMs;
  if (sira === 'son-kargo') {
    const aSon = a.kargo.kalanSaat ?? Number.POSITIVE_INFINITY;
    const bSon = b.kargo.kalanSaat ?? Number.POSITIVE_INFINITY;
    if (aSon !== bSon) return aSon - bSon;
  }
  if (sira === 'oncelik' && sekme === 'islem' && a.oncelikPuani !== b.oncelikPuani) {
    return b.oncelikPuani - a.oncelikPuani;
  }
  return b.zamanMs - a.zamanMs;
});

const SAYFA_BOYUTU = 30;
const sonSayfa = Math.max(1, Math.ceil(filtrelenmis.length / SAYFA_BOYUTU));
const istenenSayfa = Number(p.get('sayfa'));
const sayfa = Number.isSafeInteger(istenenSayfa) ? Math.max(1, Math.min(sonSayfa, istenenSayfa)) : 1;
const ilkSatir = (sayfa - 1) * SAYFA_BOYUTU;
const gorunen = filtrelenmis.slice(ilkSatir, ilkSatir + SAYFA_BOYUTU);
const webSecilebilir = gorunen.some((s) => s.kanal === 'web' && !s.entegrasyon.testSiparisi);

const filtreAdresi = (hedefSekme: string, tarihler = true) =>
  '/yonetim/siparisler?' + new URLSearchParams({
    durum: hedefSekme,
    ...(kanal !== 'tumu' ? { kanal } : {}),
    ...(q ? { q } : {}),
    ...(tarihler && bas ? { baslangic: bas } : {}),
    ...(tarihler && son ? { bitis: son } : {}),
    ...(sira !== 'oncelik' ? { sira } : {}),
  }).toString();

const sayfaBazAdresi = filtreAdresi(sekme) + (sayfa > 1 ? `&sayfa=${sayfa}` : '');
const tarihAcik = Boolean(bas || son);

const acikIndeks = secParam
  ? gorunen.findIndex((x) => x.anahtar === secParam)
  : hizliParam !== null && /^\d+$/.test(hizliParam)
    ? Number(hizliParam)
    : -1;
---

<Yonetim
  baslik="Sipariş Kuyruğu ve Operasyon"
  altBaslik="Web sitesi, Trendyol ve Hepsiburada siparişlerini tek ekrandan hazırlayın, barkodlu kargo fişini yazdırın ve faturasını tamamlayın."
  aktif="siparisler"
  basari={Astro.url.searchParams.get('ok')}
  hatalar={Astro.url.searchParams.get('hata') ? [Astro.url.searchParams.get('hata')!] : []}
  genis
>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a href="/yonetim/siparisler/hazirlik" class="btn btn--cizgi"><PIkon ad="barkod" boyut={17} />Barkodlu Toplu Hazırlık</a>
    <a href="/yonetim/finans/faturalar" class="btn btn--cizgi"><PIkon ad="fatura" boyut={17} />Faturalar{sayilar.faturasiz > 0 ? ` (${sayilar.faturasiz})` : ''}</a>
    <button type="button" class="btn btn--sepet" data-y-dialog="barkod-oku"><PIkon ad="buyutec" boyut={17} />Barkod / No ile Aç</button>
  </div>

  <dialog class="y-modal" id="barkod-oku" data-hata-ac={tarama ? '1' : undefined} aria-labelledby="barkod-baslik">
    <div class="y-modal__bas">
      <strong id="barkod-baslik">Siparişi Doğrudan Aç</strong>
      <form method="dialog"><button class="y-icon-button" aria-label="Kapat"><Ikon ad="kapat" boyut={18} /></button></form>
    </div>
    <form method="get" class="y-izgara">
      <input type="hidden" name="tara" value="1" />
      <label class="y-alan">Barkodu okutun veya sipariş / paket / takip numarasını yazın
        <input name="q" placeholder="Örn: AL202611-0001 veya kargo takip no" required autocomplete="off" autocapitalize="characters" value={tarama ? q : ''} />
      </label>
      {tarama && <p class="y-uyari" role="status">{taramaUyarisi}</p>}
      <p class="y-help">Sipariş çalışma paneli doğrudan açılır; sayfadan ayrılmadan işlem yapabilirsiniz.</p>
      <button class="btn btn--sepet">Siparişi Aç</button>
    </form>
  </dialog>

  {/* SAYFA BAŞI ÖZET KARTLARI */}
  <div class="y-metrics y-metrics--finans">
    <a class:list={['y-metric', sayilar.islem > 0 ? 'y-metric--turuncu' : 'y-metric--yesil']} href={filtreAdresi('islem')}>
      <PIkon ad="simsek" />
      <span>İşlem Bekleyen Sipariş</span>
      <strong>{sayilar.islem}</strong>
      <small>{sayilar.hazirlanacak} hazırlanacak · {sayilar.kontrol > 0 ? `${sayilar.kontrol} kontrol bekliyor` : 'sorunlu kayıt yok'}</small>
    </a>
    <a class:list={['y-metric', sayilar['kargoya-hazir'] > 0 ? 'y-metric--altin' : '']} href={filtreAdresi('kargoya-hazir')}>
      <PIkon ad="yazici" />
      <span>Etiket &amp; Kargoya Hazır</span>
      <strong>{sayilar['kargoya-hazir']}</strong>
      <small>Barkodlu kargo fişi basılıp şubeye verilecek</small>
    </a>
    <a class:list={['y-metric', sayilar.faturasiz > 0 ? 'y-metric--kirmizi' : 'y-metric--yesil']} href={filtreAdresi('faturasiz')}>
      <PIkon ad="fatura" />
      <span>Faturası Bekleyen</span>
      <strong>{sayilar.faturasiz}</strong>
      <small>GİB e-Arşiv kesilecek veya kanala iletilecek</small>
    </a>
    <a class="y-metric y-metric--mavi" href={filtreAdresi('kargoda')}>
      <PIkon ad="kargo" />
      <span>Kargoda / Yolda</span>
      <strong>{sayilar.kargoda}</strong>
      <small>Teslim tamamlanan: {sayilar.tamamlandi} sipariş</small>
    </a>
  </div>

  {!pazaryeri && (
    <p class="y-uyari-satir" role="alert">
      <Ikon ad="kalkan" boyut={16} />
      <span>Pazaryeri siparişleri şu an okunamadı; yalnız Web siparişleri listeleniyor. <a class="y-link" href="/yonetim/siparisler/kanallar">Satış kanallarını kontrol edin</a></span>
    </p>
  )}
  {pazaryeri && sorunluKanallar.length > 0 && (
    <div class="y-uyari-satir uyari--turuncu siparis-kanal-uyari" role="status">
      <PIkon ad="uyari" boyut={18} />
      <span>
        <strong>{sorunluKanallar.map((k) => KANALLAR[k]).join(' ve ')} eşitlemesinde uyarı var.</strong> Sipariş veya stok senkronizasyonunu kontrol edin.
      </span>
      <a class="btn btn--cizgi btn--kucuk" href={'/yonetim/siparisler/kanallar#' + sorunluKanallar[0]}>Kanal Durumu →</a>
    </div>
  )}

  {/* 1. 6 ANA AŞAMA ÇUBUĞU + DİĞER GÖRÜNÜMLER */}
  <div class="sm-sekme-cubugu">
    <nav class="y-filtreler sm-ana-sekmeler" aria-label="Sipariş aşamaları">
      {ANA_SEKMELER.map((t) => (
        <a href={filtreAdresi(t.id)} aria-current={sekme === t.id ? 'page' : undefined} class={'y-filtre--' + t.id}>
          <PIkon ad={t.ikon} boyut={17} />
          <span>{t.ad}</span>
          {sayilar[t.id] > 0 && <b>{sayilar[t.id]}</b>}
        </a>
      ))}
    </nav>

    <details class:list={['sm-diger-menu', { 'is-secili': Boolean(seciliDigerSekme) }]}>
      <summary class="btn btn--cizgi btn--kucuk">
        <PIkon ad={seciliDigerSekme ? 'uyari' : 'liste'} boyut={16} />
        <span>{seciliDigerSekme ? seciliDigerSekme.ad : 'Diğer Görünümler'}</span>
        {(sayilar.kontrol > 0 && !seciliDigerSekme) && <b class="sm-diger-uyari">{sayilar.kontrol}</b>}
        <PIkon ad="asagi" boyut={14} />
      </summary>
      <div class="sm-diger-liste" role="menu">
        {DIGER_SEKMELER.map((d) => (
          <a href={filtreAdresi(d.id)} role="menuitem" aria-current={sekme === d.id ? 'page' : undefined}>
            <span>{d.ad}</span>
            <b>{sayilar[d.id]}</b>
          </a>
        ))}
      </div>
    </details>
  </div>

  {/* 2. TEK SATIR ARAMA VE KANAL ÇUBUĞU */}
  <form class="y-toolbar sm-toolbar" method="get" data-filtre-form="siparis">
    <input type="hidden" name="durum" value={sekme} />
    <input class="y-girdi" name="q" type="search" value={q} placeholder="Sipariş no, müşteri, telefon, ürün, barkod veya takip no…" aria-label="Sipariş ara" />
    <select class="y-girdi" name="kanal" aria-label="Satış kanalı">
      <option value="tumu" selected={kanal === 'tumu'}>Tüm Kanallar</option>
      <option value="web" selected={kanal === 'web'}>Web Sitesi</option>
      {Object.entries(KANALLAR).map(([id, ad]) => <option value={id} selected={kanal === id}>{ad}</option>)}
    </select>
    <select class="y-girdi" name="sira" aria-label="Sıralama">
      <option value="oncelik" selected={sira === 'oncelik'}>Önceliğe Göre (Önerilen)</option>
      <option value="yeni" selected={sira === 'yeni'}>En Yeni Sipariş</option>
      <option value="son-kargo" selected={sira === 'son-kargo'}>Son Kargo Süresine Göre</option>
      <option value="tutar" selected={sira === 'tutar'}>En Yüksek Tutar</option>
      <option value="eski" selected={sira === 'eski'}>En Eski Sipariş</option>
    </select>
    <details class="y-tarih" open={tarihAcik}>
      <summary class="btn btn--cizgi">{tarihAcik ? `${bas || '…'} – ${son || '…'}` : 'Tarih'}</summary>
      <div>
        <label class="y-alan">Başlangıç<input name="baslangic" type="date" value={bas} /></label>
        <label class="y-alan">Bitiş<input name="bitis" type="date" value={son} /></label>
        {tarihAcik && <a class="y-link" href={filtreAdresi(sekme, false)}>Temizle</a>}
      </div>
    </details>
    <button class="btn btn--cizgi" type="submit">Uygula</button>
  </form>

  {/* 3. FERAH SİPARİŞ TABLOSU + SAĞ ÇALIŞMA PANELİ */}
  {gorunen.length > 0 ? (
    <>
      <div class="y-liste-detay sm-calisma-duzeni" data-panel-secim>
        <div class="y-liste-ana">
          <div class="y-tablo-kap y-tablo-kap--kart sm-tablo-kap">
            <table class="y-tablo y-siparis-tablo sm-tablo">
              <thead>
                <tr class="sm-grup-baslik">
                  <th class="y-sec"></th>
                  <th>Sipariş ve Kanal</th>
                  <th class="sm-bolge-urun">Ürün ve Alıcı</th>
                  <th class="sm-bolge-kar">Satış ve Net Kazanç</th>
                  <th class="sm-bolge-asama sm-gizle-acikken">Aşama ve Bekleyen İşler</th>
                  <th class="sm-bolge-islem sm-gizle-acikken">Sıradaki İşlem</th>
                </tr>
                <tr>
                  <th class="y-sec">
                    {webSecilebilir && (
                      <label class="y-siparis-sec-kutusu">
                        <input type="checkbox" data-y-tumu aria-label="Görünen web siparişlerinin tümünü seç" />
                      </label>
                    )}
                  </th>
                  <th>Sipariş No &amp; Tarih</th>
                  <th class="sm-bolge-urun">Sipariş İçeriği &amp; Müşteri</th>
                  <th class="y-sayi sm-bolge-kar">Tutar &amp; Net Kâr</th>
                  <th class="sm-bolge-asama sm-gizle-acikken">Durum &amp; Eksikler</th>
                  <th class="y-sayi sm-bolge-islem sm-gizle-acikken">İşlem</th>
                </tr>
              </thead>
              <tbody>
                {gorunen.map((s, i) => {
                  const panelId = 'siparis-hizli-' + i;
                  const seciliMi = i === acikIndeks;
                  const secAdresi = `${sayfaBazAdresi}&sec=${encodeURIComponent(s.anahtar)}`;
                  const tyEtiketHazir = Boolean(
                    s.py && s.py.kanal === 'trendyol' && s.py.kargoTakip
                    && !s.entegrasyon.testSiparisi
                    && !['Cancelled', 'UnSupplied', 'Returned'].includes(s.py.hamDurum),
                  );
                  return (
                    <tr data-satir={s.kanal === 'web' ? s.no : undefined} class:list={{ 'is-inceleme': seciliMi, 'sm-satir--test': s.entegrasyon.testSiparisi }}>
                      <td class="y-sec">
                        {s.kanal === 'web' && !s.entegrasyon.testSiparisi && (
                          <label class="y-siparis-sec-kutusu">
                            <input type="checkbox" name="no" value={s.no} data-y-secim-kutusu aria-label={s.no + ' seç'} />
                          </label>
                        )}
                      </td>

                      <td data-etiket="Sipariş" class="y-siparis-no">
                        <div class="sm-no-ust">
                          <KanalLogo kanal={s.kanal} boyut="kucuk" />
                          <a class="sm-no-link" href={secAdresi} data-astro-prefetch="false" data-panel-sec={panelId}>
                            {s.no}
                          </a>
                          <button type="button" class="y-kopya" data-kopyala={s.no} title="Sipariş numarasını kopyala" aria-label={s.no + ' kopyala'}>
                            <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v10H9zM5 15V5h10" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                          </button>
                        </div>
                        <div class="sm-no-alt">
                          <span>{s.kanalAdi} · {yTarih.format(new Date(s.tarih))}</span>
                          {s.paketNo && s.paketNo !== s.no && <span class="sm-paket-etiket">Pkt {s.paketNo}</span>}
                        </div>
                        {/* Panel açıkken aşama özeti burada kompakt rozet olarak görünür */}
                        <div class="sm-acikken-durum">
                          <span class:list={['y-chip', 'y-chip--' + s.asamaRenk]}>{s.asamaEtiketi}</span>
                          {s.eksikIsler[0] && <span class:list={['y-chip', 'y-chip--' + s.eksikIsler[0].renk]}>{s.eksikIsler[0].etiket}</span>}
                        </div>
                      </td>

                      <td data-etiket="Ürün & Müşteri" class="y-urunler sm-bolge-urun">
                        <a class="sm-urun-kart" href={secAdresi} data-astro-prefetch="false" data-panel-sec={panelId}>
                          <span class="sm-urun-foto">
                            {s.ilkGorsel ? (
                              <img src={s.ilkGorsel} alt="" width="56" height="56" loading="lazy" decoding="async" />
                            ) : (
                              <Ikon ad="kutu" boyut={20} />
                            )}
                          </span>
                          <span class="sm-urun-bilgi">
                            <strong class="sm-urun-ad">{s.kalemOzeti}</strong>
                            <span class="sm-musteri-satir">
                              <PIkon ad="kullanici" boyut={13} />
                              <span>{s.musteriAdi}{s.konum ? ` · ${s.konum}` : ''}</span>
                            </span>
                          </span>
                        </a>
                      </td>

                      <td data-etiket="Tutar & Net Kâr" class:list={['y-sayi', 'sm-bolge-kar', s.kazanc.tahminiNetKar !== undefined ? (s.kazanc.tahminiNetKar < 0 ? 'is-zarar' : 'is-kar') : '']}>
                        <strong class="sm-tutar">{kurusTL(s.tutarKurus)}</strong>
                        {s.kazanc.tahminiNetKar !== undefined ? (
                          <span class:list={['sm-kar-etiket', s.kazanc.tahminiNetKar < 0 ? 'is-zarar' : 'is-kar']}>
                            Net {s.kazanc.tahminiNetKar < 0 ? '−' : '+'}{kurusTL(Math.abs(s.kazanc.tahminiNetKar))}
                          </span>
                        ) : (
                          <small class="sm-not">Maliyet girilmedi</small>
                        )}
                      </td>

                      <td data-etiket="Durum & Eksikler" class="sm-bolge-asama sm-gizle-acikken">
                        <div class="sm-durum-yigin">
                          <span class:list={['y-chip', 'y-chip--' + s.asamaRenk]}>{s.asamaEtiketi}</span>
                          {s.eksikIsler.length > 0 ? (
                            <div class="durum-ozeti">
                              {s.eksikIsler.map((ek) => (
                                <span class:list={['y-chip', 'y-chip--' + ek.renk]}>{ek.etiket}</span>
                              ))}
                            </div>
                          ) : s.entegrasyon.testSiparisi ? (
                            <span class="muted">Test kaydı</span>
                          ) : (
                            <span class="y-chip y-chip--yesil">Tüm adımlar tamam</span>
                          )}
                        </div>
                      </td>

                      <td class="y-sayi y-islem sm-bolge-islem sm-gizle-acikken">
                        <div class="sm-islem-butonlar">
                          {tyEtiketHazir && (
                            <a
                              class="btn btn--cizgi btn--kucuk sm-etiket-kisa"
                              href={`/yonetim/siparisler/pazaryeri/${encodeURIComponent(s.py!.id)}/etiket?kagit=a4`}
                              target="_blank"
                              rel="noopener"
                              title="Trendyol barkodlu kargo etiketini aç ve yazdır"
                            >
                              <PIkon ad="yazici" boyut={15} /> Etiket
                            </a>
                          )}
                          <a
                            class:list={[
                              'btn',
                              'btn--kucuk',
                              'y-secim-ac',
                              s.birincilIslem.tur === 'birincil' || s.birincilIslem.tur === 'uyari' ? 'btn--sepet' : 'btn--cizgi',
                            ]}
                            href={secAdresi}
                            data-astro-prefetch="false"
                            data-panel-sec={panelId}
                            aria-controls={panelId}
                            aria-expanded={seciliMi ? 'true' : 'false'}
                          >
                            {s.birincilIslem.etiket}
                          </a>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div class="sayfa-alt">
            <p class="y-help">
              {sonSayfa > 1 ? `${ilkSatir + 1}–${ilkSatir + gorunen.length} / ` : ''}{filtrelenmis.length} sipariş
              {webSecilebilir ? ' · Web kutularını işaretleyerek toplu etiket/belge indirebilirsiniz.' : ''}
            </p>
            {sonSayfa > 1 && (
              <nav class="y-ust-aksiyonlar" aria-label="Sipariş liste sayfaları">
                {sayfa > 1 && <a href={filtreAdresi(sekme) + '&sayfa=' + (sayfa - 1)} rel="prev" class="btn btn--cizgi">Önceki</a>}
                {sayfa < sonSayfa && <a href={filtreAdresi(sekme) + '&sayfa=' + (sayfa + 1)} rel="next" class="btn btn--cizgi">Sonraki</a>}
              </nav>
            )}
          </div>
        </div>

        <aside class="y-kart y-liste-secim y-siparis-secim sm-calisma-paneli" aria-label="Sipariş çalışma paneli">
          <div data-panel-bos hidden={acikIndeks >= 0}>
            <h2><PIkon ad="simsek" /> Sipariş Çalışma Paneli</h2>
            <p class="y-help">
              Listeden ayrılmadan hazırlama, barkodlu kargo fişi, 3 aşamalı fatura ve kâr kontrolü için satırdaki işlem düğmesine tıklayın.
            </p>
          </div>
          {gorunen.map((s, i) => (
            <SiparisCalismaPaneli
              kayit={s}
              panelId={'siparis-hizli-' + i}
              acik={i === acikIndeks}
              geriBazAdresi={sayfaBazAdresi}
              kapatAdresi={sayfaBazAdresi}
              oncekiPanelId={i > 0 ? 'siparis-hizli-' + (i - 1) : undefined}
              sonrakiPanelId={i < gorunen.length - 1 ? 'siparis-hizli-' + (i + 1) : undefined}
              siraBilgisi={`${ilkSatir + i + 1}/${filtrelenmis.length}`}
              kargoAyar={magaza.site.kargo}
              urunSecenekleri={urunSecenekleri}
              kullanilabilirStok={kullanilabilirStok}
              origin={Astro.url.origin}
            />
          ))}
        </aside>
      </div>

      {webSecilebilir && (
        <div class="y-toplu" data-y-toplu hidden role="region" aria-label="Toplu web siparişi işlemleri">
          <strong data-y-secim>0 seçili</strong>
          <details class="y-toplu-onizleme"><summary>Seçilen siparişler</summary><p data-y-secim-onizleme></p></details>
          <label class="y-toplu__tur">Belge
            <select data-y-toplu-tur aria-label="Toplu belge türü">
              {Object.entries(BELGE_TURLERI).map(([id, ad]) => <option value={id}>{ad}</option>)}
            </select>
          </label>
          <button class="btn btn--sepet" type="button" data-y-toplu-eylem="belge"><PIkon ad="indir" boyut={17} />PDF / ZIP indir</button>
          <button class="btn btn--cizgi" type="button" data-y-toplu-eylem="etiket" data-bicim="a4"><PIkon ad="yazici" boyut={17} />Etiket A4</button>
          <button class="btn btn--cizgi" type="button" data-y-toplu-eylem="etiket" data-bicim="etiket"><PIkon ad="yazici" boyut={17} />Etiket 10×15</button>
          <button class="btn btn--cizgi" type="button" data-y-toplu-eylem="toplama"><PIkon ad="liste" boyut={17} />Toplama listesi</button>
          <button class="y-icon-button" type="button" data-y-toplu-temizle aria-label="Seçimi temizle"><Ikon ad="kapat" boyut={16} /></button>
        </div>
      )}
      {webSecilebilir && (
        <dialog class="y-modal" data-y-toplu-onay aria-labelledby="toplu-onay-baslik">
          <div class="y-modal__bas"><strong id="toplu-onay-baslik">Toplu işlem özeti</strong></div>
          <p data-y-toplu-ozet></p>
          <p class="y-help">Seçilen web siparişleri</p>
          <p class="y-toplu-onay-listesi" data-y-toplu-siparisler></p>
          <form method="dialog" class="y-modal__alt">
            <button class="btn btn--cizgi" value="vazgec" autofocus>Vazgeç</button>
            <button class="btn btn--sepet" value="indir">İndir</button>
          </form>
        </dialog>
      )}
    </>
  ) : (
    <div class="y-kart y-bos">
      <p>
        <strong>
          {!pazaryeri && kanal !== 'web'
            ? 'Pazaryeri sipariş listesi şu an kullanılamıyor.'
            : q
              ? `“${q}” aramasıyla eşleşen sipariş bulunamadı.`
              : sekme === 'islem'
                ? 'Şu an işlem bekleyen sipariş yok.'
                : 'Bu aşamada sipariş bulunmuyor.'}
        </strong>
      </p>
      {sekme === 'islem' && !q && sayilar.kargoda > 0 && (
        <p class="muted">Yolda olan {sayilar.kargoda} siparişi görmek için <a class="y-link" href={filtreAdresi('kargoda')}>Kargoda</a> sekmesine geçebilirsiniz.</p>
      )}
      {q && sekme !== 'tumu' && <a class="y-link" href={filtreAdresi('tumu')}>Tüm siparişlerde ara</a>}
      {(sekme !== 'tumu' || kanal !== 'tumu' || q || tarihAcik) && <a class="y-link" href="/yonetim/siparisler?durum=tumu">Tüm siparişleri göster ({sayilar.tumu})</a>}
    </div>
  )}
</Yonetim>

