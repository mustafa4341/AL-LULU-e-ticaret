---
import Yonetim from '../../../layouts/Yonetim.astro';
import Ikon from '../../../components/Ikon.astro';
import { magazaOku, siparisleriOku } from '../../../lib/depo';
import { finansOku } from '../../../lib/finansDepo';
import { BELGE_TURLERI, belgeGecerli, finansGunu, gecerliGun } from '../../../lib/finans';
import { gonderilecek, odemeEtiketi, onayliSatis, yTarih } from '../../../lib/yonetimRapor';
import { gonderildi, iadeEdildi, iptalEdilebilir, siradakiDurum } from '../../../lib/siparisAkisi';
import { siparisKargoBaglantisi } from '../../../lib/kargoTakip';
import { formatTL } from '../../../lib/fiyat';
import type { Siparis } from '../../../lib/sema';
import { KANALLAR, KANAL_LISTESI, PY_DURUM_ADLARI, PY_DURUM_RENK, kanalMi, kurusTL, type PazaryeriSiparisi } from '../../../lib/pazaryeri';
import { envanterAyarlariOku, pazaryeriSiparisleriOku } from '../../../lib/pazaryeriDepo';
import { pazaryeriApiDurumu } from '../../../lib/pazaryeriApi';
import { pazaryeriDurumu } from '../../../components/yonetim/pazaryeriGorunumu';
import BilgiKutusu from '../../../components/yonetim/BilgiKutusu.astro';
import KanalLogo from '../../../components/yonetim/KanalLogo.astro';
import KanalOzeti from '../../../components/yonetim/KanalOzeti.astro';
import { kanalToplamlari } from '../../../lib/kanalOzeti';
import SiparisSonraki from '../../../components/yonetim/SiparisSonraki.astro';
import PIkon from '../../../components/yonetim/PIkon.astro';
import type { PanelIkonAdi } from '../../../components/yonetim/panelIkon';

/* Adres boşsa son seçilen filtre (kanal, sıralama) çerezden okunur. Eskiden sayfa açıldıktan sonra tarayıcı
   filtreli adrese ikinci kez gidiyordu; artık tek açılışta doğru liste gelir. */
const p = new URLSearchParams(!Astro.url.search ? (Astro.cookies.get('y-filtre-siparis')?.value ?? '').slice(0, 300) : Astro.url.search);
const q = (p.get('q') ?? '').trim();
const sira = p.get('sira') ?? 'yeni';
const bas = p.get('baslangic') ?? '';
const son = p.get('bitis') ?? '';
const secilenKanal = p.get('kanal');
const kanal = secilenKanal === 'web' || kanalMi(secilenKanal) ? secilenKanal : 'tumu';
const aranan = q.toLocaleLowerCase('tr');
const [tum, finans, magaza, pazaryeri, envanter] = await Promise.all([
  siparisleriOku(), finansOku(), magazaOku(), pazaryeriSiparisleriOku().catch(() => undefined), envanterAyarlariOku().catch(() => undefined),
]);
const { site } = magaza;
const urunler = new Map(magaza.urunler.map((u) => [u.id, u]));
const urunKimlikleri = new Set(urunler.keys());
const simdi = Date.now();
const sorunluKanallar = envanter ? KANAL_LISTESI.filter((k) => {
  const a = envanter.kanallar[k];
  return a.sonApiHata || a.sonStokHata || (pazaryeriApiDurumu(k) === 'canli' && a.stokBaslangic && (!a.sonOtomatikApi || simdi - Date.parse(a.sonOtomatikApi) > 30 * 60_000));
}) : [];
/* Listede siparişin içeriği açıkça görünsün: ilk ürünün fotoğrafı + "1 × Ürün adı, 2 × ..." */
function urunOzeti(s: Siparis) {
  const ilk = s.kalemler[0];
  const gorsel = !ilk ? undefined : ilk.tip === 'set'
    ? magaza.setler.find((x) => x.id === ilk.id)?.gorsel?.src ?? urunler.get(ilk.parcalar[0]?.urunId ?? '')?.gorseller[0]?.src
    : urunler.get(ilk.id)?.gorseller[0]?.src;
  const metin = s.kalemler.map((k) => `${k.adet} × ${k.tip === 'set' ? 'Set: ' : ''}${k.ad}`).join(', ');
  return { gorsel, metin };
}
const gercek = tum.filter((s) => !s.paytr?.test);
const pazaryeriDetayi = (id: string) => '/yonetim/siparisler/pazaryeri/' + encodeURIComponent(id);

/* Barkod okuyucu / numara ile doğrudan açma ("AL" ve tire yazılmasa da bulunur) */
const numara = (v: string) => { const m = /^(?:AL)?(\d{6})-?(\d{4})$/.exec(v.toUpperCase().replace(/[\s#]/g, '')); return m ? `AL${m[1]}-${m[2]}` : undefined; };
const tarama = p.get('tara') === '1';
let taramaUyarisi = 'Bu numarayla eşleşen sipariş bulunamadı.';
if (tarama && q) {
  const no = numara(q);
  const secim = no && tum.find((s) => s.no === no);
  if (secim) return Astro.redirect('/yonetim/siparisler/' + secim.no);
  const eslesenler = pazaryeri?.filter((s) => [s.siparisNo, s.paketNo, s.kargoTakip].includes(q)) ?? [];
  if (eslesenler.length === 1) return Astro.redirect(pazaryeriDetayi(eslesenler[0]!.id));
  if (eslesenler.length > 1) taramaUyarisi = 'Bu numara birden çok siparişle eşleşiyor. Listeden kanalı ve paketi seçin.';
  else if (!pazaryeri) taramaUyarisi = 'Web siparişi bulunamadı ve pazaryeri siparişleri okunamadı.';
}

const belgesiVar = (no: string) => finans.belgeler.some((b) => b.siparisNo === no && belgeGecerli(b));
type Durum = ReturnType<typeof pazaryeriDurumu>;
const FILTRELER: [string, string, (s: Siparis) => boolean, (s: PazaryeriSiparisi, d: Durum) => boolean][] = [
  ['tumu', 'Tümü', () => true, () => true],
  ['islem', 'İşlem bekleyen', (s) => gonderilecek(s) || (s.durum === 'odeme-bekliyor' && !s.paytr) || !!s.paytr?.stokEksik || (s.durum === 'iptal' && !!s.kargoTakip),
    (_, d) => d.hazirlanacak || d.hazirlaniyor || d.uyari.length > 0],
  ['kontrol', 'Kontrol gerekli', (s) => !!s.paytr?.stokEksik || (s.durum === 'iptal' && !!s.kargoTakip), (_, d) => d.uyari.length > 0],
  ['odendi', 'Hazırlanacak', (s) => s.durum === 'odendi', (_, d) => d.hazirlanacak],
  ['hazirlaniyor', 'Kargoya verilecek', (s) => s.durum === 'hazirlaniyor', (_, d) => d.hazirlaniyor],
  ['kargoda', 'Kargoda', (s) => s.durum === 'kargoda' && !iadeEdildi(s), (s) => s.kalemler.some((k) => k.durum === 'kargoda')],
  ['belgesiz', 'Belgesi eksik · Web', (s) => onayliSatis(s) && !belgesiVar(s.no), () => false],
  ['odeme-bekliyor', 'Ödeme bekleyen', (s) => s.durum === 'odeme-bekliyor', (s) => s.kalemler.some((k) => k.durum === 'onay-bekliyor')],
  ['teslim-edildi', 'Teslim edilen', (s) => s.durum === 'teslim-edildi' && !iadeEdildi(s), (s) => s.kalemler.some((k) => k.durum === 'teslim-edildi')],
  ['iptal', 'İptal / İade', (s) => s.durum === 'iptal' || iadeEdildi(s), (s) => s.kalemler.some((k) => ['iptal', 'iade', 'teslim-edilemedi', 'bolundu'].includes(k.durum))],
];
const FILTRE_IKONU: Record<string, PanelIkonAdi> = {
  tumu: 'liste', islem: 'simsek', kontrol: 'uyari', odendi: 'kutu', hazirlaniyor: 'kargo', kargoda: 'kargo',
  belgesiz: 'belge', 'odeme-bekliyor': 'cuzdan', 'teslim-edildi': 'tik-daire', iptal: 'iade',
};
const gorunumler = FILTRELER.filter(([id]) => kanal === 'web' || kanal === 'tumu' || id !== 'belgesiz');
const filtre = gorunumler.find(([id]) => id === p.get('durum'))?.[0]
  ?? (p.get('durum') === 'gonderilecek' ? 'islem' : q ? 'tumu' : 'islem');
const rakam = /^(?:al)?[\s()+#\d-]+$/.test(aranan) ? aranan.replace(/\D/g, '') : '';
const basGecerli = gecerliGun(bas), sonGecerli = gecerliGun(son);
function aramayaUygun(tarih: string, metinler: (string | undefined)[]) {
  const gun = finansGunu(new Date(tarih));
  if ((basGecerli && gun < bas) || (sonGecerli && gun > son)) return false;
  return !aranan || metinler.some((m) => m?.toLocaleLowerCase('tr').includes(aranan)
    || (rakam.length >= 4 && m?.replace(/\D/g, '').includes(rakam)));
}

const webSatirlari = kanal === 'tumu' || kanal === 'web' ? gercek
  .filter((s) => aramayaUygun(s.tarih, [s.no, `${s.musteri.ad} ${s.musteri.soyad}`, s.musteri.tel, s.kargoTakip, ...s.kalemler.map((k) => k.ad)]))
  .map((siparis) => ({ kanal: 'web' as const, siparis, sonKargo: Infinity, tutar: siparis.toplam, tarih: Date.parse(siparis.tarih) })) : [];
const pazarSatirlari = (pazaryeri ?? [])
  .filter((s) => (kanal === 'tumu' || kanal === s.kanal) && aramayaUygun(s.tarih, [
    s.siparisNo, s.paketNo, s.musteri, s.kargoTakip, ...s.kalemler.flatMap((k) => [k.ad, k.barkod, k.stokKodu]),
  ]))
  .map((siparis) => {
    const durum = pazaryeriDurumu(siparis, simdi, urunKimlikleri);
    return { kanal: siparis.kanal, siparis, durum, sonKargo: Number.isFinite(durum.sonKargo) ? durum.sonKargo : Infinity,
      tutar: siparis.toplam / 100, tarih: Date.parse(siparis.tarih) };
  });
const sayilar = Object.fromEntries(gorunumler.map(([id, , web, pazar]) => [id,
  webSatirlari.filter(({ siparis }) => web(siparis)).length + pazarSatirlari.filter(({ siparis, durum }) => pazar(siparis, durum)).length,
]));
const [, , webUygun, pazarUygun] = gorunumler.find(([id]) => id === filtre)!;
const liste = [...webSatirlari.filter(({ siparis }) => webUygun(siparis)),
  ...pazarSatirlari.filter(({ siparis, durum }) => pazarUygun(siparis, durum))];
liste.sort((a, b) => {
  if (sira === 'tutar') return b.tutar - a.tutar || b.tarih - a.tarih;
  if (sira === 'eski') return a.tarih - b.tarih;
  if (sira === 'son-kargo' && a.sonKargo !== b.sonKargo) return a.sonKargo - b.sonKargo;
  return b.tarih - a.tarih;
});
const SAYFA_BOYUTU = 30;
const sonSayfa = Math.max(1, Math.ceil(liste.length / SAYFA_BOYUTU));
const istenenSayfa = Number(p.get('sayfa'));
const sayfa = Number.isSafeInteger(istenenSayfa) ? Math.max(1, Math.min(sonSayfa, istenenSayfa)) : 1;
const ilkSatir = (sayfa - 1) * SAYFA_BOYUTU;
const gorunen = liste.slice(ilkSatir, ilkSatir + SAYFA_BOYUTU);
const webSecilebilir = gorunen.some((satir) => satir.kanal === 'web');

function odemeChip(s: Siparis) {
  const renk = s.paytr ? (s.paytr.sonuc === 'odendi' ? 'yesil' : s.paytr.sonuc === 'basarisiz' ? 'kirmizi' : 'turuncu')
    : s.durum === 'iptal' ? 'gri' : s.durum === 'odeme-bekliyor' ? 'turuncu' : 'yesil';
  return { yazi: odemeEtiketi(s), renk };
}
function kargoChip(s: Siparis) {
  if (iadeEdildi(s)) return { yazi: 'İade edildi', renk: 'gri' };
  if (s.durum === 'iptal') return { yazi: s.kargoTakip ? 'İptal · takip var!' : 'İptal', renk: s.kargoTakip ? 'kirmizi' : 'gri' };
  if (s.durum === 'kargoda') return { yazi: 'Kargoda', renk: 'yesil' };
  if (s.durum === 'teslim-edildi') return { yazi: 'Teslim edildi', renk: 'yesil' };
  if (s.durum === 'hazirlaniyor') return { yazi: 'Kargoya verilecek', renk: 'turuncu' };
  if (s.durum === 'odendi') return { yazi: 'Hazırlanacak', renk: 'turuncu' };
  return { yazi: '—', renk: 'gri' };
}
function belgeChip(s: Siparis) {
  const b = finans.belgeler.filter((d) => d.siparisNo === s.no);
  if (b.some((d) => d.durum === 'hata')) return { yazi: 'Hata', renk: 'kirmizi' };
  const gecerli = b.filter(belgeGecerli);
  if (gecerli.length) return { yazi: gecerli.some((d) => d.durum === 'gonderildi') ? 'Gönderildi' : 'Düzenlendi', renk: 'yesil', baslik: gecerli.map((d) => (d.belgeNo ?? '') + ' ' + BELGE_TURLERI[d.tur]).join(', ') };
  return onayliSatis(s) ? { yazi: 'Hazırlanmadı', renk: 'turuncu' } : { yazi: '—', renk: 'gri' };
}
const filtreAdresi = (id: string, tarihler = true) => '?' + new URLSearchParams({ durum: id,
  ...(kanal !== 'tumu' ? { kanal } : {}), ...(q ? { q } : {}), ...(tarihler && bas ? { baslangic: bas } : {}),
  ...(tarihler && son ? { bitis: son } : {}), ...(sira !== 'yeni' ? { sira } : {}),
});
const tarihAcik = !!(bas || son);

/* Kanal özeti: seçili tarih aralığı, yoksa bu ay. İptal/iade ve ödemesi onaylanmamış siparişler sayılmaz. */
const bugun = finansGunu();
const ozetBas = basGecerli ? bas : bugun.slice(0, 7) + '-01';
const ozetSon = sonGecerli ? son : bugun;
const ozet = kanalToplamlari(gercek, pazaryeri ?? [], ozetBas, ozetSon);
const ozetDonemi = basGecerli || sonGecerli ? `${ozetBas.split('-').reverse().join('.')} – ${ozetSon.split('-').reverse().join('.')}` : 'Bu ay';
const kanalAdresi = (k: string) => '?' + new URLSearchParams({ durum: 'tumu', kanal: k, ...(bas ? { baslangic: bas } : {}), ...(son ? { bitis: son } : {}) });
---
<Yonetim baslik="Siparişler" altBaslik="Siparişleri hazırlayın, kargo ve belge durumunu takip edin." aktif="siparisler" basari={Astro.url.searchParams.get('ok')} hatalar={Astro.url.searchParams.get('hata') ? [Astro.url.searchParams.get('hata')!] : []}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a href="/yonetim/siparisler/kanallar" class="btn btn--cizgi"><PIkon ad="zincir" boyut={18} />Satış kanalları</a>
    <button type="button" class="btn btn--sepet" data-y-dialog="barkod-oku"><PIkon ad="barkod" boyut={18} />Barkod / numarayla aç</button>
  </div>

  <dialog class="y-modal" id="barkod-oku" data-hata-ac={tarama ? '1' : undefined} aria-labelledby="barkod-baslik">
    <div class="y-modal__bas"><strong id="barkod-baslik">Siparişi aç</strong><form method="dialog"><button class="y-icon-button" aria-label="Kapat"><Ikon ad="kapat" boyut={18} /></button></form></div>
    <form method="get" class="y-izgara">
      <input type="hidden" name="tara" value="1" />
      <label class="y-alan">Barkodu okutun veya sipariş numarasını yazın
        <input name="q" placeholder="Sipariş, paket veya takip no" required autocomplete="off" autocapitalize="characters" value={tarama ? q : ''} />
      </label>
      {tarama && <p class="y-uyari" role="status">{taramaUyarisi}</p>}
      <p class="y-help">Web hazırlık etiketini panelin herhangi bir sayfasında okutabilirsiniz.</p>
      <button class="btn btn--sepet">Siparişi aç</button>
    </form>
  </dialog>

  {!pazaryeri && <p class="y-uyari-satir" role="alert"><Ikon ad="kalkan" boyut={16} /><span>Pazaryeri siparişleri okunamadı. <a class="y-link" href="/yonetim/siparisler/kanallar">Satış kanallarını kontrol edin</a></span></p>}
  {pazaryeri && sorunluKanallar.length > 0 && <div class="y-uyari-satir uyari--turuncu siparis-kanal-uyari" role="status">
    <PIkon ad="uyari" boyut={18} />
    <span><strong>{sorunluKanallar.length} pazaryerinde eşitleme uyarısı var ({sorunluKanallar.map((k) => KANALLAR[k]).join(', ')}).</strong> Sipariş veya stok senkronizasyonu kontrol bekliyor.</span>
    <a class="btn btn--cizgi btn--kucuk" href={'/yonetim/siparisler/kanallar#' + sorunluKanallar[0]}>Detayı Gör →</a>
  </div>}

  <div class="y-siparis-govde">
  <div class="y-siparis-ozet">
  <KanalOzeti ozet={ozet} donem={ozetDonemi} adres={kanalAdresi} secili={kanal} kompakt={true} aciklama="İptal ve iadeler hariç. Karta tıklayarak kanala göre filtreleyin." />

  <BilgiKutusu baslik="Sipariş işlemleri rehberi" anahtar="siparisler" acik={false}>
    <p>Web sitesinden, Trendyol'dan ve Hepsiburada'dan gelen siparişler aynı listede. Her siparişin altında <strong>hangi kanaldan geldiği</strong> yazar.</p>
    <p>Web siparişlerinin hazırlık ve kargo adımlarını panelden tamamlayın. Trendyol ve Hepsiburada işlemlerinin nerede yapılacağı sipariş ayrıntılarında gösterilir.</p>
  </BilgiKutusu>
  </div>

  <div class="y-siparis-kuyruk">
  <nav class="y-filtreler" aria-label="Sipariş görünümleri">
    {gorunumler.map(([id, ad]) => <a href={filtreAdresi(id)} aria-current={filtre === id ? 'page' : undefined} class={'y-filtre--' + id}>
      <PIkon ad={FILTRE_IKONU[id] ?? 'liste'} boyut={18} />{ad}{id !== 'tumu' && sayilar[id] > 0 && <b>{sayilar[id]}</b>}
    </a>)}
  </nav>

  <form class="y-toolbar" method="get" data-filtre-form="siparis">
    <input type="hidden" name="durum" value={filtre} />
    <input class="y-girdi" name="q" type="search" value={q} placeholder="Sipariş no, müşteri, ürün veya takip no" aria-label="Sipariş ara" />
    <select class="y-girdi" name="kanal" aria-label="Satış kanalı">
      <option value="tumu" selected={kanal === 'tumu'}>Tüm kanallar</option>
      <option value="web" selected={kanal === 'web'}>Web sitesi</option>
      {Object.entries(KANALLAR).map(([id, ad]) => <option value={id} selected={kanal === id}>{ad}</option>)}
    </select>
    <select class="y-girdi" name="sira" aria-label="Sıralama">
      <option value="yeni" selected={sira === 'yeni'}>En yeni</option>
      <option value="eski" selected={sira === 'eski'}>En eski</option>
      <option value="son-kargo" selected={sira === 'son-kargo'}>Son kargolama tarihine göre</option>
      <option value="tutar" selected={sira === 'tutar'}>En yüksek tutar</option>
    </select>
    <details class="y-tarih" open={tarihAcik}>
      <summary class="btn btn--cizgi">{tarihAcik ? (bas || '…') + ' – ' + (son || '…') : 'Tarih'}</summary>
      <div>
        <label class="y-alan">Başlangıç<input name="baslangic" type="date" value={bas} /></label>
        <label class="y-alan">Bitiş<input name="bitis" type="date" value={son} /></label>
        {tarihAcik && <a class="y-link" href={filtreAdresi(filtre, false)}>Temizle</a>}
      </div>
    </details>
    <button class="btn btn--cizgi" type="submit">Filtrele</button>
  </form>

  {liste.length ? <>
    <div class="y-liste-detay" data-panel-secim>
    <div class="y-liste-ana">
    <div class="y-tablo-kap y-tablo-kap--kart">
      <table class="y-tablo y-siparis-tablo">
        <thead><tr>
          <th class="y-sec">{webSecilebilir && <label class="y-siparis-sec-kutusu"><input type="checkbox" data-y-tumu aria-label="Görünen web siparişlerinin tümünü seç" /></label>}</th>
          <th>Sipariş / kanal</th><th>Müşteri</th><th>Ürünler</th><th class="y-sayi">Tutar</th><th>Durum</th><th class="y-sayi"><span class="visually-hidden">İşlemler</span></th>
        </tr></thead>
        <tbody>{gorunen.map((satir, i) => {
          if (satir.kanal !== 'web') {
            const { siparis: s, durum } = satir;
            const detay = pazaryeriDetayi(s.id);
            const ilk = s.kalemler[0];
            const gorsel = ilk?.urunId ? urunler.get(ilk.urunId)?.gorseller[0]?.src : undefined;
            const metin = s.kalemler.map((k) => `${k.adet} × ${k.ad}`).join(', ');
            const kent = [s.ilce, s.il].filter(Boolean).join(' / ');
            const adim = durum.hazirlanacak ? 'yeni' : durum.hazirlaniyor ? 'hazirlaniyor' : s.durum;
            return <tr>
              <td class="y-sec"></td>
              <td data-etiket="Sipariş" class="y-siparis-no">
                <a class="y-link" href={detay}>{s.siparisNo}</a>
                <small class="y-table-note"><span class:list={['kanal-etiket', 'kanal-etiket--' + s.kanal]}>{KANALLAR[s.kanal]}</span> · {yTarih.format(new Date(s.tarih))}</small>
                {s.paketNo && s.paketNo !== s.siparisNo && <small class="y-table-note">Paket {s.paketNo}</small>}
              </td>
              <td data-etiket="Müşteri">{s.musteri ?? '—'}{kent && <small class="y-table-note">{kent}</small>}</td>
              <td data-etiket="Ürünler" class="y-urunler"><a class="y-urun-ozet" href={detay} title={metin}>
                {gorsel ? <img src={gorsel} alt="" width="36" height="36" loading="lazy" decoding="async" /> : <span class="y-kalem-gorsel--yok" aria-hidden="true"><Ikon ad="kutu" boyut={18} /></span>}
                <span>{metin}</span>
              </a></td>
              <td data-etiket="Tutar" class="y-sayi y-nowrap"><strong>{kurusTL(s.toplam)}</strong></td>
              <td data-etiket="Durum">
                <div class="durum-ozeti">
                  <span class:list={['y-chip', 'y-chip--' + PY_DURUM_RENK[adim]]}>{PY_DURUM_ADLARI[adim]}</span>
                  {durum.uyari.map((u) => <a href={detay} class:list={['y-chip', 'y-chip--' + u.renk]}>{u.yazi}</a>)}
                </div>
                {Number.isFinite(durum.sonKargo) && <small class="y-table-note">Son kargolama {yTarih.format(durum.sonKargo)}</small>}
              </td>
              <td class="y-sayi y-islem"><div class="y-row-actions"><a class="btn btn--cizgi btn--kucuk y-secim-ac" href={filtreAdresi(filtre) + '&hizli=' + i} data-astro-prefetch="false" data-panel-sec={'siparis-hizli-' + i} aria-controls={'siparis-hizli-' + i} aria-expanded={p.get('hizli') === String(i) ? 'true' : 'false'} aria-label={s.siparisNo + ' hızlı işlem'}>Hızlı işlem</a><a class="y-link detay-link" href={detay} aria-label={KANALLAR[s.kanal] + ' sipariş detayı ' + s.siparisNo}>Detay</a></div></td>
            </tr>;
          }
          const { siparis: s } = satir;
          const detay = '/yonetim/siparisler/' + s.no;
          const o = odemeChip(s), k = kargoChip(s), b = belgeChip(s);
          const takip = siparisKargoBaglantisi(s, site.kargo);
          const hazirlanabilir = s.durum !== 'iptal' && !iadeEdildi(s);
          const uo = urunOzeti(s);
          return <tr data-satir={s.no}>
            <td class="y-sec"><label class="y-siparis-sec-kutusu"><input type="checkbox" name="no" value={s.no} data-y-secim-kutusu aria-label={s.no + ' seç'} /></label></td>
            <td data-etiket="Sipariş" class="y-siparis-no">
              <a class="y-link" href={detay}>{s.no}</a>
              <button type="button" class="y-kopya" data-kopyala={s.no} title="Numarayı kopyala" aria-label={s.no + ' kopyala'}><svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v10H9zM5 15V5h10" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
              <small class="y-table-note"><span class="kanal-etiket">Web sitesi</span> · {yTarih.format(new Date(s.tarih))}</small>
            </td>
            <td data-etiket="Müşteri">{s.musteri.ad} {s.musteri.soyad}<small class="y-table-note">{s.teslimat.ilce} / {s.teslimat.il}</small></td>
            <td data-etiket="Ürünler" class="y-urunler"><a class="y-urun-ozet" href={detay} title={uo.metin}>
              {uo.gorsel ? <img src={uo.gorsel} alt="" width="36" height="36" loading="lazy" decoding="async" /> : <span class="y-kalem-gorsel--yok" aria-hidden="true"><Ikon ad="kutu" boyut={18} /></span>}
              <span>{uo.metin}</span>
            </a></td>
            <td data-etiket="Tutar" class="y-sayi y-nowrap"><strong>{formatTL(s.toplam)}</strong></td>
            <td data-etiket="Durum">
              <div class="durum-ozeti">
                {k.yazi !== '—' && <span class:list={['y-chip', 'y-chip--' + k.renk]}>{k.yazi}</span>}
                {s.paytr?.stokEksik && <a href={detay} class="y-chip y-chip--kirmizi">Stok ayrılamadı</a>}
              </div>
              <small class:list={['y-table-note', { 'kritik-not': o.renk === 'kirmizi' }]}>Ödeme: {o.yazi}</small>
              {b.yazi !== '—' && <small class:list={['y-table-note', { 'kritik-not': b.renk === 'kirmizi' }]} title={b.baslik}>Belge: {b.yazi}</small>}
            </td>
            <td class="y-sayi y-islem"><div class="y-row-actions">
              <a class="btn btn--cizgi btn--kucuk y-secim-ac" href={filtreAdresi(filtre) + '&hizli=' + i} data-astro-prefetch="false" data-panel-sec={'siparis-hizli-' + i} aria-controls={'siparis-hizli-' + i} aria-expanded={p.get('hizli') === String(i) ? 'true' : 'false'} aria-label={s.no + ' hızlı işlem'}>Hızlı işlem</a>
              <details class="y-row-menu y-row-menu--sag"><summary aria-label={s.no + ' işlemleri'}>•••</summary>
                <div>
                  <a href={detay}>Detayı aç</a>
                  {onayliSatis(s) && <form method="post" action="/yonetim/finans/belge">
                    <input type="hidden" name="islem" value="olustur" /><input type="hidden" name="tur" value="ozet" /><input type="hidden" name="no" value={s.no} />
                    <input type="hidden" name="geri" value={Astro.url.pathname + Astro.url.search} />
                    <button type="submit">Sipariş özeti PDF indir</button>
                  </form>}
                  {hazirlanabilir && <a href={'/yonetim/finans/etiket?no=' + encodeURIComponent(s.no)} target="_blank" rel="noopener">Hazırlık etiketi yazdır ↗</a>}
                  <a href={detay + '#belgeler'}>Belge durumunu gör</a>
                  <a href={detay + '#kargo'}>Kargoyu yönet</a>
                  {takip && <a href={takip.url} target="_blank" rel="noopener">Kargo takibini aç ↗</a>}
                  {(iptalEdilebilir(s) || (gonderildi(s) && !iadeEdildi(s))) && <a href={detay + (iptalEdilebilir(s) ? '#iptal' : '#iade')}>İade / iptal işlemi</a>}
                </div>
              </details>
            </div></td>
          </tr>;
        })}</tbody>
      </table>
    </div>
    <div class="sayfa-alt">
      <p class="y-help">{sonSayfa > 1 ? `${ilkSatir + 1}–${ilkSatir + gorunen.length} / ` : ''}{liste.length} kayıt{webSecilebilir && ' · Web siparişlerini seçerek toplu işlem yapabilirsiniz.'}</p>
      {sonSayfa > 1 && <nav class="y-ust-aksiyonlar" aria-label="Sipariş liste sayfaları">
        {sayfa > 1 && <a href={filtreAdresi(filtre) + '&sayfa=' + (sayfa - 1)} rel="prev" class="btn btn--cizgi">Önceki</a>}
        {sayfa < sonSayfa && <a href={filtreAdresi(filtre) + '&sayfa=' + (sayfa + 1)} rel="next" class="btn btn--cizgi">Sonraki</a>}
      </nav>}
    </div>

    </div>
    <aside class="y-kart y-liste-secim y-siparis-secim" aria-label="Sipariş hızlı işlem">
      <div data-panel-bos><h2><PIkon ad="simsek" /> Hızlı işlem paneli</h2><p class="y-help">Listeden ayrılmadan siparişin sıradaki işlemini yapmak, müşteri ve ürün detaylarını görmek için satırdaki <strong>İşlem</strong> düğmesine basın.</p></div>
      {gorunen.map((satir, i) => {
        const web = satir.kanal === 'web';
        const detay = web ? '/yonetim/siparisler/' + satir.siparis.no : pazaryeriDetayi(satir.siparis.id);
        const no = web ? satir.siparis.no : satir.siparis.siparisNo;
        const musteri = web ? `${satir.siparis.musteri.ad} ${satir.siparis.musteri.soyad}` : satir.siparis.musteri;
        const pazarDurumu = !web && (satir.durum.hazirlanacak ? 'yeni' : satir.durum.hazirlaniyor ? 'hazirlaniyor' : satir.siparis.durum);
        const durum = web ? kargoChip(satir.siparis) : { yazi: PY_DURUM_ADLARI[pazarDurumu || satir.siparis.durum], renk: PY_DURUM_RENK[pazarDurumu || satir.siparis.durum] };
        const odeme = web ? odemeChip(satir.siparis) : undefined;
        const stokSorunu = web && !!satir.siparis.paytr?.stokEksik && satir.siparis.durum !== 'iptal';
        const tyToplamaUygun = !web && satir.kanal === 'trendyol' && (satir.siparis.hamDurum === 'Created' || satir.siparis.hamDurum === 'Awaiting') && !satir.durum.uyari.some((u) => u.renk === 'kirmizi');
        const pazarKontrolGerekli = !web && satir.durum.uyari.some((u) => u.renk === 'kirmizi');
        const faturaAdresi = '/yonetim/finans/faturalar?sec=' + encodeURIComponent(web ? 'web:' + no : satir.kanal + ':' + satir.siparis.id) + '#secili';
        const kalemler = web
          ? satir.siparis.kalemler.map((k) => ({
              ad: `${k.tip === 'set' ? 'Set: ' : ''}${k.ad}`,
              adet: k.adet,
              kod: k.sku,
              tutar: formatTL(k.toplam),
              gorsel: k.tip === 'set'
                ? magaza.setler.find((x) => x.id === k.id)?.gorsel?.src ?? urunler.get(k.parcalar[0]?.urunId ?? '')?.gorseller[0]?.src
                : urunler.get(k.id)?.gorseller[0]?.src,
            }))
          : satir.siparis.kalemler.map((k) => ({
              ad: k.ad,
              adet: k.adet,
              kod: k.barkod || k.stokKodu,
              tutar: kurusTL(k.tutar),
              gorsel: k.urunId ? urunler.get(k.urunId)?.gorseller[0]?.src : undefined,
            }));
        const sonGecmis = satir.siparis.gecmis.at(-1);
        const hizliAcik = Astro.url.searchParams.get('hizli') === String(i);
        return <section id={'siparis-hizli-' + i} data-panel-kayit hidden={!hizliAcik}>
          <div class="y-kart__bas">
            <h2 class="hizli-baslik"><KanalLogo kanal={satir.kanal} boyut="kucuk" /><span>{no}</span></h2>
            <div class="hizli-ust-dugmeler">
              <a class="y-icon-button" href={detay} title="Tam sipariş detayını aç" aria-label={no + ' detay sayfasını aç'}><PIkon ad="dis-baglanti" boyut={17} /></a>
              <a href={filtreAdresi(filtre)} class="y-icon-button" data-astro-prefetch="false" data-panel-kapat aria-label="Hızlı işlemi kapat"><Ikon ad="kapat" boyut={17} /></a>
            </div>
          </div>
          <p class="muted hizli-alt">{web ? 'Web sitesi' : KANALLAR[satir.kanal]} · {yTarih.format(new Date(satir.siparis.tarih))}{!web && satir.siparis.paketNo && satir.siparis.paketNo !== no ? ` · Paket ${satir.siparis.paketNo}` : ''}</p>
          <div class="y-durumlar hizli-durum-seridi">
            {odeme && <span class:list={['y-chip', 'y-chip--' + odeme.renk]}>{odeme.yazi}</span>}
            {durum.yazi !== '—' && <span class:list={['y-chip', 'y-chip--' + durum.renk]}>{durum.yazi}</span>}
            {stokSorunu && <span class="y-chip y-chip--kirmizi">Stok ayrılamadı</span>}
            <strong class="hizli-tutar">{web ? formatTL(satir.siparis.toplam) : kurusTL(satir.siparis.toplam)}</strong>
          </div>

          <div class="hizli-siradaki">
            <h3><PIkon ad="simsek" boyut={17} /> Sıradaki adım</h3>
            {web && stokSorunu && <>
              <p class="y-help y-yazi-kirmizi">Ödeme alındı fakat stok ayrılamadı. Hazırlamaya geçmeden önce stoğu ayırın.</p>
              <form method="post" action={detay}><button class="btn btn--sepet hizli-ana-dugme" type="submit" name="eylem" value="stok-tamamla">Stoğu Ayır →</button></form>
            </>}
            {web && !stokSorunu && siradakiDurum(satir.siparis) && <SiparisSonraki siparis={satir.siparis} kargo={site.kargo} action={detay} />}
            {web && !stokSorunu && !siradakiDurum(satir.siparis) && <p class="y-help">Bu sipariş için bekleyen hazırlık/kargo adımı yok.</p>}
            {!web && pazarKontrolGerekli && <>
              <div class="hizli-uyarilar">{satir.durum.uyari.map((u) => <span class:list={['y-chip', 'y-chip--' + u.renk]}>{u.yazi}</span>)}</div>
              <p class="y-help">Hazırlığa geçmeden önce ürün eşleştirmesini veya eksik stoğu kontrol edin.</p>
              <a class="btn btn--sepet hizli-ana-dugme" href={detay + '#urunler'}>Ürün ve Stok Kontrolünü Aç →</a>
            </>}
            {!web && !pazarKontrolGerekli && tyToplamaUygun && <>
              <p class="y-help">Trendyol’a siparişin işleme alındığını bildirin.</p>
              <form method="post" action={detay}><button class="btn btn--sepet hizli-ana-dugme" type="submit" name="eylem" value="ty-toplama">Toplamaya Başla →</button></form>
            </>}
            {!web && !pazarKontrolGerekli && !tyToplamaUygun && <>
              {satir.durum.uyari.length > 0 && <div class="hizli-uyarilar">{satir.durum.uyari.map((u) => <span class:list={['y-chip', 'y-chip--' + u.renk]}>{u.yazi}</span>)}</div>}
              <a class="btn btn--sepet hizli-ana-dugme" href={detay}>Sipariş ve Stok Detayını Aç →</a>
            </>}
          </div>

          <div class="hizli-aksiyon-listesi">
            <a class="hizli-aksiyon" href={faturaAdresi}><PIkon ad="fatura" boyut={17} /><span>Fatura / Resmi Belge</span><PIkon ad="sag" boyut={16} /></a>
            {web && <a class="hizli-aksiyon" href={detay + '#belgeler'}><PIkon ad="belge" boyut={17} /><span>Sipariş Özeti / Paket İçi Fiş</span><PIkon ad="sag" boyut={16} /></a>}
            {web && satir.siparis.durum !== 'iptal' && !iadeEdildi(satir.siparis) && <a class="hizli-aksiyon" href={'/yonetim/finans/etiket?no=' + encodeURIComponent(no)} target="_blank" rel="noopener"><PIkon ad="yazici" boyut={17} /><span>Hazırlık Etiketi Yazdır ↗</span><PIkon ad="sag" boyut={16} /></a>}
            {!web && <a class="hizli-aksiyon" href={detay + '#urunler'}><PIkon ad="katman" boyut={17} /><span>Ürün Eşleştirme ve Stok</span><PIkon ad="sag" boyut={16} /></a>}
            <a class="hizli-aksiyon" href={detay}><PIkon ad="liste" boyut={17} /><span>Tüm Sipariş Detayı ve Geçmiş</span><PIkon ad="sag" boyut={16} /></a>
          </div>

          <div class="hizli-bilgi-izgara">
            <div class="hizli-kutu">
              <h4><PIkon ad="kullanici" boyut={15} /> Müşteri</h4>
              <strong>{musteri || 'Müşteri bilgisi yok'}</strong>
              {web && <small><a class="y-link" href={'tel:' + satir.siparis.musteri.tel}>{satir.siparis.musteri.tel}</a></small>}
              {web && satir.siparis.musteri.eposta && <small><a class="y-link" href={'mailto:' + satir.siparis.musteri.eposta}>{satir.siparis.musteri.eposta}</a></small>}
            </div>
            <div class="hizli-kutu">
              <h4><PIkon ad="kargo" boyut={15} /> Teslimat</h4>
              {web ? <small>{satir.siparis.teslimat.adres}<br /><strong>{satir.siparis.teslimat.ilce} / {satir.siparis.teslimat.il}</strong></small>
                : <small><strong>{[satir.siparis.ilce, satir.siparis.il].filter(Boolean).join(' / ') || 'Adres satıcı panelinde'}</strong></small>}
              {satir.siparis.kargoFirma && <small class="y-chip y-chip--gri">{satir.siparis.kargoFirma}{satir.siparis.kargoTakip ? ' · ' + satir.siparis.kargoTakip : ''}</small>}
            </div>
          </div>

          <div class="hizli-kutu">
            <h4><PIkon ad="kutu" boyut={15} /> Ürünler ({kalemler.length})</h4>
            <ul class="hizli-urunler">{kalemler.map((k) => <li>
              {k.gorsel ? <img src={k.gorsel} alt="" width="36" height="36" loading="lazy" /> : <span class="y-kalem-gorsel--yok"><Ikon ad="kutu" boyut={16} /></span>}
              <div><strong>{k.ad}</strong><small>{k.adet} adet{k.kod ? ' · ' + k.kod : ''}</small></div>
              <b>{k.tutar}</b>
            </li>)}</ul>
          </div>

          {(web && (satir.siparis.teslimat.not || satir.siparis.yoneticiNotu || satir.siparis.fatura.tip === 'kurumsal') || sonGecmis) && <div class="hizli-kutu hizli-notlar">
            <h4><PIkon ad="gecmis" boyut={15} /> Notlar ve Son İşlem</h4>
            {web && satir.siparis.teslimat.not && <p class="hizli-not"><strong>Müşteri notu:</strong> {satir.siparis.teslimat.not}</p>}
            {web && satir.siparis.fatura.tip === 'kurumsal' && <p class="hizli-not"><strong>Kurumsal fatura:</strong> {satir.siparis.fatura.firma}</p>}
            {web && satir.siparis.yoneticiNotu && <p class="hizli-not"><strong>İç not:</strong> {satir.siparis.yoneticiNotu}</p>}
            {sonGecmis && <small class="muted">Son kayıt: {yTarih.format(new Date(sonGecmis.tarih))}{sonGecmis.not ? ' · ' + sonGecmis.not : ''}</small>}
          </div>}
        </section>;
      })}
    </aside>
    </div>

    {webSecilebilir && <div class="y-toplu" data-y-toplu hidden role="region" aria-label="Toplu web siparişi işlemleri">
      <strong data-y-secim>0 seçili</strong>
      <details class="y-toplu-onizleme"><summary>Seçilen siparişler</summary><p data-y-secim-onizleme></p></details>
      <label class="y-toplu__tur">Belge
        <select data-y-toplu-tur aria-label="Toplu belge türü">{Object.entries(BELGE_TURLERI).map(([id, ad]) => <option value={id}>{ad}</option>)}</select>
      </label>
      <button class="btn btn--sepet" type="button" data-y-toplu-eylem="belge"><PIkon ad="indir" boyut={17} />PDF / ZIP indir</button>
      <button class="btn btn--cizgi" type="button" data-y-toplu-eylem="etiket" data-bicim="a4"><PIkon ad="yazici" boyut={17} />Etiket A4</button>
      <button class="btn btn--cizgi" type="button" data-y-toplu-eylem="etiket" data-bicim="etiket"><PIkon ad="yazici" boyut={17} />Etiket 10×15</button>
      <button class="btn btn--cizgi" type="button" data-y-toplu-eylem="toplama"><PIkon ad="liste" boyut={17} />Toplama listesi</button>
      <button class="y-icon-button" type="button" data-y-toplu-temizle aria-label="Seçimi temizle"><Ikon ad="kapat" boyut={16} /></button>
    </div>}
    {webSecilebilir && <dialog class="y-modal" data-y-toplu-onay aria-labelledby="toplu-onay-baslik">
      <div class="y-modal__bas"><strong id="toplu-onay-baslik">Toplu işlem özeti</strong></div>
      <p data-y-toplu-ozet></p>
      <p class="y-help">Seçilen web siparişleri</p><p class="y-toplu-onay-listesi" data-y-toplu-siparisler></p>
      <form method="dialog" class="y-modal__alt"><button class="btn btn--cizgi" value="vazgec" autofocus>Vazgeç</button><button class="btn btn--sepet" value="indir">İndir</button></form>
    </dialog>}
  </> : <div class="y-kart y-bos">
    <p><strong>{!pazaryeri && kanal !== 'web' ? 'Pazaryeri sipariş listesi kullanılamıyor.' : q ? '“' + q + '” için sipariş bulunamadı.' : filtre === 'islem' ? 'Bekleyen iş yok.' : 'Bu görünümde sipariş yok.'}</strong></p>
    {filtre === 'islem' && !q && (sayilar.belgesiz ?? 0) > 0 && <p class="muted">Belgesi hazırlanmamış {sayilar.belgesiz} web siparişi var. <a class="y-link" href={filtreAdresi('belgesiz')}>Belgesi eksik siparişleri aç</a></p>}
    {q && filtre !== 'tumu' && <a class="y-link" href={filtreAdresi('tumu')}>Tüm durumlarda ara</a>}
    {(filtre !== 'tumu' || kanal !== 'tumu' || q || tarihAcik) && <a class="y-link" href="?durum=tumu">Tüm siparişleri göster</a>}
  </div>}
  </div>
  </div>
</Yonetim>

<style>
  .y-siparis-no { white-space: normal; overflow-wrap: anywhere; }
  /* .y-panel düzen bileşeninde (body); kapsamlı CSS'te eşleşmesi için :global gerekir */
  :global(.y-panel) .y-tablo.y-siparis-tablo td small.y-table-note { white-space: normal; overflow-wrap: anywhere; }
  .durum-ozeti { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }
  .durum-ozeti .y-chip { white-space: normal; }
  .kritik-not { color: var(--y-kirmizi); font-weight: 650; }
  .detay-link { display: inline-flex; padding: 4px 6px; white-space: nowrap; }
  .sayfa-alt { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin: 10px 0; }
  .sayfa-alt .y-help { margin: 0; }
  .siparis-kanal-uyari { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 14px; background: var(--y-turuncu-zemin); color: var(--y-turuncu); border-color: #efd5a4; }
  .siparis-kanal-uyari > span { flex: 1 1 280px; }
  .hizli-baslik { display: inline-flex; align-items: center; gap: 10px; font-size: 18px !important; }
  .hizli-ust-dugmeler { display: inline-flex; align-items: center; gap: 4px; }
  .hizli-alt { margin: -8px 0 10px !important; font-size: 13px; }
  .hizli-durum-seridi { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 10px 12px !important; }
  .hizli-tutar { margin-left: auto; font-size: 18px; }
  .hizli-siradaki { padding: 14px; border: 1px solid #ecd9bd; border-radius: 13px; background: #fffaf2; margin-bottom: 12px; }
  .hizli-siradaki h3 { display: flex; align-items: center; gap: 6px; margin: 0 0 8px !important; font-size: 14.5px !important; color: var(--y-gold-ink); }
  .hizli-siradaki :global(.btn--sepet), .hizli-ana-dugme { width: 100%; }
  .hizli-uyarilar { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .hizli-aksiyon-listesi { display: grid; gap: 6px; margin-bottom: 12px; }
