---
import Yonetim from '../../layouts/Yonetim.astro';
import { formatTL } from '../../lib/fiyat';
import { iadeEdildi } from '../../lib/siparisAkisi';
import { yTarih } from '../../lib/yonetimRapor';
import { finansGunu, kalanTutar, raporla } from '../../lib/finans';
import { KANALLAR, KANAL_LISTESI, PY_DURUM_ADLARI, PY_DURUM_RENK, kurusTL } from '../../lib/pazaryeri';
import { pazaryeriApiDurumu } from '../../lib/pazaryeriApi';
import { kanalToplamlari } from '../../lib/kanalOzeti';
import KanalOzeti from '../../components/yonetim/KanalOzeti.astro';
import BilgiKutusu from '../../components/yonetim/BilgiKutusu.astro';
import PIkon from '../../components/yonetim/PIkon.astro';
import KanalLogo from '../../components/yonetim/KanalLogo.astro';
import { panelIsleriniOku } from '../../lib/panelIsleri';

const { siparisler, finans, pazar, envanter, yedekGun, hazirlanacak, kargolanacak, faturasiz, kanalHatasi, kanalGecikti, tukenen, kritikStok, isler, pazarHazirlanacak } = await panelIsleriniOku();
const bugun = finansGunu();
const bugunRapor = raporla(finans, siparisler, bugun, bugun);
const ayRapor = raporla(finans, siparisler, bugun.slice(0, 7) + '-01', bugun);
const ayKalan = kalanTutar(ayRapor);

const ayOzeti = kanalToplamlari(siparisler, pazar, bugun.slice(0, 7) + '-01', bugun);
const bugunOzeti = kanalToplamlari(siparisler, pazar, bugun, bugun);
const tarihBaslik = new Intl.DateTimeFormat('tr-TR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' }).format(new Date());
const durumYazi = (s: (typeof siparisler)[number]) => iadeEdildi(s) ? ['İade edildi', 'gri'] : s.durum === 'iptal' ? ['İptal', 'gri']
  : s.durum === 'odeme-bekliyor' ? ['Ödeme bekleniyor', 'turuncu'] : s.durum === 'odendi' ? ['Hazırlanacak', 'turuncu']
  : s.durum === 'hazirlaniyor' ? ['Kargoya verilecek', 'turuncu'] : s.durum === 'kargoda' ? ['Kargoda', 'yesil'] : ['Teslim edildi', 'yesil'];
/* Son siparişler: üç kanal birlikte, en yeni 8 */
const sonSiparisler = [
  ...siparisler.slice(0, 8).map((s) => { const [d, r] = durumYazi(s); return {
    tarih: s.tarih, no: s.no, url: '/yonetim/siparisler/' + s.no, kanal: 'web', kanalAd: 'Web sitesi',
    musteri: `${s.musteri.ad} ${s.musteri.soyad}`, tutar: formatTL(s.toplam), durum: d!, renk: r!,
  }; }),
  ...pazar.slice(0, 8).map((s) => ({
    tarih: s.tarih, no: s.siparisNo, url: '/yonetim/siparisler/pazaryeri/' + encodeURIComponent(s.id), kanal: s.kanal, kanalAd: KANALLAR[s.kanal],
    musteri: s.musteri ?? '—', tutar: kurusTL(s.toplam), durum: PY_DURUM_ADLARI[s.durum], renk: PY_DURUM_RENK[s.durum],
  })),
].sort((a, b) => Date.parse(b.tarih) - Date.parse(a.tarih)).slice(0, 8);
const ayBaslangici = bugun.slice(0, 7) + '-01';
const satisAdresi = (baslangic: string, kanal = 'tumu') => '/yonetim/siparisler?' + new URLSearchParams({ durum: 'tumu', kanal, baslangic, bitis: bugun });
const kanalAdresi = (k: string) => satisAdresi(ayBaslangici, k);
const pazaryeriKurulu = KANAL_LISTESI.some((k) => pazaryeriApiDurumu(k) !== 'kapali' || envanter.kanallar[k].stokBaslangic) || pazar.length > 0;
const hazirAdet = hazirlanacak.length + kargolanacak.length + KANAL_LISTESI.reduce((n, k) => n + pazarHazirlanacak(k), 0);
const acil = isler.filter((x) => x.ton === 'kirmizi');
const stokUyarilari = [...tukenen, ...kritikStok];
const tadilat = Astro.locals.katalog?.site.tadilat.aktif;
---
<Yonetim baslik="İş Merkezi" altBaslik={`${tarihBaslik} · Siparişler, stok, kanallar ve satışlar tek ekranda.`} aktif="ozet">
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <a class="btn btn--cizgi" href="/yonetim/urunler/yeni"><PIkon ad="arti" boyut={18} />Yeni ürün</a>
    <a class="btn btn--sepet" href="/yonetim/isler"><PIkon ad="takvim-tik" boyut={18} />Bugünkü işler</a>
  </div>

  <section class="y-kart">
    <div class="y-kart__bas"><h2><PIkon ad="takvim-tik" /> Bugün ne yapmalıyım?</h2><a class="y-link" href="/yonetim/isler">Tüm görevler</a></div>
    <div class="y-metrics y-merkez-gorevler">
      <a class="y-metric y-metric--turuncu" href="/yonetim/siparisler?durum=islem&amp;kanal=tumu"><PIkon ad="kutu" /><strong>{hazirAdet}</strong><span>Sipariş kuyruğu</span><small>Hazırlanacak ve kargolanacak · tüm kanallar</small></a>
      <a class="y-metric y-metric--yesil" href="/yonetim/siparisler?durum=hazirlaniyor&amp;kanal=web"><PIkon ad="kargo" /><strong>{kargolanacak.length}</strong><span>Kargoya verilecek</span><small>Hazırlanmış web siparişi</small></a>
      <a class="y-metric y-metric--kirmizi" href="/yonetim/finans/faturalar"><PIkon ad="fatura" /><strong>{faturasiz.length}</strong><span>Faturası kesilecek</span><small>GİB'de düzenlenip kaydedilmeli</small></a>
      <a class="y-metric y-metric--altin" href="/yonetim/urunler?filtre=kritik"><PIkon ad="uyari" /><strong>{stokUyarilari.length}</strong><span>Stok uyarısı</span><small>{tukenen.length} tükendi · {kritikStok.length} azaldı</small></a>
      <a class="y-metric y-metric--mavi" href="/yonetim/isler#acil-isler"><PIkon ad="kalkan" /><strong>{acil.length}</strong><span>Acil görev</span><small>Önce bunlara bakın</small></a>
    </div>
  </section>

  {!pazaryeriKurulu && <BilgiKutusu baslik="Pazaryeri bağlantı rehberi" anahtar="genel-pazaryeri" ton="ipucu" acik={false}>
    <p>Mağaza bağlantısı, stok başlangıcı ve otomatik eşitleme durumunu <a class="y-link" href="/yonetim/siparisler/kanallar">Satış kanalları</a> ekranından yönetin.</p>
  </BilgiKutusu>}

  <div class="y-merkez-izgara">
    <section class="y-kart">
      <div class="y-kart__bas"><h2><PIkon ad="pano" /> Görev kuyruğu</h2><a class="y-link" href="/yonetim/isler">Tümünü gör</a></div>
      {isler.length === 0 ? <p class="y-bos-satir"><PIkon ad="tik-daire" boyut={20} />Bekleyen iş yok. Her şey yolunda.</p> : <ul class="y-satir-liste">
        {isler.slice(0, 5).map((x) => <li><a href={x.url}>
          <i class:list={['y-ton-nokta', 'y-ton-nokta--' + x.ton]} aria-hidden="true"></i>
          <span class="y-satir__ana"><strong title={x.ad}>{x.ad}</strong></span>
          <b class:list={['y-chip', 'y-chip--' + x.ton]}>{x.sayi}</b>
        </a></li>)}
      </ul>}
      <p class="y-kart-dipnot"><PIkon ad="veritabani" boyut={16} />
        Veri yedeği: {yedekGun === undefined ? 'henüz alınmadı' : yedekGun === 0 ? 'bugün alındı' : yedekGun + ' gün önce alındı'} ·
        <a class="y-link" href="/yonetim/yedek">Yedek indir (ZIP)</a>
      </p>
    </section>
    <section class="y-kart">
      <div class="y-kart__bas"><h2><PIkon ad="zincir" /> Kanal durumu</h2><a class="y-link" href="/yonetim/siparisler/kanallar">Kanalları yönet</a></div>
      <ul class="y-satir-liste">
        <li><a href="/yonetim/siparisler?durum=tumu&amp;kanal=web">
          <KanalLogo kanal="web" />
          <span class="y-satir__ana"><strong>Web sitesi</strong><small>alluluhome.com</small></span>
          <b class:list={['y-chip', 'y-chip--nokta', tadilat ? 'y-chip--turuncu' : 'y-chip--yesil']}>{tadilat ? 'Bakımda' : 'Yayında'}</b>
        </a></li>
        {KANAL_LISTESI.map((k) => {
          const son = envanter.kanallar[k].sonApi;
          const api = pazaryeriApiDurumu(k);
          const [durum, ton] = kanalHatasi.includes(k) ? ['Hata var', 'kirmizi'] : api === 'kapali' || api === 'eksik' ? ['Kurulum bekliyor', 'gri'] : kanalGecikti.includes(k) ? [son ? 'Eşitleme gecikti' : 'İlk eşitleme bekleniyor', 'turuncu'] : api === 'test' ? ['Test', 'gri'] : !son ? ['İlk çekim bekleniyor', 'turuncu'] : ['Bağlı', 'yesil'];
          return <li><a href={'/yonetim/siparisler/kanallar#' + k}>
            <KanalLogo kanal={k} />
            <span class="y-satir__ana"><strong>{KANALLAR[k]}</strong><small>Son çekim: {son ? yTarih.format(new Date(son)) : 'henüz yok'}</small></span>
            <b class:list={['y-chip', 'y-chip--nokta', 'y-chip--' + ton]}>{durum}</b>
          </a></li>;
        })}
      </ul>
    </section>
    <section class="y-kart">
      <div class="y-kart__bas"><h2><PIkon ad="katman" /> Stok uyarıları</h2><a class="y-link" href="/yonetim/urunler?filtre=kritik">Tümünü gör</a></div>
      {stokUyarilari.length ? <ul class="y-satir-liste y-satir-liste--uyari">{stokUyarilari.slice(0, 4).map((u) => <li><a href={'/yonetim/urunler/' + u.id + '?bolum=fiyat'} class:list={{ 'is-azalan': u.stok > 0 }}>
        <span class="y-satir-gorsel">{u.gorseller[0] ? <img src={u.gorseller[0].src} alt="" loading="lazy" /> : <PIkon ad="kutu" boyut={20} />}</span>
        <span class="y-satir__ana"><strong title={`${u.marka} ${u.kisaAd}`}>{u.marka} {u.kisaAd}</strong><small class:list={[u.stok === 0 ? 'y-yazi-kirmizi' : 'y-yazi-turuncu']}>{u.stok === 0 ? 'Tükendi · sitede “stokta yok”' : `${u.stok} adet kaldı`}</small></span>
        <b class:list={['y-chip', u.stok === 0 ? 'y-chip--kirmizi' : 'y-chip--turuncu']}>{u.stok === 0 ? 'Tükendi' : 'Azaldı'}</b>
      </a></li>)}</ul> : <p class="y-bos-satir"><PIkon ad="tik-daire" boyut={20} />Kritik stok uyarısı yok.</p>}
      {stokUyarilari.length > 4 && <p class="y-kart-dipnot">+{stokUyarilari.length - 4} ürün daha · <a class="y-link" href="/yonetim/urunler?filtre=kritik">Listeyi aç</a></p>}
    </section>
  </div>

  <section class="y-kart">
    <div class="y-kart__bas"><h2><PIkon ad="grafik" /> Satış özeti</h2><a class="y-link" href="/yonetim/finans">Finans ve belgeler</a></div>
    <div class="y-metrics y-metrics--finans y-merkez-satis">
      <a class="y-metric" href={satisAdresi(bugun)}><PIkon ad="trend" /><span>Bugünkü satış · tüm kanallar</span><strong>{kurusTL(bugunOzeti.toplam.kurus)}</strong><small>{bugunOzeti.toplam.adet} sipariş{bugunRapor.webIade > 0 ? ' · web iadesi ' + kurusTL(bugunRapor.webIade) : ''}</small></a>
      <a class="y-metric" href={satisAdresi(ayBaslangici)}><PIkon ad="grafik" /><span>Bu ay satış · tüm kanallar</span><strong>{kurusTL(ayOzeti.toplam.kurus)}</strong><small>{ayOzeti.toplam.adet} sipariş</small></a>
      <a class="y-metric" href="/yonetim/finans?sekme=giderler"><PIkon ad="cuzdan" /><span>Bu ay gider</span><strong>{kurusTL(ayRapor.gider)}</strong><small>{ayRapor.giderler.length} kayıt</small></a>
      <a class="y-metric" href="/yonetim/finans?sekme=ozet#ay-hesabi"><PIkon ad="para" /><span>Bu ay kalan (tahmini · web)</span><strong>{kurusTL(ayKalan)}</strong>
        <small class:list={{ 'y-uyari-kucuk': ayRapor.tahmini === undefined }}>{ayRapor.tahmini === undefined ? 'Ürün maliyeti girilmedi' : 'Giderler düşüldü'}</small></a>
    </div>
    <KanalOzeti ozet={ayOzeti} donem="Bu ay" adres={kanalAdresi} />
  </section>

  <section class="y-kart" aria-label="Hızlı işlemler">
    <div class="y-kart__bas"><h2><PIkon ad="simsek" /> Hızlı işlemler</h2></div>
    <div class="y-hizli-islemler">
      <a class="btn btn--sepet" href="/yonetim/siparisler?durum=islem"><PIkon ad="sepet" boyut={19} />Siparişleri işle</a>
      <a class="btn btn--cizgi" href="/yonetim/urunler/yeni"><PIkon ad="kutu" boyut={19} />Yeni ürün</a>
      <a class="btn btn--cizgi" href="/yonetim/siparisler/kanallar"><PIkon ad="yenile" boyut={19} />Stok ve kanal eşitleme</a>
      <a class="btn btn--cizgi" href="/yonetim/finans/faturalar"><PIkon ad="fatura" boyut={19} />Fatura kaydı</a>
      <a class="btn btn--cizgi" href="/yonetim/siparisler/trendyol-urunler"><PIkon ad="etiket" boyut={19} />Trendyol ürünleri</a>
      <a class="btn btn--cizgi" href="/yonetim/finans?sekme=giderler&amp;yeni=diger"><PIkon ad="cuzdan" boyut={19} />Gider ekle</a>
      <a class="btn btn--cizgi" href="/yonetim/finans?sekme=raporlar"><PIkon ad="indir" boyut={19} />Muhasebeci raporu</a>
    </div>
  </section>

  <section class="y-kart">
    <div class="y-kart__bas"><h2><PIkon ad="gecmis" /> Güncel sipariş akışı</h2><a class="y-link" href="/yonetim/siparisler?durum=tumu">Tüm siparişler</a></div>
    {sonSiparisler.length ? <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo">
      <thead><tr><th>Sipariş no</th><th>Kanal</th><th>Müşteri</th><th class="y-sayi">Tutar</th><th>Durum</th><th>Tarih</th><th class="y-islem"><span class="visually-hidden">Aç</span></th></tr></thead>
      <tbody>{sonSiparisler.map((s) => <tr>
        <td data-etiket="Sipariş" class="y-nowrap y-siparis-no"><a class="y-link" href={s.url}><strong>{s.no}</strong></a></td>
        <td data-etiket="Kanal"><span class:list={['kanal-etiket', 'kanal-etiket--' + s.kanal]}>{s.kanalAd}</span></td>
        <td data-etiket="Müşteri">{s.musteri}</td>
        <td data-etiket="Tutar" class="y-sayi y-nowrap"><strong>{s.tutar}</strong></td>
        <td data-etiket="Durum"><span class:list={['y-chip', 'y-chip--' + s.renk]}>{s.durum}</span></td>
        <td data-etiket="Tarih" class="y-nowrap">{yTarih.format(new Date(s.tarih))}</td>
        <td class="y-islem"><a class="y-satir-ok" href={s.url} aria-label={s.no + ' siparişini aç'}><PIkon ad="sag" boyut={18} /></a></td>
      </tr>)}</tbody>
    </table></div> : <p class="y-bos-satir"><PIkon ad="sepet" boyut={20} />Henüz sipariş yok.</p>}
  </section>

</Yonetim>
