---
import Yonetim from '../../layouts/Yonetim.astro';
import { magazaOku, siparisleriOku } from '../../lib/depo';
import { formatTL } from '../../lib/fiyat';
import { Katalog } from '../../lib/katalog';
import { iadeEdildi } from '../../lib/siparisAkisi';
import { onayliSatis, yTarih } from '../../lib/yonetimRapor';
import { finansOku } from '../../lib/finansDepo';
import { belgeGecerli, finansGunu, finansPara, hakEdis, raporla } from '../../lib/finans';
import { YEDEK_ARALIGI_GUN, sonYedekTarihi } from '../../lib/yedek';
import { tumYorumlar } from '../../lib/yorum';
import { KANALLAR, KANAL_LISTESI, PY_DURUM_ADLARI, PY_DURUM_RENK, bosAyarlar, kritikEsik, kurusTL } from '../../lib/pazaryeri';
import { envanterAyarlariOku, pazaryeriSiparisleriOku } from '../../lib/pazaryeriDepo';
import { pazaryeriApiDurumu } from '../../lib/pazaryeriApi';
import { pazaryeriDurumu } from '../../components/yonetim/pazaryeriGorunumu';
import { kanalToplamlari } from '../../lib/kanalOzeti';
import KanalOzeti from '../../components/yonetim/KanalOzeti.astro';
import BilgiKutusu from '../../components/yonetim/BilgiKutusu.astro';

const [m, tum, finans, sonYedek, yorumlar, pazar, envanter] = await Promise.all([
  magazaOku(), siparisleriOku(), finansOku(), sonYedekTarihi().catch(() => undefined), tumYorumlar().catch(() => []),
  pazaryeriSiparisleriOku().catch(() => []), envanterAyarlariOku().catch(() => bosAyarlar()),
]);
const bekleyenYorum = yorumlar.filter((y) => y.durum === 'bekliyor').length;
const yedekGun = sonYedek ? Math.floor((Date.now() - Date.parse(sonYedek)) / 86_400_000) : undefined;
const yedekGerekli = yedekGun === undefined || yedekGun >= YEDEK_ARALIGI_GUN;
const siparisler = tum.filter((s) => !s.paytr?.test).sort((a, b) => Date.parse(b.tarih) - Date.parse(a.tarih));
const bugun = finansGunu();
const bugunRapor = raporla(finans, siparisler, bugun, bugun);
const ayRapor = raporla(finans, siparisler, bugun.slice(0, 7) + '-01', bugun);
const ayKalan = ayRapor.webSatis - ayRapor.webIade + ayRapor.trendyolBeklenen - ayRapor.gider;

const hazirlanacak = siparisler.filter((s) => s.durum === 'odendi' && !s.paytr?.stokEksik);
const kargolanacak = siparisler.filter((s) => s.durum === 'hazirlaniyor');
const belgesiz = siparisler.filter((s) => onayliSatis(s) && !finans.belgeler.some((b) => b.siparisNo === s.no && belgeGecerli(b)));
const odemeKontrol = siparisler.filter((s) => s.durum === 'odeme-bekliyor' && !s.paytr);
const stokUyusmazligi = siparisler.filter((s) => s.paytr?.stokEksik && s.durum !== 'iptal' && !iadeEdildi(s));
const iptalKargo = siparisler.filter((s) => s.durum === 'iptal' && s.kargoTakip);
const belgeHatasi = finans.belgeler.filter((b) => b.durum === 'hata');
const trendyolBekleyen = finans.trendyol.filter((x) => x.banka === undefined);
const tukenen = m.urunler.filter((u) => u.durum === 'yayinda' && u.stok === 0);
const kritikStok = m.urunler.filter((u) => u.durum === 'yayinda' && u.stok > 0 && u.stok <= kritikEsik(envanter, u.id));
const simdi = Date.now();
const urunIdleri = new Set(m.urunler.map((u) => u.id));
const pazarDurum = pazar.map((s) => ({ s, d: pazaryeriDurumu(s, simdi, urunIdleri) }));
const pazarHazirlanacak = (k: string) => pazarDurum.filter(({ s, d }) => s.kanal === k && (d.hazirlanacak || d.hazirlaniyor)).length;
const pazarKontrol = pazarDurum.filter(({ d }) => d.uyari.some((u) => u.renk === 'kirmizi')).length;
const kanalHatasi = KANAL_LISTESI.filter((k) => envanter.kanallar[k].sonApiHata || envanter.kanallar[k].sonStokHata);
const kanalGecikti = KANAL_LISTESI.filter((k) => {
  const a = envanter.kanallar[k];
  return pazaryeriApiDurumu(k) !== 'kapali' && a.stokBaslangic && !kanalHatasi.includes(k)
    && (!a.sonApi || simdi - Date.parse(a.sonApi) > 30 * 60_000);
});
const ayOzeti = kanalToplamlari(siparisler, pazar, bugun.slice(0, 7) + '-01', bugun);
const bugunOzeti = kanalToplamlari(siparisler, pazar, bugun, bugun);
const fotosuz = m.urunler.filter((u) => !u.gorseller.length && u.durum === 'yayinda');
const k = new Katalog(m);
const taslakSetler = m.setler.filter((s) => s.durum === 'taslak' && k.setEngelleri(s).length === 0);

type Is = { ad: string; sayi: number | string; url: string; ton: 'turuncu' | 'kirmizi' | 'gri' };
const isler = ([
  { ad: 'Ödeme alındı, stok ayrılamadı', sayi: stokUyusmazligi.length, url: stokUyusmazligi.length === 1 ? '/yonetim/siparisler/' + stokUyusmazligi[0]!.no : '/yonetim/siparisler?durum=odendi', ton: 'kirmizi' },
  { ad: 'İptal edildi ama kargo takip numarası var', sayi: iptalKargo.length, url: iptalKargo.length === 1 ? '/yonetim/siparisler/' + iptalKargo[0]!.no : '/yonetim/siparisler?durum=iptal', ton: 'kirmizi' },
  { ad: 'Hazırlanacak siparişler', sayi: hazirlanacak.length, url: '/yonetim/siparisler?durum=odendi', ton: 'turuncu' },
  { ad: 'Kargoya verilecek siparişler', sayi: kargolanacak.length, url: '/yonetim/siparisler?durum=hazirlaniyor', ton: 'turuncu' },
  { ad: 'Belgesi hazırlanmamış siparişler', sayi: belgesiz.length, url: '/yonetim/siparisler?durum=belgesiz', ton: 'turuncu' },
  { ad: 'Hata veren belgeler (yeniden dene)', sayi: belgeHatasi.length, url: '/yonetim/finans?sekme=belgeler', ton: 'kirmizi' },
  { ad: 'Ödemesi kontrol edilecek (havale/EFT)', sayi: odemeKontrol.length, url: '/yonetim/siparisler?durum=odeme-bekliyor', ton: 'turuncu' },
  { ad: 'Ödemesi beklenen Trendyol hakedişi', sayi: trendyolBekleyen.length ? finansPara(trendyolBekleyen.reduce((t, x) => t + hakEdis(x), 0)) : 0, url: '/yonetim/finans?sekme=trendyol', ton: 'gri' },
  ...kanalHatasi.map((k) => ({ ad: `${KANALLAR[k]} bağlantısında sorun var (ayrıntıyı görmek için dokunun)`, sayi: '!', url: '/yonetim/siparisler/kanallar#' + k, ton: 'kirmizi' as const })),
  { ad: 'Pazaryeri siparişinde stok açığı / eşleşmeyen ürün', sayi: pazarKontrol, url: '/yonetim/siparisler?durum=kontrol', ton: 'kirmizi' },
  ...KANAL_LISTESI.map((k) => ({ ad: `${KANALLAR[k]} siparişi hazırlanacak (kargo ${KANALLAR[k]} panelinden)`, sayi: pazarHazirlanacak(k), url: `/yonetim/siparisler?kanal=${k}&durum=islem`, ton: 'turuncu' as const })),
  ...kanalGecikti.map((k) => ({ ad: `${KANALLAR[k]} siparişleri 30 dakikadır güncellenmedi`, sayi: '!', url: '/yonetim/siparisler/kanallar#' + k, ton: 'turuncu' as const })),
  { ad: 'Onay bekleyen müşteri değerlendirmesi', sayi: bekleyenYorum, url: '/yonetim/yorumlar', ton: 'turuncu' },
  { ad: 'Tükenen ürün (sitede “stokta yok” görünüyor)', sayi: tukenen.length, url: '/yonetim/urunler?filtre=kritik', ton: 'kirmizi' },
  { ad: `Azalan stok (${envanter.kritikVarsayilan} adet ve altı)`, sayi: kritikStok.length, url: '/yonetim/urunler?filtre=kritik', ton: 'turuncu' },
  { ad: 'Yayındaki üründe fotoğraf eksik', sayi: fotosuz.length, url: fotosuz.length === 1 ? '/yonetim/urunler/' + fotosuz[0]!.id + '?bolum=fotograf' : '/yonetim/urunler', ton: 'gri' },
  { ad: 'Yayına hazır taslak set', sayi: taslakSetler.length, url: '/yonetim/setler', ton: 'gri' },
  { ad: yedekGun === undefined ? 'Veri yedeği hiç alınmadı (indir)' : `Aylık veri yedeği zamanı (son: ${yedekGun} gün önce)`, sayi: yedekGerekli ? '!' : 0, url: '/yonetim/yedek', ton: 'turuncu' },
] satisfies Is[]).filter((x) => x.sayi !== 0);
const tarihBaslik = new Intl.DateTimeFormat('tr-TR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' }).format(new Date());
const durumYazi = (s: (typeof siparisler)[number]) => iadeEdildi(s) ? ['İade edildi', 'gri'] : s.durum === 'iptal' ? ['İptal', 'gri']
  : s.durum === 'odeme-bekliyor' ? ['Ödeme bekleniyor', 'turuncu'] : s.durum === 'odendi' ? ['Hazırlanacak', 'turuncu']
  : s.durum === 'hazirlaniyor' ? ['Kargoya verilecek', 'turuncu'] : s.durum === 'kargoda' ? ['Kargoda', 'yesil'] : ['Teslim edildi', 'yesil'];
/* Son siparişler: üç kanal birlikte, en yeni 8 */
const sonSiparisler = [
  ...siparisler.slice(0, 8).map((s) => { const [d, r] = durumYazi(s); return {
    tarih: s.tarih, no: s.no, url: '/yonetim/siparisler/' + s.no, kanal: 'web', kanalAd: 'Web sitesi',
    musteri: `${s.musteri.ad} ${s.musteri.soyad}`, tutar: formatTL(s.toplam), durum: d!, renk: r!,
  }; }),
  ...pazar.slice(0, 8).map((s) => ({
    tarih: s.tarih, no: s.siparisNo, url: '/yonetim/siparisler/pazaryeri/' + encodeURIComponent(s.id), kanal: s.kanal, kanalAd: KANALLAR[s.kanal],
    musteri: s.musteri ?? '—', tutar: kurusTL(s.toplam), durum: PY_DURUM_ADLARI[s.durum], renk: PY_DURUM_RENK[s.durum],
  })),
].sort((a, b) => Date.parse(b.tarih) - Date.parse(a.tarih)).slice(0, 8);
const kanalAdresi = (k: string) => '/yonetim/siparisler?durum=tumu' + (k === 'tumu' ? '' : '&kanal=' + k);
const pazaryeriKurulu = KANAL_LISTESI.some((k) => pazaryeriApiDurumu(k) !== 'kapali' || envanter.kanallar[k].stokBaslangic) || pazar.length > 0;
---
<Yonetim baslik="Genel Bakış" altBaslik={tarihBaslik} aktif="ozet">
  <div class="y-metrics y-metrics--finans">
    <a class="y-metric" href="/yonetim/siparisler?durum=tumu"><span>Bugünkü satış · tüm kanallar</span><strong>{kurusTL(bugunOzeti.toplam.kurus)}</strong><small>{bugunOzeti.toplam.adet} sipariş{bugunRapor.webIade > 0 ? ' · web iadesi ' + kurusTL(bugunRapor.webIade) : ''}</small></a>
    <a class="y-metric" href="/yonetim/siparisler?durum=tumu"><span>Bu ay satış · tüm kanallar</span><strong>{kurusTL(ayOzeti.toplam.kurus)}</strong><small>{ayOzeti.toplam.adet} sipariş</small></a>
    <a class="y-metric" href="/yonetim/finans?sekme=giderler"><span>Bu ay gider</span><strong>{kurusTL(ayRapor.gider)}</strong><small>{ayRapor.giderler.length} kayıt</small></a>
    <a class="y-metric" href="/yonetim/finans?sekme=ozet#ay-hesabi"><span>Bu ay kalan (tahmini · web)</span><strong>{kurusTL(ayKalan)}</strong>
      <small class:list={{ 'y-uyari-kucuk': ayRapor.tahmini === undefined }}>{ayRapor.tahmini === undefined ? 'Ürün maliyeti girilmedi' : 'Giderler düşüldü'}</small></a>
  </div>

  <KanalOzeti ozet={ayOzeti} donem="Bu ay" adres={kanalAdresi} />

  {!pazaryeriKurulu && <BilgiKutusu baslik="Trendyol ve Hepsiburada siparişleri buraya nasıl gelecek?" anahtar="genel-pazaryeri" ton="ipucu">
    <p>Mağazalar açılınca siparişler bu panele <strong>kendiliğinden</strong> gelir; ayrı bir yere bakmanıza gerek kalmaz. Kurulum bir kere yapılır.</p>
    <p><a class="y-link" href="/yonetim/siparisler/kanallar">Satış kanalları → adım adım kurulum</a></p>
  </BilgiKutusu>}

  <section class="y-kart">
    <h2>Bugün yapılacaklar</h2>
    {isler.length === 0 ? <p class="muted">Bekleyen iş yok. Her şey yolunda.</p> : <ul class="y-is-listesi">
      {isler.map((x) => <li><a href={x.url}>
        <span>{x.ad}</span>
        <b class:list={['y-chip', 'y-chip--' + x.ton]}>{x.sayi}</b>
      </a></li>)}
    </ul>}
    <p class="muted" style="margin-top:12px;font-size:13px">
      Veri yedeği: {yedekGun === undefined ? 'henüz alınmadı' : yedekGun === 0 ? 'bugün alındı' : yedekGun + ' gün önce alındı'} ·
      <a class="y-link" href="/yonetim/yedek">Yedek indir (ZIP)</a>
    </p>
  </section>

  <section class="y-kart">
    <div class="y-kart__bas"><h2>Son siparişler</h2><a class="y-link" href="/yonetim/siparisler?durum=tumu">Tümü</a></div>
    {sonSiparisler.length ? <div class="y-tablo-kap y-tablo-kap--kart"><table class="y-tablo">
      <thead><tr><th>Sipariş</th><th>Müşteri</th><th class="y-sayi">Tutar</th><th>Durum</th></tr></thead>
      <tbody>{sonSiparisler.map((s) => <tr>
        <td data-etiket="Sipariş" class="y-nowrap"><a class="y-link" href={s.url}>{s.no}</a><small class="y-table-note"><span class:list={['kanal-etiket', 'kanal-etiket--' + s.kanal]}>{s.kanalAd}</span> · {yTarih.format(new Date(s.tarih))}</small></td>
        <td data-etiket="Müşteri">{s.musteri}</td>
        <td data-etiket="Tutar" class="y-sayi y-nowrap">{s.tutar}</td>
        <td data-etiket="Durum"><span class:list={['y-chip', 'y-chip--' + s.renk]}>{s.durum}</span></td>
      </tr>)}</tbody>
    </table></div> : <p class="muted">Henüz sipariş yok.</p>}
  </section>

  <section class="y-quick">
    <a class="btn btn--sepet" href="/yonetim/urunler/yeni">Yeni ürün</a>
    <a class="btn btn--cizgi" href="/yonetim/finans?sekme=giderler&yeni=diger">Gider ekle</a>
    <a class="btn btn--cizgi" href="/yonetim/finans?sekme=raporlar">Muhasebeci raporu</a>
  </section>
</Yonetim>
