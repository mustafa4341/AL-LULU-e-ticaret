---
import Yonetim from '../../layouts/Yonetim.astro';
import { DogrulamaHatasi, magazaGuncelle, magazaOku, supabaseBagliMi } from '../../lib/depo';
import { metin, sayi } from '../../lib/form';
import { bosYasalBilgi } from '../../lib/yonetimSite';

const mevcut = (await magazaOku()).site;
let satici = mevcut.satici;
let iade = mevcut.iadeGun;
let hatalar: string[] = [];
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  satici = {
    unvan: metin(f, 'unvan'), adres: metin(f, 'adres'), mersis: metin(f, 'mersis'),
    vergiDairesiNo: metin(f, 'vergiDairesiNo'), kep: metin(f, 'kep'), etbis: metin(f, 'etbis'),
  };
  iade = sayi(f, 'iadeGun', mevcut.iadeGun);
  try {
    await magazaGuncelle((m) => { m.site.satici = satici; m.site.iadeGun = iade; });
    return Astro.redirect('/yonetim/ayarlar?ok=' + encodeURIComponent('Yasal bilgiler kaydedildi.'), 303);
  } catch (e) {
    hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
  }
}
const alanlar = [
  ['unvan', 'Ticari unvan'], ['adres', 'Açık adres'], ['mersis', 'MERSİS no'],
  ['vergiDairesiNo', 'Vergi dairesi ve numarası'], ['kep', 'KEP adresi'], ['etbis', 'ETBİS kayıt no'],
] as const;
const eksik = alanlar.slice(0, 4).filter(([id]) => bosYasalBilgi(satici[id])).map(([, ad]) => ad);
---
<Yonetim baslik="Ayarlar" aktif="ayarlar" basari={Astro.url.searchParams.get('ok')} hatalar={hatalar}>
  <button slot="ust-sag" type="submit" form="yasal-form" class="btn btn--sepet">Kaydet</button>
  <form method="post" id="yasal-form" class="y-kart" data-editor>
    <h2>Yasal Bilgiler</h2>
    {eksik.length > 0 && <p class="y-uyari">Tamamlanacak alanlar · {eksik.join(', ')}</p>}
    <div class="y-izgara y-izgara--2">
      {alanlar.map(([id, ad]) => <label class="y-alan">{ad}<input name={id} value={satici[id]} /></label>)}
      <label class="y-alan">Cayma ve iade süresi (gün)<input name="iadeGun" type="number" min="1" value={iade} /></label>
    </div>
    <p class="y-form-state" data-kayit-durum role="status"></p>
  </form>
  <details class="y-kart">
    <summary>Bağlantı ve erişim</summary>
    <p class="muted">{supabaseBagliMi() ? 'Depo yapılandırması · Supabase' : 'Depo yapılandırması · Yerel dosya'}</p>
    <p class="muted">Yönetim işlemleri oturum gerektirir.</p>
  </details>
</Yonetim>
