---
import Yonetim from '../../layouts/Yonetim.astro';
import PIkon from '../../components/yonetim/PIkon.astro';
import Ikon from '../../components/Ikon.astro';
import Onizleme from '../../components/yonetim/Onizleme.astro';
import Sekmeler from '../../components/yonetim/Sekmeler.astro';
import { DogrulamaHatasi, magazaGuncelle, magazaOku } from '../../lib/depo';
import { formatTL } from '../../lib/fiyat';
import { liste, metin } from '../../lib/form';
import { BOLUMLER, BOLUM_ADLARI } from '../../lib/sema';
import { KARGO_SABLONLARI } from '../../lib/kargoTakip';
import { SITE_SEKMELERI, siteFormu } from '../../lib/yonetimSite';

const basari = Astro.url.searchParams.get('ok');
const sekmeler = new Map(SITE_SEKMELERI);
let aktifBolum = Astro.url.searchParams.get('bolum') ?? 'anasayfa';
if (!sekmeler.has(aktifBolum)) aktifBolum = 'anasayfa';
let hatalar: string[] = [];
let m = await magazaOku();
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (sekmeler.has(metin(f, 'aktifBolum'))) aktifBolum = metin(f, 'aktifBolum');
  const degisen = [...new Set(liste(f, 'degisen').filter((id) => sekmeler.has(id)))];
  const bolumler = degisen.length ? degisen : [aktifBolum];
  try {
    await magazaGuncelle((m) => siteFormu(f, m, bolumler));
    const q = new URLSearchParams({ bolum: aktifBolum, ok: bolumler.map((id) => sekmeler.get(id)).join(', ') + ' kaydedildi.' });
    return Astro.redirect('/yonetim/site-duzeni?' + q, 303);
  } catch (e) {
    hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
    m = structuredClone(m);
    siteFormu(f, m, bolumler, true);
  }
}
const s = m.site;
const a = m.anaSayfa;
const t = s.tadilat;
const siraliBolumler = [...a.bolumler, ...BOLUMLER.filter((b) => !a.bolumler.includes(b))];
---
<Yonetim baslik="Mağaza Görünümü" altBaslik="Vitrin, kampanyalar, kargo, iletişim ve bakım ayarları." aktif="site" basari={basari} hatalar={hatalar}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    <button type="button" class="btn btn--cizgi" data-onizleme-ac aria-controls="site-onizleme" aria-expanded="false"><PIkon ad="goz" boyut={18} />Önizle</button>
    <button type="submit" form="site-ayar-form" class="btn btn--sepet"><PIkon ad="tik" boyut={18} />Kaydet</button>
  </div>
  <form id="bakim-form" method="post" action="/yonetim/tadilat">
    <input type="hidden" name="islem" value={t.aktif ? "kapat" : "ac"} />
    <input type="hidden" name="geri" value="/yonetim/site-duzeni?bolum=tadilat" />
  </form>
  <div class="y-editor-duzen" data-editor-duzen>
    <form method="post" id="site-ayar-form" class="y-editor-form" data-editor data-onizleme-form="site"><input type="hidden" name="aktifBolum" value={aktifBolum} />
      <Sekmeler secenekler={SITE_SEKMELERI} aktif={aktifBolum} />
      <!-- 1. TADİLAT MODU AYARLARI -->
      <section class="y-kart" id="tadilat-bolum" data-bolum="tadilat" hidden={aktifBolum !== "tadilat"} style="border-color:#E8C860">
        <h2><PIkon ad="anahtar" /> Bakım Modu</h2>


        <div class="y-maintenance-control">
          <p>{t.aktif ? "Müşteriler bakım ekranını görüyor." : "Müşteriler mağazaya erişebiliyor."}</p>
          <button type="submit" form="bakim-form" class="btn btn--tehlike btn--kucuk" data-onayla={t.aktif ? "Mağaza müşterilere tekrar açılsın mı?" : "Bakım modu yeni siparişleri durdurur. Site bakıma alınsın mı?"}>{t.aktif ? "Bakımı bitir" : "Bakımı başlat"}</button>
        </div>

        <div class="y-izgara y-izgara--2">
          <div class="y-alan">
            <label for="tadilat_baslik">Bakım Başlığı </label>
            <input
              id="tadilat_baslik"
              name="tadilat_baslik"
              value={t.baslik}
              data-site-demo-sekme="tadilat"
              data-alan-ipucu="Bakım Başlığı: Tadilat ekranının ortasındaki büyük ana başlıktır."
            />
          </div>
          <div class="y-alan">
            <label for="tadilat_sure">Tahmini Açılış Süresi <span class="y-ipucu">(isteğe bağlı)</span></label>
            <input
              id="tadilat_sure"
              name="tadilat_sure"
              value={t.tahminiSure}
              placeholder="Örn. Bugün saat 18:00 / 2 saat içinde"
              data-site-demo-sekme="tadilat"
              data-alan-ipucu="Tahmini Açılış Süresi: Doldurulursa bakım ekranında saat ikonuyla 'Tahmini açılış: ...' kutusu çıkar."
            />
          </div>
        </div>
        <div class="y-alan" style="margin-top:10px">
          <label for="tadilat_aciklama">Bakım Açıklaması </label>
          <textarea
            id="tadilat_aciklama"
            name="tadilat_aciklama"
            rows="2"
            data-site-demo-sekme="tadilat"
            data-alan-ipucu="Bakım Açıklaması: Müşteriye neden bakımda olduğunuzu anlatan sıcak bilgilendirme cümlesidir."
          >{t.aciklama}</textarea>
        </div>
        <div class="y-secimler" style="margin-top:10px">
          <label class="y-secim">
            <input type="checkbox" name="tadilat_wa" checked={t.whatsappGoster} data-site-demo-sekme="tadilat" />
            Bakım ekranında WhatsApp destek butonu göster
          </label>
          <label class="y-secim">
            <input type="checkbox" name="tadilat_takip" checked={t.siparisTakipAcik} data-site-demo-sekme="tadilat" />
            Mevcut müşteriler sipariş takip sayfasını kullanabilsin
          </label>
        </div>
      </section>

      <!-- 2. ANA SAYFA VİTRİNİ (HERO) VE BÖLÜM SIRALAMASI -->
      <section class="y-kart" id="anasayfa-bolum" data-bolum="anasayfa" hidden={aktifBolum !== "anasayfa"}>
        <h2><PIkon ad="duzen" /> Ana Sayfa</h2>


        <div class="y-izgara y-izgara--2">
          <div class="y-alan">
            <label for="heroUrun">Vitrinde Gösterilecek Ürün </label>
            <select
              id="heroUrun"
              name="heroUrun"
              data-site-demo-sekme="anasayfa"
              data-alan-ipucu="Vitrin Ürünü: Ana sayfanın en üstündeki büyük ürün fotoğrafı, fiyatı ve 'Şimdi Al / Sepete Ekle' butonları bu ürüne bağlanır."
            >
              {m.urunler.filter((u) => u.durum === "yayinda" || u.id === a.hero.urunId).map((u) => <option value={u.id} selected={a.hero.urunId === u.id}>{u.kisaAd} ({formatTL(u.fiyat)})</option>)}
            </select>
          </div>
          <div class="y-alan">
            <label for="heroUst">Görsel Üstü Küçük Etiket </label>
            <input
              id="heroUst"
              name="heroUst"
              value={a.hero.ustBaslik}
              placeholder="Öne çıkan ürün"
              data-site-demo-sekme="anasayfa"
              data-alan-ipucu="Görsel Üstü Etiket: Ürün 'En Çok Satan' değilse fotoğrafın sol üst köşesinde bu etiket görünür."
            />
          </div>
          <div class="y-alan">
            <label for="heroBaslik">Vitrin Ana Başlığı </label>
            <input
              id="heroBaslik"
              name="heroBaslik"
              value={a.hero.baslik}
              required
              data-site-demo-sekme="anasayfa"
              data-alan-ipucu="Vitrin Ana Başlığı: Ana sayfanın en dikkat çekici büyük başlığıdır."
            />
          </div>
          <div class="y-alan">
            <label for="heroAlt">Vitrin Alt Açıklaması </label>
            <input
              id="heroAlt"
              name="heroAlt"
              value={a.hero.altBaslik}
              data-site-demo-sekme="anasayfa"
              data-alan-ipucu="Vitrin Alt Açıklaması: Masaüstü ekranlarda ana başlığın hemen altında yer alan açıklama cümlesidir."
            />
          </div>
        </div>

        <div class="y-alan" style="margin-top:10px">
          <label for="heroMaddeler">Vitrindeki 3 Kısa Fayda Maddesi  <span class="y-ipucu">(her satıra bir madde, en fazla 3)</span></label>
          <textarea
            id="heroMaddeler"
            name="heroMaddeler"
            rows="3"
            data-site-demo-sekme="anasayfa"
            data-alan-ipucu="3 Kısa Fayda Maddesi: İlk ekranda fiyat kutusunun hemen üstünde renkli ikonlarla listelenir."
          >{a.hero.maddeler.join('\n')}</textarea>
        </div>

        <div class="y-izgara y-izgara--2" style="margin-top:10px">
          <div class="y-alan">
            <label for="oneCikanlarBaslik">"Öne Çıkan Ürünler" Bölüm Başlığı</label>
            <input id="oneCikanlarBaslik" name="oneCikanlarBaslik" value={a.oneCikanlarBaslik} data-site-demo-sekme="anasayfa" />
          </div>
          <div class="y-alan">
            <label for="setlerBaslik">"Setler & Fırsatlar" Bölüm Başlığı</label>
            <input id="setlerBaslik" name="setlerBaslik" value={a.setlerBaslik} data-site-demo-sekme="anasayfa" />
          </div>
        </div>

        <div class="y-alan" style="margin-top:14px">
          <span class="y-etiket">Ana Sayfa Bölümleri ve Sıralaması </span>
          <p class="y-ipucu">Gösterilmesini istediğiniz bölümleri işaretleyin, <strong>↑ / ↓</strong> oklarıyla yukarı veya aşağı taşıyın.</p>
          <div class="y-bolum-siralama-liste" data-bolum-siralayici>
            {siraliBolumler.map((b, idx) => {
              const aktifMi = a.bolumler.includes(b);
              return (
                <div class:list={['y-bolum-satir', { 'is-kapali': !aktifMi }]} data-bolum-oge>
                  <input type="hidden" name="bolum_kod" value={b} />
                  <input type="hidden" name="bolum_sira" value={idx + 1} data-bolum-sira-girdi />
                  <span class="y-bolum-no" data-bolum-no>{idx + 1}</span>
                  <label class="y-bolum-etiket">
                    <input type="checkbox" name="bolum" value={b} checked={aktifMi} data-bolum-aktif />
                    <strong>{BOLUM_ADLARI[b]}</strong>
                  </label>
                  <div class="y-bolum-oklar">
                    <button type="button" class="y-mini-btn" data-bolum-yukari title="Yukarı taşı" aria-label="Yukarı taşı">↑</button>
                    <button type="button" class="y-mini-btn" data-bolum-asagi title="Aşağı taşı" aria-label="Aşağı taşı">↓</button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- 3. DUYURU ŞERİDİ VE KAMPANYA KURALLARI -->
      <section class="y-kart" id="duyuru-bolum" data-bolum="duyuru" hidden={aktifBolum !== "duyuru"}>
        <h2><PIkon ad="zil" /> Duyurular ve fiyat görünümü</h2>

        <div class="y-alan">
          <label for="duyurular">Üst Şerit Duyuruları  <span class="y-ipucu">(her satır bir mesaj; otomatik sırayla döner)</span></label>
          <textarea
            id="duyurular"
            name="duyurular"
            rows="4"
            data-site-demo-sekme="anasayfa"
            data-alan-ipucu="Üst Şerit Duyuruları: Sitenin en tepesindeki koyu şeritte 4 saniyede bir sırayla dönen mesajlardır."
          >{s.duyurular.join('\n')}</textarea>
        </div>

        <div class="y-alan" style="margin-top:12px">
          <label for="fiyatSunumu">
            Fiyat ve İndirim Görünüm Stili <a class="y-ipucu" href="/yonetim/fiyat-onizleme" style="text-decoration:underline;font-weight:700">Üç stili yan yana karşılaştırın →</a>
          </label>
          <select id="fiyatSunumu" name="fiyatSunumu">
            <option value="dengeli" selected={s.fiyatSunumu === 'dengeli'}>C — Dengeli Premium (Önerilen: Bordo fiyat + yeşil TL kazanç)</option>
            <option value="sade" selected={s.fiyatSunumu === 'sade'}>A — Sade (Siyah fiyat + küçük üstü çizili eski fiyat)</option>
            <option value="kampanya" selected={s.fiyatSunumu === 'kampanya'}>B — Güçlü Kampanya (Kırmızı büyük % rozeti + tasarruf kutusu)</option>
          </select>
        </div>

        <div class="y-izgara y-izgara--3" style="margin-top:12px">
          <div class="y-alan">
            <label>Peşin Fiyatına Taksit Sayısı <span class="y-ipucu">(yoksa boş)</span></label>
            <input name="taksit" inputmode="numeric" value={s.taksit.pesinFiyatinaTaksit ?? ''} placeholder="Örn. 3" />
          </div>
          <div class="y-alan">
            <label>"En Çok Satan" Otomatik Eşiği <span class="y-ipucu">(30 günlük satış)</span></label>
            <input name="cokSatanEsik" inputmode="numeric" value={s.cokSatanEsik} />
          </div>
          <div class="y-alan">
            <label>"Son … Günün En Düşük Fiyatı" Rozeti (Gün)</label>
            <input name="indirimReferansGun" inputmode="numeric" value={s.indirimReferansGun} />
            <span class="y-ipucu">Üstü çizili önceki fiyat bu ayardan etkilenmez: yasa gereği indirimden önceki 10 günde bu sitede uygulanan en düşük fiyattır.</span>
          </div>
        </div>
        <div class="y-izgara y-izgara--2" style="margin-top:10px">
          <div class="y-alan"><label>Genel Taksit Metni</label><input name="taksitMetin" value={s.taksit.genelMetin} /></div>

        </div>
      </section>

      <!-- 4. KARGO VE TESLİMAT -->
      <section class="y-kart" id="kargo-bolum" data-bolum="kargo" hidden={aktifBolum !== "kargo"}>
        <h2><PIkon ad="kargo" /> Kargo ve Teslimat</h2>
        <div class="y-izgara y-izgara--3">
          <div class="y-alan"><label>Kargo Firması</label><input id="kargoFirma" name="kargoFirma" value={s.kargo.firma} data-site-demo-sekme="anasayfa" /></div>
          <div class="y-alan"><label>Kargo Ücreti (TL)</label><input id="kargoUcret" name="kargoUcret" inputmode="numeric" value={s.kargo.ucret} data-site-demo-sekme="anasayfa" /></div>
          <div class="y-alan">
            <label>Kargo Bedava Sınırı (TL) </label>
            <input
              id="kargoEsik"
              name="kargoEsik"
              inputmode="numeric"
              value={s.kargo.ucretsizEsik}
              data-site-demo-sekme="anasayfa"
              data-alan-ipucu="Kargo Bedava Sınırı: Fiyatı bu tutar ve üzerinde olan tüm ürünlerde otomatik 'Kargo Bedava' şeridi çıkar; sepette bu tutara ulaşılınca kargo 0 TL olur."
            />
          </div>
          <div class="y-alan"><label>Aynı Gün Kargo Kesim Saati (0–23)</label><input id="kesimSaati" name="kesimSaati" inputmode="numeric" value={s.kargo.kesimSaati} data-site-demo-sekme="anasayfa" /></div>
          <div class="y-alan"><label>Teslim Süresi En Az (İş Günü)</label><input name="teslimMin" inputmode="numeric" value={s.kargo.teslimGun[0]} /></div>
          <div class="y-alan"><label>Teslim Süresi En Çok (İş Günü)</label><input name="teslimMax" inputmode="numeric" value={s.kargo.teslimGun[1]} /></div>
        </div>
        <div class="y-alan" style="margin-top:10px">
          <label for="takipUrl">Kargo Takip Bağlantısı Şablonu <span class="y-ipucu">(<code>{'{kod}'}</code> yerine müşterinin takip numarası yazılır)</span></label>
          <input id="takipUrl" name="takipUrl" value={s.kargo.takipUrl} />
          <select aria-label="Hazır kargo şablonu" data-kargo-sablon>
            <option value="">Hazır kargo şablonu seçin</option>
            {KARGO_SABLONLARI.map((ks) => <option value={ks.url} data-ad={ks.ad}>{ks.ad}</option>)}
          </select>
        </div>
      </section>

      <!-- 5. İLETİŞİM VE MAĞAZA KİMLİĞİ -->
      <section class="y-kart" id="iletisim-bolum" data-bolum="iletisim" hidden={aktifBolum !== "iletisim"}>
        <h2><PIkon ad="whatsapp" /> WhatsApp ve İletişim</h2>

        <div class="y-izgara y-izgara--2">
          <div class="y-alan"><label for="telefon">WhatsApp / Telefon Numarası</label><input id="telefon" name="telefon" type="tel" value={s.telefonGorunen} required data-site-demo-sekme="anasayfa" /></div>
          <div class="y-alan"><label for="eposta">Müşteri Hizmetleri E-postası</label><input id="eposta" name="eposta" type="email" value={s.eposta} required /><small class="muted">Sitede, sözleşmelerde ve iade bildirimlerinde görünür.</small></div>
          <div class="y-alan"><label for="kurumsalEposta">Kurumsal E-posta (isteğe bağlı)</label><input id="kurumsalEposta" name="kurumsalEposta" type="email" value={s.kurumsalEposta} placeholder="info@alluluhome.com" /><small class="muted">Alt bilgide "Kurumsal / iş birliği" olarak görünür.</small></div>
          <div class="y-alan"><label for="calismaSaatleri">Çalışma Saatleri</label><input id="calismaSaatleri" name="calismaSaatleri" value={s.calismaSaatleri} placeholder="Hafta içi 09:00–18:00" /></div>
          <div class="y-alan"><label for="url">Site Adresi (URL)</label><input id="url" name="url" value={s.url} required /></div>
          <div class="y-alan"><label for="ad">Mağaza Adı</label><input id="ad" name="ad" value={s.ad} required data-site-demo-sekme="anasayfa" /></div>
          <div class="y-alan"><label for="slogan">Mağaza Sloganı </label><input id="slogan" name="slogan" value={s.slogan} data-site-demo-sekme="anasayfa" /></div>
        </div>
      </section>

      <!-- 6. ANA SAYFA SSS -->
      <section class="y-kart" id="sss-bolum" data-bolum="sss" hidden={aktifBolum !== "sss"}>
        <h2><PIkon ad="soru" /> Sık Sorulan Sorular</h2>
        <p class="y-ipucu" style="margin:-4px 0 10px">Kartlı ödeme (PayTR) açılana kadar içinde "taksit" geçen sorular sitede gösterilmez; ödeme açılınca kendiliğinden görünür.</p>
        <div class="y-tekrar">
          {a.sss.map((x) => (
            <div class="y-tekrar__satir">
              <div class="y-tekrar__alanlar">
                <input class="y-girdi" name="sss_soru" value={x.soru} />
                <textarea class="y-girdi" name="sss_cevap" rows="2">{x.cevap}</textarea>
              </div>
              <button type="button" class="y-sil-btn" data-tekrar-sil aria-label="Soruyu sil"><Ikon ad="cop" boyut={18} /></button>
            </div>
          ))}
          <template>
            <div class="y-tekrar__satir">
              <div class="y-tekrar__alanlar">
                <input class="y-girdi" name="sss_soru" placeholder="Soru" />
                <textarea class="y-girdi" name="sss_cevap" rows="2" placeholder="Cevap"></textarea>
              </div>
              <button type="button" class="y-sil-btn" data-tekrar-sil aria-label="Soruyu sil"><Ikon ad="cop" boyut={18} /></button>
            </div>
          </template>
          <button type="button" class="y-ekle-btn" data-tekrar-ekle>+ Soru-Cevap Ekle</button>
        </div>
      </section>


      <p class="y-form-state" data-kayit-durum role="status"></p>
    </form>
    <Onizleme id="site-onizleme" tur="site" />
  </div>
</Yonetim>
