---
import Yonetim from '../../layouts/Yonetim.astro';
import Ikon from '../../components/Ikon.astro';
import { DogrulamaHatasi, magazaGuncelle, magazaOku } from '../../lib/depo';
import { benzersizKod, evet, liste, metin, sayi } from '../../lib/form';
import { IkonSema, type Kategori } from '../../lib/sema';

let hatalar: string[] = [];
let secim = Astro.url.searchParams.get('duzenle');
let aday: Kategori | undefined;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const eylem = metin(f, 'eylem');
  const id = metin(f, 'id');
  if (id) secim = id;
  try {
    await magazaGuncelle((m) => {
      if (eylem === 'sirala') {
        const sira = liste(f, 'siraId');
        if (new Set(sira).size !== m.kategoriler.length || !m.kategoriler.every((k) => sira.includes(k.id))) throw new Error('Kategori listesi değişti. Sayfayı yenileyin.');
        for (const k of m.kategoriler) k.sira = sira.indexOf(k.id) + 1;
        return;
      }
      const mevcut = m.kategoriler.find((k) => k.id === id);
      if (!mevcut && id !== 'yeni') throw new Error('Kategori bulunamadı.');
      if (eylem === 'sil') {
        if (m.urunler.some((u) => u.kategoriler.includes(id))) throw new Error('Bu kategoride ürün var. Önce ürünleri başka kategoriye taşıyın.');
        m.kategoriler = m.kategoriler.filter((k) => k.id !== id);
        return;
      }
      const ikon = IkonSema.safeParse(metin(f, 'ikon'));
      const ad = metin(f, 'ad');
      aday = {
        id: mevcut?.id ?? benzersizKod(ad, new Set(m.kategoriler.map((k) => k.id))), ad, aciklama: metin(f, 'aciklama'),
        ikon: ikon.success ? ikon.data : 'kutu', sira: sayi(f, 'sira', 1),
        menudeGoster: evet(f, 'menudeGoster'), anaSayfadaGoster: evet(f, 'anaSayfadaGoster'), yakindaGoster: evet(f, 'yakindaGoster'),
      };
      if (mevcut) Object.assign(mevcut, aday);
      else m.kategoriler.push(aday);
    });
    const ok = eylem === 'sil' ? 'Kategori silindi.' : eylem === 'sirala' ? 'Kategori sırası kaydedildi.' : 'Kategori kaydedildi.';
    return Astro.redirect('/yonetim/kategoriler?ok=' + encodeURIComponent(ok), 303);
  } catch (e) {
    hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
  }
}
const m = await magazaOku();
const listeK = [...m.kategoriler].sort((a, b) => a.sira - b.sira);
const yeni = secim === 'yeni';
const k = aday ?? (yeni ? { id: 'yeni', ad: '', aciklama: '', ikon: 'kutu', sira: (listeK.at(-1)?.sira ?? 0) + 1, menudeGoster: true, anaSayfadaGoster: true, yakindaGoster: false } as Kategori : listeK.find((k) => k.id === secim));
const ikonlar = [['duduklu','Düdüklü tencere'],['tencere','Tencere'],['tava','Tava'],['kasik','Mutfak gereci'],['kutu','Kutu'],['kase','Sofra'],['ates','Ocak'],['hediye','Hediye'],['yildiz','Yıldız'],['ev','Ev']];
---
<Yonetim baslik={k ? yeni ? 'Yeni Kategori' : k.ad : 'Kategoriler'} aktif="kategoriler" basari={Astro.url.searchParams.get('ok')} hatalar={hatalar}>
  <div slot="ust-sag" class="y-ust-aksiyonlar">
    {k ? <><a class="y-link" href="/yonetim/kategoriler">Kategorilere dön</a><button type="submit" form="kategori-form" class="btn btn--sepet">Kaydet</button></> : <a href="?duzenle=yeni" class="btn btn--sepet">Yeni Kategori</a>}
  </div>
  {k ? <form method="post" id="kategori-form" class="y-kart" data-editor>
    <input type="hidden" name="id" value={yeni ? 'yeni' : k.id} />
    <div class="y-izgara y-izgara--3">
      <label class="y-alan">Kategori adı<input name="ad" value={k.ad} required /></label>
      <label class="y-alan">İkon<select name="ikon">{!ikonlar.some(([v]) => v === k.ikon) && <option selected value={k.ikon}>{k.ikon}</option>}{ikonlar.map(([id, ad]) => <option value={id} selected={k.ikon === id}>{ad}</option>)}</select></label>
      <label class="y-alan">Sıra<input name="sira" type="number" min="0" value={k.sira} required /></label>
    </div>
    <label class="y-alan y-block-gap">Açıklama<input name="aciklama" value={k.aciklama} /></label>
    <div class="y-secimler y-block-gap">
      <label class="y-secim"><input type="checkbox" name="menudeGoster" checked={k.menudeGoster} />Menüde göster</label>
      <label class="y-secim"><input type="checkbox" name="anaSayfadaGoster" checked={k.anaSayfadaGoster} />Ana sayfada göster</label>
      <label class="y-secim"><input type="checkbox" name="yakindaGoster" checked={k.yakindaGoster} />Boşsa “Yakında” göster</label>
    </div>
    <p class="y-form-state" data-kayit-durum role="status"></p>
    {!yeni && <details class="y-danger"><summary>Tehlikeli işlemler</summary><button class="btn btn--tehlike" type="submit" name="eylem" value="sil" formnovalidate data-onayla="Bu kategori silinsin mi?">Kategoriyi sil</button></details>}
  </form> : listeK.length ? <form method="post" class="y-kategori-siralama" data-editor>
    <input type="hidden" name="eylem" value="sirala" />
    <div class="y-tablo-kap"><table class="y-tablo"><thead><tr><th>Sıra</th><th>Kategori</th><th>Ürün</th><th>Menü</th><th>Ana sayfa</th><th>Boşsa</th><th>İşlem</th></tr></thead>
      <tbody data-sirala>{listeK.map((k, i) => (
        <tr data-sira-satir>
          <td><input type="hidden" name="siraId" value={k.id} /><span data-sira-no>{i + 1}</span> <button type="button" class="y-icon-button" data-sira="yukari" aria-label={k.ad + ' yukarı'}><Ikon ad="yukari" boyut={14} /></button><button type="button" class="y-icon-button" data-sira="asagi" aria-label={k.ad + ' aşağı'}><Ikon ad="asagi" boyut={14} /></button></td>
          <td><strong>{k.ad}</strong></td><td>{m.urunler.filter((u) => u.kategoriler.includes(k.id)).length}</td>
          <td>{k.menudeGoster ? 'Açık' : 'Kapalı'}</td><td>{k.anaSayfadaGoster ? 'Açık' : 'Kapalı'}</td>
          <td>{k.yakindaGoster ? 'Yakında' : 'Gizli'}</td><td><a class="y-link" href={'?duzenle=' + k.id}>Düzenle</a></td>
        </tr>
      ))}</tbody></table></div>
    <div class="y-ust-aksiyonlar y-block-gap"><button type="submit" class="btn btn--cizgi" data-sira-kaydet hidden>Sırayı kaydet</button><span data-kayit-durum class="y-form-state" role="status"></span></div>
  </form> : <p class="y-kart muted">Henüz kategori yok.</p>}
</Yonetim>
