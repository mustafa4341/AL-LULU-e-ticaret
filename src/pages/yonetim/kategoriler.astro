---
import Yonetim from '../../layouts/Yonetim.astro';
import Ikon from '../../components/Ikon.astro';
import { DogrulamaHatasi, magazaGuncelle, magazaOku } from '../../lib/depo';
import { benzersizKod, evet, metin, sayi } from '../../lib/form';
import { IkonSema, type IkonAdi } from '../../lib/sema';

let hatalar: string[] = [];
const basari = Astro.url.searchParams.get('ok');
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const eylem = metin(f, 'eylem');
  const id = metin(f, 'id');
  try {
    await magazaGuncelle((m) => {
      if (eylem === 'sil') {
        const kullanan = m.urunler.filter((u) => u.kategoriler.includes(id));
        if (kullanan.length) throw new DogrulamaHatasi([`Bu kategoride ${kullanan.length} ürün var; önce ürünleri başka kategoriye taşıyın.`]);
        m.kategoriler = m.kategoriler.filter((k) => k.id !== id);
        return;
      }
      const ikon = IkonSema.safeParse(metin(f, 'ikon'));
      const veri = {
        ad: metin(f, 'ad'), aciklama: metin(f, 'aciklama'), ikon: (ikon.success ? ikon.data : 'kutu') as IkonAdi,
        sira: sayi(f, 'sira', 10), menudeGoster: evet(f, 'menudeGoster'), anaSayfadaGoster: evet(f, 'anaSayfadaGoster'), yakindaGoster: evet(f, 'yakindaGoster'),
      };
      if (eylem === 'yeni') m.kategoriler.push({ id: benzersizKod(veri.ad, new Set(m.kategoriler.map((k) => k.id))), ...veri });
      else { const k = m.kategoriler.find((x) => x.id === id); if (k) Object.assign(k, veri); }
    });
    return Astro.redirect(`/yonetim/kategoriler?ok=${encodeURIComponent(eylem === 'sil' ? 'Kategori silindi' : 'Kaydedildi')}`);
  } catch (e) {
    hatalar = e instanceof DogrulamaHatasi ? e.hatalar : [(e as Error).message];
  }
}
const m = await magazaOku();
const IKONLAR: [IkonAdi, string][] = [['duduklu', 'Düdüklü tencere'], ['tencere', 'Tencere'], ['tava', 'Tava'], ['kasik', 'Kaşık / gereç'], ['kutu', 'Kutu / saklama'], ['kase', 'Kase / sofra'], ['ates', 'Ocak'], ['hediye', 'Hediye'], ['yildiz', 'Yıldız'], ['ev', 'Ev']];
const say = (id: string) => m.urunler.filter((u) => u.kategoriler.includes(id)).length;
---
<Yonetim baslik="Kategoriler" aktif="kategoriler" basari={basari} hatalar={hatalar}>
  <p class="muted small" style="margin-bottom:14px">Ürünü olmayan kategori, "Yakında göster" işaretli değilse sitede gizlenir.</p>
  {[...m.kategoriler].sort((a, b) => a.sira - b.sira).map((k) => (
    <form method="post" class="y-kart">
      <input type="hidden" name="id" value={k.id} />
      <div class="y-izgara y-izgara--3">
        <div class="y-alan"><label>Ad</label><input name="ad" value={k.ad} required /></div>
        <div class="y-alan"><label>İkon</label><select name="ikon">{IKONLAR.map(([v, a]) => <option value={v} selected={k.ikon === v}>{a}</option>)}</select></div>
        <div class="y-alan"><label>Sıra</label><input name="sira" inputmode="numeric" value={k.sira} /></div>
      </div>
      <div class="y-alan" style="margin-top:10px"><label>Açıklama</label><input name="aciklama" value={k.aciklama} /></div>
      <div class="y-secimler" style="margin-top:10px">
        <label class="y-secim"><input type="checkbox" name="menudeGoster" checked={k.menudeGoster} />Menüde</label>
        <label class="y-secim"><input type="checkbox" name="anaSayfadaGoster" checked={k.anaSayfadaGoster} />Ana sayfada</label>
        <label class="y-secim"><input type="checkbox" name="yakindaGoster" checked={k.yakindaGoster} />Boşsa "Yakında" göster</label>
      </div>
      <div style="display:flex;gap:8px;justify-content:space-between;align-items:center;margin-top:12px;flex-wrap:wrap">
        <span class="y-ipucu">{say(k.id)} ürün · <a href={`/kategori/${k.id}`} target="_blank" rel="noopener">/kategori/{k.id}</a></span>
        <span style="display:flex;gap:8px">
          <button class="btn btn--tehlike btn--kucuk" type="submit" name="eylem" value="sil" formnovalidate data-onayla={`"${k.ad}" kategorisi silinsin mi?`}>Sil</button>
          <button class="btn btn--sepet btn--kucuk" type="submit" name="eylem" value="kaydet">Kaydet</button>
        </span>
      </div>
    </form>
  ))}
  <form method="post" class="y-kart" style="border-style:dashed">
    <h2>Yeni kategori</h2>
    <div class="y-izgara y-izgara--3" style="margin-top:10px">
      <div class="y-alan"><label>Ad</label><input name="ad" required placeholder="Örn. Bıçaklar" /></div>
      <div class="y-alan"><label>İkon</label><select name="ikon">{IKONLAR.map(([v, a]) => <option value={v}>{a}</option>)}</select></div>
      <div class="y-alan"><label>Sıra</label><input name="sira" inputmode="numeric" value={m.kategoriler.length + 1} /></div>
    </div>
    <div class="y-alan" style="margin-top:10px"><label>Açıklama</label><input name="aciklama" /></div>
    <div class="y-secimler" style="margin-top:10px">
      <label class="y-secim"><input type="checkbox" name="menudeGoster" checked />Menüde</label>
      <label class="y-secim"><input type="checkbox" name="anaSayfadaGoster" checked />Ana sayfada</label>
      <label class="y-secim"><input type="checkbox" name="yakindaGoster" />Boşsa "Yakında" göster</label>
    </div>
    <div style="text-align:right;margin-top:12px"><button class="btn btn--sepet" type="submit" name="eylem" value="yeni"><Ikon ad="arti" />Kategori ekle</button></div>
  </form>
</Yonetim>
