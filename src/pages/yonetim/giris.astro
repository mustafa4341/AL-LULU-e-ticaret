---
import '../../styles/global.css';
import '../../styles/yonetim.css';
import '../../styles/panel-tasarim.css';
import { basariliGiris, basarisizGiris, girisEngelliMi, oturumAc, parolaDogruMu, yonetimHazirMi } from '../../lib/oturum';
import { istemciIp } from '../../lib/guvenlik';

let hata = '';
const hazir = yonetimHazirMi();
const hedefHam = Astro.url.searchParams.get('d') ?? '/yonetim';
const hedef = /^\/yonetim(\/[\w\-/]*)?$/.test(hedefHam) ? hedefHam : '/yonetim';
if (Astro.locals.yonetici) return Astro.redirect(hedef);

if (Astro.request.method === 'POST' && hazir) {
  const ip = istemciIp(Astro.request, Astro.clientAddress);
  if (await girisEngelliMi(ip)) {
    await new Promise((r) => setTimeout(r, 600));
    hata = 'Çok fazla hatalı deneme yapıldı. Lütfen 15 dakika sonra tekrar deneyin.';
  } else {
    const f = await Astro.request.formData();
    if (parolaDogruMu(String(f.get('parola') ?? ''))) {
      await basariliGiris(ip);
      oturumAc(Astro.cookies, Astro.url.protocol === 'https:');
      return Astro.redirect(hedef, 303);
    }
    await basarisizGiris(ip);
    await new Promise((r) => setTimeout(r, 600)); // kaba kuvvet denemelerini yavaşlat
    hata = 'Parola hatalı.';
  }
}
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Giriş</title>
    <link rel="icon" href="/img/logo/favicon-64.png" type="image/png" />
  </head>
  <body class="y-giris y-giris-panel">
    <form method="post" class="y-giris-kart">
      <img src="/img/logo/amblem.webp" alt="" width="64" height="64" />
      <p class="y-giris-brand">AL LULU HOME</p>
      <h1>Yönetim paneli</h1>
      {!hazir ? (
        <p class="y-bildirim y-bildirim--hata">Panel parolası ayarlanmamış. Proje klasöründeki <code>.env</code> dosyasına <code>YONETIM_PAROLA</code> ve en az 32 karakterlik <code>OTURUM_GIZLI</code> yazın.</p>
      ) : (
        <>
          {hata && <p class="y-bildirim y-bildirim--hata" role="alert">{hata}</p>}
          <div class="y-alan">
            <label for="parola">Yönetici Parolası</label>
            <input id="parola" name="parola" type="password" autocomplete="current-password" required autofocus maxlength="200" placeholder="••••••••••••" />
          </div>
          <button class="btn btn--sepet btn--block" type="submit">Yönetim Paneline Giriş Yap</button>
          <p class="muted" style="margin:8px 0 0;font-size:.78rem;text-align:center">Güvenlik koruması aktif · 5 hatalı denemede 15 dakika erişim kilidi uygulanır.</p>
        </>
      )}
    </form>
  </body>
</html>
