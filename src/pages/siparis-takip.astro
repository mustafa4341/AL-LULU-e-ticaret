---
import Base from '../layouts/Base.astro';
import Ikon from '../components/Ikon.astro';
import { siparisleriOku } from '../lib/depo';
import { SMS_BAGLI } from '../lib/altyapi';

const k = Astro.locals.katalog;
let hata = '';
let girilenNo = (Astro.url.searchParams.get('no') ?? '').slice(0, 30);
let girilenTel = '';
const kayit = globalThis as unknown as { __takipDenemeleri?: Map<string, number[]> };
const denemeler: Map<string, number[]> = (kayit.__takipDenemeleri ??= new Map<string, number[]>());

/** Müşteri numarayı nasıl yazarsa yazsın (küçük harf, boşluklu, tiresiz, "AL" olmadan) doğru biçime çevirir. */
function numaraDuzelt(girdi: string): string | undefined {
  const temiz = girdi.toUpperCase().replace(/[\s#.]/g, '').replace(/[–—]/g, '-');
  const m = /^(?:AL)?(\d{6})-?(\d{4})$/.exec(temiz);
  return m ? `AL${m[1]}-${m[2]}` : undefined;
}

if (Astro.request.method === 'POST') {
  const ip = Astro.clientAddress;
  const simdi = Date.now();
  const onceki = (denemeler.get(ip) ?? []).filter((t) => simdi - t < 600_000);
  denemeler.set(ip, [...onceki, simdi]);
  const f = await Astro.request.formData();
  girilenNo = String(f.get('no') ?? '').slice(0, 30);
  girilenTel = String(f.get('tel') ?? '').slice(0, 20);
  if (onceki.length >= 10) {
    hata = 'Çok fazla deneme yaptınız. Lütfen 10 dakika sonra tekrar deneyin.';
  } else {
    const no = numaraDuzelt(girilenNo);
    let tel = girilenTel.replace(/\D/g, '');
    if (tel.startsWith('90') && tel.length === 12) tel = tel.slice(2);
    if (tel.length === 10) tel = '0' + tel;
    if (!no) {
      hata = 'Sipariş numarası AL ile başlar ve 10 rakamdan oluşur (ör. AL261117-1234).';
    } else if (!/^05\d{9}$/.test(tel)) {
      hata = 'Siparişte kullandığınız cep telefonunu 05xx xxx xx xx biçiminde girin.';
    } else {
      const s = (await siparisleriOku()).find((x) => x.no === no && x.musteri.tel === tel);
      if (s) return Astro.redirect(`/siparis/${s.no}?t=${s.token}`, 303);
      hata = 'Bu sipariş numarası ve telefonla eşleşen bir sipariş bulunamadı. Numarayı ve telefonu kontrol edin.';
    }
  }
}
---
<Base baslik={`Sipariş takip | ${k.site.ad}`} aciklama="Hesap gerekmeden siparişinizi takip edin." indekslenmesin>
  <div class="container siparis-sonuc">
    <div class="kart-kutu">
      <h1 style="font-size:34px">Sipariş takip</h1>
      <p class="muted" style="margin:6px 0 16px">Üyelik gerekmez. Sipariş numaranız, sipariş sonrası ekranda{SMS_BAGLI ? ' ve size gönderilen SMS’te' : ''} yazar.</p>
      {hata && <p class="hata-ozeti is-visible" role="alert">{hata}</p>}
      <form method="post" class="alanlar">
        <div class="alan">
          <label for="no">Sipariş numarası</label>
          <input id="no" name="no" required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="AL261117-1234" value={girilenNo} maxlength="30" />
          <span class="ipucu">Tire veya “AL” yazmasanız da olur.</span>
        </div>
        <div class="alan">
          <label for="tel">Cep telefonu</label>
          <input id="tel" name="tel" type="tel" inputmode="tel" required autocomplete="tel-national" placeholder="05xx xxx xx xx" value={girilenTel} maxlength="20" />
          <span class="ipucu">Siparişte kullandığınız numara.</span>
        </div>
        <button class="btn btn--sepet btn--block" type="submit"><Ikon ad="kargo" />Siparişimi göster</button>
      </form>
      <a class="odeme-yardim" href={k.whatsapp('Merhaba, siparişimi takip etmek istiyorum.')} target="_blank" rel="noopener"><Ikon ad="whatsapp" boyut={20} />Numaranızı bulamıyor musunuz? WhatsApp’tan yazın</a>
    </div>

    <div class="kart-kutu" data-siparislerim hidden>
      <h2>Bu cihazdan verdiğiniz siparişler</h2>
      <div class="siparislerim" data-siparislerim-liste></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var liste = [];
      try { liste = JSON.parse(localStorage.getItem('allulu_siparislerim') || '[]'); } catch (e) {}
      if (!liste.length) return;
      var kutu = document.querySelector('[data-siparislerim]');
      var alan = document.querySelector('[data-siparislerim-liste]');
      var tl = new Intl.NumberFormat('tr-TR');
      var tarih = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' });
      liste.forEach(function (s) {
        if (!/^AL[0-9]{6}-[0-9]{4}$/.test(s.no) || !/^[a-f0-9]{32}$/.test(s.t)) return;
        var a = document.createElement('a');
        a.href = '/siparis/' + s.no + '?t=' + s.t;
        var sol = document.createElement('span');
        var no = document.createElement('strong'); no.textContent = s.no; no.style.whiteSpace = 'nowrap';
        var gun = document.createElement('small'); gun.className = 'muted'; gun.textContent = ' · ' + tarih.format(new Date(s.tarih));
        sol.appendChild(no); sol.appendChild(gun);
        var sag = document.createElement('span'); sag.textContent = tl.format(s.toplam) + ' TL ›'; sag.style.whiteSpace = 'nowrap';
        a.appendChild(sol); a.appendChild(sag); alan.appendChild(a);
      });
      if (alan.children.length) kutu.hidden = false;
    })();
  </script>
</Base>
