---
import Base from '../../layouts/Base.astro';
import Ikon from '../../components/Ikon.astro';
import Fiyat from '../../components/Fiyat.astro';
import Galeri from '../../components/Galeri.astro';
import KargoSayaci from '../../components/KargoSayaci.astro';
import UrunKarti from '../../components/UrunKarti.astro';
import SSS from '../../components/SSS.astro';
import FirsatSayaci from '../../components/FirsatSayaci.astro';
import BirlikteAl from '../../components/BirlikteAl.astro';
import FaydaBolumleri from '../../components/FaydaBolumleri.astro';
import PisirmeSureleri from '../../components/PisirmeSureleri.astro';
import SonCagri from '../../components/SonCagri.astro';
import { formatTL } from '../../lib/fiyat';

const k = Astro.locals.katalog;
const urun = k.urunBul(Astro.params.id ?? '');
if (!urun) return Astro.rewrite('/404');

const site = k.site;
const kat = k.kategoriBul(urun.kategoriler[0]!);
const bilgi = k.fiyatBilgisi(urun);
const rozet = k.rozetler(urun);
const stokta = k.stoktaMi(urun);
const oneriSet = k.urunuIcerenSetler(urun.id)[0];
const tamamlayicilar = k.birlikteIyiGiderler(urun);
const taksit = site.taksit.pesinFiyatinaTaksit;
const stokMetni = urun.stok <= 3 ? 'Stokta son ' + urun.stok + ' adet' : 'Stokta · hemen gönderime hazır';
const soruUrl = k.whatsapp(`Merhaba, ${urun.marka} ${urun.kisaAd} hakkında bir sorum var.`);
const stokHaberUrl = k.whatsapp(`${urun.kisaAd} stoğa girince haber verir misiniz?`);
const gosterilenFiyat = bilgi.sepette?.fiyat ?? bilgi.fiyat;
const hacim = urun.teknik.find(([e]) => e.toLocaleLowerCase('tr') === 'hacim')?.[1];
const guvenSatiri = [...urun.rozetler, ...(rozet.serit ? [rozet.serit] : [])].slice(0, 3);

const yapisalVeri = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${urun.marka} ${urun.ad}`,
  brand: { '@type': 'Brand', name: urun.marka },
  sku: urun.sku || undefined,
  mpn: urun.sku || undefined,
  description: urun.ozet,
  image: urun.gorseller.map((g) => new URL(g.src, site.url).href),
  offers: {
    '@type': 'Offer', priceCurrency: 'TRY', price: String(urun.fiyat),
    availability: stokta ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition', url: new URL(`/urun/${urun.id}`, site.url).href,
    seller: { '@type': 'Organization', name: site.ad },
  },
};
---
<Base baslik={`${urun.marka} ${urun.ad} | ${site.ad}`} aciklama={`${urun.marka} ${urun.ad}: ${urun.ozet} ${formatTL(urun.fiyat)}, vergiler dahil.`} gorsel={urun.gorseller[0]?.src} aktif={urun.kategoriler[0]} yapisalVeri={yapisalVeri} altCubuk={stokta} ozelDuyuru={rozet.serit ? `Bu üründe kargo bedava · ${site.kargo.kesimSaati}:00'e kadar aynı gün kargoda` : undefined}>
  <div class="container">
    <nav aria-label="Konum" class="kirinti-kap--urun">
      <ol class="kirinti">
        <li><a href="/">Ana sayfa</a></li>
        {kat && <li><a href={`/kategori/${kat.id}`}>{kat.ad}</a></li>}
        <li aria-current="page">{urun.kisaAd}</li>
      </ol>
    </nav>

    <section class="urun-ust" aria-labelledby="urun-adi">
      <div class="urun-galeri-kap">
        <Galeri gorseller={urun.gorseller} yedekIkon={kat?.ikon} />
        {rozet.damga && <span class="damga damga--buyuk urun-damga"><span>{rozet.damga}</span></span>}
      </div>

      <div class="urun-bilgi">
        {(bilgi.firsat || k.cokSatanMi(urun) || urun.durum === 'taslak') && (
          <div class="urun-ust-satir">
            {bilgi.firsat && <FirsatSayaci etiket={bilgi.firsat.etiket} bitis={bilgi.firsat.bitis} />}
            {k.cokSatanMi(urun) && <span class="cip cip--altin"><Ikon ad="yildiz" boyut={14} />En Çok Satan</span>}
            {urun.durum === 'taslak' && <span class="rozet rozet--taslak">Örnek ürün · canlıda görünmez</span>}
          </div>
        )}
        <p class="urun-eyebrow"><a href={kat ? `/kategori/${kat.id}` : '/urunler'}><span lang="en">{urun.marka}</span>{hacim && <> · {hacim}</>}</a></p>
        <h1 class="urun-ad" id="urun-adi">{urun.ad}</h1>
        {urun.ozet && <p class="urun-deger">{urun.ozet}</p>}
        {guvenSatiri.length > 0 && (
          <ul class="urun-guven-satir" aria-label="Güvenceler">{guvenSatiri.map((g) => <li><Ikon ad="tik" boyut={14} />{g}</li>)}</ul>
        )}

        <div class="urun-fiyat">
          <Fiyat bilgi={bilgi} boyut="buyuk" />
          {bilgi.etiket && <span class="indirim-etiket">{bilgi.etiket}</span>}
          <p class="urun-fiyat__alt">Vergiler dahil{rozet.serit && <> · <strong class="yesil">{rozet.serit}</strong></>}{taksit ? <> · Peşin fiyatına <strong>{taksit} taksit</strong></> : <span class="urun-fiyat__taksit"> · {site.taksit.genelMetin}</span>}</p>
        </div>

        {stokta ? (
          <>
            <div class="satin-al" data-ana-cta>
              <button class="btn btn--simdi" type="button" data-hemen-al data-tip="urun" data-id={urun.id}>Şimdi Al</button>
              <button class="btn btn--sepet" type="button" data-sepete-ekle data-tip="urun" data-id={urun.id} data-konum="urun-sayfasi">
                <Ikon ad="canta" boyut={20} /><span data-etiket>Sepete Ekle</span>
              </button>
            </div>
            <p class:list={['stok', { 'stok--az': urun.stok <= 3 }]}>{stokMetni}</p>
            <KargoSayaci />
          </>
        ) : (
          <>
            <p class="stok stok--yok">Şu an stokta yok</p>
            <a class="btn btn--wa btn--block" style="margin-top:14px" href={stokHaberUrl} target="_blank" rel="noopener"><Ikon ad="whatsapp" />Stoğa girince haber ver</a>
          </>
        )}

        {urun.hediye && <p class="hediye"><Ikon ad="hediye" />{urun.hediye}</p>}

        {oneriSet && <BirlikteAl set={oneriSet} mevcutUrunId={urun.id} />}

        {urun.oneCikanBilgiler.length > 0 && (
          <ul class="bilgiler" aria-label="Öne çıkan özellikler">
            {urun.oneCikanBilgiler.map((b) => <li class="bilgi"><Ikon ad={b.ikon} />{b.metin}</li>)}
          </ul>
        )}

        <a class="soru-sor" href={soruUrl} target="_blank" rel="noopener">
          <Ikon ad="whatsapp" boyut={26} />
          <span><strong>Bu ürünle ilgili sorunuz mu var?</strong><span>WhatsApp'tan yazın: {site.telefonGorunen}</span></span>
          <Ikon ad="sag" boyut={18} />
        </a>

        {urun.sku && <p class="urun-model">Model kodu: {urun.sku}</p>}
        <ul class="guvenceler">
          <li><Ikon ad="kalkan" boyut={18} /><span>Orijinal ürün, adınıza faturalı gönderim</span></li>
          {urun.garanti && <li><Ikon ad="belge" boyut={18} /><span>{urun.garanti} garanti · <a href="/yasal/garanti-kosullari">Garanti koşulları</a></span></li>}
          <li><Ikon ad="kilit" boyut={18} /><span>3D Secure ile güvenli ödeme · Sipariş takibi SMS ile</span></li>
        </ul>
      </div>
      <div class="urun-pisirme"><PisirmeSureleri urun={urun} /></div>
    </section>
  </div>

  <FaydaBolumleri urun={urun} />

  {(urun.teknik.length > 0 || urun.kutuIcerigi.length > 0) && (
    <section class="bolum" aria-label="Teknik bilgiler">
      <div class="container iki-kolon">
        {urun.teknik.length > 0 && (
          <div data-reveal>
            <h2 class="alt-baslik">Teknik özellikler</h2>
            <table class="teknik-tablo"><tbody>{urun.teknik.map(([e, d]) => <tr><th scope="row">{e}</th><td>{d}</td></tr>)}</tbody></table>
          </div>
        )}
        {urun.kutuIcerigi.length > 0 && (
          <div data-reveal>
            <h2 class="alt-baslik">Kutu içeriği</h2>
            <ul class="kutu-liste">{urun.kutuIcerigi.map((x) => <li><Ikon ad="tik" boyut={18} />{x}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="bolum" aria-labelledby="yorum-baslik">
    <div class="container">
      <div class="bolum-bas"><div><p class="eyebrow eyebrow--altin">Müşteri deneyimleri</p><h2 id="yorum-baslik">Değerlendirmeler</h2></div></div>
      <div class="yorum-bos" data-reveal>
        <Ikon ad="yildiz" boyut={28} />
        <p><strong>İlk değerlendirmeler yakında burada.</strong> Yalnızca gerçek siparişlerden gelen yorumları yayınlıyoruz; düzenlenmiş veya satın alınmış yorum yok.</p>
      </div>
    </div>
  </section>

  {urun.sss.length > 0 && (
    <section class="bolum bolum--beyaz" aria-labelledby="urun-sss">
      <div class="container">
        <div class="bolum-bas"><div><p class="eyebrow eyebrow--altin">Sık sorulanlar</p><h2 id="urun-sss">Bu ürün hakkında</h2></div></div>
        <SSS maddeler={urun.sss} />
      </div>
    </section>
  )}

  {tamamlayicilar.length > 0 && (
    <section class="bolum" aria-labelledby="tamamlayici">
      <div class="container">
        <div class="bolum-bas"><div><p class="eyebrow eyebrow--altin">Tamamlayıcı ürünler</p><h2 id="tamamlayici">Bununla iyi gider</h2></div></div>
        <div class="urun-ray">{tamamlayicilar.map((u) => <UrunKarti urun={u} konum="tamamlayici" />)}</div>
      </div>
    </section>
  )}

  <SonCagri urun={urun} />

  {stokta && (
    <div class="alt-cubuk" slot="alt-cubuk" data-alt-cubuk aria-hidden="true">
      <div class="alt-cubuk__bilgi">
        {bilgi.onceki && <s class="alt-cubuk__eski">{formatTL(bilgi.onceki)}</s>}
        <div class:list={['alt-cubuk__fiyat', { 'fiyat--indirimli': !!bilgi.onceki }]}>{formatTL(gosterilenFiyat)}</div>
        <div class="alt-cubuk__not">{bilgi.sepette ? 'Sepette fiyat' : rozet.serit ?? 'Vergiler dahil'}</div>
      </div>
      <button class="btn btn--simdi" type="button" data-hemen-al data-tip="urun" data-id={urun.id} tabindex="-1">Şimdi Al</button>
      <button class="btn btn--sepet" type="button" data-sepete-ekle data-tip="urun" data-id={urun.id} data-konum="alt-cubuk" tabindex="-1"><span data-etiket>Sepete Ekle</span></button>
    </div>
  )}

  <script>
    import '../../scripts/buyutec';
  </script>
</Base>
