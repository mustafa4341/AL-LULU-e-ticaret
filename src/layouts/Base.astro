---
import '../styles/global.css';
import '../styles/vitrin.css';
import Ikonlar from '../components/Ikonlar.astro';
import Ikon from '../components/Ikon.astro';
import Header from '../components/Header.astro';
import AltMenu from '../components/AltMenu.astro';
import YanMenu from '../components/YanMenu.astro';
import SepetPaneli from '../components/SepetPaneli.astro';
import Footer from '../components/Footer.astro';
import CerezOnay from '../components/CerezOnay.astro';

interface Props {
  baslik: string;
  aciklama: string;
  gorsel?: string;
  /** Aktif menü: 'ana', kategori id, 'urunler', 'setler' */
  aktif?: string;
  /** JSON-LD: tek nesne ya da birden çok (ör. Product + BreadcrumbList) */
  yapisalVeri?: Record<string, unknown> | Record<string, unknown>[];
  /** Ziyaretçinin geldiği yol: [ad, adres] çiftleri; BreadcrumbList olarak eklenir (son öğe bu sayfa) */
  kirinti?: [string, string][];
  /** Open Graph türü (ürün sayfasında "product") */
  ogTuru?: 'website' | 'product';
  /** Ürün sayfası: Meta (Facebook/Instagram) kataloğu ve paylaşım önizlemeleri için product:* etiketleri.
   *  id, ürün akışındaki g:id ile aynıdır; böylece Meta sayfayı katalogdaki ürünle eşleştirir. */
  urunMeta?: { id: string; marka: string; fiyat: number; stokta: boolean; gtin?: string };
  /** Ürün sayfası: alt menü yerine satın alma çubuğu */
  altCubuk?: boolean;
  indekslenmesin?: boolean;
  /** Ödeme sayfası için sade başlık */
  sade?: boolean;
  /** Sayfaya özel ilk duyuru (ör. ürün sayfasında "Bu üründe kargo bedava") */
  ozelDuyuru?: string;
}
const { baslik, aciklama, gorsel = '/img/logo/al-lulu-home.png', aktif, yapisalVeri, kirinti, ogTuru = 'website', urunMeta, altCubuk = false, indekslenmesin = false, sade = false, ozelDuyuru } = Astro.props;
const k = Astro.locals.katalog;
const onizleme = Astro.locals.vitrinOnizleme;
/* Google Tag Manager kimliği (Vercel: GTM_KIMLIGI). Yönetici ve önizleme ziyaretleri ölçülmez. */
const gtmHam = process.env.GTM_KIMLIGI ?? import.meta.env.GTM_KIMLIGI ?? '';
const gtm = /^GTM-[A-Z0-9]{4,12}$/.test(gtmHam) && !onizleme && !Astro.locals.yonetici ? gtmHam : '';
const kok = Astro.site ?? new URL(k.site.url);
const kanonik = new URL(Astro.url.pathname, kok).href;
const ogGorsel = new URL(gorsel, kok).href;
const jsonLd: Record<string, unknown>[] = [
  ...(Array.isArray(yapisalVeri) ? yapisalVeri : yapisalVeri ? [yapisalVeri] : []),
  ...(kirinti?.length ? [{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [['Ana sayfa', '/'] as [string, string], ...kirinti].map(([ad, yol], i) => ({
      '@type': 'ListItem', position: i + 1, name: ad, item: new URL(yol, kok).href,
    })),
  }] : []),
];
const duyurular = ozelDuyuru ? [ozelDuyuru, ...k.site.duyurular.filter((d) => !/kargo bedava/i.test(d))] : k.site.duyurular;
const geriYol = Astro.url.pathname;
const vitrinGecisi = !onizleme && !geriYol.startsWith('/yonetim');
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <meta name="theme-color" content="#FFFFFF" />
    {(indekslenmesin || onizleme) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={kanonik} />
    <!-- Google arama sonucundaki ikon için 48'in katı boyutlar -->
    <link rel="icon" href="/img/logo/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/img/logo/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/img/logo/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/img/logo/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={k.site.ad} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={baslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:image" content={ogGorsel} />
    <meta property="og:type" content={ogTuru} />
    <meta property="og:url" content={kanonik} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={baslik} />
    <meta name="twitter:description" content={aciklama} />
    <meta name="twitter:image" content={ogGorsel} />
    {urunMeta && <>
      <meta property="product:brand" content={urunMeta.marka} />
      <meta property="product:price:amount" content={urunMeta.fiyat.toFixed(2)} />
      <meta property="product:price:currency" content="TRY" />
      <meta property="product:availability" content={urunMeta.stokta ? 'in stock' : 'out of stock'} />
      <meta property="product:condition" content="new" />
      <meta property="product:retailer_item_id" content={urunMeta.id} />
      {urunMeta.gtin && <meta property="product:gtin" content={urunMeta.gtin} />}
    </>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/img/logo/yazi.webp" />
    {vitrinGecisi && <style is:inline>@view-transition { navigation: auto; }</style>}
    {gtm && <script is:inline>
      /* Consent Mode varsayılanı: onay verilene kadar her şey kapalı (GTM de yüklenmez) */
      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); } /* GTM yalnızca "arguments" nesnesini komut sayar */
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
    </script>}
    {jsonLd.map((v) => <script type="application/ld+json" set:html={JSON.stringify(v).replace(/</g, '\\u003c')} />)}
  </head>
  <body class:list={{ 'alt-cubuklu': altCubuk, 'alt-menulu': !altCubuk && !sade }}>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <Ikonlar />

    {!sade && duyurular.length > 0 && (
      <div class="duyuru" data-duyuru aria-label="Duyurular">
        <div class="duyuru__ray">
          {duyurular.map((d, i) => <p class:list={['duyuru__madde', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>{d}</p>)}
        </div>
      </div>
    )}

    {Astro.locals.yonetici && !onizleme && (
      <div class="yonetici-serit" style={k.site.tadilat.aktif ? 'background:#4A2506;color:#FFE4B5' : undefined}>
        <Ikon ad="ayar" boyut={14} />
        {k.site.tadilat.aktif && (
          <strong style="color:#FFB04D">🛠️ SİTE TADİLATTA (Müşteriler bakım ekranını görüyor) ·</strong>
        )}
        {Astro.locals.musteriGorunumu ? (
          <span>Müşteri görünümü (taslak ürünler ve setler gizli) · <a href={`/yonetim/gorunum?m=0&d=${encodeURIComponent(geriYol)}`}>Yönetici görünümüne dön</a></span>
        ) : (
          <span>Yönetici görünümü · <a href={`/yonetim/gorunum?m=1&d=${encodeURIComponent(geriYol)}`}>Müşteri gibi gör</a> · <a href="/yonetim">Yönetim Paneli</a></span>
        )}
        <form method="post" action="/yonetim/tadilat" onsubmit={k.site.tadilat.aktif ? "return confirm('Site müşterilere açılsın mı?')" : "return confirm('Site bakım moduna alınsın mı? Yeni sipariş alınmayacak.')"} style="display:inline;margin-left:6px">
          <input type="hidden" name="islem" value={k.site.tadilat.aktif ? 'kapat' : 'ac'} />
          <input type="hidden" name="geri" value={geriYol} />
          <button type="submit" style={`border:0;border-radius:999px;padding:2px 10px;font-size:11.5px;font-weight:700;${k.site.tadilat.aktif ? 'background:#0A7F3F;color:#fff' : 'background:rgba(255,255,255,.15);color:#F4E7C5'}`}>
            {k.site.tadilat.aktif ? '🚀 Yayına Aç' : '🛠️ Tadilata Al'}
          </button>
        </form>
      </div>
    )}

    <Header aktif={aktif} sade={sade} />

    <main id="main" data-vitrin-gecisi={vitrinGecisi ? '' : undefined}>
      <slot />
    </main>

    <Footer />

    <slot name="alt-cubuk" />
    {!altCubuk && !sade && <AltMenu aktif={aktif} />}

    {!sade && (
      <a class="wa-yuzen" href={k.whatsapp('Merhaba, bir sorum var.')} target="_blank" rel="noopener" aria-label="WhatsApp'tan bize yazın">
        <Ikon ad="whatsapp" boyut={30} /><span class="wa-yuzen__metin">Sorunuz mu var?<strong>WhatsApp'tan yazın</strong></span>
      </a>
    )}

    <div class="perde" data-perde hidden></div>
    <YanMenu />
    <SepetPaneli />
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    {vitrinGecisi && (
      <div class="sayfa-iskelet" data-sayfa-yukleme hidden aria-hidden="true">
        <!-- 1. Ana Sayfa İskeleti (Hero + Güvence Şeridi + Öne Çıkan 4'lü Ürün Rayı) -->
        <div class="iskelet-ekran" data-iskelet-ekran="ana">
          <div class="container iskelet-hero">
            <div class="iskelet-hero__metin">
              <div class="sk sk--etiket"></div>
              <div class="sk sk--baslik-buyuk"></div>
              <div class="sk sk--satir"></div>
              <div class="sk sk--satir sk--kisa"></div>
              <div class="iskelet-maddeler">
                <div class="sk sk--madde"></div>
                <div class="sk sk--madde"></div>
                <div class="sk sk--madde"></div>
              </div>
              <div class="sk sk--fiyat-kutu"></div>
              <div class="iskelet-cta">
                <div class="sk sk--buton"></div>
                <div class="sk sk--buton"></div>
              </div>
            </div>
            <div class="sk sk--hero-gorsel"></div>
          </div>
          <div class="iskelet-guven"><div class="container iskelet-guven__ic">{[1,2,3,4,5].map(() => <div class="sk sk--guven-oge"></div>)}</div></div>
          <div class="container iskelet-bolum">
            <div class="sk sk--etiket"></div>
            <div class="sk sk--bolum-baslik"></div>
            <div class="iskelet-urun-grid">{[1,2,3,4].map(() => (
              <div class="iskelet-kart">
                <div class="sk sk--kart-gorsel"></div>
                <div class="sk sk--satir"></div>
                <div class="sk sk--satir sk--kisa"></div>
                <div class="sk sk--fiyat"></div>
                <div class="sk sk--kart-buton"></div>
              </div>
            ))}</div>
          </div>
        </div>

        <!-- 2. Ürün Detay Sayfası İskeleti (Sol Galeri + Sağ Bilgi & Satın Alma + Alt Fayda Kartları) -->
        <div class="iskelet-ekran" data-iskelet-ekran="urun">
          <div class="container">
            <div class="sk sk--kirinti"></div>
            <div class="iskelet-urun-ust">
              <div class="iskelet-galeri">
                <div class="iskelet-kucukler">{[1,2,3,4].map(() => <div class="sk sk--kucuk-foto"></div>)}</div>
                <div class="sk sk--ana-foto"></div>
              </div>
              <div class="iskelet-urun-bilgi">
                <div class="sk sk--etiket"></div>
                <div class="sk sk--urun-baslik"></div>
                <div class="sk sk--satir sk--kisa"></div>
                <div class="sk sk--fiyat-kutu"></div>
                <div class="iskelet-maddeler">
                  <div class="sk sk--madde"></div>
                  <div class="sk sk--madde"></div>
                  <div class="sk sk--madde"></div>
                  <div class="sk sk--madde"></div>
                </div>
                <div class="iskelet-cta">
                  <div class="sk sk--buton"></div>
                  <div class="sk sk--buton"></div>
                </div>
                <div class="sk sk--kargo-kutu"></div>
              </div>
            </div>
            <div class="iskelet-faydalar">{[1,2,3].map(() => <div class="sk sk--fayda-kart"></div>)}</div>
          </div>
        </div>

        <!-- 3. Kategori / Tüm Ürünler Listeleme İskeleti (Başlık + Sol Yan Filtre + Ürün Kartları Izgarası) -->
        <div class="iskelet-ekran" data-iskelet-ekran="liste">
          <div class="container">
            <div class="sk sk--kirinti"></div>
            <div class="sk sk--bolum-baslik"></div>
            <div class="sk sk--satir sk--orta" style="margin-top:8px;margin-bottom:18px"></div>
            <div class="iskelet-filtre-serit">{[1,2,3,4,5].map(() => <div class="sk sk--hap"></div>)}</div>
            <div class="iskelet-liste-duzen">
              <div class="iskelet-yan-filtre">{[1,2,3,4,5,6,7].map(() => <div class="sk sk--yan-satir"></div>)}</div>
              <div>
                <div class="iskelet-liste-arac"><div class="sk sk--etiket"></div><div class="sk sk--sirala"></div></div>
                <div class="iskelet-urun-grid">{[1,2,3,4,5,6,7,8].map(() => (
                  <div class="iskelet-kart">
                    <div class="sk sk--kart-gorsel"></div>
                    <div class="sk sk--satir"></div>
                    <div class="sk sk--satir sk--kisa"></div>
                    <div class="sk sk--fiyat"></div>
                    <div class="sk sk--kart-buton"></div>
                  </div>
                ))}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Setler Sayfası İskeleti (Başlık + 2'li Set Kartları) -->
        <div class="iskelet-ekran" data-iskelet-ekran="setler">
          <div class="container">
            <div class="sk sk--kirinti"></div>
            <div class="sk sk--bolum-baslik"></div>
            <div class="sk sk--satir sk--orta" style="margin-top:8px;margin-bottom:22px"></div>
            <div class="iskelet-set-grid">{[1,2].map(() => <div class="sk sk--set-kart"></div>)}</div>
          </div>
        </div>

        <!-- 5. Sipariş Takip Sayfası İskeleti (Ortalanmış Takip Formu Kartı) -->
        <div class="iskelet-ekran" data-iskelet-ekran="takip">
          <div class="container iskelet-takip">
            <div class="iskelet-takip__kart">
              <div class="sk sk--bolum-baslik"></div>
              <div class="sk sk--satir" style="margin-top:10px;margin-bottom:18px"></div>
              <div class="sk sk--etiket"></div>
              <div class="sk sk--girdi"></div>
              <div class="sk sk--etiket" style="margin-top:14px"></div>
              <div class="sk sk--girdi"></div>
              <div class="sk sk--buton" style="margin-top:18px;width:100%"></div>
            </div>
          </div>
        </div>

        <!-- 6. Ödeme Sayfası İskeleti (Sol Adım Kartları + Sağ Sipariş Özeti) -->
        <div class="iskelet-ekran" data-iskelet-ekran="odeme">
          <div class="container iskelet-odeme">
            <div class="iskelet-odeme__form">
              <div class="sk sk--adim-kart"></div>
              <div class="sk sk--adim-kart"></div>
              <div class="sk sk--adim-kart"></div>
            </div>
            <div class="sk sk--ozet-kart"></div>
          </div>
        </div>
      </div>
    )}
    {gtm && <CerezOnay gtm={gtm} />}
    <div class="dev-banner">Doğrulama modu: sarı çerçeveli metinler teyit bekliyor</div>
    <script type="application/json" id="katalog-veri" set:html={JSON.stringify(k.istemci()).replace(/</g, '\\u003c')} />

    <script>
      import '../scripts/ui';
      import '../scripts/vitrin';
      import '../scripts/sepet';
      import '../scripts/olaylar';
    </script>
  </body>
</html>
